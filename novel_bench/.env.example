# ---------------------------------------------------------------------------
# NovelBench 独立配置（只被 novel_bench 读取，不影响主程序 .env）
# Standalone config for NovelBench. Nothing here is read by the simulator app.
#
# 用法：复制本文件为 `.env`，改掉下面三项即可。
# Usage: copy to `.env` and edit the three values below.
# ---------------------------------------------------------------------------

# 主评审模型（OpenAI 兼容的 /chat/completions）
# Primary judge (any OpenAI-compatible endpoint)
NB_LLM_BASE_URL=https://api.deepseek.com/v1
NB_LLM_API_KEY=
NB_JUDGE_MODEL=deepseek-chat

# 可选：第二、三个评委（同一用例取中位数，抵消单模型偏好）
# Optional: a second / third judge; the report takes the median per dimension.
# NB_JUDGE2_BASE_URL=https://openrouter.ai/api/v1
# NB_JUDGE2_API_KEY=
# NB_JUDGE2_MODEL=anthropic/claude-sonnet-4.5
# NB_JUDGE3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NB_JUDGE3_API_KEY=
# NB_JUDGE3_MODEL=qwen-max

# 评审参数
NB_JUDGE_TEMPERATURE=0
NB_JUDGE_MAX_TOKENS=2200
NB_JUDGE_TIMEOUT=180
NB_JUDGE_REPEATS=1
NB_JUDGE_MAX_CHARS=9000
# 新版 DeepSeek Flash/V4 默认会思考（思考按输出计费，且吃 max_tokens）
# auto=按模型名判断并发送 thinking:disabled；on=强制开；off=强制关
NB_JUDGE_THINKING=auto

NB_PAIRWISE=true

# 推演参数（一拍 = 一次模型往返，实测 1–2 分钟；含开场与收尾，8 拍约 20–25 分钟/用例）
# Run parameters. A beat is one model round-trip (1–2 min measured); with opening and wrap-up,
# 8 beats is roughly 20–25 min/case. Raise NB_RUN_TIMEOUT if you use more ticks.
NB_RUN_TICKS=8
NB_RUN_BEAT_SECONDS=1
NB_RUN_TIME_RATIO=1
NB_RUN_TIMEOUT=2700
NB_KEEP_PROJECTS=false

# 输出与随机种子
NB_OUTPUT_DIR=results
NB_SEED=20261018
NB_LANG=zh
