# 摄取对话框（比普通对话框更宽，便于并排看「日志 / AI 对话」两栏）
# [EN] Ingest dialog (wider than a normal dialog, to view the "日志 / AI 对话" columns side by side)
# ⚠ 这个值乘的是 `paper_frame` 的宽度，**屏幕上的内容区 = 这个值 − 50**
#   （外框 border 2×2 + padding 7×2 + 内层 padding 16×2）。
#   曾经写 980 → 内容区只剩 928 → 每栏 459、正文区 426px ≈ **30 个全角字**：
#   AI 的体检段落一行放不下，而气泡又拿到了"无限宽"（见 `_add_chat`），
#   于是整段被右边缘裁掉 —— 用户的原话是「软件给我的字和我打的回复
#   都看不见，都被右侧吞掉了」。现在 1180 → 每栏 559、正文区 526 ≈ 37 字。
#   实测判据：`developers/probe_chat_bubble.py`（量"墨迹右端 vs 面板右边界"的车道）。
# [EN] ⚠ This value multiplies `paper_frame`'s width, **on-screen content area = this value − 50**
# [EN] (outer frame border 2×2 + padding 7×2 + inner padding 16×2).
# [EN] Once wrote 980 → content area only 928 left → each column 459, body area 426px ≈ **30 full-width
# [EN] chars**:
# [EN] AI's checkup paragraph doesn't fit on one line, and the bubble gets "infinite width" (see
# [EN] `_add_chat`),
# [EN] so the whole paragraph is clipped off at the right edge -- the user's exact words were "the text
# [EN] the software gives me and the reply I type
# [EN] are both invisible, both swallowed by the right side". Now 1180 → each column 559, body area 526
# [EN] ≈ 37 chars.
# [EN] Measured criterion: `developers/probe_chat_bubble.py` (measures the lane of "ink right edge vs
# [EN] panel right border").
ING_W = 1180
ING_H = 540
# 左右两栏（运行日志 / AI 优化对话）是**平铺的流水**，最容易长到看不见头 ——
# 两栏各给一条自绘常驻滚动条（用户 2026-10-06：「开卷的AI部分左侧和右侧也需要滚动条」）。
ING_LANE = 20        # 车道：条画在右边缘、往左画，不留就会压在最右那列字上
ING_LIST_H = 320     # 单栏估高（只影响**初次**画条的长短；真实值等滚动事件校正）
#: 摄取对话框最下面那个聊天输入框的**行数**（用户 2026-10-11：「最下面那个聊天输入的
#: 框 我希望可以高度高一些 比如3行」，右侧的「发送 / ⏹ 强制停止」跟着**居中**
#: 到中间那一行）。
#: ⚠ 行数**只能交给 `min_lines` / `max_lines`**：实测（2026-10-11）
#:   `TextField.height` 在本版 Flet 上不起作用（写 72 也画 62）。见 `_do_import()`
#:   里那个输入框的注释。
# [EN] The number of **lines** for the chat input at the bottom of the ingest dialog (user
# [EN] 2026-10-11: "the chat input at the very bottom, I'd like it taller, say 3 lines", with the
# [EN] "Send / Force stop" buttons on its right **centred** onto the middle line).
# [EN] ⚠ The line count **can only go through `min_lines` / `max_lines`**: measured (2026-10-11),
# [EN] `TextField.height` has no effect in this version of Flet (writing 72 still paints 62). See the
# [EN] note on that input in `_do_import()`.
CHAT_INPUT_LINES = 3
# ★★ 起笔的**启动守卫**（2026-10-12 用户报的两件事都落在这一段）：
#   ①「我连续点了两次起笔，结果就同时有两个推演过程在进行」；
#   ②「我点了起笔之后 感觉没反应了一段时间才开始推演，这也是为什么我会点两次」。
#   ①② 是同一件事的两面 —— 从"点下按钮"到"会话真的起来"这一段**没有任何界面反馈**，
#   用户以为没生效就再点一次；而当时的守卫只看 `self.session`，那要等装配完才建出来，
#   装配那几秒里两次点击**都过了闸**。
#   现在：`LAUNCH_STARTING` 把"装配中"也算占着（单飞），点完立刻切运行页给出反馈，
#   装配丢进后台线程（界面不冻），超时（`LAUNCH_TIMEOUT_S`）由界面主动停止等待。
#   详见 `NovelWorldApp._launch_arm` 上面那一段说明。
# [EN] ★★ The **launch guard** for start-writing (both things the user reported on 2026-10-12 land
# [EN] here):
# [EN] 1. "I clicked start-writing twice in a row and two simulations ran at the same time";
# [EN] 2. "after clicking start-writing nothing happened for a while before it started, which is why I
# [EN] clicked twice".
# [EN] 1 and 2 are two faces of one thing -- the stretch from "button pressed" to "session really up"
# [EN] gave **no UI feedback at all**, so the user thought it had not taken effect and clicked again;
# [EN] and the guard then only looked at `self.session`, which is not created until assembly finishes,
# [EN] so during those assembly seconds **both clicks got through**.
# [EN] Now: `LAUNCH_STARTING` counts "assembling" as occupied (single flight), the click immediately
# [EN] switches to the run screen for feedback, assembly goes to a background thread (the UI stays
# [EN] alive), and the timeout (`LAUNCH_TIMEOUT_S`) makes the UI stop waiting on its own.
# [EN] Details are in the note above `NovelWorldApp._launch_arm`.
LAUNCH_STARTING = 'starting'
#: 启动态（正在装配）。`idle` = 没在装配 —— **"在不在跑"是另一回事**（看 `self.session`）。
#: 两个都要看才是完整的"现在能不能起笔"（见 `launch_busy()`）。
# [EN] The starting state (assembling). `idle` = not assembling -- **"is it running" is a separate
# [EN] question** (see `self.session`).
# [EN] Both must be consulted for a complete "can I start now" (see `launch_busy()`).
LAUNCH_IDLE = 'idle'
#: 装配期间刷新状态条的间隔（秒）。用户要"尽快高速我你已经开始推演" ——
#: 所以这个数**故意很小**：屏幕上那个「已 N 秒」自己会走，就是"没死"的证据。
# [EN] Interval (seconds) for refreshing the status bar during assembly. The user asked for "tell me as
# [EN] soon as possible that you have started" -- so this number is **deliberately small**: the
# [EN] "N s elapsed" on screen moves by itself, which is the evidence that "it is not dead".
LAUNCH_HEARTBEAT_S = 1.0
#: `LAUNCH_TIMEOUT_S` 旋钮的兜底值（秒）—— 旋钮读不出来时用它。
# [EN] Fallback value (seconds) for the `LAUNCH_TIMEOUT_S` knob -- used when the knob cannot be read.
LAUNCH_TIMEOUT_FALLBACK = 180
# [EN] The left and right columns (run log / AI optimization chat) are **flat streams**, most prone to
# [EN] growing beyond sight --
# [EN] each column gets a self-drawn persistent scrollbar (user 2026-10-06: "the AI part on the left
# [EN] and the right side both need scrollbars").
# [EN] Lane: the bar is drawn at the right edge, drawn leftward; if no room is left it presses onto the
# [EN] rightmost column of text
# [EN] Single-column estimated height (only affects the length of the bar on the **first** draw; the
# [EN] real value is corrected on scroll events)

# ★ 摄取阶段里**哪几步会真的调用大模型**（用来给「跟大模型沟通」那行小字说人话）。
# [EN] ★ Which steps in the **ingest phase actually call the large model** (used to make the small text
# [EN] on the "communicate with the large model" line say something human).
# 2026-10-06 逐个对着 `ingest/pipeline.py` 的 `_emit()` 核对过：
#   scan / read / consent  → 本地扫描、读取分章、等你确认，**一步都不联网**；
#   extract (提取设定) · genre (类型判定) · style (风格卡) · progress (进度表)
#   · align (正文对齐) · opening (开局方案)   → 这六步会发 LLM 请求；
#   extract_done / start / tier / freeze / done → 拿结果做本地计算与落盘，不联网。
# 所以这行小字能放心地说「本地处理（这一步不联网）」，不会骗人。
# [EN] 2026-10-06 checked one by one against `_emit()` in `ingest/pipeline.py`:
# [EN] scan / read / consent → local scan, read and chapter split, wait for your confirmation, **not a
# [EN] single step goes online**;
# [EN] extract (extract settings) · genre (genre determination) · style (style card) · progress
# [EN] (progress table)
# [EN] · align (body alignment) · opening (opening plan)   → these six steps send LLM requests;
# [EN] extract_done / start / tier / freeze / done → take the results for local computation and writing
# [EN] to disk, no network.
# [EN] So this small line can safely say "local processing (this step does not go online)" without
# [EN] lying.
# ⚠ **pipeline 加阶段时这里要跟着改**，否则小字会说错（`verify_ingest_status.py`
#   的 A 组会读 `ingest/pipeline.py` 的源码逐个核对，改漏了会当场报红）。
# [EN] ⚠ **When the pipeline adds a stage, this must be changed accordingly**, otherwise the small text
# [EN] will be wrong (`verify_ingest_status.py`
# [EN] 's group A will read the source of `ingest/pipeline.py` and check one by one; if a change is
# [EN] missed it will flag red on the spot).
AI_STAGES = {'extract', 'genre', 'style', 'progress', 'align', 'opening'}

# 帮助面板：**一个窗口两个选项卡** —— 「帮助信息」（翻说明书）/「问个问题」（问说明书）。
# 两页的内容都直接来自随程序附带的《使用说明》(zh) / 《User Manual》(en)，
# 说明书里有表格与代码块，所以这个窗口比普通设置对话框宽。
# [EN] Help panel: **one window, two tabs** -- "Help Info" (browse the manual) / "Ask a Question" (ask
# [EN] the manual).
# [EN] The content of both pages comes directly from the bundled 《使用说明》(zh) / 《User Manual》(en),
# [EN] the manual contains tables and code blocks, so this window is wider than an ordinary settings
# [EN] dialog.
HELP_W = 1180
HELP_H = 640            # 580 → 640：加了选项卡条（`HELP_TAB_H`），内容区高度不变
# [EN] 580 → 640: added the tab strip (`HELP_TAB_H`), content area height unchanged
HELP_TOC_W = 240
HELP_TAB_H = 54         # 选项卡条占的高度（**从 HELP_H 里让出来** —— 不让内容区被挤扁）
# [EN] the height occupied by the tab strip (**yielded from HELP_H** -- so the content area is not
# [EN] squeezed flat)
HELP_PANE_H = HELP_H - HELP_TAB_H

#: 「翻」那一页的**面板**还要再让出多少 px（**实测 99**）。
# [EN] : how many more px the **panel** of the "browse" page must yield (**measured 99**).
#: ★★ 2026-10-09 修用户报的「帮助窗口左边的下拉滚动条**又没了**」。
#:   查到底是**两个错叠在一起**：
# [EN] : ★★ 2026-10-09 fix the user-reported "the dropdown scrollbar on the left of the help window
# [EN] **is gone again**".
# [EN] :   It turns out to be **two errors stacked together**:
#:   ① **面板被悄悄裁掉一截。** `HELP_PANE_H`（586）只是"对话框总高 − 选项卡条"，
#:      它**没算**框架还要拿走的那些（标题行、选项卡条的真实高度、底部按钮、
#:      对话框自身的留白）。实测（`开发者探针`，像素取证）：
#:      面板容器画在 y=380，可**可见部分只到 y=833** —— 只给了 453px，
#:      而代码按 552px 去排版。于是左栏目录**最后一条半被裁掉**，
#:      而屏幕上**没有任何提示**（这才是用户说的"滚滚条没了"的真身：
#:      他想看的条目看不见了，却也没有条告诉他"下面还有"）。
#:   ② **"要不要出条"的估算用的是那个没被裁的高度。**
#:      `toc_avail = pane_h - 12 = 540`，而内容只要 493 → 判"放得下" → 不出条；
#:      可真实可用只有 441 → 内容**超出 52px**。**估算与实际差了整整一截。**
# [EN] : ① **The panel is quietly clipped by a chunk.** `HELP_PANE_H` (586) is just "dialog total
# [EN] height − tab strip",
# [EN] : it **does not count** what the framework also takes (title bar, real height of the tab strip,
# [EN] bottom buttons,
# [EN] :      the dialog's own padding). Measured (`developer probe`, pixel forensics):
# [EN] : the panel container is drawn at y=380, but **the visible part only reaches y=833** -- only
# [EN] 453px given,
# [EN] : while the code lays out for 552px. So the left column's directory **has its last one and a
# [EN] half entries clipped**,
# [EN] : and on screen **there is no hint at all** (this is the true form of what the user called "the
# [EN] scrollbar is gone":
# [EN] : the entries he wanted to see are invisible, yet there is no bar telling him "there is more
# [EN] below").
# [EN] :   ② **The "should a bar appear" estimate uses that unclipped height.**
# [EN] : `toc_avail = pane_h - 12 = 540`, while the content only needs 493 → judged "it fits" → no bar;
# [EN] : but actually only 441 is usable → the content **overflows by 52px**. **The estimate and
# [EN] reality differ by a whole chunk.**
#:   所以这里做两件事，缺一不可：
#:     · `pane_h` **减去这个保留量** → 版面按"真的能拿到的高度"排，不再被裁；
#:     · 估算跟着用同一个 `pane_h` → 超出就**必须**出条（见 `_rebuild` 的 `reset`）。
# [EN] :   So two things are done here, both indispensable:
# [EN] : · `pane_h` **minus this reserve** → layout is arranged by "the height actually obtainable", no
# [EN] longer clipped;
# [EN] : · the estimate uses the same `pane_h` → if it overflows a bar **must** appear (see `reset` in
# [EN] `_rebuild`).
#:   ⚠ 这个数是**实测**的，不是推导的：453 = 552 − 99。框架分给内容的高度
#:     会随窗口大小浮动，所以取值要**偏保守（偏小）** —— 偏小的后果是
#:     "面板留一点空"，偏大的后果是"内容被裁掉且没人告诉用户"。
#:     两者不对称，所以宁可留空。
#:     ⚠ 改这里之后**要重新量一次**（`tools/verify_help_scrollbar.py` 会真机核对
#:     "内容没被裁 + 超出时出条"两件事，量法写在那个脚本里）。
# [EN] : ⚠ This number is **measured**, not derived: 453 = 552 − 99. The height the framework gives to
# [EN] the content
# [EN] : floats with the window size, so the value must be **on the conservative (small) side** -- too
# [EN] small results in
# [EN] : "the panel leaves a bit of blank", too large results in "the content is clipped and no one
# [EN] tells the user".
# [EN] :     The two are asymmetric, so leaving blank is preferred.
# [EN] : ⚠ After changing here, **measure once again** (`tools/verify_help_scrollbar.py` will verify on
# [EN] a real machine
# [EN] : the two things "content not clipped + bar appears when overflowing"; the measurement method is
# [EN] written in that script).
HELP_PANE_RESERVED_H = 99
HELP_CHAT_LANE = 24     # 聊天页给滚动条留的车道（滚动条画在 Column 右边缘、且往左画）
HELP_CHAT_INPUT_W = HELP_W - 140   # 让出「发送」按钮 80 + 间距 + 左侧「问题」标签
HELP_SEARCH_W = 340                # 检索框宽度（右边还要放「清除」与命中数那行小字）
# ── 滚动条几何：**自绘常驻条**（2026-10-06 用户：「左边和右边有下拉条吗？没有就加上」）──
# [EN] The lane the chat page leaves for the scrollbar (the scrollbar is drawn at the right edge of the
# [EN] Column, and drawn leftward)
# [EN] yield "Send" button 80 + spacing + left "Question" label
# [EN] search box width (the right side still needs "Clear" and the small text line of hit count)
# [EN] ── scrollbar geometry: **self-drawn persistent bar** (2026-10-06 user: "do the left and right
# [EN] sides have dropdown bars? if not add them") ──
# 先记结论，别再去试框架那条路（实测过，`developers/probe_help_scrollbar.py`）：
#   · `ft.ListView(scroll=ft.Scrollbar(thumb_visibility=True, …))` —— **无效**；
# [EN] Record the conclusion first, don't try the framework route again (measured,
# [EN] `developers/probe_help_scrollbar.py`):
# [EN] · `ft.ListView(scroll=ft.Scrollbar(thumb_visibility=True, …))` -- **ineffective**;
#   · `page.theme.scrollbar_theme=ft.ScrollbarTheme(thumb_visibility=True, …)`
#     —— **同样无效**（`thickness` 从 8 调到 40，车道里依旧一个像素都没有）。
#   这个 Flet 构建里那个开关没被客户端应用，所以「常驻可见的滚动条」一律
#   **自己画** —— 见 `NovelWorldApp._scroll_bar()`（按 `pixels` /
#   `max_scroll_extent` / `viewport_dimension` 算位置，滚动时更新）。
# [EN] -- **equally ineffective** (`thickness` adjusted from 8 to 40, still not a single pixel in the
# [EN] lane).
# [EN] In this Flet build that switch is not applied by the client, so "persistently visible
# [EN] scrollbars" are all
# [EN] **drawn by ourselves** -- see `NovelWorldApp._scroll_bar()` (computes position by `pixels` /
# [EN] `max_scroll_extent` / `viewport_dimension`, updated on scroll).
# 用它的时候有两件事一起做才对（只做一件就会**看不见**或**压住字**）：
#   ① **车道**：条画在右边缘、**往左画**，右边必须留出 ≥ 条宽的内边距，
#      否则压在最右边那列字上。`ListView` 自带 `padding`，正好把车道做进去；
#      `ft.Column` 没有 `padding`，要用 `_scroll_bar(..., scroller=col)` 配一层
#      带右内边距的 `Container`。
#   ② **初次画不画要显式告诉它**（`bar.reset(need)`）：`max_scroll_extent` 只在
#      滚动事件里才有 —— 不滚就永远不知道内容有没有超出，条会一直藏着。
#      有 `auto_scroll` 的列表自己会滚（不用管）；**预载内容**的列表要调 `reset`。
HELP_BAR_W = 8                     # （历史）框架滚动条粗细；自绘的用 4px，见 `_scroll_bar`
HELP_TOC_LANE = 16                 # 左栏车道
HELP_BODY_LANE = 20                # 右栏车道
HELP_CHAT_H = HELP_PANE_H - 150    # 「问个问题」聊天框的估高（只影响**初次**画条的长短）
# [EN] When using it, two things must be done together (doing only one makes it **invisible** or
# [EN] **press onto the text**):
# [EN] ① **Lane**: the bar is drawn at the right edge, **drawn leftward**, and the right side must
# [EN] leave an inner padding ≥ bar width,
# [EN] otherwise it presses onto the rightmost column of text. `ListView` has its own `padding`, which
# [EN] fits the lane right in;
# [EN] `ft.Column` has no `padding`, so use `_scroll_bar(..., scroller=col)` with a layer
# [EN] of `Container` that has right inner padding.
# [EN] ② **Whether to draw on the first draw must be told explicitly** (`bar.reset(need)`):
# [EN] `max_scroll_extent` only exists
# [EN] in scroll events -- without scrolling you never know whether the content overflows, and the bar
# [EN] stays hidden forever.
# [EN] Lists with `auto_scroll` scroll by themselves (no need to handle); lists with **preloaded
# [EN] content** must call `reset`.
# [EN] (history) framework scrollbar thickness; the self-drawn one uses 4px, see `_scroll_bar`
# [EN] left column lane
# [EN] right column lane
# [EN] estimated height of the "Ask a Question" chat box (only affects the length of the bar on the
# [EN] **first** draw)


# Markdown 渲染开关（**这是默认值修不了的两件事**，2026-10-05 用户报"代码和表格渲染有问题"）：
# [EN] Markdown rendering switch (**these are two things that cannot be fixed with default values**,
# [EN] user reported on 2026-10-05 "code and table rendering has problems"):
# 1. **表格**：`ft.Markdown` 默认的 `MarkdownExtensionSet.NONE` **根本不认表格语法**
#    （表格是 GFM 扩展）→ 说明书里 240 多行 `| a | b |` 全被当成**普通文本行**原样画出来，
#    满屏都是竖线。必须显式给 `GITHUB_WEB`。
# 2. **代码块**：不指定 `code_theme` 时走的是**深色**主题，压在宣纸色的代码块底上
#    → 关键字/注释几乎是浅色，看着像坏的。改用浅色主题 + 等宽字。
# [EN] 1. **Tables**: the default `MarkdownExtensionSet.NONE` of `ft.Markdown` **does not recognize table syntax at all**
# [EN] (tables are a GFM extension) → the 240-some lines of `| a | b |` in the manual are all drawn as
# [EN] **plain text lines** verbatim,
# [EN] The whole screen is vertical bars. Must explicitly pass `GITHUB_WEB`.
# [EN] 2. **Code block**: when `code_theme` is not specified, it uses a **dark** theme, laid on a rice-paper-colored code block background
# [EN] → Keywords/comments are almost light-colored, looking broken. Switch to a light theme +
# [EN] monospace font.
MD_EXTENSION_SET = ft.MarkdownExtensionSet.GITHUB_WEB
MD_CODE_THEME = ft.MarkdownCodeTheme.ATOM_ONE_LIGHT
# 代码字号比正文小一号：说明书里最长的代码行 125 字符，13.5 号会顶出版心
# [EN] Code font size is one step smaller than body text: the longest code line in the doc is 125
# [EN] chars, at 13.5 it overflows the text block
MD_CODE_FS = 12.5

# ★ 有序列表**留给标号的那条道**有多宽（`MarkdownStyleSheet.list_indent`）。
# [EN] ★ How wide is the **lane reserved for the marker** in ordered lists
# [EN] (`MarkdownStyleSheet.list_indent`).
# 用户报的现象（2026-10-06）：「帮助文件目录**从 10 开始后面每行多一个点**」。
# 不是多打了一个点 —— 是**标号自己被折到第二行**了：这条道只按 `1.`（两字符）留，
# 到了 `10.`（三字符）就放不下，标点被挤到下一行单独一行，于是
# 「每行多一个点」，而且那一项还高出一截。
# [EN] User-reported symptom (2026-10-06): "In the help file TOC, **from 10 onward every line has an
# [EN] extra dot**".
# [EN] It's not an extra dot typed in -- it's that **the marker itself gets wrapped to the second
# [EN] line**: this lane is sized only for `1.` (two chars),
# [EN] by `10.` (three chars) it no longer fits, the marker gets pushed to the next line on its own, so
# [EN] "every line has an extra dot", and that item is also a bit taller.
# 实测（`developers/probe_md_listnum.py` 扫 list_indent，量相邻两项的行距）：
#     list_indent=16 → 行距 [26×9, 46, 46, 46, 46]   ← 10..14 那几项被折行，高 46
#     list_indent=24 → 全是 26                        ← 修好
#     24 / 30 / 34 / 40 都一样好
# 所以 16 → **28**（比 24 多留一点余量给别处的字体/缩放，成本只是列表多缩 12px）。
# [EN] Measured (`developers/probe_md_listnum.py` scans list_indent, measures line spacing between
# [EN] adjacent items):
# [EN] list_indent=16 → spacing [26×9, 46, 46, 46, 46]   ← items 10..14 are wrapped, height 46
# [EN] list_indent=24 → all 26                        ← fixed
# [EN] 24 / 30 / 34 / 40 are all equally good
# [EN] So 16 → **28** (a bit more headroom than 24 for fonts/scaling elsewhere, the only cost is the
# [EN] list indenting 12px more).
MD_LIST_INDENT = 28


# ── Markdown 渲染：**唯一入口** ────────────────────────────────────────
# 说明书面板、拾卷的存档卡片与详情，以后任何要渲染 Markdown 的地方都走这里。
# 为什么不各写各的：那三个开关（扩展集 / 浅色代码主题 / 等宽代码字）**少一个就是
# 「表格变满屏竖线」或「代码是浅字压浅底」那种看着像坏了的效果** —— 而它不会报错，
# 只会让人觉得「这软件渲染有问题」（用户 2026-10-05 报的就是这个）。
# `tools/verify_md_render.py` 钉的就是这三个。
# [EN] ── Markdown rendering: **the single entry point** ────────────────────────────────────────
# [EN] The doc panel, the archived save cards and details, and any place that will render Markdown
# [EN] later, all go through here.
# [EN] Why not write each one separately: those three switches (extension set / light code theme /
# [EN] monospace code font) **missing any one means
# [EN] "table turns into a screen full of vertical bars" or "code is light text on a light background",
# [EN] effects that look broken** -- and it won't raise an error,
# [EN] it just makes people think "this software has a rendering problem" (this is exactly what the
# [EN] user reported on 2026-10-05).
# [EN] `tools/verify_md_render.py` pins exactly these three.
def md_style_sheet(body_fs: float = None) -> ft.MarkdownStyleSheet:
    """Markdown 排版：跟着纸墨主题走（默认的黑蓝压在宣纸上很出戏）。

    `body_fs` 给「小字场景」（拾卷的存档卡片）降一档，表格与行内代码跟着缩。
    
        English:
    Markdown typography: follow the paper-ink theme (the default black-blue on rice paper looks very
    out of place).
        `body_fs` drops one level for "small-text scenarios" (the archive cards for picking up scrolls), and tables and inline code shrink along with it.
    """
    fs = float(body_fs or BODY_FS)
    sub = max(10.0, fs - 1.5)          # 表格 / 行内代码比正文小一号
    # [EN] Tables / inline code are one step smaller than body text
    return ft.MarkdownStyleSheet(
        p_text_style=ft.TextStyle(size=fs, color=C['text']),
        a_text_style=ft.TextStyle(size=fs, color=C['accent'],
                                  decoration=ft.TextDecoration.UNDERLINE),
        h1_text_style=ft.TextStyle(size=fs + 6, color=C['gold'],
                                   weight=ft.FontWeight.BOLD),
        h2_text_style=ft.TextStyle(size=fs + 3, color=C['gold'],
                                   weight=ft.FontWeight.BOLD),
        h3_text_style=ft.TextStyle(size=fs + 1, color=C['gold'],
                                   weight=ft.FontWeight.BOLD),
        em_text_style=ft.TextStyle(size=fs, color=C['text'], italic=True),
        code_text_style=ft.TextStyle(size=min(MD_CODE_FS, sub), color=C['seal'],
                                     font_family='Consolas'),
        strong_text_style=ft.TextStyle(size=fs, color=C['text'],
                                       weight=ft.FontWeight.BOLD),
        blockquote_text_style=ft.TextStyle(size=fs, color=C['muted']),
        table_head_text_style=ft.TextStyle(size=sub, color=C['gold'],
                                           weight=ft.FontWeight.BOLD),
        table_body_text_style=ft.TextStyle(size=sub, color=C['text']),
        table_padding=ft.Padding(8, 4, 8, 4),
        list_bullet_text_style=ft.TextStyle(size=fs, color=C['muted']),
        list_indent=MD_LIST_INDENT,
        block_spacing=6,
    )


def mk_md(text: str, *, body_fs: float = None, selectable: bool = True,
          image_error: bool = False) -> ft.Markdown:
    """渲染一段 Markdown。三个开关 + 纸墨配色一次配齐（见上面那段注释）。
        English:
    Render a section of Markdown. Three switches + paper-ink color scheme configured all at once
    (see the comment block above).
    """
    fs = float(body_fs or BODY_FS)
    return ft.Markdown(
        text, selectable=selectable,
        extension_set=MD_EXTENSION_SET,
        code_theme=MD_CODE_THEME,
        code_style_sheet=ft.TextStyle(size=min(MD_CODE_FS, max(10.0, fs - 1.5)),
                                      color=C['seal'], font_family='Consolas'),
        image_error_content=(ft.Text(
            t('（这张插图没能加载 —— 图片在 assets/images/manual/ 下）'),
            size=HINT_FS, color=C['muted']) if image_error else None),
        md_style_sheet=md_style_sheet(body_fs),
    )


def _blocks_of(md_text: str, level: int = 3) -> list:
    """把一章 Markdown 切成**若干个小块**（每块一个小节），供帮助面板逐块渲染。

    见 `util.md.split_blocks()` 的说明：整章交给**一个** `ft.Markdown` 时，
    高度在"首次挂载"那一刻算不准 → 外层 `ListView` 以为没超出 → 不滚也没滚动条。
    拆小之后才量得对。（局部 import：`util.md` 只为这个功能用一次。）
    
        English:
    Split a chapter of Markdown into **several small blocks** (each block a section), for the help
    panel to render block by block.
        See the description in `util.md.split_blocks()`: when the whole chapter is handed to **one** `ft.Markdown`,
        the height cannot be measured accurately at the moment of "first mount" -> the outer `ListView` thinks it hasn't overflowed -> no scroll and no scrollbar.
        Only after splitting into small pieces can it be measured correctly. (Local import: `util.md` is used only once for this feature.)
    """
    from util.md import split_blocks
    return split_blocks(md_text, level)


# ── 「把 Markdown 当纯文本显示」：两个助手（见 `util/md.plain_*`）──────────
# 只给**不经过渲染器**的控件用（目录行 / 正文顶上那行标题 / 命中处摘录）。
# 局部 import 同上：`util.md` 是纯函数模块，没必要在模块级再挂一次依赖。
# [EN] ── "Display Markdown as plain text": two helpers (see `util/md.plain_*`) ──────────
# [EN] Only for controls that **do not go through the renderer** (TOC lines / the title line above body
# [EN] text / excerpts at matches).
# [EN] Local import same as above: `util.md` is a pure-function module, no need to hang another
# [EN] dependency at module level.
def _plain_title(s: str) -> str:
    """章节标题 → 可显示的纯文字（去掉 `**加粗**` / `` `代码` ``）。
        English:
    Section title -> displayable plain text (remove `**bold**` / `` `code` ``).
    """
    from util.md import plain_inline
    return plain_inline(s)


def _plain_frag(s: str) -> str:
    """一行预览 → 纯文字（再去掉 `###` / `>` / `-` / 表格竖线）。
        English:
    One-line preview -> plain text (further remove `###` / `>` / `-` / table pipes).
    """
    from util.md import plain_preview
    return plain_preview(s)


# ── Markdown 摘要：截断不许把格式切坏 ─────────────────────────────────
# 存档卡片与详情面板显示的是「每天的生活 / 运行小结」原文（**本来就是 Markdown**）。
# 直接 `text[:80]` 会切在半个表格行或半个 `**粗体**` 上 —— 渲染出来是
# 「多了个星号」「表格只剩一条竖线」这种莫名其妙的东西。所以：
#   ① 丢本机绝对路径行（`〔图〕…C:\…png`）—— `ft.Markdown` 只认相对路径，
#      留着就是一行谁也不认识的路径文字；
#   ② **按行**累加，绝不切在行中间；
#   ③ 收尾时若正停在一张表格中间，把这张表的残行整段丢掉（半截表格最难看）。
# [EN] ── Markdown summary: truncation must not break the formatting ─────────────────────────────────
# [EN] The archive cards and detail panel show the raw text of "each day's life / run summary" (**which
# [EN] is Markdown to begin with**).
# [EN] Direct `text[:80]` will cut in the middle of a table row or in the middle of `**bold**` --
# [EN] rendering produces
# [EN] "an extra asterisk" / "the table has only one vertical bar left" -- nonsensical things. So:
# [EN] ① Drop absolute local path lines (`〔img〕…C:\…png`) -- `ft.Markdown` only recognizes relative
# [EN] paths,
# [EN] keeping them is just a line of path text nobody recognizes;
# [EN] ② **Accumulate by line**, never cut mid-line;
# [EN] ③ On finishing, if we're stopped in the middle of a table, drop the leftover table lines of that
# [EN] table entirely (a half table looks the worst).
_MD_DROP_PREFIX = ('〔图〕',)


def md_excerpt(text: str, limit: int, *, drop_prefixes=None,
               skip_leading_heads: bool = False) -> str:
    """从 Markdown 原文里取一段**格式不会坏**的摘要（超出部分以 `…` 结尾）。

    `skip_leading_heads=True` 用于**卡片那种小地方**：日档开头是
    `# 第 1 天 · 辰时 · 晴` + `> 在场：…`，在小卡片里渲染成一枚大金标题 +
    一行引言，把真正的内容挤下去。跳过开头这几行，卡片第一眼就是正文。
    
        English:
    Take a **format-preserving** summary from the Markdown source (overflow ends with `…`).
        `skip_leading_heads=True` is for **small places like cards**: the daily archive starts with
        `# Day 1 · Chen hour · Clear` + `> Present: ...`, which in a small card renders as a big gold title +
        one line of quote, pushing the real content down. Skip these leading lines, and the card shows the body text at first glance.
    """
    drops = _MD_DROP_PREFIX + tuple(drop_prefixes or ())
    lines = [ln.rstrip() for ln in str(text or '').splitlines()]
    kept: list[str] = []
    used = 0
    for ln in lines:
        s = ln.strip()
        if s and s.startswith(drops):
            continue
        if skip_leading_heads and not kept and s[:1] in ('#', '>'):
            continue
        if not kept and not s:             # 开头空行不留
        # [EN] Leading blank lines are dropped
            continue
        cost = len(ln) + 1
        if used + cost > limit and kept:
            break
        kept.append(ln)
        used += cost
    while kept and not kept[-1].strip():   # 收尾空行不留
    # [EN] Trailing blank lines are dropped
        kept.pop()
    # ③ 停在表格中间 → 把尾巴上那一串表格行全丢掉
    # [EN] ③ Stopped in the middle of a table → drop the whole run of table lines at the tail
    if kept and kept[-1].strip().startswith('|'):
        while kept and kept[-1].strip().startswith('|'):
            kept.pop()
        while kept and not kept[-1].strip():
            kept.pop()
    body = '\n'.join(kept).strip()
    truncated = len(body) < len('\n'.join(lines).strip())
    return (body + '\n\n…') if (body and truncated) else body


def read_manual(path: Path) -> tuple[str, list]:
    """把说明书按二级标题切成 `(导言, [(章节标题, 正文 markdown), …])`。

    找不到文件就返回空 —— 调用方要明说「没找到」，而不是弹一个空白框
    （打包形态不一定带上 `.md`）。

    ★ 切分**搬到 `util.md.split_h2()`**（2026-10-06）：以前这里是一段自己的
    `re.split(r'(?m)^##[ \\t]+')`，**不认代码围栏** —— 而 §4.2.4「每轮开场」里
    那个 ```markdown 示例块的第 497 行正是 `## 登场人物`，于是：
    左栏目录凭空多出一项「登场人物」（用户报的「为什么没序号」就是它），
    而它**吞掉了后面 §4.3~§4.16 全部小节**（实测 23158 字），
    点「4. 主界面详解」读不到那半个 §4。
    `research/manual_qa._split_sections()` 是同一个 bug 的另一份实现 ——
    两处一起改成调 `util.md`（本项目的老规矩：一份实现，多处调用）。
    
        English:
    Split the manual by H2 headings into `(intro, [(section title, body markdown), ...])`.
        If the file is not found, return empty -- the caller must explicitly say "not found", rather than popping up a blank box
        (the packaged form may not include the `.md`).
        ★ Splitting **moved to `util.md.split_h2()`** (2026-10-06): previously this was its own
        `re.split(r'(?m)^##[ \\t]+')`, which **does not recognize code fences** -- and in §4.2.4 "each round's opening"
        the ```markdown example block's line 497 is exactly `## 登场人物`, so:
        the left-column table of contents gained an extra item "登场人物" out of nowhere (the user-reported "why no number" was this),
        and it **swallowed all subsequent sections §4.3~§4.16** (measured 23158 characters),
        `research/manual_qa._split_sections()` is another implementation of the same bug --
        both places were changed together to call `util.md` (this project's old rule: one implementation, called from multiple places).
    """
    from util.md import split_h2
    try:
        text = path.read_text(encoding='utf-8', errors='ignore')
    except OSError:
        return '', []
    if not text.strip():
        return '', []
    return split_h2(text)


def _snippets(body: str, terms: list[str], *, limit: int = 5,
              around: int = 34) -> list[str]:
    """摘出**命中处**的若干小段（每处前后各 `around` 字），给正文当预览。

    为什么要"若干"而不是一处：检索的粒度是**章**（`read_manual` 按 `##` 切），
    一章可能几十屏长、命中的地方有好几处 —— 只给第一处，用户还得自己在整章里找。
    列出前几处，他扫一眼就知道该看哪儿。

    重叠的窗口只留第一个：同一处命中挤两行是噪声。

    ★ 2026-10-06：摘出来的**是 Markdown 原文**（`### 标题`、`**加粗**`、
    `` `代码` ``、`![图](路径)`、`| 表格 |`），而它要放进的是 `ft.Text` ——
    屏幕上就成了"渲染没成功"的样子（用户报：「搜索结果里有 markdown
    渲染没成功的地方 还有不少」）。所以过一道 `md.plain_preview()`：
    摘录是**一行预览**，本来就不该带标记。
    
        English:
    Extract several small segments at **match locations** (`around` chars before and after each), to
    use as a preview in the main text.
        Why "several" instead of one: the retrieval granularity is **chapter** (`read_manual` splits by `##`),
        a chapter may be dozens of screens long with several match locations -- giving only the first one means the user still has to find it themselves within the whole chapter.
        Listing the first few lets them glance and know where to look.
        For overlapping windows keep only the first: two lines for the same match location is noise.
        ★ 2026-10-06: what is extracted is the **Markdown source** (`### heading`, `**bold**`,
        `` `code` ``, `![image](path)`, `| table |`), but it is placed into `ft.Text` --
        so on screen it looks like "rendering failed" (user reported: "in the search results there are markdown"
        "places where rendering failed, and quite a few"). So it goes through `md.plain_preview()`:
        the extract is a **single-line preview** and should not carry markers anyway.
    """
    s = str(body or '')
    if not s.strip():
        return []
    low = s.lower()
    spots: list[int] = []
    for x in terms:
        xl = str(x).lower()
        start = 0
        while True:
            p = low.find(xl, start)
            if p < 0:
                break
            spots.append(p)
            start = p + max(1, len(xl))
    spots.sort()
    out: list[str] = []
    last_end = -1
    for p in spots:
        if p < last_end:
            continue
        a = max(0, p - around)
        b = min(len(s), p + around + 12)
        # 换行 / 表格线 / 标记全压掉：摘要是"一行纯文字预览"，不该在正文里折断
        # [EN] Line breaks / table borders / markers all flattened: the summary is a "one-line plain-text
        # [EN] preview", it should not break inside the body
        frag = _plain_frag(s[a:b])
        out.append(('…' if a > 0 else '') + frag + ('…' if b < len(s) else ''))
        last_end = b
        if len(out) >= limit:
            break
    return out


def _snippet(body: str, terms: list[str], around: int = 34) -> str:
    """第一处命中那一段（左栏 / 目录行旁边那点预览用）。
        English:
    The segment at the first match location (used for the preview next to the left column /
    directory line).
    """
    got = _snippets(body, terms, limit=1, around=around)
    return got[0] if got else ''


def search_manual(items: list, query: str, *, limit: int = 0) -> list[dict]:
    """在说明书章节里做**关键字检索**（纯本地：零 LLM、零网络、零成本）。

    `items` 是 `read_manual()` 的产物 `[(标题, 正文 markdown), …]`。

    规则（**每条都有对应的验证判据**，见 `tools/verify_help_search.py`）：

      · **多词是「都出现」**（AND）：`运行模式 存档` 只留两样都有的节。
        一个词都不沾的节直接不看 —— 关键字检索的意义就是**收敛**，
        宽进宽出等于没检索（"宁可少给，不可塞一堆"）。
      · **一个都没全命中时退回「沾到一部分」**（`loose=True`），
        界面要明说"下面这些可能不相关" —— 比对着"没有找到"更帮得上忙，
        但绝不能假装它们是答案。
      · 排序：**命中标题**优先（标题是作者亲手写的"这节讲什么"），
        其次按命中次数，最后按原顺序（稳定）。
      · 大小写不敏感；中英文都走同一条路（英文手册就是按英文关键字检索）。

    返回 `[{'idx', 'title', 'count', 'in_title', 'loose', 'snippet', 'snippets'}, …]`。
    空/纯空白查询返回 `[]` —— 界面用"空查询 = 显示全部"（那是另一条分支，
    别把"没查"和"查了没中"混成同一个结果）。
    
        English:
    Perform **keyword search** within manual chapters (purely local: zero LLM, zero network, zero
    cost).
        `items` is the output of `read_manual()`: `[(title, body markdown), …]`.
        Rules (**each has a corresponding verification criterion**, see `tools/verify_help_search.py`):
            A section with none of the words is ignored entirely -- the point of keyword search is **convergence**;
            loose in, loose out means no search at all ("better to give less than stuff a pile").
          · **When none fully match, fall back to "matched partially"** (`loose=True`),
            and the UI must explicitly say "these below may be irrelevant" -- more helpful than just "not found",
            but never pretend they are answers.
          · Order: **title matches** first (titles are the author's own "what this section is about"),
            then by match count, finally by original order (stable).
          · Case-insensitive; Chinese and English take the same path (an English manual is searched by English keywords).
        Return `[{'idx', 'title', 'count', 'in_title', 'loose', 'snippet', 'snippets'}, …]`.
        An empty/whitespace-only query returns `[]` -- the UI uses "empty query = show all" (that is another branch,
        don't mix "not searched" and "searched but no match" into the same result).
    """
    terms = [x for x in re.split(r'[\s,，、;；/]+', str(query or '').strip()) if x]
    if not terms:
        return []

    def _match(require_all: bool) -> list[dict]:
        out: list[dict] = []
        for i, pair in enumerate(items):
            title = str((pair[0] if len(pair) > 0 else '') or '')
            body = str((pair[1] if len(pair) > 1 else '') or '')
            low_t, low_b = title.lower(), body.lower()
            n_title = n_body = found = 0
            for x in terms:
                xl = x.lower()
                a, b = low_t.count(xl), low_b.count(xl)
                if a or b:
                    found += 1
                n_title += a
                n_body += b
            if found == 0 or (require_all and found < len(terms)):
                continue
            snips = _snippets(body, terms)
            out.append({
                'idx': i, 'title': title, 'in_title': n_title > 0,
                'count': int(n_title + n_body), 'loose': not require_all,
                'snippets': snips, 'snippet': snips[0] if snips else '',
            })
        # 标题命中 > 命中次数 > 原顺序（`sorted` 稳定，第三项不用写）
        # [EN] Title match > match count > original order (`sorted` is stable, the third key needs no writing)
        out.sort(key=lambda r: (0 if r['in_title'] else 1, -r['count']))
        return out

    rows = _match(True) or _match(False)
    return rows[:limit] if limit > 0 else rows


# 运行界面：页头高度（显式给出，便于下方中栏算准剩余空间）
# [EN] Run UI: header height (given explicitly, so the middle column below can compute remaining space
# [EN] accurately)
HEADER_H = 48


def _clip(text: str, n: int) -> str:
    """日志里长文本截断（保留头部 + 注明省略字数）。

    ⚠ 那个省略后缀**也能被人看到**（帮助面板的左栏标题就靠它截断）——
    以前是写死的中文，英文界面下会露出「…（省略 5 字）」（`verify_ui_english` 抓到的）。
    所以它走 `t()`。
    
        English:
    Truncate long text in logs (keep the head + note the number of omitted chars).
        ⚠ That omission suffix **can also be seen by people** (the left column title of the help panel relies on it for truncation) --
        it used to be hardcoded Chinese, and under an English UI it exposed "…(5 chars omitted)" (caught by `verify_ui_english`).
        So it goes through `t()`.
    """
    text = str(text).replace("\r", "")
    if len(text) <= n:
        return text
    return text[:n] + t(' …（省略 {n} 字）', n=len(text) - n)


