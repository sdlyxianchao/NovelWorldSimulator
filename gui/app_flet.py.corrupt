# ── 界面不透明度（「天机 · 全局设置」里可调，见 .env 的 UI_OPACITY）──
# [EN] -- UI opacity (adjustable in "Tianji · Global Settings", see UI_OPACITY in .env) --
# 这里特意叫「不透明度」而不是「透明度」：
# 「透明度 30%」到底是「透 30%」还是「留 30%」是经典歧义，
# 用 100 = 完全不透 的语义，配一个 0~100 的整数，谁都不会理解错。
OPACITY_MIN = 30          # 面板下限：再低文字就被背景花纹吃掉
FIELD_OPACITY_MIN = 85    # 可编辑控件下限：得看清自己打的字
DEFAULT_OPACITY = 70      # 与 .env.example 保持一致
# [EN] It's deliberately called "opacity" here rather than "transparency":
# [EN] whether "transparency 30%" means "30% see-through" or "30% retained" is a classic ambiguity,
# [EN] using the semantics of 100 = fully opaque, paired with an integer from 0 to 100, no one can
# [EN] misunderstand.
# [EN] Panel lower bound: any lower and the text gets eaten by the background pattern
# [EN] Editable control lower bound: you have to see what you're typing
# [EN] Keep consistent with .env.example

# 不透明基色（每次改透明度都从这里重算，避免 alpha 反复叠加）
# [EN] Opaque base color (recomputed from here every time opacity changes, to avoid alpha repeatedly
# [EN] stacking)
_BASE_C = dict(C)
_BASE_INKC = dict(INKC)


def ui_opacity() -> float:
    """界面不透明度 0.0~1.0（读 .env 的 UI_OPACITY，越界夹紧）。
        English:
    UI opacity 0.0~1.0 (read UI_OPACITY from .env, clamped when out of range).
    """
    try:
        v = int(CFG.i('UI_OPACITY'))
    except Exception:
        v = DEFAULT_OPACITY
    if v <= 0:
        v = DEFAULT_OPACITY
    return max(OPACITY_MIN, min(100, v)) / 100.0


def with_alpha(color: str, alpha: float) -> str:
    """#RRGGBB → #AARRGGBB（Flet 的颜色格式就是 AARRGGBB）。已是 8 位则换掉 alpha。
        English:
    #RRGGBB -> #AARRGGBB (Flet's color format is AARRGGBB). If already 8 digits, replace the alpha.
    """
    c = str(color).lstrip('#')
    if len(c) == 8:
        c = c[2:]
    if len(c) != 6:
        return color
    a = max(0, min(255, int(round(alpha * 255))))
    return f'#{a:02X}{c.upper()}'


def ink_text(text: str, size: int, color: str, *, stroke: float = 0,
             halo: str = '#ffffff', **kw) -> ft.Control:
    """写在背景图上的墨字：**白描边垫底 + 本色字压上**，等于给字加了圈护边。

    为什么绕这么一圈（都是实测出来的，别再返工）：

    - `TextStyle.shadow` 在 Flet 1.0 里**基本没用**。实测：浅灰底
      （lum=176）上写黑字，量字形外沿最亮值 —— 加不加 shadow 只差
      **+1~+8**，而**不描边的对照组本身**就有 +6 的抗锯齿噪声。
      等于画了看不见（`developers/probe_shadow.py`）。
    - `TextStyle.foreground=Paint(style=STROKE)` **是有效的**，外沿能到
      255。但它会**顶掉填充色**（Flutter 里 `foreground` 优先于 `color`），
      所以必须再叠一层同字号的本色字压上去。
    - 两层靠 `Stack` 居中重合。**字号 / 文本 / 字体必须完全一致**，否则错位
      （`developers/probe_stroke.py`：核心仍是最暗 16、外沿 255）。
    
        English:
    Ink characters written on the background image: **white stroke as the underlay + the
    native-color characters on top**, which is effectively adding an outline to the characters.
        Why take this roundabout approach (all measured, do not redo):
        - `TextStyle.shadow` is **basically useless** in Flet 1.0. Measured: on a light gray background
          (lum=176) writing black text, measuring the brightest value along the glyph edge -- adding shadow or not differs by only
          **+1~+8**, whereas the **non-stroked control group itself** already has +6 of anti-aliasing noise.
          Effectively it draws nothing visible (`developers/probe_shadow.py`).
        - `TextStyle.foreground=Paint(style=STROKE)` **is effective**, the edge reaches
          255. But it **overrides the fill color** (`foreground` takes priority over `color` in Flutter),
          so a second layer of native-color characters at the same font size must be stacked on top.
        - The two layers overlap centered via `Stack`. **Font size / text / font must be exactly identical**, otherwise misalignment
          (`developers/probe_stroke.py`: the core is still darkest 16, edge 255).
    """
    if stroke <= 0:
        return ft.Text(text, size=size, color=color, **kw)
    base = ft.Text(text, size=size, font_family=kw.get('font_family'),
                   text_align=ft.TextAlign.CENTER,
                   style=ft.TextStyle(foreground=ft.Paint(
                       color=halo, stroke_width=stroke,
                       style=ft.PaintingStyle.STROKE)))
    top = ft.Text(text, size=size, color=color, **kw)
    return ft.Stack([base, top], alignment=ft.Alignment(0, 0))


def panel_alpha() -> float:
    """面板用不透明度。
        English:
    Panels use opacity.
    """
    return ui_opacity()


def field_alpha() -> float:
    """输入框/下拉用不透明度（有下限，保证输入可读）。
        English:
    Input boxes/dropdowns use opacity (with a lower bound to keep input readable).
    """
    return max(ui_opacity(), FIELD_OPACITY_MIN / 100.0)


def apply_ui_opacity() -> float:
    """按当前设置重算 C / INKC 里「表面色」的 alpha（**原地改**）。

    原地修改是关键：`C[...]` 被几十处引用，改名/换对象会漏掉一堆地方；
    就地改内容则所有既有引用自动跟着变（构建界面时读到的就是新值）。

    **文字色与描边不加 alpha** —— 半透明的字伤可读性，1px 描边半透明只会显脏。
    
        English:
    Recompute the alpha of the "surface color" in C / INKC according to the current settings
    (**modify in place**).
        In-place modification is key: `C[...]` is referenced in dozens of places, renaming/replacing the object would miss a bunch of spots;
        modifying the contents in place makes all existing references follow automatically (what's read when building the UI is the new value).
        **Text color and stroke do not get alpha** -- semi-transparent text hurts readability, and a semi-transparent 1px stroke only looks dirty.
    """
    a = panel_alpha()
    fa = field_alpha()
    C['panel'] = with_alpha(_BASE_C['panel'], a)
    C['panel_glass'] = with_alpha(_BASE_C['panel'], a)   # 与 panel 同色，只用于主板面
    # [EN] Same color as panel, used only for the main panel surface
    C['hover'] = with_alpha(_BASE_C['hover'], a)
    C['paper_hi'] = with_alpha(_BASE_C['paper_hi'], a)   # 纸册渐变两端
    # [EN] Paper booklet gradient ends
    C['paper_lo'] = with_alpha(_BASE_C['paper_lo'], a)
    C['input_bg'] = with_alpha(_BASE_C['input_bg'], fa)
    INKC['card'] = with_alpha(_BASE_INKC['card'], a)
    INKC['paper'] = with_alpha(_BASE_INKC['paper'], a)
    INKC['hover'] = with_alpha(_BASE_INKC['hover'], a)
    # C['bg'] 是 page.bgcolor（窗口底色），保持不透明：它一透就露出窗口后面的桌面
    # [EN] C['bg'] is page.bgcolor (window base color), keep it opaque: once it becomes transparent it
    # [EN] reveals the desktop behind the window
    return a


# 启动时先算一次，保证任何界面构建前 C/INKC 都已是当前设置对应的值
# [EN] Compute once at startup, to ensure C/INKC already match the current settings before any UI is
# [EN] built
apply_ui_opacity()


# ── 控件几何（对话框里的控件尺寸）──
# [EN] -- Control geometry (control sizes in dialogs) --
# **尺寸是算出来的，不是随手取的。** 三个宽度是同一根栅格上的 1/2、1/3：
# [EN] **The sizes are computed, not arbitrarily chosen.** The three widths are 1/2 and 1/3 on the same
# [EN] grid:
#     全宽 520  ·  半宽 256（2×256 + 8 间距 = 520）  ·  三分 168（3×168 + 2×8 = 520）
# [EN] Full width 520 · Half width 256 (2×256 + 8 gap = 520) · One third 168 (3×168 + 2×8 = 520)
# 以前是 520 / 350 / 250 / 118 混用 —— 那个 350 是「没写 width 时的默认值」，
# 于是同一个面板里同时出现 350 和 520 两种宽度，右边缘参差不齐（实测确认）：
# 「API Key」「Base URL」「界面语言」三个漏写 width 的控件就是 350，其余是 520。
# 现在**默认值就是全宽**，写不写 width 都落在栅格上。
SET_W = 520        # 全宽（默认）
SET_W_HALF = 256   # 半宽：两个并排正好一行
SET_W_THIRD = 168  # 三分：三个并排正好一行
#: 分页那一行里「上一页 / 下一页」两个按钮的宽度。
#: ⚠ 这两颗原来是 `SET_W_THIRD`(168)，加上页码与「每页」下拉一共 594px ——
#:   **超过 `SET_W`(520)**，整行最右端就伸到滚动条车道底下（2026-10-11 用户报的
#:   「每页多少个只能看到"每"」就是这么来的：右端被条压住 / 裁掉）。
#:   96 是"两个字 + 内边距"够用的宽度，不为了填满而把行撑破。
# [EN] Width of the "Previous / Next" buttons in the pagination row.
# [EN] ⚠ These two used to be `SET_W_THIRD` (168); together with the page number and the "per page"
# [EN] dropdown that is 594px -- **more than `SET_W` (520)**, so the right end of the row slid under the
# [EN] scrollbar lane (that is exactly the "per-page shows only '每'" report from the user on 2026-10-11:
# [EN] the right end was pressed on / clipped by the bar). 96 is enough for two characters plus padding,
# [EN] and does not burst the row just to fill it.
SET_W_PAGER_BTN = 96
#: 分页那一行里「每页」下拉的宽度。
#: ⚠ **不能小于 168**（2026-10-11 判据 A4 量出来的）：`_label_width('每页', 168)`
#: 仍取 `LABEL_GUTTER_MIN`(88)，所以下拉本体 = `avail − 88 − 8`。
#: 给 140 时本体只剩 44px —— 显示一位数够，**而"每页 50"这种两位数放不下**
#: （真实字体量：两位数 16px + 左内边距 8 + 右内边距 4 + 箭头 22 = 50px）。
#: 168 时本体 72px，两位数加箭头宽松放下。
# [EN] Width of the "per page" dropdown in the pagination row.
# [EN] ⚠ **Must not be less than 168** (measured by criterion A4 on 2026-10-11):
# [EN] `_label_width('每页', 168)` still takes `LABEL_GUTTER_MIN` (88), so the dropdown body is
# [EN] `avail - 88 - 8`. At 140 the body is only 44px -- fine for one digit, but **"per page 50" (two
# [EN] digits) does not fit** (measured with the real font: two digits 16px + left padding 8 + right
# [EN] padding 4 + arrow 22 = 50px). At 168 the body is 72px, comfortably fitting two digits and the arrow.
SET_W_PAGER_DD = 168
# [EN] Previously 520 / 350 / 250 / 118 were mixed -- that 350 was "the default when width isn't
# [EN] specified",
# [EN] so the same panel had both 350 and 520 widths, with ragged right edges (confirmed by
# [EN] measurement):
# [EN] "API Key", "Base URL", "Interface Language" -- the three controls missing width were 350, the
# [EN] rest were 520.
# [EN] Now **the default is full width**, and whether or not width is written it lands on the grid.
# [EN] Full width (default)
# [EN] Half width: two side by side make exactly one row
# [EN] One third: three side by side make exactly one row

# 高度与字号是**一组比例关系**，不能单独调：
# [EN] Height and font size are **a set of proportional relationships**, they cannot be adjusted
# [EN] independently:
#   ① **控件要矮** —— 42 → 36 → 30 都还嫌高（用户三次说"控件本身也太高了"），
#      现在压到 **24**。这条是**实测过**的：`tools/_exp_field_height.py` 把
#      SET_H 依次设成 30/28/26/24/22 各截一张图，量出文本框的渲染高度
#      严格等于 SET_H（1:1 联动），说明 Flet 认这个值、可以放心往下压。
#      22 时框内只剩 19px，14px 的字开始局促，24 是"还读得舒服"的下限。
#   ② **标签不能小于正文** —— 用户原话："两者差不多大，甚至标签的字体还要
#      再大一些才对"。浮动标签压在边框线上，比正文略大反而更好认。
#      现在是**标签 15 > 正文 14**，比值 1.07。
# [EN] ① **Controls must be short** -- 42 → 36 → 30 all still feel too tall (the user said "the
# [EN] controls themselves are also too tall" three times),
# [EN] now pressed down to **24**. This was **actually measured**: `tools/_exp_field_height.py` sets
# [EN] SET_H to 30/28/26/24/22 in turn, takes a screenshot for each, and measures the rendered height
# [EN] of the text box,
# [EN] which is strictly equal to SET_H (1:1 linkage), showing Flet honors this value and it can be
# [EN] safely pressed lower.
# [EN] At 22 there are only 19px left inside the box, and 14px text starts to feel cramped; 24 is the
# [EN] lower bound of "still comfortable to read".
# [EN] ② **Labels must not be smaller than body text** -- the user's exact words: "the two are about
# [EN] the same size, and the label font
# [EN] should even be a bit larger". The floating label sits on the border line, and being slightly
# [EN] larger than body text actually makes it easier to recognize.
# [EN] Currently it's **label 15 > body 14**, ratio 1.07.
# 判据（`developers/measure_controls.py`）：框高/字号 ∈ [1.6, 2.6]、**标签/正文 ≥ 1.0**、
# **控件高 ≤ 26**。
# 小地图画布尺寸：左栏宽 220、`_create_panel` 左右内边距各 12 → 内容区正好 196。
# 图比内容区宽会被**裁掉而且不报错**，所以这两个数不许随手改大。
# [EN] Criteria (`developers/measure_controls.py`): box height/font size ∈ [1.6, 2.6], **label/body ≥
# [EN] 1.0**,
# [EN] **control height ≤ 26**.
# [EN] Minimap canvas size: left column width 220, `_create_panel` left and right padding 12 each →
# [EN] content area exactly 196.
# [EN] An image wider than the content area gets **clipped without any error**, so these two numbers
# [EN] must not be casually increased.
MAP_W = 196
MAP_H = 132

SET_H = 24         # 控件高度（30 → 24；42 是初版，一路压下来）
SET_FS = 15        # 控件正文 / 输入文字
