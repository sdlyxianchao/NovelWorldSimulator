                   # —— 16 和正文 15 只差 1px，看着就是一回事，拉到 17 才立得住。
DLG_TITLE_FS = 21  # 对话框标题
BTN_H = 28         # 按钮高度（比控件略高一点，点击区不至于太薄）
BTN_FS = 15        # 按钮文字（和控件正文同号，看着是一套）
