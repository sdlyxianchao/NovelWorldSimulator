def _pane(title: str, body: ft.Control) -> ft.Container:
    """带标题的纸卡容器（摄取对话框里放日志 / 对话列表）。
        English:
    Paper-card container with a title (used in the ingestion dialog to hold logs / conversation
    lists).
    """
    return ft.Container(
        content=ft.Column([
            ft.Text(title, size=HINT_FS, color=C['muted']),
            ft.Container(content=body, expand=True),
        ], spacing=4, expand=True),
        bgcolor=C['input_bg'],
        border=make_border(1, C['border']),
        border_radius=6,
        padding=ft.Padding(8, 6, 8, 6),
        expand=True,
    )


# 标签列的宽度：**按字符分别估算**，不能一律按 12px/字。
# 踩过：`story_day 暂停间隔(天)` 里有 10 个拉丁字符，按 12px 估成 204px，
# 把 256 的半宽行顶成 260（溢出 4px，`measure_controls` 的栅格判据抓到的）。
LABEL_GUTTER_MIN = 88   # 短标签的统一左边距（**不用贴着字宽**，否则输入框参差）
FIELD_MIN_W = 64        # 输入框再窄也得留下的宽度（要看得见数字）
# [EN] Width of the label column: **estimate each character separately**, you cannot use a uniform
# [EN] 12px/char.
# [EN] Learned the hard way: `story_day 暂停间隔(天)` contains 10 Latin characters, estimated as 204px at
# [EN] 12px,
# [EN] which pushed the 256 half-width row to 260 (4px overflow, caught by `measure_controls`' grid
# [EN] criterion).
# [EN] Unified left margin for short labels (**do not hug the text width**, otherwise the input boxes
# [EN] end up ragged)
# [EN] The width the input box must retain even when narrow (numbers must be visible)


def _label_px(text: str) -> int:
    """估算标签要占多少像素：CJK 按 1 个字号，拉丁/数字按 0.55 个字号。
        English:
    Estimate how many pixels a label takes: CJK counts as 1 font size, Latin/digits count as 0.55
    font size.
    """
    w = 0.0
    for ch in str(text or ''):
        w += LBL_FS if ord(ch) > 0x2E80 else LBL_FS * 0.55
    return int(w) + 6


def _label_width(label: str, avail: int) -> int:
    """标签列宽：够用、但**绝不吃掉输入框**（保证 行宽 == avail）。

    向上对齐到 **8px 栅格** —— 大多数标签短，统一落到 `LABEL_GUTTER_MIN`；
    只有确实长（如「文生图模型（IMAGE_AI_MODEL）」）才加宽。
    不对齐的话每行标签宽 72/73/87/88 各不相同，右侧输入框起点就会参差。
    
        English:
    Label column width: just enough, but **never eat into the input field** (ensure row width ==
    avail).
        Align upward to the **8px grid** -- most labels are short and uniformly fall to `LABEL_GUTTER_MIN`;
        only those that are truly long (like "文生图模型(IMAGE_AI_MODEL)") get widened.
        Without alignment each row's label width varies 72/73/87/88, and the right-side input field start would be ragged.
    """
    cap = max(LABEL_GUTTER_MIN, avail - 8 - FIELD_MIN_W)
    w = max(LABEL_GUTTER_MIN, min(_label_px(label), cap))
    return min(int(-(-w // 8)) * 8, cap)      # 向上取整到 8 的倍数
    # [EN] Round up to a multiple of 8


def _label_box(label: str, avail: int) -> ft.Container:
    """左侧标签（定宽 + 垂直居中 + 超长省略，绝不换行）。
        English:
    Left-side label (fixed width + vertically centered + ellipsis when too long, never wrap).
    """
    return ft.Container(
        content=ft.Text(label, size=LBL_FS, color=C['muted'],
                        max_lines=1, no_wrap=True,
                        overflow=ft.TextOverflow.ELLIPSIS),
        width=_label_width(label, avail), height=SET_H,
        alignment=ft.Alignment(-1, 0),
        padding=ft.Padding(0, 0, 0, 0),
    )


def mk_field(label: str, value, width: int = None, password: bool = False,
             hint: str = None, on_change=None) -> ft.Row:
    """左侧标签 + 右侧输入框（Windows 风格，不是 Material 浮动标签）。

    返回的是 **`Row`**，真正的输入框挂在 `row._field` 上（`field_value()` 取值）。
    `width` 指**整行**宽度（标签 + 间距 + 输入框），所以放进 `SET_W_HALF` 这种
    并排栅格时，两边加起来还是一整行。
    
        English:
    Left-side label + right-side input field (Windows style, not Material floating label).
        What is returned is a **`Row`**, and the real input field hangs on `row._field` (`field_value()` gets the value).
        `width` means the **whole row** width (label + spacing + input field), so when placed into `SET_W_HALF` and similar
        side-by-side grids, both sides together still equal a full row.
    """
    avail = int(width or SET_W)
    lbl = _label_box(label, avail)
    field_w = avail - int(lbl.width) - 8
    field = ft.TextField(
        value=str(value), password=password, hint_text=hint,
        width=field_w, height=SET_H, text_size=SET_FS,
        content_padding=ft.Padding(8, 4, 8, 4),
        bgcolor=C['input_bg'], color=C['text'], border_color=C['border'],
        on_change=on_change,
    )
    row = ft.Row([lbl, field], spacing=8,
                 vertical_alignment=ft.CrossAxisAlignment.CENTER)
    row._field = field
    return row


def _norm_options(options: list) -> list:
    """把下拉选项的**显示文字搬到 `content` 上**（`key` 才是存盘的值）。

    ⚠ **`ft.DropdownM2` 忽略 `Option.text`，拿 `key` 当显示文字。**
    实测（`developers/probe_dd_option.py`）：`key='K'` + `text='MMMMMMMM'`
    在框里只画出 **7px** 宽（一个 K）；把两者**对调**，仍是 **98px**（八个 M）
    —— 说明显示的一直是 `key`，跟 `text` 无关。
    `ft.dropdown.Option` 与 `dropdownm2.Option` 行为**完全一致**（换个类没用）。

    后果就是用户在界面上看到 `story` / `story_day` / `zh` 这类变量值 ——
    「后台存变量值、前台给人话」的设计**在这里整条失效了**。
    文档写 `content` 优先、`text` 只是它的兜底，实测确实如此：补上 `content`
    之后框里显示的就是它（98px ✓）。

    所以统一在这里补：**有 `text` 没 `content` 的，包一个 `ft.Text` 进去**。
    只改一处，全项目 20 多个下拉框一起修好。

    **`text` 要原样留着**：真正渲染的是 `content`，但 `text` 是"这项该显示什么"
    的可读记录 —— 验证脚本（`tools/verify_run_modes.py`）和以后读代码的人都靠它。
    两个都写，别嫌重复。
    
        English:
    Move the dropdown option's **display text onto `content`** (`key` is the value that gets saved).
        ⚠ **`ft.DropdownM2` ignores `Option.text` and uses `key` as the display text.**
        Measured (`developers/probe_dd_option.py`): `key='K'` + `text='MMMMMMMM'`
        draws only **7px** wide in the box (one K); **swapping** the two still gives **98px** (eight M's)
        -- showing that what is displayed has always been `key`, unrelated to `text`.
        `ft.dropdown.Option` and `dropdownm2.Option` behave **exactly the same** (changing the class does nothing).
        The consequence is that the user sees variable values like `story` / `story_day` / `zh` in the UI --
        the design of "store variable values in the backend, show human words in the frontend" **fails entirely here**.
        The docs say `content` takes priority and `text` is just its fallback, and measurement confirms it: add `content`
        and what shows in the box is it (98px ✓).
        So patch it uniformly here: **anything with `text` but no `content`, wrap it in an `ft.Text`**.
        Change one place, fix all 20+ dropdowns across the whole project.
        **`text` must be kept as-is**: what actually renders is `content`, but `text` is the readable record of "what this item should display"
        -- the verification script (`tools/verify_run_modes.py`) and future readers of the code both rely on it.
        Write both, don't mind the duplication.
    """
    out = []
    for o in options:
        text = getattr(o, 'text', None)
        if text and not getattr(o, 'content', None):
            o = ft.dropdown.Option(
                key=o.key,
                text=text,
                content=ft.Text(text, size=SET_FS, color=C['text']),
            )
        out.append(o)
    return out


def mk_dropdown(label: str, options: list, value, width: int = None) -> ft.Row:
    """左侧标签 + 右侧下拉框（Windows 风格）。

    ⚠ **必须用 `ft.DropdownM2`，不能用 `ft.Dropdown`。**
    实测（`developers/probe_dd_h.py` / `probe_dd_m2.py`）：

    - `ft.Dropdown` 是 Material 输入框那一套，**框顶固定留 20px 给浮动标签**，
      文字永远从框顶往下 20px 起排。压到 24px 高时文字会**掉出框外、落到标签下方**
      （实测偏差 +13.5px），看起来就是"标签没对齐 + 框里上面一大片空"。
      负 content_padding / dense / 无边框**都改不掉**，只有给到 48px 才居中 —— 太蠢。
    - `ft.DropdownM2` 没有那套装饰，`height` 被严格认，配
      `text_vertical_align=CENTER` + `alignment=(-1,0)` 后文字中心偏差只有 **+2px**。

    箭头（`select_icon`）靠右放：`content_padding` 右边给小值即可。

    **`options` 一律先过 `_norm_options()`** —— `DropdownM2` 只认 `key` 当显示文字，
    不补 `content` 的话界面上会露出变量值（见那个函数的说明）。
    
        English:
    Label on the left + dropdown on the right (Windows style).
        ⚠ **Must use `ft.DropdownM2`, not `ft.Dropdown`.**
        Measured (`developers/probe_dd_h.py` / `probe_dd_m2.py`):
        - `ft.Dropdown` is the Material text-field family: **a fixed 20px is reserved at the top of the box for the floating label**,
          and text always starts 20px down from the top edge. Squeeze it to 24px tall and the text **falls out of the box, landing below the label**
          (measured offset +13.5px), which looks like "the label is misaligned + a big empty strip at the top of the box".
          Negative content_padding / dense / no border **none of them fix it**; only giving it 48px centers it -- absurd.
        - `ft.DropdownM2` has none of that decoration, `height` is strictly honored, and with
          `text_vertical_align=CENTER` + `alignment=(-1,0)` the text center offset is only **+2px**.
        The arrow (`select_icon`) sits on the right: a small `content_padding` on the right is enough.
        **`options` always goes through `_norm_options()` first** -- `DropdownM2` only recognizes `key` as the display text,
        and without adding `content` the variable value leaks into the UI (see that function's docs).
    """
    avail = int(width or SET_W)
    lbl = _label_box(label, avail)
    dd_w = avail - int(lbl.width) - 8
    # 本体去掉自带底色/边框（DropdownM2 的 border_width/border_color 在
    # 无 `border` 样式时不生效），改由外面那层 Container 提供 —— 这样
    # 输入框（TextField）和下拉框看起来是**同一种盒子**。
    # [EN] The body itself drops its own background/border (DropdownM2's border_width/border_color is
    # [EN] ineffective when there is no `border` style), and instead the outer Container provides it — this
    # [EN] way
    # [EN] the input box (TextField) and the dropdown look like **the same kind of box**.
    dd = ft.DropdownM2(
        options=_norm_options(options), value=value,
        expand=True, height=SET_H, text_size=SET_FS,
        text_vertical_align=ft.VerticalAlignment.CENTER,
        alignment=ft.Alignment(-1, 0),
        # 右边给小值 → 箭头（select_icon）贴着右边缘（用户要求"使劲往右放"）
        # [EN] Give a small value on the right → the arrow (select_icon) hugs the right edge (user asked to
        # [EN] "push it hard to the right")
        content_padding=ft.Padding(8, 0, 4, 0),
        color=C['text'], bgcolor=None, filled=False, border_width=0,
        select_icon=ft.Icon(ft.Icons.ARROW_DROP_DOWN, size=SZ(18),
                            color=C['muted']),
    )
    shell = ft.Container(
        content=dd, width=dd_w, height=SET_H,
        bgcolor=C['input_bg'],
        border=make_border(1, C['border']), border_radius=4,
        padding=ft.Padding(0, 0, 0, 0),
    )
    row = ft.Row([lbl, shell], spacing=8,
                 vertical_alignment=ft.CrossAxisAlignment.CENTER)
    row._field = dd
    return row


def field_value(ctrl) -> str:
    """从 mk_field/mk_dropdown 返回的 Row 中取值。
        English:
    Get values from the Row returned by mk_field/mk_dropdown.
    """
    if hasattr(ctrl, '_field'):
        return ctrl._field.value or ''
    return getattr(ctrl, 'value', '') or ''


# 模型下拉的**内置兜底**候选。只在「没拉取过、也没缓存」时用得上。
# 顺序有意：把 DeepSeek 现行的名字放最前（用户 2026-10-06 的原话就是
# 「我之前写的模型名字不对」—— 下拉里能选到，才不会填错）。
# [EN] The **built-in fallback** candidates for the model dropdown. Only used when "never fetched and
# [EN] never cached".
# [EN] The order is intentional: put DeepSeek's current name first (the user's exact words on
# [EN] 2026-10-06 were
# [EN] "the model name I wrote before was wrong" — being able to select it in the dropdown is what
# [EN] prevents mis-entry).
_FALLBACK_MODELS = (
    'deepseek-flash,deepseek-v4-pro,deepseek-chat,deepseek-reasoner,'
    'gpt-4o,gpt-4o-mini,qwen-max,qwen-turbo,glm-4-flash'
)


def model_choices(*current: str) -> list:
    """模型下拉的候选项：**缓存 → 内置兜底 → 当前填的值**。

    三样缺一不可（每一种缺法都是踩过的坑）：

    * 少了**缓存/拉取结果** -> 下拉里永远是那几个写死的名字。用户看到的
      "只有 DeepSeek-V4 Flash 和 DeepSeek-V4 Pro" 就是被这个坑的：
      服务上真正有什么，只有 `/models` 说了算，写死的列表迟早对不上。
    * 少了**当前值** -> 服务端改了模型名之后，`.env` 里存着的旧值不在候选项里，
      下拉框显示成空 —— 用户会以为配置丢了。
    * 少了**内置兜底** -> 第一次装好、还没拉过的时候下拉是空的，无从下手。
    
        English:
    Candidates for the model dropdown: **cache -> built-in fallback -> currently filled value**.
        All three are required (each missing one is a pit we've already stepped in):
        * Missing the **cache/fetch result** -> the dropdown always shows just those hardcoded names. The "only
          DeepSeek-V4 Flash and DeepSeek-V4 Pro" users saw was exactly this pit:
          what's actually on the server is only dictated by `/models`; a hardcoded list will eventually be out of date.
        * Missing the **current value** -> after the server renames a model, the old value stored in `.env` isn't among the candidates,
          the dropdown shows empty -- users think the config was lost.
        * Missing the **built-in fallback** -> on a fresh install before any fetch, the dropdown is empty and there's nothing to pick.
    """
    out: list[str] = []
    for src in (CFG.s('MODEL_LIST_CACHE'), _FALLBACK_MODELS,
                ','.join(c for c in current if c)):
        for name in str(src or '').split(','):
            name = name.strip()
            if name and name not in out:
                out.append(name)
    # `key` 是存进 `.env` 的值、`text` 是给人看的显示文字（这里两者相同）——
    # 两个都写，`_norm_options` 才会补上 `content`（否则 DropdownM2 只认 key）。
    # [EN] `key` is the value stored into `.env`, `text` is the display text shown to humans (here the two
    # [EN] are the same) —
    # [EN] write both, and `_norm_options` will fill in `content` (otherwise DropdownM2 only recognizes
    # [EN] key).
    return [ft.dropdown.Option(key=n, text=n) for n in out]


def mk_help_dot(on_click, tooltip: str = '') -> ft.Control:
    """小节标题旁边那个小「?」—— 点开一段说明。

    ⚠ **不能用 `ft.IconButton`**：它的点按区自带 40~48px 内边距，
    塞进标题行会把整行顶高（这项目栽过：控件自带尺寸把行撑变形）。
    这里就是一个 18×18 的圆点，尺寸完全可控。
    
        English:
    The little "?" next to a section title -- click to open an explanation.
        ⚠ **Cannot use `ft.IconButton`**: its tap area has 40~48px of built-in padding,
        and stuffing it into a title row pushes the whole row taller (this project got burned by that: control-intrinsic size deforming the row).
        Here it's just an 18x18 dot with fully controllable size.
    """
    return ft.Container(
        content=ft.Text('?', size=SZ(12), color=C['gold'],
                        weight=ft.FontWeight.BOLD),
        width=18, height=18, border_radius=9,
        bgcolor=with_alpha(C['border_gold'], 0.18),
        border=make_border(1, C['border_gold']),
        alignment=ft.Alignment(0, 0),
        on_click=on_click, tooltip=(md_strip(tooltip) or None),
    )


#: 提示问号的直径。**就是很小** —— 它是"解释按钮"，不是内容；
#: 大了会把所在那一行顶高（本项目对"控件自带高度把行撑变形"栽过好几次）。
# [EN] : diameter of the hint question mark. **It is just very small** — it is an "explain button", not
# [EN] content;
# [EN] : if larger it would push the row it is on taller (this project has been burned several times by
# [EN] "a control's built-in height deforming the row").
TIP_D = 15


def mk_tip(text: str, *, d: int = TIP_D, fg: str = '', bg: str = '',
           ring: str = '') -> ft.Control:
    """白色带圈的小问号 —— **鼠标放上去**就解释旁边那个东西是什么。

    用户 2026-10-10 原话：「你看下软件的 UI 上哪些地方需要 Tip 解释的 你都加上
    样式是有一个白色带圈小问号（很小） 鼠标放上去就解释对应目标是什么东西」。

    ⚠ 与 `mk_help_dot` **不是一回事，别合并**：

    ==================  ====================  ==========================
    哪个                 外观                  行为
    ==================  ====================  ==========================
    `mk_help_dot`       金环 · 18px            **可点** —— 打开一段完整说明
    `mk_tip`（这个）     白环 · 15px            **只能悬停** —— 只给一句话
    ==================  ====================  ==========================

    外观刻意做得不一样：**长得一样却行为不同，等于骗人**。
    金色的那个能点，白色的只解释 —— 用户看一眼就知道该不该点。

    ⚠ 尺寸**完全写死**（宽=高=`d`）。不可以用 `ft.IconButton`：它自带
    40~48px 的点按区，塞进标题行会把整行顶高（见 `mk_help_dot` 的注释）。
    
        English:
    Small white circled question mark -- **hover the mouse** and it explains what the thing next to
    it is.
        User's exact words on 2026-10-10: "Look through the software's UI for places that need a Tip explanation and add them all.
        The style is a small white circled question mark (very small); hover the mouse and it explains what the target is."
        ⚠ **Not the same thing as `mk_help_dot`, don't merge them**:
        ==================  ====================  ==========================
        Which               Appearance            Behavior
        ==================  ====================  ==========================
        `mk_help_dot`       gold ring · 18px      **clickable** -- opens a full explanation
        `mk_tip` (this)     white ring · 15px     **hover only** -- just one sentence
        ==================  ====================  ==========================
        Appearance is deliberately different: **looking the same but behaving differently is lying**.
        The gold one is clickable, the white one only explains -- users know at a glance whether to click.
        ⚠ Size is **hardcoded** (width = height = `d`). Cannot use `ft.IconButton`: it comes with
        a 40~48px tap area; stuffing it into a title row pushes the row taller (see `mk_help_dot`'s comment).
    """
    return ft.Container(
        content=ft.Text('?', size=max(9.0, d * 0.68), color=fg or C['muted'],
                        weight=ft.FontWeight.BOLD,
                        text_align=ft.TextAlign.CENTER),
        width=d, height=d, border_radius=d,
        bgcolor=bg or '#ffffff',
        border=make_border(1, ring or C['border']),
        alignment=ft.Alignment(0, 0),
        # ⚠ tooltip 是**平台原生浮层**，只吃纯字符串 ⇒ 这里的 `**` 只能去掉
        #   （不去掉就是字面上带星号的一句提示，用户天天看）。见 `md_strip`。
        # [EN] ⚠ tooltip is a **platform-native overlay**, it only accepts plain strings ⇒ the `**` here can
        # [EN] only be stripped
        # [EN] (if not stripped it becomes a literal hint with asterisks, which the user sees every day). See
        # [EN] `md_strip`.
        tooltip=md_strip(text),
    )


def mk_tip_row(label, tip: str, *, spacing: int = 6, label_kw: dict = None):
    """"一句话标签 + 白问号"排成一行（**界面上最常用的一处**）。

    `label` 可以是 `str`（自动变成一个 `ft.Text`），也可以是已经建好的控件
    （比如带颜色的那一行）。返回 `ft.Row`。
    
        English:
    "One-line label + white question mark" laid out in a row (**the most commonly used spot in the
    UI**).
        `label` can be a `str` (automatically becomes an `ft.Text`), or an already-built control
        (e.g. the colored row). Returns an `ft.Row`.
    """
    ctrl = label if not isinstance(label, str) else mk_text(
        label, size=BODY_FS, color=C['muted'])
    return ft.Row([ctrl, mk_tip(tip)], spacing=spacing,
                  vertical_alignment=ft.CrossAxisAlignment.CENTER,
                  **(label_kw or {}))


def mk_menu_icon(spec: str, *, color: str, dim: bool = False, d: int = 38,
                 size: int = 20) -> ft.Control:
    """开始菜单左边那个图标 —— **彩色位图优先**，矢量/emoji 兜底。

    `spec` 有三种写法，**同一个形参**：
      · **`img:<槽位>`**（`'img:puzzle'` / `'img:door'` …）→ 渲染成 `ft.Image`，
        位图来自 `assets/images/menu_icons/<槽位>.png`（**当前八项都走这条**）；
      · **Material 图标名**（`'EXTENSION'` / `'LOGOUT'`…）→ `ft.Icon`（单色矢量）；
      · **别的字符串**（`'📜'` 这种 emoji）→ 原样渲染成 `ft.Text`。

    ★★ 为什么是位图（这一项本轮翻过面，别照着旧注释想）：
      用户 2026-10-10 先点名要三个 emoji 里没有的字形（"拼图"/"下横+逆时针箭头"/
      "门+从门里离开"），于是八项**统一换成了单色矢量图标**；当天又追加一句
      **「你帮我绘制或者去网上找之前那种彩色图标 现在不好看 如果是网上找则请
      避免版权问题」** —— 单色线条在纸色卡片上确实偏冷、偏"工具感"。
      ⇒ 结论不是"退回 emoji"（那三个字形的问题还在），而是
        **彩色 + 字形可选 + 许可干净**：用微软 Fluent Emoji（**MIT**）的图标，
        离线落成 PNG 提交进仓库。生成脚本 `developers/make_menu_icons.py`，
        出处与许可见 `assets/images/menu_icons/README.md`。
      ⇒ 收益之一：**系统 emoji 字体各平台长得不一样**（macOS/Linux 又是另一套），
        位图是同一张图，三个平台一个样；`color` 参数也终于能真染上色（见下）。

    `dim=True` → 用同一张图的**去色褪色版**（`_dim.png`）。
      这一项**不可点**时（没有正在运行的故事），标题、说明、图标一起灰 ——
      这是上一轮"灰掉就整项在灰、不是只灰一半"的延续。

    ⚠ **兜底那两条不是装饰，别当死代码删掉**：
      ① `img:` 指到的文件**不在**（槽位名写错、或素材没生成）→ 不崩，
         降级成一个"破图"矢量图标 —— 一眼看得出不对，但窗口照常打得开；
      ② 想把某一项换回 emoji 或矢量，把 `img:xxx` 改成 `'📜'` / `'SETTINGS'`
         即可，不用改这个函数。
      **但菜单里那八项必须都是彩色位图**，这条由
      `tools/verify_resume_menu.py` 的**真机**判据钉着（见 `EXPECT_ICON`）。
    
        English:
    The icon on the left of the Start menu -- **colored bitmap preferred**, vector/emoji as
    fallback.
        `spec` has three forms, **all on the same parameter**:
          · **`img:<slot>`** (`'img:puzzle'` / `'img:door'` ...) → rendered as `ft.Image`,
            bitmap comes from `assets/images/menu_icons/<slot>.png` (**all eight items currently go this route**);
          · **Material icon name** (`'EXTENSION'` / `'LOGOUT'`...) → `ft.Icon` (monochrome vector);
          · **any other string** (an emoji like `'📜'`) → rendered as-is into `ft.Text`.
        ★★ Why bitmaps (this item was reworked this round, don't reason from the old comments):
          on 2026-10-10 the user first named three glyphs not present in emoji ("puzzle"/"down-bar + counterclockwise arrow"/
          "door + leaving through the door"), so the eight items were **uniformly switched to monochrome vector icons**; the same day they added
          **"You draw them for me or go find that old colorful icon style online, it doesn't look good now, and if you find them online please
          avoid copyright issues"** —— monochrome line art on a paper-colored card really does feel cold and "tool-like".
          ⇒ The conclusion is not "revert to emoji" (those three glyphs' problem remains), but
            **colorful + glyph optional + clean license**: use Microsoft Fluent Emoji (**MIT**) icons,
            baked offline into PNGs and committed to the repo. Generation script `developers/make_menu_icons.py`,
            provenance and license in `assets/images/menu_icons/README.md`.
          ⇒ One benefit: **the system emoji font looks different on each platform** (macOS/Linux is yet another set),
            the bitmap is the same image, identical across all three platforms; and the `color` param can finally actually tint it (see below).
        `dim=True` → use the **desaturated faded version** of the same image (`_dim.png`).
          When this item is **not clickable** (no story currently running), title, description and icon go gray together ——
          this continues the previous round's "when grayed, the whole item is gray, not just half of it".
        ⚠ **Those two fallback branches are not decoration, don't delete them as dead code**:
          ① the file that `img:` points to is **missing** (slot name typo, or asset not generated) → don't crash,
             fall back to a "broken image" vector icon —— obviously wrong at a glance, but the window still opens normally;
          ② to switch an item back to emoji or a vector, change `img:xxx` to `'📜'` / `'SETTINGS'`
             and you're done, no need to touch this function.
          **But those eight items in the menu must all be colorful bitmaps**, this is nailed down by
          the **real-device** criterion in `tools/verify_resume_menu.py` (see `EXPECT_ICON`).
    """
    nm = str(spec or '').strip()
    if nm.startswith('img:'):
        slot = nm[4:]
        f = MENU_ICON_DIR / f'{slot}{"_dim" if dim else ""}.png'
        if f.exists():
            return ft.Container(
                content=ft.Image(src=str(f), width=d, height=d,
                                 fit=ft.BoxFit.CONTAIN),
                width=d, alignment=ft.Alignment(0, 0))
        return ft.Container(
            content=ft.Icon(ft.Icons.BROKEN_IMAGE, size=size, color=color),
            width=d, alignment=ft.Alignment(0, 0))
    glyph = getattr(ft.Icons, nm, None) if nm and nm.isascii() else None
    if glyph is not None:
        ctrl: ft.Control = ft.Icon(glyph, size=size, color=color)
    else:
        ctrl = ft.Text(nm, size=size, color=color,
                       text_align=ft.TextAlign.CENTER)
    # 宽度写死成 `d`：八项的图标列必须**同宽**，否则标题会参差不齐。
    # [EN] Width is hardcoded to `d`: the icon column of the eight items must be **the same width**,
    # [EN] otherwise the titles come out misaligned.
    return ft.Container(content=ctrl, width=d, alignment=ft.Alignment(0, 0))


def mk_section(text: str, on_help=None, help_tooltip: str = '') -> ft.Control:
    """小节标题。

    **标题下面必须留白。** 以前它是个裸 `Text`，和下面第一个控件只隔一个
    Column 的 spacing（6px）—— 看起来就是"标题和选项挤在一起"（用户原话）。
    现在标题自带 10px 下边距，加上 Column 的 spacing，小节之间才有层次。

    返回 `Container`（不是 `Text`）就是为了这段留白 —— 调用方照旧放进列表即可。
    统一点：**下边距用这里，间距用 Column 的 `spacing`**，别在调用处手塞空 Divider。

    `on_help`：给了就在标题右边挂一个小「?」（`mk_help_dot`），点开说明。
    没给时**仍然返回一个 Row**（不是裸 Text）—— 两种形态宽度一致，
    不至于同一份布局里有的标题左对齐 3px、有的 0px。
    
        English:
    Section heading.
        **There must be whitespace below the title.** It used to be a bare `Text`, separated from the first widget below by only
        the Column's spacing (6px) —— which just looked like "the title and the options are crammed together" (user's words).
        Now the title carries its own 10px bottom margin, plus the Column's spacing, so sections have some hierarchy.
        Returning a `Container` (not a `Text`) is precisely for this whitespace —— callers just drop it into a list as before.
        Unified rule: **bottom margins go here, gaps use the Column's `spacing`**, don't hand-stuff empty Dividers at the call site.
        `on_help`: if given, hang a small "?" (`mk_help_dot`) to the right of the title, click to open the explanation.
        When not given, **still return a Row** (not a bare Text) —— both forms have the same width,
        so titles in the same layout don't end up some left-aligned by 3px and some by 0px.
    """
    title = ft.Text(text, color=C['gold'], size=SEC_FS,
                    weight=ft.FontWeight.BOLD)
    row = ft.Row([title] + ([mk_help_dot(on_help, help_tooltip)] if on_help else []),
                 spacing=6, vertical_alignment=ft.CrossAxisAlignment.CENTER)
    return ft.Container(content=row, padding=ft.Padding(0, 2, 0, SECTION_GAP))


def mk_tab_content(controls: list, pane_h: int = None,
                   lane_extra: int = 0) -> ft.Container:
    """选项卡内容容器（**天机 / 书斋两个选项卡对话框共用**）。

    三条约定，都是用户提过之后定下来的：

    1. **行距 10**（原来 6）—— 配合 `mk_section` 的下边距，标题与选项之间
       大约 16px；同一小节里的控件之间 10px。
    2. **右侧留一条 `TAB_GUTTER` 的车道给滚动条**，而且**把 Column 的宽度写死**。
    3. ★ **给这条车道配一条真的看得见的滚动条**（2026-10-06 用户：
       「我标框的地方没有滚动条」）。原来这里只写了 `scroll=ScrollMode.ADAPTIVE`
       就以为"滚动条一直显示" —— 那是**错的**：Flutter 的滚动条默认
       `thumbVisibility:false`，**只在拖动时现身**（这个 Flet 构建里连那个开关
       都不生效，见 `mk_scroll_bar` 的文件头）。所以改走和其他栏同一套：
       自绘常驻条。⚠ **不做"主动校准"** —— 那个做法会阻塞事件循环，
       见 `mk_scroll_bar` 上面那段（血的教训）；可见性由调用方的估算
       （`reset`）与真实的滚动事件共同决定。

    ⚠ **为什么要把 Column 的宽度写死、并且横向 padding 给 0：**

    滚动条画在**可滚动条（Column）自己的右边缘上，且往左画**。所以
    「车道 = Column 宽 − 控件宽」，只有 Column 宽写死，这个等式才成立。
    以前靠"容器内边距"间接决定 Column 宽，结果：
    `paper_frame` 的 16×2 和这里的 14+6 **叠了两层内边距**，
    在 DLG_W=576 时内容区只剩 **524** —— **比控件还窄 16px**，
    滚动条当然压在输入框上（用户连着两轮反馈的就是这个）。

    现在：横向 padding 归零（左右留白全部交给 `paper_frame` 的 16），
    Column 与容器都写死 `SET_W + TAB_GUTTER`，车道由构造保证。

    `lane_extra`（2026-10-10 加）：**把车道整体加宽**，给"页签多、要加宽
    对话框"的场合用（目前只有「天机」，见 `DLG_W_TABS`）。加宽的那部分
    **平分到控件两侧**（`horizontal_alignment=CENTER`）—— 控件本身仍是
    `SET_W` 宽（栅格写死 520，改不得），所以多出来的宽度只当左右留白，
    滚动条依旧贴右边缘。`lane_extra=0` 时行为与以前**逐像素一致**。
    
        English:
    Tab content container (**shared by both the Tianji / Shuzhai tab dialogs**).
        Three conventions, all settled after the user raised them:
        1. **Line spacing 10** (was 6) —— together with `mk_section`'s bottom margin, title to options is
           about 16px; widgets within the same section are 10px apart.
        2. **Keep a `TAB_GUTTER` lane on the right for the scrollbar**, and **hard-code the Column's width**.
        3. ★ **Give this lane a real, visible scrollbar** (2026-10-06 user:
           "The spot I boxed has no scrollbar"). It used to be that writing just `scroll=ScrollMode.ADAPTIVE`
           made one assume "the scrollbar is always shown" —— that is **wrong**: Flutter's scrollbar defaults to
           `thumbVisibility:false`, **only appearing while dragging** (in this Flet build even that switch
           doesn't work, see the file header of `mk_scroll_bar`). So we switch to the same scheme as the other columns:
           a self-drawn always-visible bar. ⚠ **No "active calibration"** —— that approach blocks the event loop,
           see the paragraph above `mk_scroll_bar` (blood lesson); visibility is determined jointly by the caller's estimate
           (`reset`) and real scroll events.
        ⚠ **Why hard-code the Column's width and set horizontal padding to 0:**
        The scrollbar is drawn **on the scrollable Column's own right edge, and drawn leftward**. So
        "lane = Column width − widget width", and only if the Column width is hard-coded does this equation hold.
        It used to rely on the "container's padding" to indirectly determine the Column width, and as a result:
        `paper_frame`'s 16×2 and this place's 14+6 **stacked two layers of padding**,
        at DLG_W=576 the content area was only **524** —— **16px narrower than the widget itself**,
        so of course the scrollbar sat on top of the input box (this is what the user reported two rounds in a row).
        Now: horizontal padding is zeroed (all left/right whitespace handed to `paper_frame`'s 16),
        both Column and container hard-code `SET_W + TAB_GUTTER`, so the lane is guaranteed by construction.
        `lane_extra` (added 2026-10-10): **widen the whole lane**, for cases with "many tabs and a wider
        dialog" (currently only "天机", see `DLG_W_TABS`). The widened part
        is **split evenly to both sides of the control** (`horizontal_alignment=CENTER`) -- the control itself is still
        `SET_W` wide (the grid is hardcoded to 520, can't change it), so the extra width is just left/right padding,
        the scrollbar still hugs the right edge. When `lane_extra=0` the behavior is **pixel-for-pixel identical** to before.
    """
    lane = SET_W + TAB_GUTTER + max(0, int(lane_extra))
    col = ft.Column(
        controls, spacing=TAB_SPACING,
        scroll=ft.ScrollMode.ADAPTIVE,
        width=lane,                      # ← 写死，车道才等于 TAB_GUTTER
        # 加宽时把控件**居中**（两边留白相等）；不加宽时保持原来的左对齐
        # [EN] ← hardcoded, so that the lane equals TAB_GUTTER
        # [EN] When widening, **center** the control (equal padding on both sides); when not widening, keep the
        # [EN] original left alignment
        horizontal_alignment=(ft.CrossAxisAlignment.CENTER if lane_extra
                              else ft.CrossAxisAlignment.START),
    )
    bar = mk_scroll_bar(col, pane_h or (DLG_H - TAB_BAR_H), lane=TAB_GUTTER,
                        scroller=col)
    return ft.Container(
        content=bar,
        width=lane,
        # 横向 0：左右留白交给 `paper_frame` 的 16px，**不再叠第二层**
        # （叠出来的那 20px 现在改当滚动条车道用）。
        # [EN] Horizontal 0: left/right padding is delegated to `paper_frame`'s 16px, **do not stack a second
        # [EN] layer**
        # [EN] (the stacked 20px is now repurposed as the scrollbar lane).
        padding=ft.Padding(0, 12, 0, 12),
    )


# ══════════════════════════════════════════════════════════════
#  聊天气泡（**一处实现**：AI 优化的对话区 + 帮助面板的「问个问题」）
# [EN] Chat bubble (**implemented in one place**: the AI-optimized conversation area + the help panel's
# [EN] "ask a question")
# ══════════════════════════════════════════════════════════════
_BUBBLE_BOLD = re.compile(r"\*\*(.+?)\*\*|__(.+?)__")
_BUBBLE_CODE = re.compile(r"`([^`]+)`")
_BUBBLE_HEAD = re.compile(r"(?m)^#{1,6}[ \t]*")
_BUBBLE_RULE = re.compile(r"(?m)^-{3,}[ \t]*$")

# 气泡底色。**提成模块常量是为了能"标记色法"取证**：
# 验证脚本临时把它们换成全项目没人用的荧光色（品红 / 青），再发一问，
# 新气泡就带着荧光色 —— 量它的像素位置，才是"屏幕上到底靠左还是靠右"
# （`tools/verify_help_qa.py` 的 B8）。⚠ `chat_bubble` 里必须**在函数体里**
# 读这两个全局，不能写成默认参数（默认参数在定义时就求值，改了不生效）。
BUBBLE_USER_BG = '#e8eef6'      # 作者说的：浅靛青
BUBBLE_AI_BG = '#f2ece0'        # AI 说的：旧纸米色
# [EN] Bubble background color. **Extracted into module constants to enable "marker-color forensics"**:
# [EN] the verification script temporarily swaps them for fluorescent colors nobody in the project uses
# [EN] (magenta / cyan), then sends a question,
# [EN] and the new bubble carries the fluorescent color — measuring its pixel position is how you know
# [EN] "on screen, is it actually on the left or on the right"
# [EN] (B8 of `tools/verify_help_qa.py`). ⚠ inside `chat_bubble` you must read **in the function body**
# [EN] these two globals, you cannot write them as default parameters (default parameters are evaluated
# [EN] at definition time, changes do not take effect).
# [EN] Author's: light indigo
# [EN] AI's: old-paper beige


def bubble_text(text: str) -> str:
    """气泡里显示的文本：把 Markdown 的**粗体/行内代码/标题号/分隔线**脱掉。

    为什么不用 `ft.Markdown` 渲染气泡：气泡要**贴着内容长**（短回答不能变成
    一条大宽条），而 `ft.Markdown` 会填满可用宽度 —— 于是"谁说的"那半边
    对齐就看不出来了，聊天最要紧的那个信号反而没了（见 `chat_bubble`）。

    代价是 Markdown 语法不渲染，所以这里手工脱掉最常见的四种标记。
    列表符号（`- `）、换行、缩进**都保留** —— 回答的分点结构就靠它们。
    
        English:
    Text shown in the bubble: strip Markdown **bold/inline code/heading markers/divider lines**.
        Why not render the bubble with `ft.Markdown`: the bubble must **grow tight to its content** (a short answer must not become
        one big wide bar), and `ft.Markdown` fills the available width -- then the "who said it" half
        alignment becomes invisible, and the most important signal in a chat is lost (see `chat_bubble`).
        The cost is that Markdown syntax isn't rendered, so here we manually strip the four most common markers.
        List bullets (`- `), newlines, and indentation **are all preserved** -- the answer's bullet structure depends on them.
    """
    s = str(text if text is not None else "")
    s = _BUBBLE_RULE.sub("", s)
    s = _BUBBLE_BOLD.sub(lambda m: m.group(1) or m.group(2) or "", s)
    s = _BUBBLE_CODE.sub(lambda m: m.group(1), s)
    s = _BUBBLE_HEAD.sub("", s)
    # 上面几步会留下成串空行（原来 `---` 那行变成空行），压成一空行
    # [EN] The above steps leave runs of blank lines (the original `---` line becomes a blank line),
    # [EN] collapse to a single blank line
    return re.sub(r"\n{3,}", "\n\n", s).strip()


def chat_bubble(text: str, is_user: bool, placeholder: bool = False) -> ft.Control:
    """一条聊天气泡：作者在右、AI 在左。

    ⚠ **别用 `ft.Row` 来排这个气泡。** `Row` 会给"非 flex"的子控件
    **无限宽**约束 —— 老写法 `Row([bubble, Container(expand=True)])`
    里 bubble 就是非 flex 的，于是里面的 `Text` 既不换行、也不管面板
    多宽，整段一路横向涨到面板外面被裁掉：屏幕上就是「软件给我的字
    和我打的回复看不见，都被右侧吞掉了」（2026-10-05 用户报）。
    更隐蔽的是：那个 `expand=True` 的留白在气泡超宽时会被压到 0，
    于是"靠右"的用户气泡**看着像靠左**，两头都被裁。

    `ft.Column` 的横向约束是**有界**的（子控件拿到 maxWidth），
    所以 Text 会正常换行；`horizontal_alignment` 负责靠左/靠右。
    判据：`developers/probe_chat_bubble.py`（量墨迹右端到面板右边界的车道）。

    `placeholder=True` 是"正在查…"那种临时气泡（颜色更淡，拿到结果就换掉）。
    
        English:
    A chat bubble: author on the right, AI on the left.
        ⚠ **Don't use `ft.Row` to lay out this bubble.** `Row` gives "non-flex" children
        an **unbounded width** constraint -- in the old form `Row([bubble, Container(expand=True)])`
        the bubble is non-flex, so the `Text` inside neither wraps nor cares
        how wide the panel is, and the whole run grows horizontally past the panel and gets clipped: on screen it's "the text the software gives me
        and the reply I type are invisible, both swallowed by the right side" (reported by user 2026-10-05).
        More insidious: that `expand=True` spacer gets squeezed to 0 when the bubble is too wide,
        so the "right-aligned" user bubble **looks left-aligned**, and both ends are clipped.
        `ft.Column`'s horizontal constraint is **bounded** (children get a maxWidth),
        so Text wraps normally; `horizontal_alignment` handles left/right alignment.
        Criterion: `developers/probe_chat_bubble.py` (measures the lane from the ink's right end to the panel's right boundary).
        `placeholder=True` is the temporary "searching..." style bubble (lighter color, swapped out once results arrive).
    """
    # ★ **空气泡防护**（2026-10-06 用户报：AI 优化里 AI 一句话都没说）。
    #   推理模型的额度被思考内容吃光时 `content` 是空串，`Container` 里放一个
    #   空 `Text` 只画出个 0 高度的条 —— 屏幕上就是"点开 AI 优化，AI 没动静"，
    #   作者分不清是"AI 没意见"还是"这一步挂了"。所以**任何一条气泡都保证有字**。
    # [EN] ★ **Empty bubble guard** (user reported on 2026-10-06: in AI optimization the AI did not say a
    # [EN] single word).
    # [EN] When a reasoning model's budget is eaten up by thinking content, `content` is an empty string,
    # [EN] and placing an
    # [EN] empty `Text` in a `Container` only draws a 0-height strip — on screen it is "I open AI
    # [EN] optimization and the AI does nothing",
    # [EN] and the author cannot tell whether it is "the AI has no opinion" or "this step crashed". So
    # [EN] **every bubble is guaranteed to have text**.
    body = bubble_text(text)
    if not body:
        body = t('（这次没有拿到内容）')
    color = C['muted'] if placeholder else C['text']
    bubble = ft.Container(
        content=ft.Text(body, size=BODY_FS, color=color, selectable=not placeholder),
        # ⚠ 在**函数体里**读模块全局（不是默认参数）—— 验证脚本靠临时改这两个
        #   常量做"标记色法"取证，写进默认参数就改不动了（见常量处的说明）。
        # [EN] ⚠ read module globals **in the function body** (not as default parameters) — the verification
        # [EN] script relies on temporarily changing these two
        # [EN] constants to do "marker-color forensics", and writing them into default parameters makes them
        # [EN] unchangeable (see the notes at the constants).
        bgcolor=BUBBLE_USER_BG if is_user else BUBBLE_AI_BG,
        border_radius=8, padding=ft.Padding(10, 8, 10, 8))
    return ft.Column(
        [bubble], spacing=0, tight=True,
        horizontal_alignment=(ft.CrossAxisAlignment.END if is_user
                              else ft.CrossAxisAlignment.START))


def mk_switch(label: str, value: bool, on_change=None,
              height: int = None) -> ft.Switch:
    """统一开关（左对齐 + 可读的字号）。

    ⚠ **绝对不要给开关设 `height`。** 开关本体（轨道 + 圆钮 + 标签）的自然高度是
    40px；Flet 一旦收到比它小的 `height`，会把**整个控件连同标签一起等比缩小**
    —— 给 24 时缩到 **0.6 倍**（实测 238.5×40 → 143.1×24），标签 17.5 号字最后
    只画出 ~9px，用户的原话就是"开关框标签字体都很小"。给 32 也一样被缩（0.75）。
    `developers/probe_switch.py` 量过整张表。

    所以：**高度交给自然布局，尺寸只用 `scale` 调**。
    标签字号按 `LBL_FS / SWITCH_SCALE` 反推 —— 因为 `scale` 会把字一起缩，
    先放大再缩，落到屏幕上正好是 `LBL_FS`，与其他字段标签一致。
    
        English:
    Unified switch (left-aligned + readable font size).
        ⚠ **Never set `height` on a switch.** The switch body (track + knob + label) has a natural height of
        40px; once Flet receives a smaller `height`, it **scales the entire control including the label**
        -- given 24 it shrinks to **0.6x** (measured 238.5×40 → 143.1×24), and a 17.5pt label ends up
        rendering at only ~9px; the user's exact words were "the switch box label font is all tiny". Given 32 it's also shrunk (0.75).
        `developers/probe_switch.py` measured the whole table.
        So: **leave height to natural layout, adjust size only via `scale`**.
        The label font size is derived back from `LBL_FS / SWITCH_SCALE` -- because `scale` shrinks the text too,
        first enlarge then shrink, and on screen it lands exactly at `LBL_FS`, consistent with the other field labels.
    """
    return ft.Switch(
        label=label, value=bool(value), on_change=on_change,
        label_text_style=ft.TextStyle(size=LBL_FS / SWITCH_SCALE,
                                      color=C['text']),
        active_color=C['accent'], scale=SWITCH_SCALE,
        label_position=ft.LabelPosition.LEFT)


def mk_check(label: str, value: bool, on_change=None,
             label_size: int = None) -> ft.Checkbox:
    """统一复选框。

    和 `mk_switch` 同一条铁律：**不给 `height`**。给 24 时整个控件被缩到 0.6 倍
    （实测 142.8×40 → 85.7×24），标签字跟着变小。字号同样按 `1/scale` 反推。
    
        English:
    Unified checkbox.
        Same iron rule as `mk_switch`: **don't set `height`**. Given 24 the whole control is shrunk to 0.6x
        (measured 142.8×40 → 85.7×24), and the label text shrinks accordingly. Font size is likewise derived back via `1/scale`.
    """
    return ft.Checkbox(
        label=label, value=bool(value), on_change=on_change,
        label_style=ft.TextStyle(
            size=(label_size or LBL_FS) / CHECK_SCALE, color=C['text']),
        active_color=C['accent'], scale=CHECK_SCALE)


def mk_radio(value: str, label: str, label_size: int = None) -> ft.Radio:
    """统一单选钮（2026-10-07 加，给岔路口的候选选项用）。

    与 `mk_switch` / `mk_check` 同一条铁律：**不给 `height`**。
    Radio 和它们一样自带最小触控尺寸，给了 `height` 会把**整个控件连同标签等比缩小**
    （`developers/probe_switch.py` 量过那一族的行为），标签字跟着变小。
    字号同样按 `1/scale` 反推。

    ⚠ **没有 `on_change`**：Flet 1.0 里单选事件只在 `ft.RadioGroup` 上，
      单个 Radio 传 `on_change` 会 `TypeError`（实测踩过）。要接事件就接在组上。

    ⚠ `label` 里**不要塞长段落**（单选钮的标签不换行，长了会被右边缘吞掉）——
      岔路口那种「标题 + 一句后果」要拆成 `Radio(label=标题)` + 下面一行 `mk_hint`。
    
        English:
    Unified radio button (added 2026-10-07, for candidate options at a fork in the road).
        Same iron rule as `mk_switch` / `mk_check`: **don't set `height`**.
        Radio has a built-in minimum touch size like them; setting `height` will **scale the entire control including the label**
        (`developers/probe_switch.py` measured that family's behavior), and the label text shrinks accordingly.
        Font size is likewise derived back via `1/scale`.
        ⚠ **There is no `on_change`**: in Flet 1.0 radio events only exist on `ft.RadioGroup`;
          passing `on_change` to an individual Radio will `TypeError` (actually hit this). To hook events, hook them on the group.
        ⚠ **Don't stuff long paragraphs into `label`** (a radio button's label doesn't wrap, and if long gets swallowed by the right edge) --
          a fork's "title + one-line consequence" should be split into `Radio(label=title)` + a `mk_hint` line below.
    """
    return ft.Radio(
        value=value, label=label,
        label_style=ft.TextStyle(
            size=(label_size or LBL_FS) / RADIO_SCALE, color=C['text']),
        active_color=C['accent'], scale=RADIO_SCALE)


def mk_slider(**kw) -> ft.Slider:
    """统一滑块：默认缩到 0.9（默认尺寸偏大，和压低后的控件不搭）。

    高度不强行设 —— Slider 本体（轨道 + 圆钮）比 SET_H 高，
    硬压会把圆钮裁掉，只缩比例更稳。
    
        English:
    Unified slider: default scaled to 0.9 (default size is a bit large, doesn't match the compressed
    controls).
        Don't force a height -- the Slider body (track + knob) is taller than SET_H;
        forcing it down clips the knob, so just scaling the ratio is more stable.
    """
    kw.setdefault('active_color', C['accent'])
    kw.setdefault('scale', SLIDER_SCALE)
    return ft.Slider(**kw)


def md_spans(text: str, *, size: float, color: str,
             bold_color: str = None) -> list:
    """把 `**粗体**` 标记转成 `ft.TextSpan`（`**` 才是真粗体，不是字面星号）。

    ★★★ 为什么必须有这个（2026-10-10 实测 `developers/_probe_md_in_text.py`）：
      **`ft.Text` 不认行内 Markdown** —— 同一句话去掉 `**` 之后渲染宽度
      **少了 36px**（＝ 4 个星号的宽度），也就是**星号真的画在界面上**。
      而本项目 i18n 里有 **172 条**词条写着 `**强调**`（`mk_hint` 54 处、
      直接 `ft.Text` 14 处、`tooltip/hint_text` 4 处…）
      ⇒ 用户看到的一直是 `默认**关**。` 这种带着星号的句子。

      ⇒ 两条路：把标记**吃掉**（信息还在、强调没了），或者**真渲染成粗体**。
        这里选后者 —— 文案里写 `**` 的用意就是强调，抹掉等于把作者的意思丢了。

    ⚠ **成对**才算粗体：`split('**')` 之后**奇数下标**是粗体段。
      落单的 `**`（写错时）只会让后面那半段变粗体 —— 不报错、也不崩，
      这与"宁可显示得怪一点，也别为一个装饰性标记把界面搞崩"是一致的。
    
        English:
    Convert `**bold**` markers into `ft.TextSpan` (`**` is what's truly bold, not literal
    asterisks).
        ★★★ Why this is necessary (measured 2026-10-10 with `developers/_probe_md_in_text.py`):
          **`ft.Text` doesn't understand inline Markdown** -- the same sentence with `**` removed renders at width
          **36px short** (= width of 4 asterisks), i.e. **the asterisks are really being drawn on the UI**.
          And in this project's i18n there are **172 entries** containing `**emphasis**` (`mk_hint` 54 places,
          direct `ft.Text` 14 places, `tooltip/hint_text` 4 places...)
          => What the user always sees is sentences like `默认**关**。` with literal asterisks.
          => Two paths: **eat** the markup (info stays, emphasis gone), or **really render it as bold**.
            Choosing the latter here -- the intent of writing `**` in the copy is emphasis; erasing it throws away the author's meaning.
        ⚠ Only **paired** counts as bold: after `split('**')`, **odd indices** are the bold segments.
          A lone `**` (from a typo) only bolds the second half -- no error, no crash,
          which is consistent with "rather display it a bit oddly than crash the UI over a decorative marker".
    """
    raw = str(text if text is not None else '')
    if '**' not in raw:
        return [ft.TextSpan(raw, style=ft.TextStyle(size=size, color=color))]
    out: list = []
    for i, part in enumerate(raw.split('**')):
        if part == '':
            continue
        out.append(ft.TextSpan(part, style=ft.TextStyle(
            size=size, color=(bold_color or color) if i % 2 else color,
            weight=ft.FontWeight.BOLD if i % 2 else None)))
    return out or [ft.TextSpan(raw, style=ft.TextStyle(size=size, color=color))]


def md_strip(text: str) -> str:
    """去掉 `**` 标记 —— 给**只能是纯字符串**的地方用（`tooltip` / `hint_text`）。

    ⚠ tooltip 是**平台原生浮层**，只吃字符串、画不出富文本 ⇒ 那儿只能把标记去掉
      （留着就是字面星号）。**别**顺手把别处也换成这个：能渲染的地方一律走
      `md_spans`，把强调留住。
    
        English:
    Strip the `**` markup -- for places that **can only be plain strings** (`tooltip` /
    `hint_text`).
        ⚠ tooltip is a **platform-native overlay**, it only takes strings and cannot draw rich text => there you can only strip the markup
          (keeping it means literal asterisks). **Do not** casually switch other places to this: wherever rendering is possible, always go through
          `md_spans`, preserving the emphasis.
    """
    return str(text if text is not None else '').replace('**', '')


def mk_text(text: str, **kw) -> ft.Text:
    """`ft.Text` 的**富文本版**：`**粗体**` 会真的变粗（签名与 `ft.Text` 一致）。

    ★ 为什么要有一个独立函数而不是改 `ft.Text`：`**` 只在**我们自己的文案**里
      是标记（那些字符串都过 `t()`）；用户输入 / 文件内容里出现 `**` 不该被当标记。
      所以是"**你想渲染标记就用 `mk_text`**"，而不是全局改写。

    `size` / `color` 会被拿出来喂给每段 `TextSpan`，其余关键字（`selectable` /
    `text_align` / `expand`…）原样传给 `ft.Text`。
    ⚠ 若传了 `weight=`（整段加粗），它会落在 `ft.Text` 上而**盖不住 spans**
      —— 那种场合请改用 `mk_hint`，或把要粗的那半截写成 `**…**`。
    
        English:
    The **rich-text version** of `ft.Text`: `**bold**` will actually become bold (signature matches
    `ft.Text`).
        ★ Why have a standalone function instead of modifying `ft.Text`: `**` is only markup in **our own copy**
          (those strings all go through `t()`); `**` appearing in user input / file content should not be treated as markup.
          So it is "**if you want markup rendered, use `mk_text`**", not a global rewrite.
        `size` / `color` are pulled out and fed to each `TextSpan`; the remaining keywords (`selectable` /
        `text_align` / `expand`...) are passed to `ft.Text` as-is.
        ⚠ If `weight=` is passed (bolding the whole thing), it lands on `ft.Text` and **cannot override the spans**
          -- in that case use `mk_hint` instead, or write the half you want bold as `**...**`.
    """
    size = kw.pop('size', None) or BODY_FS
    color = kw.pop('color', None) or C['text']
    return ft.Text(spans=md_spans(text, size=size, color=color), **kw)


def set_hint(ctrl, text: str) -> None:
    """改一段**富文本**提示的内容（`value=` 改不动带 `spans` 的 `ft.Text`）。

    ⚠ Flet 里 `spans` 与 `value` 并存时**以 spans 为准** ⇒ 对 `mk_hint` / `mk_text`
      造出来的控件写 `.value = ...` 是**没反应**的（不报错、界面就是不变）。
      要改内容就用这个函数（它换的是 `spans`）。
    
        English:
    Change the content of a **rich-text** hint (`value=` cannot modify an `ft.Text` that has
    `spans`).
        ⚠ In Flet, when `spans` and `value` coexist, **spans win** => writing `.value = ...` on a control built by `mk_hint` / `mk_text`
          has **no effect** (no error, the UI just does not change).
          To change the content, use this function (it swaps out `spans`).
    """
    size = getattr(ctrl, 'size', None) or HINT_FS
    color = getattr(ctrl, 'color', None) or C['muted']
    ctrl.spans = md_spans(text, size=size, color=color)
    upd = getattr(ctrl, 'update', None)
    if callable(upd):
        try:
            upd()
        except Exception:                                        # noqa: BLE001
            pass


def mk_hint(text: str) -> ft.Text:
    """灰色说明（**会渲染 `**粗体**`** —— 见 `md_spans` 的理由）。
        English:
    Gray explanatory text (**will render `**bold**`** -- see the rationale in `md_spans`).
    """
    return ft.Text(spans=md_spans(text, size=HINT_FS, color=C['muted']))


# ── 小选项之间的分隔符（用户 2026-10-06：「小选项之间可以加一点点分隔符，以便区分」）──
# [EN] ── Separator between small options (user on 2026-10-06: "a small separator can be added between
# [EN] small options, to distinguish them") ──
# 两种：横向的（竖着一摞小选项之间）与纵向的（并排几个小字段之间）。
# [EN] Two kinds: horizontal (between a vertical stack of small options) and vertical (between several
# [EN] small fields side by side).
# ⚠ **宽度必须是 0 代价**。这一栏的行宽有硬要求（`SET_W` = 520），而并排的
#   小字段之间的间距一共只有 16px（两个 8px 空隙）—— 想塞一条细线，只能从
#   间距里抠，抠完必须**还是 520**：
#     两个半宽字段：2×256 + 2×3px + 2px 线 = 520 ✓（原来 2×256 + 2×8 = 520 ✓）
#     三个三分字段：3×168 + 4×3px + 2×2px = 520 ✓（原来 3×168 + 2×8 = 520 ✓）
#   所以统一用 `SET_SEP_GAP = 3` + 2px 竖线：凭空多出一条分隔线，**不多占 1px**。
#   写死成别的数会当场把行顶宽（`developers/measure_controls.py` 量得到）。
SEP_W = 2            # 竖线粗细（2px = 看得见但不抢眼）
SET_SEP_GAP = 3      # 并排字段之间的空隙（见上面的账）
# [EN] ⚠ **The width must cost 0**. This column's row width has a hard requirement (`SET_W` = 520), and
# [EN] for the side-by-side
# [EN] small fields the total gap is only 16px (two 8px gaps) — to squeeze in a thin line, you can only
# [EN] carve it out of
# [EN] the gaps, and after carving it must **still be 520**:
# [EN] Two half-width fields: 2×256 + 2×3px + 2px line = 520 ✓ (originally 2×256 + 2×8 = 520 ✓)
# [EN] Three third-width fields: 3×168 + 4×3px + 2×2px = 520 ✓ (originally 3×168 + 2×8 = 520 ✓)
# [EN] So uniformly use `SET_SEP_GAP = 3` + a 2px vertical line: you get an extra divider line out of
# [EN] thin air, **without taking 1 extra px**.
# [EN] Hardcoding another number would widen the row on the spot (`developers/measure_controls.py` can
# [EN] measure it).
# [EN] Vertical line thickness (2px = visible but not attention-grabbing)
# [EN] Gap between side-by-side fields (see the accounting above)


def mk_vsep(height: int = 16) -> ft.Control:
    """并排小字段之间的**竖细线**（占 2px，账见 `SET_SEP_GAP`）。
        English:
    The **thin vertical line** between side-by-side small fields (takes 2px, accounting see
    `SET_SEP_GAP`).
    """
    return ft.Container(width=SEP_W, height=height, bgcolor=C['border'],
                        border_radius=1)


def mk_sep_row(*fields, height: int = 16) -> ft.Row:
    """把并排的小字段用**竖细线**隔开（`mk_vsep` 的批量用法）。

    字段之间的视觉间距仍是 8px（3 + 2 + 3），行宽仍是 `SET_W`。
    
        English:
    Separate side-by-side small fields with a **thin vertical line** (the batch usage of `mk_vsep`).
        The visual gap between fields is still 8px (3 + 2 + 3), and the row width is still `SET_W`.
    """
    ctrls: list = []
    for f in fields:
        if ctrls:
            ctrls.append(mk_vsep(height))
        ctrls.append(f)
    return ft.Row(ctrls, spacing=SET_SEP_GAP,
                  vertical_alignment=ft.CrossAxisAlignment.CENTER)


def mk_options_sep(width: int = None) -> ft.Control:
    """一摞小选项之间的**横细线**（比 `mk_section` 轻，只是"这是另一项"的暗示）。
        English:
    The **thin horizontal line** between a stack of small options (lighter than `mk_section`, just a
    hint that "this is another item").
    """
    return ft.Container(height=1, bgcolor=C['border'],
                        width=width, margin=ft.Margin(0, 4, 0, 4))


# ══════════════════════════════════════════════════════════════════════
#  自绘常驻滚动条（`mk_scroll_bar`）
# [EN] Self-drawn persistent scrollbar (`mk_scroll_bar`)
# ══════════════════════════════════════════════════════════════════════
# 为什么必须自己画（2026-10-06 实测，别再去试框架那条路）：
#   · `ft.ListView(scroll=ft.Scrollbar(thumb_visibility=True, …))` —— **无效**；
# [EN] Why it must be drawn yourself (actually tested on 2026-10-06, do not try the framework route
# [EN] again):
# [EN] · `ft.ListView(scroll=ft.Scrollbar(thumb_visibility=True, …))` — **ineffective**;
#   · `page.theme.scrollbar_theme=ft.ScrollbarTheme(thumb_visibility=True, …)`
#     —— **同样无效**（`thickness` 从 8 调到 40，车道里依旧一个像素都没有）。
#   Flutter 的滚动条默认 `thumbVisibility: false`，**只在拖动时现身**，
#   而这个 Flet 构建里那个开关没被客户端应用。用户的原话「左边和右边有
#   下拉条吗，没有就加上」 —— 那就自己画：位置与长度按
#   `pixels / max_scroll_extent / viewport_dimension` 算（标准公式）。
# [EN] — **also ineffective** (`thickness` adjusted from 8 to 40, still not a single pixel in the
# [EN] lane).
# [EN] Flutter's scrollbar defaults to `thumbVisibility: false`, **it only appears while dragging**,
# [EN] and in this Flet build that switch is not applied by the client. The user's exact words "left
# [EN] and right have
# [EN] scrollbars? if not add them" — so draw it yourself: position and length computed from
# [EN] `pixels / max_scroll_extent / viewport_dimension` (the standard formula).
# ★★ 2026-10-06 第二个关键点：**不要尝试"主动校准"—— 它会阻塞事件循环。**
# [EN] ★★ 2026-10-06 second key point: **do not attempt "proactive calibration" — it blocks the event
# [EN] loop.**
#   那三个数（`max_scroll_extent` 等）只在滚动事件里才有，不滚就永远没有 ——
#   这确实是"该有条的时候没有条"的根子。所以一开始试过"挂载后抖 1px"
#   （`await scroll_to(1)` → `0`，屏幕上看不出来）把真实数值要回来：
#   在**只有一个 Column 的探针里**它是好的（`developers/probe_scroll_calibrate.py`
#   一次就报准 2172px），于是接进了所有滚动条。
# [EN] Those three numbers (`max_scroll_extent` etc.) only exist during scroll events; if you never
# [EN] scroll they never appear —
# [EN] this is indeed the root of "there should be a bar but there is none". So at first we tried
# [EN] "jitter 1px after mount"
# [EN] (`await scroll_to(1)` → `0`, invisible on screen) to get the real values back:
# [EN] in a **probe with only one Column** it works fine (`developers/probe_scroll_calibrate.py`
# [EN] reported accurate 2172px in one go), so it hooked into all scrollbars.
#   **然后在真实界面里炸了**：`tools/verify_ui_english.py` 跑到「风格参数说明」
#   那一步整个脚本挂死 —— 原样 21 秒的脚本跑满 400 秒被 `timeout` 杀掉，
#   日志停在那一行，**没有任何异常**（不是抛错，是等）。
#   逐个变量排除（字体 / 全屏 / `assets_dir` / 各页的条 / `mk_sep_row` …）
#   之后确认：**`scroll_to()` 会阻塞事件循环**（它会同步等客户端的响应，
#   而对话框里那些控件、以及已经关掉的控件，响应永远不来）。
#   挂住的不是一个 task —— 是**整个 asyncio loop**，所以脚本里所有
#   `await` 一起停摆。
# [EN] **Then it blew up in the real UI**: `tools/verify_ui_english.py` ran up to "Style parameter
# [EN] description"
# [EN] and at that step the whole script hung -- the script that normally takes 21 seconds ran for a
# [EN] full 400 seconds and was killed by `timeout`,
# [EN] the log stopped at that line, **with no exception at all** (not a thrown error, but waiting).
# [EN] Ruled out variables one by one (font / fullscreen / `assets_dir` / bars on each page /
# [EN] `mk_sep_row` ...)
# [EN] then confirmed: **`scroll_to()` blocks the event loop** (it synchronously waits for the client's
# [EN] response,
# [EN] and those controls in the dialog, as well as already-closed controls, never respond).
# [EN] What hung was not a single task -- it was **the entire asyncio loop**, so all
# [EN] `await` in the script stalled together.
#   于是**放弃主动校准**：条的可见性与长度仍由
#     ① 调用方在换内容时给的**估算**（`reset(need)` / `sync(need)`）定，
#     ② 用户**真的滚动**时用事件里的真实数据校正（`on_scroll`）。
#   实测够用：`tools/verify_scrollbars.py` 的 40 项（含"打开就画了条"
#   与"内容一多就出现"）全绿，而且再没有卡死。
#   ⚠ 以后想"主动问客户端要数据"，先想清楚它会不会阻塞 loop。
# [EN] So **abandon active calibration**: the visibility and length of the bar are still determined by
# [EN] ① the **estimate** provided by the caller when swapping contents (`reset(need)` / `sync(need)`),
# [EN] ② corrected with the real data from the event when the user **actually scrolls** (`on_scroll`).
# [EN] Measured as sufficient: the 40 items in `tools/verify_scrollbars.py` (including "draws the bar
# [EN] on open"
# [EN] and "appears once there is more content") are all green, and there are no more hangs.
# [EN] ⚠ If in the future you want to "actively ask the client for data", first think clearly about
# [EN] whether it will block the loop.
def mk_scroll_bar(lv: ft.Control, pane_h: int, *, lane: int,
                  scroller: ft.Control | None = None) -> ft.Control:
    """给一个可滚动控件套一条**自己画的、常驻显示**的细滚动条。

    `lane` 是右边缘给它留的车道宽（≥ 条宽），它贴在车道里，不压正文。
    `scroller` 给「真正会滚的不是 `lv` 本身」的场合用（`ft.Column` 没有
    `padding`，要拿一层带右内边距的 `Container` 当车道，这时滚动事件在
    `Column` 上、而条要贴在容器边缘）。
    ⚠ **没有 `page` 参数**：曾经有，用来在挂载后"主动校准" ——
    那个做法会阻塞事件循环，已经删掉，理由见上面那段。
    
        English:
    Wrap a scrollable control with a **self-drawn, always-visible** thin scrollbar.
        `lane` is the lane width reserved for it on the right edge (>= bar width); it sticks inside the lane and does not overlap the content.
        `scroller` is for cases where "the thing that actually scrolls is not `lv` itself" (`ft.Column` has no
        `padding`, you need a `Container` with right padding as the lane; then the scroll event fires on
        `Column`, while the bar sticks to the container edge).
        ⚠ **No `page` parameter**: there used to be one, for "actively recalibrating" after mount --
        that approach blocks the event loop; it has been removed, see the paragraph above for the reason.
    """
    # ⚠ `bar_w` / 右偏移**一律走模块常量**（`SCROLL_BAR_W`、`scroll_bar_right()`）：
    #   开卷向导那笔宽度账（`WIZ_W`）就是按"条占多少"倒推出来的，两边各写一份迟早漂。
    # [EN] ⚠ `bar_w` / the right offset **always go through module constants** (`SCROLL_BAR_W`,
    # [EN] `scroll_bar_right()`): the wizard's width accounting (`WIZ_W`) is derived backwards from "how
    # [EN] much the bar occupies", and two hand-written copies would drift apart sooner or later.
    bar_w = SCROLL_BAR_W
    thumb = ft.Container(
        width=bar_w, height=max(24, pane_h // 3),
        bgcolor=C['muted'], border_radius=bar_w // 2,
        right=scroll_bar_right(lane), top=0,
        visible=False,          # 内容放得下时压根不画（跟系统滚动条一致）
        # [EN] When the content fits, it is not drawn at all (consistent with system scrollbars)
    )
    target = scroller or lv

    # ★★ 关掉**框架自己那根条**，否则同一个面板上会出现「一细一粗」两根（2026-10-07 用户报
    #   「有的窗口是2个滑动条 一个粗的 一个细的」）。
    #   原因：Flet 的 `ScrollMode.ADAPTIVE` 在桌面端是**常驻显示**（官方文档原话
    # [EN] ★★ Turn off **the framework's own bar**, otherwise two bars -- "one thin, one thick" -- appear
    # [EN] on the same panel (user report 2026-10-07
    # [EN] "some windows have 2 scrollbars, one thick and one thin").
    # [EN] Reason: Flet's `ScrollMode.ADAPTIVE` is **permanently shown** on desktop (official docs wording
    #   "scroll bar is always shown when running app as web or desktop"），
    #   而 `AUTO` 是"滚动时才显示" —— 两种都会在**我们自绘的 4px 细条**旁边
    #   再画一根 8px 的框架条。
    #   实测（`developers/probe_double_scrollbar.py` 差分法，帮助面板右栏）：
    #     原样 ADAPTIVE：x1499..1502 = 自绘 4px 细条（#6a6f78）
    #                    x1503..1510 = 框架 8px 粗条（浅灰 228,226,218）→ 两根并排
    #     改成 HIDDEN 后：x1503..1510 变回底色，只剩自绘那根。
    #   ★ 只改这一处就够了 —— `mk_scroll_bar` 是"套条"的唯一入口，
    #     将来新加的滚动区不可能漏掉（这正是把它做成 choke point 的意义）。
    #   ⚠ `HIDDEN` 只是"不画框架条"，**滚动照常可用**（官方文档：
    # [EN] while `AUTO` is "shown only when scrolling" -- both will, next to **our self-drawn 4px thin
    # [EN] bar**,
    # [EN] draw another 8px framework bar.
    # [EN] Measured (`developers/probe_double_scrollbar.py` difference method, help panel right column):
    # [EN] As-is ADAPTIVE: x1499..1502 = self-drawn 4px thin bar (#6a6f78)
    # [EN] x1503..1510 = framework 8px thick bar (light gray 228,226,218) -> two bars side by side
    # [EN] After changing to HIDDEN: x1503..1510 reverts to background color, only the self-drawn bar
    # [EN] remains.
    # [EN] ★ Changing only this one place is enough -- `mk_scroll_bar` is the only entry point for
    # [EN] "wrapping a bar",
    # [EN] so newly added scroll areas in the future cannot be missed (this is exactly the point of making
    # [EN] it a choke point).
    # [EN] ⚠ `HIDDEN` only means "do not draw the framework bar"; **scrolling still works as usual**
    # [EN] (official docs:
    #     "Scrolling is enabled, but scroll bar is always hidden"）。
    if hasattr(target, 'scroll'):
        target.scroll = ft.ScrollMode.HIDDEN

    def _on_scroll(e) -> None:
        try:
            px = float(getattr(e, 'pixels', 0) or 0)
            mx = float(getattr(e, 'max_scroll_extent', 0) or 0)
            vp = float(getattr(e, 'viewport_dimension', 0) or 0) or float(pane_h)
        except (TypeError, ValueError):
            return
        if mx <= 1:                       # 没得滚 → 藏起来
        # [EN] nothing to scroll -> hide it
            thumb.visible = False
        else:
            h = max(24.0, vp * vp / (vp + mx))
            thumb.height = round(h, 1)
            thumb.top = round((vp - h) * (min(max(px, 0.0), mx) / mx), 1)
            thumb.visible = True
        try:
            thumb.update()
        except Exception:                               # noqa: BLE001
            pass

    target.on_scroll = _on_scroll
    # ⚠ 栈的尺寸**必须跟里面那个控件一致**，否则会改变版面：
    #   · 里面是 `expand=True` 的（ListView / Container）→ 栈也 `expand=True`
    #     （`StackFit.EXPAND` 让栈里的子项撑满，不然它缩成内容大小 ——
    #      跟 Column 那个"横向贴合"是同一个坑）；
    #   · 里面是**固定尺寸**的（`Column(width=220)`、风格参数那个 780×560）→
    #     栈必须**照抄宽和高**。
    # ★★ 2026-10-06 用户报「主窗口左右太宽了，中间太窄了」就是这个：
    #   左右两栏（宽 220 / 240）被套进 `expand=True` 的栈之后，在 `Row` 里
    #   变成了**弹性子项** —— 于是它们去抢剩余宽度、把中栏挤窄。
    #   `expand` 在 `Row` 里管的是**横轴**（分剩余宽度），不是"撑满高度"。
    # ★★ 同日第二个更凶的：**只照抄宽度、丢了高度**。
    #   `mk_dialog()` 是拿 `content` 的尺寸去定对话框大小的，一个宽 780、
    #   高 `None` 的 `Stack` 让它算不出高度 —— 症状是
    #   `tools/verify_ui_english.py` 打开「风格参数 · 怎么调」那一步
    #   **整个脚本挂死**（本来 21 秒的脚本跑满 400 秒被杀，日志停在那一行）。
    #   所以宽和高**都要照抄**。
    # [EN] ⚠ The stack's size **must match the control inside it**, otherwise it changes the layout:
    # [EN] · If the inside is `expand=True` (ListView / Container) -> the stack is also `expand=True`
    # [EN] (`StackFit.EXPAND` makes the children in the stack fill it out, otherwise it shrinks to content
    # [EN] size --
    # [EN] the same pitfall as Column's "horizontal fit");
    # [EN] · If the inside is **fixed size** (`Column(width=220)`, the 780×560 of the style parameters) ->
    # [EN] the stack must **copy the width and height exactly**.
    # [EN] ★★ 2026-10-06 user reported "the main window is too wide on the left and right, and too narrow
    # [EN] in the middle" -- this is exactly it:
    # [EN] the left and right columns (width 220 / 240) were wrapped in an `expand=True` stack, then inside
    # [EN] `Row`
    # [EN] became **flex children** -- so they fought for the remaining width and squeezed the middle
    # [EN] column narrow.
    # [EN] `expand` inside `Row` governs the **horizontal axis** (splitting remaining width), not "filling
    # [EN] the height".
    # [EN] ★★ The second, fiercer one the same day: **only copied the width, lost the height**.
    # [EN] `mk_dialog()` uses `content`'s size to determine the dialog size; a `Stack` with width 780 and
    # [EN] height `None` makes it unable to compute the height -- the symptom is that
    # [EN] `tools/verify_ui_english.py` opens the "Style parameters · How to adjust" step and
    # [EN] **the entire script hangs** (the script that normally takes 21 seconds ran for a full 400
    # [EN] seconds and was killed, log stopped at that line).
    # [EN] So both width and height **must be copied exactly**.
    _fixed_w = getattr(lv, 'width', None)
    _fixed_h = getattr(lv, 'height', None)
    stack = (ft.Stack([lv, thumb], width=_fixed_w, height=_fixed_h,
                      fit=ft.StackFit.LOOSE)
             if (_fixed_w is not None or _fixed_h is not None) else
             ft.Stack([lv, thumb], expand=True, fit=ft.StackFit.EXPAND))

    def _reset(need: bool) -> None:
        """换内容时由调用方告诉它"这一屏要不要滚"（**初次就能看见条**）。

        ⚠ 为什么不能只等 `on_scroll`：滚动事件里才带 `max_scroll_extent` /
        `viewport_dimension` —— 不滚就永远不知道内容有没有超出，
        于是条一直藏着，用户也就一直"看不到下拉条"（那就白画了）。
        所以初次用**粗估**（调用方按字数算），一旦滚动就用真实数据校正。
        
                English:
        When the content changes, the caller tells it "whether this screen should scroll" (**the bar is
        visible from the start**).
                ⚠ Why can't we just wait for `on_scroll`: only scroll events carry `max_scroll_extent` /
                `viewport_dimension` —— without scrolling you can never know whether the content overflows,
                so the bar stays hidden, and the user keeps "not seeing the scrollbar" (which makes it pointless).
                So the first time use a **rough estimate** (the caller computes it by character count), and once scrolling occurs correct it with real data.
        """
        thumb.visible = bool(need)
        thumb.top = 0
        thumb.height = max(24, pane_h // 3)
        try:
            thumb.update()
        except Exception:                               # noqa: BLE001
            pass

    stack.reset = _reset

    def _sync(need: bool) -> None:
        """便宜的"这一屏该不该有滚动条"通知：**只在可见性变化时才真动控件**。

        逐行追加的流水（运行日志 / 气泡 / 叙事）每加一条都会问一次 ——
        直接调 `reset` 会把条的长度与位置每条都打回初值（滚动事件随即再校正），
        屏幕上就是条一直在抖。这里只在"从藏到显 / 从显到藏"那一下才动。
        
                English:
        Cheap "should this screen have a scrollbar" notification: **only actually touch the control when
        visibility changes**.
                A stream appended line by line (run log / bubbles / narrative) asks once per added line ——
                calling `reset` directly would reset the bar's length and position to initial values on every line (scroll events then correct it again),
                and on screen the bar would keep jittering. Here we only move on the "hidden → shown / shown → hidden" transition.
        """
        if bool(need) != bool(thumb.visible):
            _reset(need)

    stack.sync = _sync

    return stack


def toc_row_h() -> float:
    """帮助面板左栏**目录一行**的高度（px，实测 30）。

    组成：文字行高（`HINT_FS` × 1.4）+ 行容器上下 padding（4+4）+ ListView spacing（2）。
    写成函数而不是常量：验证脚本要拿同一个式子复算"行数×行高 是否超出容器"，
    **两处各抄一份迟早会漂**（本项目的老毛病）。
    
        English:
    Height of **one TOC row** in the help panel's left column (px, measured 30).
        Composition: text line height (`HINT_FS` x 1.4) + row container top/bottom padding (4+4) + ListView spacing (2).
        Written as a function instead of a constant: the validation script needs to recompute "does rows x row height exceed the container" with the same formula,
        **two copies will drift sooner or later** (a chronic problem in this project).
    """
    return float(HINT_FS) * 1.4 + 8 + 2


def md_height_est(md_text: str, body_fs: float = None) -> float:
    """估算一段 Markdown **渲染后**的高度（px）—— 给滚动条判"要不要露面"用。

    ★★ **别按字数估**（2026-10-07 修）。原来帮助面板右栏用的是
      `len(text) > max(200, (pane_h // 24) * 60)`（约 1380 字），
      而**表格与代码块是"字少行多"**，于是被系统性低估：
        实测 §1「产品介绍」只有 977 字（判据说"不用滚"），
        但那 9 行表格排出来约 **1075px**，容器内高只有 **536px** → 内容被截断、
        滚动条又不出现（用户报的"这个地方还是没有滚动条"）。
        同病的小节有 5 个：§1 977字/1075px · §7 987字/1113px · §8 550字/902px ·
        §11 1002字/946px · §12 748字/792px —— 全都低估。
      所以改成**逐行按类型**估：表格行、代码行、标题、图片各有自己的行高。

    只求"量级正确、宁可略高"：它决定的是**初次**画不画条，
    一旦用户真的滚动，`on_scroll` 会用客户端的真实数值校正（见 `mk_scroll_bar`）。
    
        English:
    Estimate the **rendered** height (px) of a Markdown section -- used by the scrollbar to decide
    "whether to show up".
        ★★ **Do not estimate by character count** (fixed 2026-10-07). The help panel's right column originally used
          `len(text) > max(200, (pane_h // 24) * 60)` (about 1380 chars),
          while **tables and code blocks are "few chars, many lines"**, so they were systematically underestimated:
            Measured: §1 "Product Introduction" has only 977 chars (the criterion said "no need to scroll"),
            but those 9 table rows lay out to about **1075px**, while the container inner height is only **536px** -> content is truncated,
            and the scrollbar does not appear (the user-reported "this place still has no scrollbar").
            There are 5 sections with the same problem: §1 977 chars/1075px · §7 987 chars/1113px · §8 550 chars/902px ·
            §11 1002 chars/946px · §12 748 chars/792px -- all underestimated.
          So it was changed to estimate **line by line, by type**: table rows, code lines, headings, images each have their own line height.
        Only aiming for "correct order of magnitude, prefer a slight overestimate": it only decides whether to draw the bar **initially**,
        Once the user actually scrolls, `on_scroll` corrects with the client's real values (see `mk_scroll_bar`).
    """
    fs = float(body_fs or BODY_FS)
    h = 0.0
    in_fence = False
    for raw in str(md_text or '').splitlines():
        s = raw.strip()
        if s.startswith('```'):
            in_fence = not in_fence
            h += fs * 1.1                      # 围栏行本身
            # [EN] the fence line itself
            continue
        if in_fence:
            h += fs * 1.45                     # 代码行（等宽、行距紧）
            # [EN] code line (monospace, tight line spacing)
            continue
        if not s:
            h += fs * 0.55                     # 空行 ≈ 段间距
            # [EN] blank line ≈ paragraph spacing
            continue
        if s.startswith('!['):
            h += 300.0                         # 插图：按常见渲染高度算
            # [EN] illustration: computed by common render height
            continue
        if s.startswith('|'):
            h += fs * 2.1                      # 表格行（29px 实测 / 14px 字）
            # [EN] table row (29px measured / 14px font)
            continue
        if s.startswith('#'):
            h += SEC_FS * 1.9                  # 小节标题（字更大）
            # [EN] section heading (larger font)
            continue
        if s.startswith(('>', '- ', '* ', '+ ')):
            h += fs * 1.7                      # 引用 / 列表项
            # [EN] quote / list item
            continue
        h += fs * 1.6                          # 普通正文行
        # [EN] normal body line
    return h


def paper_gradient() -> ft.LinearGradient:
    """纸底渐变：左上受光、右下偏暖 —— 一块纸该有的过渡。
        English:
    Paper base gradient: top-left lit, bottom-right warmer -- the transition a piece of paper should
    have.
    """
    return ft.LinearGradient(begin=ft.Alignment.TOP_LEFT,
                             end=ft.Alignment.BOTTOM_RIGHT,
                             colors=[C['paper_hi'], C['paper_lo']])


def make_box_shadow(blur: int = 18, dy: int = 6) -> ft.BoxShadow:
    """纸卡投影（古朴质感的一半靠它）。
        English:
    Paper card shadow (half of the antique texture depends on it).
    """
    return ft.BoxShadow(blur_radius=blur, spread_radius=0,
                        color=C['shadow'], offset=ft.Offset(0, dy))


def paper_frame(body: ft.Control, *, width: int = None, height: int = None,
                pad: tuple = (16, 14, 16, 14), radius: int = 8) -> ft.Container:
    """对话框内容外壳：**外墨线 + 内描金双线**，中间夹纸底渐变。

    这是「古朴有质感」的主要载体：单层平底看着像网页，
    双线夹一层渐变的旧纸才像一册书。
    
        English:
    Dialog content shell: **outer ink line + inner gold-traced double line**, with paper base
    gradient sandwiched between.
        This is the main carrier of "antique and textured": a single flat base looks like a web page,
        only old paper with a gradient sandwiched between double lines looks like a book.
    """
    inner = ft.Container(
        content=body,
        border=make_border(1, C['border_gold']),
        border_radius=max(2, radius - 3),
        padding=ft.Padding(*pad),
        expand=True,
    )
    return ft.Container(
        content=inner,
        width=width, height=height,
        gradient=paper_gradient(),
        border=make_border(2, C['border_ink']),
        border_radius=radius,
        padding=ft.Padding(7, 7, 7, 7),
        shadow=make_box_shadow(),
    )


def dialog_close_side() -> str:
    """对话框那个「×」该放哪一边：**按各系统自己的习惯**。

    Windows 右上角，macOS / Linux 左上角（用户 2026-10-06 点名的）。
    认不出来的平台按 Windows 来（右上角）—— 这是最不容易点错的一边。
    
        English:
    Where the dialog's "x" should go: **follow each system's own convention**.
        Windows top-right, macOS / Linux top-left (user specified on 2026-10-06).
        Unrecognized platforms default to Windows (top-right) -- that's the side least likely to be mis-clicked.
    """
    if sys.platform.startswith('win'):
        return 'right'
    if sys.platform in ('darwin', 'linux'):
        return 'left'
    return 'right'


def mk_dialog(title: str, content: ft.Control, actions: list,
              width: int = None, height: int = None) -> ft.AlertDialog:
    """统一的「古朴纸册」对话框：纸底 + 双线描金 + 投影 + 标题描金细线 + **关闭按钮**。

    **尺寸从 `content` 身上读。** 调用方的写法一直是
    `mk_dialog(标题, ft.Container(content=X, width=DLG_W, height=DLG_H), 按钮)`
    —— 尺寸挂在那一层 Container 上，而 `width` / `height` 参数没人用。
    于是 `paper_frame` 拿到的是 `height=None`，加上这里 `body` 带着
    `expand=True`，对话框会被**拉到接近满屏高**（实测每个都是 1081px，
    内容少的向导也那么高）。现在把尺寸取出来传下去，高度才真的受控。

    ★ **标题行右边（Windows）/ 左边（macOS、Linux）有一个「×」**（用户 2026-10-06 要的）。
    Flet 的对话框是**程序自己画的浮层**，不是系统原生窗口 —— 所以拿不到系统标题栏那三个
    按钮，只能自己画一个；位置则按各系统的习惯摆（见 `dialog_close_side()`）。
    ⚠ 别用 `ft.IconButton`：它自带 40~48px 的内边距，会把标题行顶得很高
    （本项目图标按钮一律走 `mk_icon_btn`，原因见那里）。

    所有对话框都从这里出，所以**加一次就全都有了**。
    
        English:
    Unified "antique paper volume" dialog: paper base + gold-traced double line + shadow + title
    gold-traced thin line + **close button**.
        **Size is read from `content`.** Callers have always written
        `mk_dialog(title, ft.Container(content=X, width=DLG_W, height=DLG_H), buttons)`
        -- size hangs on that Container layer, while the `width` / `height` params are unused.
        So `paper_frame` gets `height=None`, and with `body` here carrying
        `expand=True`, the dialog gets **stretched to nearly full screen height** (measured 1081px each,
        even wizards with little content are that tall). Now the size is extracted and passed down, so the height is actually controlled.
        ★ **There is an "x" on the right of the title row (Windows) / left (macOS, Linux)** (user requested on 2026-10-06).
        Flet's dialog is **a floating layer drawn by the program itself**, not a system-native window -- so the three
        buttons of the system title bar aren't available; one must be drawn manually, positioned per each system's convention (see `dialog_close_side()`).
        ⚠ Don't use `ft.IconButton`: it comes with 40~48px padding, which pushes the title row very tall
        (icon buttons in this project all go through `mk_icon_btn`, see there for the reason).
        All dialogs come from here, so **adding once gives it to all of them**.
    """
    holder: dict = {}

    def _close_dialog(e=None):
        """关掉这个对话框。

        ⚠ 控件挂上页面之前 `.page` 会抛 `RuntimeError`（Flet 1.0 的行为），
        所以先试控件自己、再试事件带回来的 page（测试里手调会传 `None`）。
        
                English:
        Close this dialog.
                ⚠ Before the control is attached to the page, `.page` throws `RuntimeError` (Flet 1.0's behavior),
                so first try the control itself, then the page brought back by the event (manual calls in tests pass `None`).
        """
        dlg = holder.get('dlg')
        pg = None
        try:
            pg = dlg.page if dlg is not None else None
        except RuntimeError:
            pg = None
        if pg is None:
            pg = getattr(e, 'page', None)
        if pg is None:
            return
        pg.pop_dialog()

    close_btn = mk_icon_btn(ft.Icons.CLOSE, _close_dialog,
                               size=SZ(26), height=SZ(22),
                            danger=False, tooltip=t('关闭'))
    title_txt = ft.Text(title, color=C['gold'], size=DLG_TITLE_FS,
                        font_family=UI_FONT, weight=ft.FontWeight.BOLD,
                        expand=True)
    head = ft.Container(
        content=ft.Row(
            ([close_btn, title_txt] if dialog_close_side() == 'left'
             else [title_txt, close_btn]),
            spacing=8, vertical_alignment=ft.CrossAxisAlignment.CENTER,
        ),
        border=make_border_bottom(1, C['border_gold']),
        padding=ft.Padding(2, 0, 2, 6),
    )
    cw = width if width is not None else getattr(content, 'width', None)
    ch = height if height is not None else getattr(content, 'height', None)
    body = ft.Column([head, ft.Container(content=content, expand=True)], spacing=8)
    dlg = ft.AlertDialog(
        title=None,
        content=paper_frame(body, width=cw, height=ch),
        actions=actions,
        actions_padding=ft.Padding(20, 8, 20, 14),
        bgcolor=C['panel'],
        elevation=10,
        shadow_color='#55000000',
    )
    holder['dlg'] = dlg
    return dlg


def mk_kv(label: str, value: str, value_color: str = None) -> ft.Row:
    """「标签 …… 值」一行（运行界面面板里用，内容随配置伸缩）。
        English:
    "Label ... value" row (used in the run UI panel; content scales with config).
    """
    return ft.Row([
        ft.Text(label, size=HINT_FS, color=C['muted']),
        ft.Container(expand=True),
        ft.Text(value, size=HINT_FS, color=value_color or C['text']),
    ], spacing=6)


def runtime_features() -> dict:
    """汇总运行界面需要体现的全局开关（真读 .env，不编造默认值）。

    顶层「天机」里关掉的功能，必须在这里被感知，运行界面才能相应地
    隐藏 / 折叠 / 标注，而不是留一行僵尸占位。
    
        English:
    Global toggles the run UI summary needs to reflect (truly reads .env, does not fabricate
    defaults).
        Features turned off in the top-level "Tianji" must be sensed here, so the run UI can correspondingly
        hide / collapse / annotate, rather than leaving a zombie placeholder row.
    """
    mode = (CFG.s('RUN_MODE') or 'story').strip().lower()
    emb = (CFG.s('EMBEDDING_PROVIDER') or 'none').strip().lower()
    return {
        'mock': CFG.mock,
        'model': CFG.model_of('front'),
        'run_mode': mode if mode in ('story', 'open', 'story_day') else 'story',
        'story_day_days': CFG.i('STORY_DAY_EVERY_DAYS'),
        'pause_at_night': CFG.b('PAUSE_AT_NIGHT'),
        'auto_run_days': CFG.i('AUTO_RUN_DAYS'),
        'time_ratio': CFG.i('TIME_RATIO'),
        'tick_ms': CFG.i('TICK_REAL_MS'),
        'embedding': emb,
        'embedding_off': emb in ('', 'none'),
        'budget': CFG.i('TOKEN_BUDGET_PER_DAY'),
        'director': CFG.b('DIRECTOR_ENABLED'),
        'compliance': CFG.b('COMPLIANCE_ENABLED'),
        'compliance_level': (CFG.s('COMPLIANCE_LEVEL') or 'standard').strip().lower(),
        'debug': CFG.b('DEBUG_MODE'),
        # 运行窗口底部的命令行**默认不显示**（`HIDE_COMMAND_BAR` 默认 true）。
        # 它只有 /help /status /settings 三条命令，留着只是占掉叙事区的高度；
        # 关掉不减能力 —— 右上角「❓ 帮助」与 F11 照旧。
        # [EN] The run window's bottom command bar is **hidden by default** (`HIDE_COMMAND_BAR`
        # [EN] defaults to true). It only has three commands (/help /status /settings) and merely eats
        # [EN] into the narrative area's height; hiding it costs no capability -- "❓ Help" at the top
        # [EN] right and F11 still work.
        'command_bar': not CFG.b('HIDE_COMMAND_BAR'),
    }


# ── 运行模式：后台存变量值（story / open / story_day），前台只显示人话 ──
# 界面上**不允许**出现 story_day 这类变量名：一律走 run_mode_name()。
# [EN] ── Run mode: backend stores variable values (story / open / story_day), frontend shows only
# [EN] plain words ──
# [EN] Variable names like story_day are **not allowed** to appear in the UI: always go through
# [EN] run_mode_name().
# **名字要自带解释**：光写「走完故事」「不限期限」还是得猜，
# 所以每个名字后面缀一个括号说明，下面再配一整句的 `RUN_MODE_HINT`。
# （用户 2026-10-05：「story_day / story / open 你要用语言解释，
#   后台 .env 可以存这几个值，但界面上要用普通人看懂的词语」。）
# [EN] **The name must be self-explanatory**: just writing "finish the story" or "no deadline" still
# [EN] requires guessing,
# [EN] so each name is suffixed with a parenthetical explanation, plus a full-sentence `RUN_MODE_HINT`
# [EN] below.
# [EN] (User 2026-10-05: "story_day / story / open you need to explain in words,
# [EN] the backend .env can store these values, but the UI must use words ordinary people understand.")
RUN_MODES = ('story', 'open', 'story_day')
_MODE_NAME = {
    'story': '走完故事（有终点）',      # 一路跑到剧情终点
    'open': '不限期限（一直续写）',     # 不设终点，一直往下写
    'story_day': '定期暂停（每几天停一次）',   # 每 N 天自动暂停
    # [EN] Run all the way to the plot's end
    # [EN] No endpoint set, keep writing onward
    # [EN] Auto-pause every N days
}
_MODE_HINT = {
    'story': '照着已有的设定一路推演到剧情终点，然后收尾。',
    'open': '不设终点，故事一直往下续写，你想停才停。',
    'story_day': '正常推演，每过 N 天（游戏里的天）自动暂停一次，等你确认再继续。',
}


def run_mode_name(value: str) -> str:
    """把后台存的运行模式变量值翻成前台人话（跟随界面语言）。

    只影响显示；CFG 里存的始终是原始变量值。
    
        English:
    Translate the run mode variable value stored in the backend into front-end human language
    (follows UI language).
        Only affects display; what's stored in CFG is always the raw variable value.
    """
    key = (value or '').strip().lower()
    return t(_MODE_NAME.get(key, '未知模式'))


def run_mode_hint(value: str) -> str:
    """当前运行模式的一句话解释（跟着下拉框的选择变）。
        English:
    One-sentence explanation of the current run mode (changes with the dropdown selection).
    """
    key = (value or '').strip().lower()
    return t(_MODE_HINT.get(key, ''))


def beat_pace_text() -> str:
    """一拍的节奏，说人话：「15 故事秒 ≈ 15.0 真实秒（一个故事日约 24.0 小时）」。

    算出来的、不是另存一份 —— `TIME_RATIO` / `BEAT_SECONDS` 一改就跟着变，
    免得界面上那句说明和真正跑起来的节奏对不上。
    用户 2026-10-05 报「时间比例太夸张了」，根子就是**这个数从来没被说出来过**。
    
        English:
    The pace of one beat, in human language: "15 story seconds ~ 15.0 real seconds (one story day ~
    24.0 hours)".
        Computed, not stored as a separate copy -- changes with `TIME_RATIO` / `BEAT_SECONDS`,
        so the text in the UI doesn't mismatch the pace actually running.
        User reported on 2026-10-05 that "the time ratio is too exaggerated"; the root cause is that **this number was never spoken out**.
    """
    try:
        ratio = max(1, CFG.i('TIME_RATIO'))
        beat = max(1, CFG.i('BEAT_SECONDS'))
        real = beat / ratio
        day = 86400 / ratio              # 一个故事日要多少**真实秒**
        # 单位跟着量级走：24 分钟就说 24 分钟，别说「0.4 小时」——
        # 后者要把人绕一下才反应过来（这个函数存在的意义就是别让人算）。
        # [EN] How many **real seconds** one story day takes
        # [EN] The unit follows the magnitude: say 24 minutes for 24 minutes, do not say "0.4 hours" --
        # [EN] the latter requires a mental detour to register (the whole point of this function is to save
        # [EN] people from calculating).
        if day >= 3600:
            day_s = t('{v:.1f} 小时', v=day / 3600)
        elif day >= 60:
            day_s = t('{v:.0f} 分钟', v=day / 60)
        else:
            day_s = t('{v:.0f} 秒', v=day)
        # 一拍的真实耗时也要跟着量级走：倍率一高，"0.0 真实秒" 看着像坏了
        # [EN] The real duration of one beat must also follow the magnitude: when the multiplier is high, "0.0
        # [EN] real seconds" looks broken
        if real >= 1:
            beat_s = t('{v:.1f} 真实秒', v=real)
        elif real >= 0.1:
            beat_s = t('{v:.1f} 真实秒', v=real)
        else:
            beat_s = t('不到 0.1 真实秒（跑起来由模型速度决定）')
        return t('{b} 故事秒 ≈ {r} · 一个故事日约 {d}', b=beat, r=beat_s, d=day_s)
    except Exception:                                       # noqa: BLE001
        return '—'


def run_mode_options() -> list:
    """运行模式下拉选项：`key` 是变量值，`text` 是人话（由 `mk_dropdown` 显示）。
        English:
    Run mode dropdown options: `key` is the variable value, `text` is human language (displayed by
    `mk_dropdown`).
    """
    return [ft.dropdown.Option(v, run_mode_name(v)) for v in RUN_MODES]


# ── 开卷向导 · 故事类型 / 风格来源 ──
# [EN] ── Getting-started guide · Story type / Style source ──
# 和运行模式同一个道理：**后台存真值、前台说人话**。
# 这里的键就是最终落盘的值（`.nwsproj` 的 `类型=` / `风格=`），
# 所以键**一个都不能写 `t(...)`** —— 那会让存盘值跟着界面语言变
# （英文界面下会把「玄幻修仙」存成 "Xianxia/cultivation"，换回中文就认不出来了）。
# [EN] Same principle as run mode: **backend stores real values, frontend speaks plain words**.
# [EN] The keys here are exactly the values persisted to disk (`.nwsproj`'s `类型=` / `风格=`),
# [EN] so the keys **must not have `t(...)` written in any of them** -- that would make the saved
# [EN] values change with the UI language
# [EN] (In the English UI, "玄幻修仙" is stored as "Xianxia/cultivation"; switching back to Chinese makes
# [EN] it unrecognizable).
# `auto` / `plain` 这两个词也必须翻掉：用户看到的应该是「自动判断」而不是「auto」。
# （用户 2026-10-05：「Auto 和 Plain 也都改成显示中文和英文的正确描述，
#   只在后台保存真的值」。）
# [EN] The words `auto` / `plain` must also be translated: what the user sees should be "自动判断" rather
# [EN] than "auto".
# [EN] (User 2026-10-05: "Change Auto and Plain to also display the correct Chinese and English
# [EN] descriptions,
# [EN] only save the real values in the backend.")
GENRE_CHOICES = ('auto', '悬疑·单元', '玄幻修仙', '都市', '历史架空', '言情', '科幻')
_GENRE_LABEL = {
    'auto': '自动判断（由 AI 读正文后决定）',
    '悬疑·单元': '悬疑 · 单元剧',
    '玄幻修仙': '玄幻修仙',
    '都市': '都市',
    '历史架空': '历史架空',
    '言情': '言情',
    '科幻': '科幻',
}

# `custom` 只有「书斋 · 项目设置」用得上（那里有自定义风格的输入框），
# 开卷向导没有，所以由 `style_source_options(include_custom=...)` 决定给不给。
# [EN] `custom` is only used by "书斋 · 项目设置" (that's where the custom style input box is),
# [EN] the startup wizard doesn't have it, so `style_source_options(include_custom=...)` decides
# [EN] whether to offer it.
STYLE_SOURCES = ('auto', 'plain', '冷笔白描', '华丽辞藻', 'custom')
_STYLE_SOURCE_LABEL = {
    'auto': '自动判断（从正文里学笔法）',
    'plain': '朴素白描（不加修饰）',
    '冷笔白描': '冷笔白描（短句、少形容词）',
    '华丽辞藻': '华丽辞藻（长句、意象密）',
    'custom': '自定义（在下方自己调）',
}


def genre_label(value: str) -> str:
    """故事类型的显示名（跟随界面语言）；存盘的始终是原始键。
        English:
    Display name of story type (follows UI language); what's saved is always the raw key.
    """
    return t(_GENRE_LABEL.get((value or '').strip(), value or ''))


def style_source_label(value: str) -> str:
    """风格来源的显示名（跟随界面语言）；存盘的始终是原始键。
        English:
    Display name of style source (follows UI language); what's saved is always the raw key.
    """
    return t(_STYLE_SOURCE_LABEL.get((value or '').strip(), value or ''))


def _with_current(options: list, value: str, label: str, *,
                  skip: tuple = ('', 'auto')) -> list:
    """把「当前值不在选项表里」补成一项 —— **下拉框永远不许是空白**。

    真实数据就是会跑出表外：类型判定的「主题材」是**自由文本**（AI 读正文后
    可能回「玄幻」），而我们的选项表键是「玄幻修仙」；对不上时 `DropdownM2`
    **什么都不显示**，用户看到的就是一个空框
    （2026-10-05 用户报：「故事类型…这里没有拉出来显示」）。

    补一项「玄幻（AI 判定）」既能看见、又**不会偷偷改掉存盘值** ——
    把 `value` 归一到表内的键是在替用户做决定，那才是真的错。
    
        English:
    Fill in "current value not in options table" as an entry -- **the dropdown must never be
    blank**.
        Real data will run off the table: the "main genre" of type judgment is **free text** (the AI, after reading the body,
        may return "Xuanhuan"), while our options table key is "Xuanhuan Xianxia"; when they don't match, `DropdownM2`
        **displays nothing**, and what the user sees is an empty box
        (user reported on 2026-10-05: "story type... this isn't pulled out for display").
        Adding an entry "Xuanhuan (AI-determined)" is both visible and **does not secretly alter the saved value** --
        normalizing `value` to a key within the table is making a decision for the user, and that is the real error.
    """
    v = (value or '').strip()
    if v in skip or any(getattr(o, 'key', None) == v for o in options):
        return options
    return list(options) + [ft.dropdown.Option(v, label)]


def genre_options(extra: str = None) -> list:
    """故事类型下拉：`key` 是落盘值，`text` 是人话。

    `extra`：当前项目的类型（`.nwsproj` 的 `类型=`）—— 不在表里时补一项。
    
        English:
    Story type dropdown: `key` is the on-disk value, `text` is human language.
        `extra`: the current project's type (the `类型=` of `.nwsproj`) -- if not in the table, add an entry.
    """
    opts = [ft.dropdown.Option(v, genre_label(v)) for v in GENRE_CHOICES]
    v = (extra or '').strip()
    return _with_current(opts, v, t('{v}（AI 判定）', v=v))


def style_source_options(include_custom: bool = False, extra: str = None) -> list:
    """风格来源下拉：`key` 是落盘值，`text` 是人话。

    `custom` 只给「书斋」用（那里有自定义风格的输入框）。
    
        English:
    Style source dropdown: `key` is the on-disk value, `text` is human language.
        `custom` is only for "Shuzhai" (which has an input box for custom styles).
    """
    vals = STYLE_SOURCES if include_custom else tuple(
        v for v in STYLE_SOURCES if v != 'custom')
    opts = [ft.dropdown.Option(v, style_source_label(v)) for v in vals]
    v = (extra or '').strip()
    return _with_current(opts, v, t('{v}（自定义）', v=v))


