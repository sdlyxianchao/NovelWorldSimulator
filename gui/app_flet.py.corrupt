# 开场地点的自动档：显示名是这句人话，落盘值仍是 `auto`。
# [EN] Auto option for the opening location: the display name is this human-readable string, but the
# [EN] persisted value is still `auto`.
SCENE_AUTO_LABEL = '自动（按设定里的地点推断）'


def scene_name_options(proj) -> list:
    """开场地点下拉：`auto` = 自动推断，其余是**设定里已有的地点名**。

    为什么是下拉不是输入框：这一项决定"世界从哪儿开场"，而地点在
    `设定集/地点.yaml` 里本来就有清单 —— 让人手打一个不存在的名字，
    开局只会跟设定对不上。当前值若已不在清单里（设定改过），
    照样补一项显示，别让框空着（见 `_with_current`）。
    
        English:
    Opening location dropdown: `auto` = auto-infer, the rest are **location names already in the
    settings**.
        Why a dropdown instead of a text input: this item decides "where the world starts", and the location is
        would only mismatch the setting at startup. If the current value is no longer in the list (the setting changed),
        still add an entry to display it, don't leave the box empty (see `_with_current`).
    """
    opts = [ft.dropdown.Option('auto', t(SCENE_AUTO_LABEL))]
    seen = set()
    for nm in project_place_names(proj):
        if nm and nm != 'auto' and nm not in seen:
            seen.add(nm)
            opts.append(ft.dropdown.Option(nm, nm))
    cur = (getattr(proj, 'scene_name', '') or '').strip()
    return _with_current(opts, cur, cur)


def project_place_names(proj) -> list:
    """项目设定里的地点名（读 `设定集/地点.yaml`；读不到就当空，不抛）。
        English:
    Location names from the project settings (read `设定集/地点.yaml`; treat as empty if unreadable,
    don't throw).
    """
    if proj is None:
        return []
    try:
        from sim.setup import load_settings
        places = load_settings(proj.settings_dir).get('places') or []
    except Exception:                                       # noqa: BLE001
        return []
    out: list[str] = []
    for p in places:
        nm = str(p.get('名称', '') if isinstance(p, dict) else p).strip()
        if nm and nm not in out:
            out.append(nm)
    return out


def scene_name_label(value: str) -> str:
    """开场地点的显示名（`auto` → 人话；地点名原样）。
        English:
    Display name of the start location (`auto` -> human-readable; location name kept as-is).
    """
    v = (value or '').strip()
    return t(SCENE_AUTO_LABEL) if v in ('', 'auto') else v


_COMPLIANCE_LABEL = {'strict': '严格', 'standard': '标准', 'relaxed': '宽松'}





# ── 全局消息：级别 → (图标, 颜色) ──
# 颜色只用来说明严重程度，不参与别的判断；主题是浅色纸墨，
# 所以「警告」用赭黄而不是亮黄（亮黄在宣纸上看不清）。
# [EN] ── Global message: level → (icon, color) ──
# [EN] Color is only used to indicate severity and doesn't participate in any other decision; the theme
# [EN] is light paper-and-ink,
# [EN] so "warning" uses ochre yellow instead of bright yellow (bright yellow is unreadable on rice
# [EN] paper).
MSG_STYLE = {
    'info': ('·', '#6a6f78'),    # 淡墨
    'ok': ('✓', '#4f9a6a'),      # 青绿
    'warn': ('⚠', '#b8791f'),    # 赭金
    'error': ('✕', '#c02c22'),   # 朱砂
    # [EN] Light ink
    # [EN] Teal
    # [EN] Ochre gold
    # [EN] Cinnabar
}
MSG_LABEL = {'info': '提示', 'ok': '完成', 'warn': '注意', 'error': '错误'}
# 严重度（消息框挑"该显示哪一条"时用）
# [EN] Severity (used by the message box to pick "which one to show")
MSG_SEVERITY = {'info': 0, 'ok': 1, 'warn': 2, 'error': 3}

# ★ 状态栏**只报要紧的**（2026-10-06 用户原话：「不需要所有的事情都发消息
#   重要的事情才发」）。哪些级别值得留在常驻那块框里：
#     warn / error → 要人知道、要人处理，必须留；
#     ok           → 一个动作的收尾回执（配置已保存、删完并写明备份在哪），留；
#     info         → 过程播报（"已打开帮助""语言已切换"），**只进日志**。
#   想要强制留在状态栏的 info 传 `keep=True`。
#   注意：**用户主动操作得到的即时反馈不受影响** —— 那些走 `snack=True`，
#   照旧弹一下（只是不再塞进常驻列表，免得列表被"已打开设置"刷满）。
# [EN] ★ The status bar **only reports what matters** (user's exact words on 2026-10-06: "not
# [EN] everything needs to be broadcast
# [EN] only important things get broadcast"). Which levels deserve to stay in that persistent box:
# [EN] warn / error → people need to know, people need to act, must stay;
# [EN] ok → closing receipt for an action (config saved, deletion done with backup location noted),
# [EN] stays;
# [EN] info         → progress broadcast ("help opened" "language switched"), **goes to log only**.
# [EN] To force an info to stay in the status bar, pass `keep=True`.
# [EN] Note: **immediate feedback from user-initiated actions is unaffected** —— those go through
# [EN] `snack=True`,
# [EN] they still pop up as before (just no longer stuffed into the persistent list, so the list
# [EN] doesn't get flooded by "settings opened").
MSG_KEEP_LEVELS = ('ok', 'warn', 'error')
# 挑标题时往回看多少条：只看最近这一批，别让今天早上的一条警告
# 一直霸着位置，把后面真正的新消息全挡住。
# [EN] How many entries to look back when picking a title: only look at the most recent batch, don't
# [EN] let one warning from this morning
# [EN] keep hogging the spot and block all the genuinely new messages behind it.
MSG_LOOKBACK = 20
#: 消息列表里那列时间的宽度。'08-14 23:41' 有 11 个字符 —— 78 px 放不下。
# [EN] : Width of the time column in the message list. '08-14 23:41' is 11 characters —— 78 px can't
# [EN] fit it.
MSG_TS_W = 96

# ══════════════════════════════════════════════════════════════════════
#  消息**落盘**（2026-10-09）
# [EN] Message **persistence** (2026-10-09)
# ══════════════════════════════════════════════════════════════════════
# 用户报的原话：「系统消息应该是**跨启动保留**，除非我主动删除，
# 否则不能够上次运行过程中的消息关闭再启动就没了」。
# 以前 `_messages` 就是一个内存 list —— 关掉程序那一刻，那些
# 「⚠ 配置已改动（…）—— 需要重启程序才会生效」「❌ 保存失败：…」全没了，
# 而这个框存在的**全部理由**就是"留着回来处理"（见 `_post_message` 的注释）。
# [EN] The user's exact report: "System messages should be **preserved across launches**, unless I
# [EN] actively delete them,
# [EN] otherwise messages from the previous run are gone after closing and relaunching".
# [EN] Previously `_messages` was just an in-memory list —— the moment the program closed, those
# [EN] "⚠ Config changed (…) —— needs program restart to take effect" "❌ Save failed: …" all vanished,
# [EN] yet the **entire reason** this box exists is to "keep them around to deal with later" (see the
# [EN] comment in `_post_message`).
# 落盘格式用 **JSONL**（一行一条、只追加）：
#   · 追加不用读全量、不用重写，消息多起来也不慢；
#   · 某一行坏了只丢那一行，不会像整体 JSON 那样**一处坏、全盘丢**；
#   · 与本项目别处（`审读台账.jsonl`）同一套做法。
# [EN] Persistence format uses **JSONL** (one entry per line, append-only):
# [EN] · Appending doesn't need to read the whole thing or rewrite it, and it stays fast as messages
# [EN] pile up;
# [EN] · If one line gets corrupted, only that line is lost, unlike whole-file JSON where **one
# [EN] corruption loses everything**;
# [EN] · Same approach as elsewhere in this project (`审读台账.jsonl`).
# ⚠ 为什么放**程序目录**而不是 `logs/`：`log_dir()` 是可配置的，而且会按
#   `LOG_ROTATE_DAYS` 清理 —— 消息要"留到用户主动删"，不该被日志清理顺手扫掉。
# [EN] ⚠ Why put it in the **program directory** rather than `logs/`: `log_dir()` is configurable and
# [EN] will be
# [EN] cleaned up according to `LOG_ROTATE_DAYS` —— messages are meant to be "kept until the user
# [EN] actively deletes them" and shouldn't be swept away by log cleanup.
MSG_FILE_NAME = '.nws_messages.jsonl'
#: 磁盘上最多留多少条（超出就重写一次，只留最近的）。
# [EN] : Max number of entries kept on disk (exceeding it triggers a rewrite, keeping only the most
# [EN] recent).
MSG_KEEP_MAX = 500


def _msg_sink() -> Path | None:
    """验证/回归期间把消息写盘**重定向**到临时文件（给 `msg_file_path` 用）。

    ★★★ 必须隔离，理由是两个实测到的后果：
      ① **污染用户的文件**：回归里有几十支脚本会起真界面，`app.main()` 一上来
         就会发消息 —— 每跑一次回归就往用户的 `.nws_messages.jsonl` 里灌几十条
         **中文测试消息**（"滚动条验证用的第 19 条消息""项目根目录已改为
         C://Users//…//Temp//…//根乙"）。用户第二天打开程序，看到一屏测试垃圾。
      ② **判据之间互相看到对方的垃圾**：`verify_ui_english` 会读消息历史，
         而它读到的是**别的脚本留下的中文消息** → 英文界面判据当场假红。
      这与 `.env` 是同一类问题，所以用**同一个保险丝**（本项目铁律：
      会写用户文件的路径，默认就该写不进去）。
    
        English:
    During verification/regression, redirect message writes to disk to a temp file (used for
    `msg_file_path`).
        ★★★ Must be isolated, for two empirically observed consequences:
          1. **Pollutes the user's files**: dozens of scripts in regression start the real UI, and `app.main()` on startup
             immediately sends messages -- every regression run dumps dozens of
             **Chinese test messages** into the user's `.nws_messages.jsonl` ("message 19 used for scrollbar verification", "project root changed to
             C://Users//...//Temp//...//root B"). The user opens the program the next day and sees a screenful of test junk.
          2. **Criteria see each other's junk**: `verify_ui_english` reads the message history,
             and what it reads is **Chinese messages left by other scripts** -> the English UI criterion turns false-red on the spot.
          This is the same class of problem as `.env`, so use the **same fuse** (project iron rule:
          paths that write to user files should by default be unwritable).
    """
    # ★★ 为什么单列一个 `NWS_MSG_SINK`，而不是直接复用 `NWS_ENV_SINK`：
    #   回归器给**所有子进程**设的是**同一个** `NWS_ENV_SINK`。对 `.env` 没问题
    #   （那是个**只写**的保险丝，谁也不读它）；可消息文件**启动时要读回来** ——
    #   共用一个文件，等于每支判据都能读到**别的判据留下的消息**。
    #   实测：`verify_ui_english` 因此在自己那份英文界面里读出了
    #   "滚动条验证用的第 19 条消息"，判据当场假红；`verify_regular_tab`
    #   的「保存后有没有回执」也因为前面压着别人的消息而找不到那条回执。
    #   ⇒ 消息用**每支脚本一份**的路径（回归器按脚本名给）。
    # [EN] ★★ Why a separate `NWS_MSG_SINK` instead of directly reusing `NWS_ENV_SINK`:
    # [EN] The regressor sets the **same** `NWS_ENV_SINK` for **all subprocesses**. No problem for `.env`
    # [EN] (that's a **write-only** fuse; nobody reads it); but the message file **must be read back on
    # [EN] startup** ——
    # [EN] sharing one file means every assertion script can read **messages left behind by other assertion
    # [EN] scripts**.
    # [EN] Observed in practice: `verify_ui_english` thus read, within its own English-UI run,
    # [EN] "the 19th message used for scrollbar verification", and the assertion turned falsely red on the
    # [EN] spot; `verify_regular_tab`
    # [EN] 's "is there a receipt after saving" also couldn't find that receipt because other people's
    # [EN] messages were piled in front.
    # [EN] ⇒ Use a **per-script** path for messages (the regressor provides it by script name).
    for key, suffix in (('NWS_MSG_SINK', ''), ('NWS_ENV_SINK', '.msg')):
        v = (os.environ.get(key) or '').strip()
        if v:
            return Path(v).expanduser().with_suffix(suffix) if suffix else Path(v).expanduser()
    try:
        from config import Config
        if Config.redirect_save is not None:
            return Path(str(Config.redirect_save)).with_suffix('.msg')
    except Exception:                                          # noqa: BLE001
        pass
    return None


def msg_file_path() -> Path:
    """消息落盘文件（程序目录下，与 `.env` 同处）。

    ⚠ 验证/回归期间会写到临时文件 —— 见 `_msg_sink()` 里的两条实测理由。
    
        English:
    Message persistence file (in the program directory, same place as `.env`).
        ⚠ During verification/regression it writes to a temp file -- see the two empirical reasons in `_msg_sink()`.
    """
    sink = _msg_sink()
    return sink if sink is not None else APP_DIR / MSG_FILE_NAME


def load_messages() -> list[dict]:
    """从盘上读回上次的消息。

    ★ **读坏了就当没有**（返回空表）：这个文件只是"方便"，它绝不该
      拦住程序启动 —— 一个坏掉的 jsonl 让软件打不开，是最不划算的交换。
    
        English:
    Read the last messages back from disk.
        ★ **Treat a bad read as nothing** (return an empty list): this file is only a "convenience", it must never
          block program startup -- a broken jsonl making the software unopenable is the worst possible trade.
    """
    p = msg_file_path()
    if not p.exists():
        return []
    out: list[dict] = []
    try:
        text = p.read_text(encoding='utf-8', errors='replace')
    except OSError:
        return []
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except ValueError:
            continue                      # 只丢这一行
            # [EN] only drop this line
        if isinstance(d, dict) and str(d.get('text') or '').strip():
            out.append({'ts': str(d.get('ts') or ''),
                        'day': str(d.get('day') or ''),
                        'text': str(d['text']),
                        'level': str(d.get('level') or 'info')})
    return out[-MSG_KEEP_MAX:]


def append_message(m: dict) -> None:
    """追加一条到盘上。**写不进去不算错**（消息在内存里照样能看）。
        English:
    Append one to disk. **Failure to write is not an error** (messages are still visible in memory).
    """
    p = msg_file_path()
    try:
        with p.open('a', encoding='utf-8') as f:
            f.write(json.dumps(m, ensure_ascii=False) + '\n')
    except OSError:
        return
    # 涨过头就压一次 —— 不然文件会随年月无限长下去。
    # [EN] Compact once it grows too large —— otherwise the file grows without bound over months and years.
    try:
        if p.stat().st_size > 200_000:
            keep = load_messages()[-MSG_KEEP_MAX:]
            p.write_text(''.join(json.dumps(x, ensure_ascii=False) + '\n'
                                 for x in keep), encoding='utf-8')
    except OSError:
        pass


def clear_message_file() -> None:
    """把落盘的消息删掉（用户点「清空」时调）。**删不动也不报错。**
        English:
    Delete the persisted messages (called when the user clicks "Clear"). **Failure to delete is not
    an error either.**
    """
    try:
        msg_file_path().unlink(missing_ok=True)
    except OSError:
        pass


def msg_time_label(m: dict, today: str) -> str:
    """消息在界面上显示的时间。

    ★ 跨启动之后**光给 `HH:MM:SS` 是不够的**：昨天的 23:41 和今天的 23:41
      长得一模一样，用户看到会以为"怎么刚发生的"。所以非今天的条目**带上日期**。
    
        English:
    The time a message is displayed in the UI.
        ★ Across restarts, **`HH:MM:SS` alone is not enough**: yesterday's 23:41 and today's 23:41
          look identical, and the user will think "how did this just happen". So entries not from today **include the date**.
    """
    ts = str(m.get('ts') or '')
    day = str(m.get('day') or '')
    if not day or day == today:
        return ts
    return f'{day[5:]} {ts[:5]}' if len(day) >= 10 else ts


# 环境变量键 → 界面上的名字（只在「你改了 XX，需要重启」这句提示里用）。
# 模型能力那几项的名字从 `llm.capabilities.CAP_META` 取，避免两处各写一份。
# [EN] Env var key → name shown in the UI (only used in the "you changed XX, needs restart" hint).
# [EN] The names of the model capability items come from `llm.capabilities.CAP_META`, to avoid writing
# [EN] them in two places.
LLM_KEY_LABEL = {
    'LLM_PROVIDER': '接入协议',
    'LLM_BASE_URL': 'Base URL',
    'LLM_API_KEY': 'API Key',
    'LLM_TIMEOUT_SECONDS': '请求超时',
    'LLM_MAX_RETRIES': '重试次数',
    'LLM_MAX_CONCURRENCY': '并发上限',
    'MOCK_LLM': '演示模式',
    'MODEL_FRONT': '华彩档模型',
    'MODEL_DAILY': '日常档模型',
    'MODEL_CHEAP': '摘要档模型',
    'IMAGE_AI_MODEL': '文生图模型',
    'IMAGE_AI_SIZE': '文生图尺寸',
    # ★ 2026-10-09：`MUMU_AUTOSTART` 是 `restart=True` 的（服务只在校验/启动时拉一次
    #   —— 它不在"每一次都现读"的那一类里）。不登记的话，改了它之后那句
    #   「⚠ 配置已改动（MUMU_AUTOSTART）—— 需要重启」会露出**配置键名**，
    #   用户看不懂那是哪一项。
    # [EN] ★ 2026-10-09: `MUMU_AUTOSTART` is `restart=True` (the service only pulls it once at
    # [EN] validation/startup
    # [EN] —— it's not in the "re-read every time" category). If it's not registered, then after changing
    # [EN] it the line
    # [EN] "⚠ Config changed (MUMU_AUTOSTART) —— needs restart" would expose the **config key name**,
    # [EN] and users can't tell which item that is.
    'MUMU_AUTOSTART': '自动拉起创作服务',
}


def msg_level_of(text: str) -> str:
    """按文案前缀猜级别（老的提示语都带 ✅/❌/⚠️ 前缀，不必逐处改调用）。
        English:
    Guess the level from the text prefix (old prompts all have ✅/❌/⚠️ prefixes, no need to change
    call sites one by one).
    """
    s = str(text or '').lstrip()
    if s.startswith('❌'):
        return 'error'
    if s.startswith('⚠'):
        return 'warn'
    if s.startswith('✅'):
        return 'ok'
    return 'info'


def mk_btn(label: str, on_click=None, primary: bool = True, width: int = None,
           height: int = None, danger: bool = False) -> ft.Control:
    """紧凑按钮。

    `height` 默认 `BTN_H`。**和输入框同一行时传 `SET_H`** ——
    一个 34 的按钮挨着一个 42 的输入框，看着就是"没对齐"。

    `danger=True` 换成**朱砂底 + 纸白字**：删除这类不可逆的操作必须一眼看出来
    跟旁边那几个按钮不是一类。（**别把 `color` 写在里面的 `Text` 上** ——
    那样按钮自己的 `color` 就透不进去了，改配色要改两处。）
    
        English:
    Compact button.
        `height` defaults to `BTN_H`. **When on the same row as an input, pass `SET_H`** --
        a 34-high button next to a 42-high input just looks "misaligned".
        `danger=True` switches to **vermilion background + paper-white text**: irreversible operations like delete must be obvious at a glance
        that they are not the same kind as the buttons next to them. (**Don't put `color` on the inner `Text`** --
        that way the button's own `color` won't show through, and changing the palette means changing two places.)
    """
    txt = ft.Text(label, size=BTN_FS)
    style = ft.ButtonStyle(padding=CP_BTN)
    h = height or BTN_H
    if danger:
        return ft.FilledButton(content=txt, on_click=on_click,
                               height=h, width=width, style=style,
                               bgcolor=DANGER, color=C['paper_hi'])
    if primary:
        return ft.FilledButton(content=txt, on_click=on_click,
                               height=h, width=width, style=style,
                               bgcolor=C['border'], color=C['gold'])
    return ft.TextButton(content=txt, on_click=on_click,
                         height=h, width=width, style=style)


def mk_icon_btn(icon, on_click=None, *, size: int = 26, height: int = 22,
                danger: bool = True, tooltip: str = '') -> ft.Container:
    """**图标小按钮**：自己画一个圆角底 + 居中一个 Material 图标。

    为什么不直接 `mk_btn('🗑')`：那个 emoji 是**彩色字形**，宽度和基线由字体决定，
    塞进 30px 宽的 `FilledButton` 里会**溢出背景** —— 用户的原话就是
    「删除的垃圾桶图标没在红色背景里」。`ft.Icon` 是**单色矢量**（跟着 `color` 走、
    尺寸可控），再配 `alignment` 保证居中，几何完全由我们说了算。

    ⚠ 里面那个 `ft.Icon` **不要**再挂 `on_click`（容器已经接了）——
    两层都接的话点击会走到两个回调里。
    
        English:
    **Small icon button**: draw your own rounded background + a centered Material icon.
        Why not just `mk_btn('🗑')`: that emoji is a **color glyph**, its width and baseline determined by the font,
        and stuffing it into a 30px-wide `FilledButton` will **overflow the background** -- the user's exact words were
        "the delete trash icon isn't inside the red background". `ft.Icon` is a **monochrome vector** (follows `color`,
        controllable size), and with `alignment` to guarantee centering, the geometry is entirely up to us.
        ⚠ The inner `ft.Icon` should **not** also have `on_click` attached (the container already handles it) --
        if both layers handle it, the click will go into two callbacks.
    """
    return ft.Container(
        content=ft.Icon(icon, size=max(10, size - 11),
                        color=C['paper_hi'] if danger else C['text']),
        width=size, height=height, border_radius=4,
        bgcolor=DANGER if danger else C['panel'],
        border=make_border(1, DANGER if danger else C['border']),
        alignment=ft.Alignment(0, 0),
        on_click=on_click,
        tooltip=(tooltip or None),
    )


def set_btn_text(btn, text: str) -> None:
    """改按钮文字。

    Flet 1.0 里按钮文字在 **`content`**，而不是 `.text`。
    而 `content` 可能是裸字符串（`FilledButton("暂停")` 的第一个位置参数就是它），
    也可能是 `ft.Text` —— 两种都要能改。
    
        English:
    Change button text.
        In Flet 1.0 button text is in **`content`**, not `.text`.
        And `content` may be a bare string (the first positional arg of `FilledButton("Pause")` is it),
        or it may be `ft.Text` -- both must be changeable.
    """
    if btn is None:
        return
    if isinstance(getattr(btn, 'content', None), ft.Text):
        btn.content.value = text
    else:
        btn.content = text


def make_border(width: int = 1, color: str = '#4a3f34') -> ft.Border:
    """创建边框（Flet 1.0 兼容）。
        English:
    Create a border (Flet 1.0 compatible).
    """
    side = ft.BorderSide(width, color)
    return ft.Border(top=side, bottom=side, left=side, right=side)


def make_border_bottom(width: int = 1, color: str = '#4a3f34') -> ft.Border:
    """创建只有底部的边框（Flet 1.0 兼容）。
        English:
    Create a bottom-only border (Flet 1.0 compatible).
    """
    return ft.Border(bottom=ft.BorderSide(width, color))


def make_padding(top: int = 0, right: int = 0, bottom: int = 0, left: int = 0) -> ft.Padding:
    """创建内边距（Flet 1.0 兼容）。
        English:
    Create padding (Flet 1.0 compatible).
    """
    return ft.Padding(left, top, right, bottom)


def make_padding_symmetric(horizontal: int = 0, vertical: int = 0) -> ft.Padding:
    """创建对称内边距（Flet 1.0 兼容）。
        English:
    Create symmetric padding (Flet 1.0 compatible).
    """
    return ft.Padding(horizontal, vertical, horizontal, vertical)


def _on_hover(e: ft.HoverEvent):
    """鼠标悬停事件处理。
        English:
    Mouse hover event handling.
    """
    # Flet 1.0 中 on_hover 事件的处理
    # [EN] Handling of the on_hover event in Flet 1.0
    pass


# 背景资源目录
# [EN] Background asset directory
BG_DIR = APP_DIR / 'assets' / 'images'

# 背景图来自**文生图**（实景：无锡鼋头渚春季），由 image_gen/background.py 的
# build_from_source() 处理成这两张：
#   title_bg.webp       母版（16:9 · 3840×2160）→ 开始界面
#   title_bg_soft.webp  柔化版 → 运行界面（面板半透明，背景不能抢字）
# 原图在 assets/images/bg/ 存档，所以换尺寸/改柔化参数只要重跑一次构建。
# [EN] Background images come from **text-to-image** (real scene: Wuxi Yuantouzhu in spring), processed
# [EN] by image_gen/background.py's
# [EN] build_from_source() into these two:
# [EN] title_bg.webp       master (16:9 · 3840×2160) → start screen
# [EN] title_bg_soft.webp softened version → running screen (the panel is semi-transparent, the
# [EN] background must not fight the text)
# [EN] The originals are archived in assets/images/bg/, so changing dimensions/softening parameters
# [EN] only requires re-running the build once.
BG_VARIANTS = {
    'master': ('title_bg.webp', None),
    'soft': ('title_bg_soft.webp', 'soft'),
}


def get_bg(kind: str = 'master', width: int = 3840, height: int = 2160) -> str:
    """取背景图路径。

    ① 成品已在 → 直接用（正常路径，不做任何处理）
    ② 缺成品但有**文生图原图**（assets/images/bg/）→ 现场构建
    ③ 都没有 → 退到旧的程序化绘制（legacy，只为缺图时不至于白屏）
    
        English:
    Get the background image path.
        1. Finished product already exists -> use it directly (normal path, no processing)
        ② No finished product but has **text-to-image originals** (assets/images/bg/) -> build on the spot
        ③ Neither exists -> fall back to the old procedural drawing (legacy, only so it isn't a blank screen when images are missing)
    """
    BG_DIR.mkdir(parents=True, exist_ok=True)
    filename, variant = BG_VARIANTS.get(kind, BG_VARIANTS['master'])
    path = BG_DIR / filename
    if path.exists():
        return str(path)

    log = get_logger('nws.gui')
    from image_gen import background as _bg

    # ② 从文生图原图构建
    # [EN] ② Build from text-to-image originals
    try:
        src = _bg.find_ai_source()
        if src is not None:
            log.info(t('背景图缺失，正从文生图原图构建：%s'), src.name,
                     extra={'category': 'ui'})
            _bg.build_from_source(src, BG_DIR, (width, height))
            if path.exists():
                return str(path)
    except Exception:
        log_exception(t('从文生图原图构建背景失败'), category='ui')

    # ③ 兜底：程序化绘制（legacy）
    # [EN] ③ Fallback: programmatic drawing (legacy)
    try:
        log.warning(t('没有文生图原图，改用程序化背景（兜底）'),
                    extra={'category': 'ui'})
        img = generate_title_background(width, height)
        if variant == 'soft':
            img = soften(img)
        img.save(str(path), format='WEBP', quality=92, method=6)
        log.info(t('背景图已生成: %s'), path.name, extra={'category': 'ui'})
    except Exception:
        log_exception(t('生成背景图失败'), category='ui')
        return ''
    return str(path) if path.exists() else ''


def get_or_generate_bg() -> str:
    """兼容旧调用：水墨原图（master）。
        English:
    Backward-compatible old call: ink-wash original (master).
    """
    return get_bg('master')


ICON_STAMP = APP_DIR / 'assets' / '.icon_stamp'


def ensure_icon_assets(force: bool = False) -> dict:
    """把**全套**图标产物对齐到当前图标代码，返回各文件路径。

    ★ 实现已搬到 **`image_gen/icon.py::ensure_assets()`**（2026-10-07）——
      因为**安装器也要用**，而安装器不能 `import gui.app_flet`（会拉起 Flet）。
      这里只留一层薄封装：负责把结果写进界面日志（这是界面该管的事）。

    行为一字未变：按 `image_gen/icon.py` 的**源码指纹**判定，
    指纹与 `assets/.icon_stamp` 存的不一样就重做全套五份产物。
    五份 = `assets/images/{icon.png, icon_256.png, icon.ico}` +
    `assets/{app_icon.png, app_icon.ico}`（后两份是窗口与任务栏在用的）。
    
        English:
    Align the **full set** of icon artifacts to the current icon code, returning each file path.
        ★ Implementation has been moved to **`image_gen/icon.py::ensure_assets()`** (2026-10-07) --
          because **the installer also needs it**, and the installer cannot `import gui.app_flet` (that would pull up Flet).
          Only a thin wrapper is left here: responsible for writing results into the UI log (which is the UI's job).
        Behavior unchanged at all: determined by the **source fingerprint** of `image_gen/icon.py`,
        if the fingerprint differs from what is stored in `assets/.icon_stamp`, redo the full set of five artifacts.
        Five = `assets/images/{icon.png, icon_256.png, icon.ico}` +
        `assets/{app_icon.png, app_icon.ico}` (the latter two are used by the window and taskbar).
    """
    from image_gen.icon import ensure_assets, icon_signature

    msgs: list[str] = []
    res = ensure_assets(force=force, log=msgs.append)
    if msgs:
        try:
            get_logger('nws.gui').info(
                '；'.join(msgs) + f'（指纹 {icon_signature() or "?"}）',
                extra={'category': 'ui'})
        except Exception:                                       # noqa: BLE001
            pass
    return res


def get_or_generate_icon() -> str:
    """应用图标（朱砂橙圆角方底 · 象牙白狐狸，界面内显示用，绝对路径）。

    **不是"不存在才生成"** —— 见 `ensure_icon_assets()`：图标代码一变，
    这五份产物（含任务栏在用的 `assets/app_icon.ico`）会一起重做。
    
        English:
    App icon (cinnabar-orange rounded-square base · ivory-white fox, for in-UI display, absolute
    path).
        **Not "generate only if it doesn't exist"** -- see `ensure_icon_assets()`: as soon as the icon code changes,
        these five artifacts (including the taskbar's `assets/app_icon.ico`) are all redone together.
    """
    return str(ensure_icon_assets()['png'])


def get_window_icon_rel() -> str:
    """窗口图标：Flet 要求**相对 assets 目录**的路径，故在 assets 根下放一份。
        English:
    Window icon: Flet requires a path **relative to the assets directory**, so place a copy under
    the assets root.
    """
    p = ensure_icon_assets()['app_png']
    if not p.exists():
        return ''
    return 'app_icon.png'


def get_window_icon_ico() -> str:
    """窗口/任务栏图标 .ico（Win32 API 用绝对路径加载）。
        English:
    Window/taskbar icon .ico (Win32 API loads with an absolute path).
    """
    p = ensure_icon_assets()['app_ico']
    return str(p) if p.exists() else ''


def _win32():
    """Win32 句柄（非 Windows 返回 None）。
        English:
    Win32 handle (returns None on non-Windows).
    """
    if not sys.platform.startswith('win'):
        return None
    try:
        import ctypes
        from ctypes import wintypes
    except Exception:                                       # noqa: BLE001
        return None
    return ctypes, wintypes


# ══════════════════════════════════════════════════════════════
#  「这个窗口是不是**我们自己的**」—— 2026-10-07 修的
# [EN] "Is this window **our own**" -- fixed 2026-10-07
#  ⚠⚠ 用户报「发现为何 explorer.exe 的图标也被替换了」，查出来的就是这个。
# [EN] ⚠⚠ User reported "found out why explorer.exe's icon was also replaced", this is what turned up.
#  老实现（`find_app_hwnd`）的兜底是：
#      凡标题里含 `VERSION`（= "0.1.0"）或 `'Novel World'` 或 `'小说世界'`
#      的窗口，收集起来，**取第一个**（`found[0]`）。
#  而 `apply_icon_to_hwnd` 里有一句：
#      `SetClassLongPtrW(hwnd, GCLP_HICON, hicon)`   ← 改的是**窗口【类】**图标
#  改窗口类图标 = 影响**那个进程里所有同类窗口**。
# [EN] The old implementation (`find_app_hwnd`) fallback was:
# [EN] Any window whose title contains `VERSION` (= "0.1.0") or `'Novel World'` or `'小说世界'`
# [EN] , collect them, **take the first one** (`found[0]`).
# [EN] And in `apply_icon_to_hwnd` there is this line:
# [EN] `SetClassLongPtrW(hwnd, GCLP_HICON, hicon)`   <- this changes the **window [class]** icon
# [EN] Changing the window class icon = affects **all windows of that class in that process**.
#  于是只要命中了别人的窗口，就会把人家**一整类**窗口的图标换掉。
#  实测（`developers/probe_window_icon_target.py`，本机真实枚举）：
#    · 用户桌面上的 `小说世界虚拟模拟` 文件夹窗口 → 类 `CabinetWClass`，属 explorer.exe
#      ⇒ 改了它 = **资源管理器（含任务栏那个"文件资源管理器"）图标全变**
#    · 标题跟着工作目录走的 Windows 终端 → 类 `CASCADIA_HOSTING_WINDOW_CLASS`
#    · 本程序自己的窗口 → 类 `FLUTTER_RUNNER_WIN32_WINDOW`
#  再加 `found[0]` 按 Z 序取第一个（谁在最前取谁）—— 用户点一下别处就可能换目标。
# [EN] So as long as it hits someone else's window, it will replace the icons of that person's **entire
# [EN] class** of windows.
# [EN] Measured (`developers/probe_window_icon_target.py`, real enumeration on this machine):
# [EN] ⇒ changing it = **all Explorer (including the "File Explorer" icon in the taskbar) icons
# [EN] change**
# [EN] · Windows Terminal whose title follows the working directory -> class
# [EN] `CASCADIA_HOSTING_WINDOW_CLASS`
# [EN] · This program's own window -> class `FLUTTER_RUNNER_WIN32_WINDOW`
# [EN] Plus `found[0]` takes the first by Z order (whoever is on top gets picked) -- the user clicking
# [EN] elsewhere can switch the target.
#  ★ 修法不是"把条件写细一点"，而是**两道结构性锁**：
#    ① **窗口类必须是 Flet 的**（`FLUTTER_RUNNER_WIN32_WINDOW`）——
#       文件夹窗口 / 终端 / 记事本……结构上就不可能命中；
#    ② **进程必须是我们自己的**（本进程，或本进程起的 `flet.exe` 子进程）——
#       就算类名撞了（实测别的 Flet 程序 `Abysswalker.exe` 也用这个类名）
#       也伤不到别人。
#    宁可找不到（退回"不设图标"、任务栏显示默认图），也**绝不碰别人的窗口**。
# [EN] ★ The fix is not "write the condition more narrowly", but **two structural locks**:
# [EN] ① **The window class must be Flet's** (`FLUTTER_RUNNER_WIN32_WINDOW`) --
# [EN] folder windows / terminals / Notepad ... are structurally impossible to hit;
# [EN] ② **The process must be our own** (this process, or the `flet.exe` child process spawned by this
# [EN] process) --
# [EN] even if the class name collides (measured: another Flet program `Abysswalker.exe` also uses this
# [EN] class name)
# [EN] it still can't hurt others.
# [EN] Better to fail to find it (fall back to "don't set icon", taskbar shows the default) than
# [EN] **never touch someone else's window**.
# ══════════════════════════════════════════════════════════════

#: Flet（Windows 桌面客户端）的窗口类名。**只有它**才是"我们自己画的窗口"。
#: ⚠ 光靠它不够：别的 Flet 程序用同一个类名（实测 `Abysswalker.exe`），
#:   所以必须**叠加进程归属**那一锁。
# [EN] : Flet's (Windows desktop client) window class name. **Only it** is a "window we drew
# [EN] ourselves".
# [EN] : ⚠ Relying on it alone is not enough: other Flet programs use the same class name (measured
# [EN] `Abysswalker.exe`),
# [EN] :   so the **process ownership** lock must be **stacked on top**.
_FLET_WINDOW_CLASS = 'FLUTTER_RUNNER_WIN32_WINDOW'

#: 标题里出现这些，才算"像我们的窗口"。
#: ⚠ **不再拿 `VERSION` 当标识**：`VERSION = "0.1.0"` 这种版本号太通用，
#:   任何窗口标题里带 `0.1.0`（某个工具的版本提示）都会被命中。
# [EN] : Only if these appear in the title is it "like our window".
# [EN] : ⚠ **No longer use `VERSION` as an identifier**: `VERSION = "0.1.0"` version numbers like this
# [EN] are too generic,
# [EN] :   any window title containing `0.1.0` (a tool's version hint) will be hit.
_OWN_TITLE_MARKS = ('小说世界', 'Novel World')


def _u32_decls(): 
    """显式声明用到的 Win32 函数签名。

    ⚠ **必须**声明 `restype = c_void_p`：HWND / HICON / HANDLE 都是**指针型**，
    让 ctypes 按默认的 `c_int` 接会把高位的 32 位丢掉（句柄 > 0x7FFFFFFF 时
    变成负数），之后再传回去就是另一个东西了。本项目的老规矩：
    碰 Win32 的地方一律把签名写全，不靠默认值。
    
        English:
    Explicitly declare the signatures of the Win32 functions used.
        ⚠ **Must** declare `restype = c_void_p`: HWND / HICON / HANDLE are all **pointer types**,
        letting ctypes receive them as the default `c_int` will drop the upper 32 bits (when the handle > 0x7FFFFFFF
        it becomes negative), and passing it back afterward is then something else entirely. This project's old rule:
        anywhere Win32 is touched, always write the full signature, never rely on defaults.
    """
    w = _win32()
    if not w:
        return None
    ctypes, wintypes = w
    u32 = ctypes.windll.user32
    k32 = ctypes.windll.kernel32

    u32.FindWindowW.argtypes = [wintypes.LPCWSTR, wintypes.LPCWSTR]
    u32.FindWindowW.restype = ctypes.c_void_p
    u32.GetWindowTextLengthW.argtypes = [wintypes.HWND]
    u32.GetWindowTextLengthW.restype = ctypes.c_int
    u32.GetWindowTextW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
    u32.GetWindowTextW.restype = ctypes.c_int
    u32.GetClassNameW.argtypes = [wintypes.HWND, wintypes.LPWSTR, ctypes.c_int]
    u32.GetClassNameW.restype = ctypes.c_int
    u32.GetWindowThreadProcessId.argtypes = [wintypes.HWND,
                                             ctypes.POINTER(wintypes.DWORD)]
    u32.GetWindowThreadProcessId.restype = wintypes.DWORD
    u32.IsWindowVisible.argtypes = [wintypes.HWND]
    u32.IsWindowVisible.restype = wintypes.BOOL
    u32.EnumWindows.argtypes = [ctypes.c_void_p, wintypes.LPARAM]
    u32.EnumWindows.restype = wintypes.BOOL
    u32.SendMessageW.argtypes = [wintypes.HWND, wintypes.UINT, wintypes.WPARAM,
                                 wintypes.LPARAM]
    u32.SendMessageW.restype = ctypes.c_ssize_t
    u32.LoadImageW.argtypes = [wintypes.HINSTANCE, wintypes.LPCWSTR, wintypes.UINT,
                               ctypes.c_int, ctypes.c_int, wintypes.UINT]
    u32.LoadImageW.restype = ctypes.c_void_p
    # SetClassLongPtrW 的第三参数与返回值都是 LONG_PTR（64 位）——
    # 不声明的话 ctypes 按 32 位传，句柄会被截。
    # [EN] SetClassLongPtrW's third argument and return value are both LONG_PTR (64-bit) --
    # [EN] without declaring it, ctypes passes it as 32-bit and the handle gets truncated.
    try:
        _set = u32.SetClassLongPtrW
    except AttributeError:                                  # 32 位解释器
    # [EN] 32-bit interpreter
        _set = u32.SetClassLongW
    _set.argtypes = [wintypes.HWND, ctypes.c_int, ctypes.c_ssize_t]
    _set.restype = ctypes.c_ssize_t
    k32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
    k32.OpenProcess.restype = ctypes.c_void_p
    k32.QueryFullProcessImageNameW.argtypes = [ctypes.c_void_p, wintypes.DWORD,
                                               wintypes.LPWSTR,
                                               ctypes.POINTER(wintypes.DWORD)]
    k32.QueryFullProcessImageNameW.restype = wintypes.BOOL
    k32.CloseHandle.argtypes = [ctypes.c_void_p]
    return u32, k32


def hwnd_title(hwnd: int) -> str:
    """窗口标题（拿不到返回空串）。
        English:
    Window title (returns empty string if unavailable).
    """
    d = _u32_decls()
    w = _win32()
    if not d or not w or not hwnd:
        return ''
    u32 = d[0]
    ctypes = w[0]
    n = u32.GetWindowTextLengthW(hwnd)
    if n <= 0:
        return ''
    buf = ctypes.create_unicode_buffer(n + 1)
    u32.GetWindowTextW(hwnd, buf, n + 1)
    return buf.value


def hwnd_class(hwnd: int) -> str:
    """窗口类名（拿不到返回空串）。**判定"是不是我们的窗口"的第一把锁**。
        English:
    Window class name (returns empty string if unavailable). **The first lock for deciding "is this
    our window"**.
    """
    d = _u32_decls()
    w = _win32()
    if not d or not w or not hwnd:
        return ''
    u32 = d[0]
    ctypes = w[0]
    buf = ctypes.create_unicode_buffer(256)
    u32.GetClassNameW(hwnd, buf, 256)
    return buf.value


def hwnd_pid(hwnd: int) -> int:
    """窗口属于哪个进程（拿不到返回 0）。
        English:
    Which process the window belongs to (returns 0 if unavailable).
    """
    d = _u32_decls()
    w = _win32()
    if not d or not w or not hwnd:
        return 0
    u32 = d[0]
    ctypes, wintypes = w
    pid = wintypes.DWORD()
    u32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
    return int(pid.value)


def process_exe(pid: int) -> str:
    """进程的 exe 全路径（拿不到返回空串）。
        English:
    Full exe path of the process (returns empty string if unavailable).
    """
    d = _u32_decls()
    if not d or not pid:
        return ''
    _u32, k32 = d
    ctypes, wintypes = _win32()
    PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
    h = k32.OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not h:
        return ''
    try:
        buf = ctypes.create_unicode_buffer(1024)
        n = wintypes.DWORD(1024)
        ok = k32.QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(n))
        return buf.value if ok else ''
    finally:
        k32.CloseHandle(h)


def _parent_pid(pid: int) -> int:
    """拿 `pid` 的**父进程** id（Toolhelp32 快照；拿不到返回 0）。

    ★ 为什么需要它：Flet 的窗口不是画在 Python 进程里的 ——
      `ft.run()` 会拉起一个**子进程** `flet.exe`（实测路径
      `~/.flet/client/flet-desktop-full-<ver>/flet/flet.exe`），窗口属于它。
      所以"是不是我的窗口"这件事，只能靠**父子关系**回答
      （靠 exe 路径不行：那个路径在用户目录下，不反映"是谁起的"）。
    
        English:
    Get the **parent process** id of `pid` (Toolhelp32 snapshot; returns 0 if unavailable).
        ★ Why it's needed: Flet's window is not drawn inside the Python process --
          `ft.run()` spawns a **child process** `flet.exe` (measured path
          `~/.flet/client/flet-desktop-full-<ver>/flet/flet.exe`), and the window belongs to it.
          So "is this my window" can only be answered by the **parent-child relationship**
          (the exe path won't do: that path is under the user directory, and doesn't reflect "who launched it").
    """
    d = _u32_decls()
    if not d or not pid:
        return 0
    _u32, k32 = d
    ctypes, wintypes = _win32()

    class PROCESSENTRY32W(ctypes.Structure):
        _fields_ = [('dwSize', wintypes.DWORD),
                    ('cntUsage', wintypes.DWORD),
                    ('th32ProcessID', wintypes.DWORD),
                    ('th32DefaultHeapID', ctypes.POINTER(ctypes.c_ulong)),
                    ('th32ModuleID', wintypes.DWORD),
                    ('cntThreads', wintypes.DWORD),
                    ('th32ParentProcessID', wintypes.DWORD),
                    ('pcPriClassBase', ctypes.c_long),
                    ('dwFlags', wintypes.DWORD),
                    ('szExeFile', ctypes.c_wchar * 260)]

    k32.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
    k32.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
    k32.Process32FirstW.argtypes = [ctypes.c_void_p,
                                    ctypes.POINTER(PROCESSENTRY32W)]
    k32.Process32FirstW.restype = wintypes.BOOL
    k32.Process32NextW.argtypes = [ctypes.c_void_p,
                                   ctypes.POINTER(PROCESSENTRY32W)]
    k32.Process32NextW.restype = wintypes.BOOL

    TH32CS_SNAPPROCESS = 0x00000002
    snap = k32.CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0)
    if not snap or snap == ctypes.c_void_p(-1).value:
        return 0
    try:
        e = PROCESSENTRY32W()
        e.dwSize = ctypes.sizeof(PROCESSENTRY32W)
        if not k32.Process32FirstW(snap, ctypes.byref(e)):
            return 0
        while True:
            if e.th32ProcessID == pid:
                return int(e.th32ParentProcessID)
            if not k32.Process32NextW(snap, ctypes.byref(e)):
                return 0
    finally:
        k32.CloseHandle(snap)


def should_take_window(cls: str, title: str, own: bool) -> bool:
    """**纯判定**：这个窗口能不能当"我们的主窗口"。

    三个条件必须**同时**成立 —— 缺任何一个都会误伤别人的窗口
    （2026-10-07 就是这么把 explorer.exe 的图标改掉的）：
      ① `own`  —— 进程是我们自己的（见 `is_own_window`）；
      ② `cls`  —— 窗口类是 Flet 的 `FLUTTER_RUNNER_WIN32_WINDOW`；
      ③ `title`—— 标题里含本程序的字样（`小说世界` / `Novel World`）。

    ⚠ 抽成纯函数是为了**能直接单测**（判据 A 组把各种组合喂进来）；
      写在 `find_app_hwnd` 里就没法测了。

    ⚠ 这里**不看 `VERSION`** —— 拿版本号当标识是上一版的错（见上面那段）。
    
        English:
    **Pure predicate**: whether this window can serve as "our main window".
        All three conditions must hold **simultaneously** -- missing any one will wrongly hit someone else's window
        (that's exactly how explorer.exe's icon got changed on 2026-10-07):
          ① `own`  -- the process is our own (see `is_own_window`);
          ② `cls`  -- the window class is Flet's `FLUTTER_RUNNER_WIN32_WINDOW`;
          ③ `title`-- the title contains this program's wording (`小说世界` / `Novel World`).
        ⚠ Extracting it into a pure function is so it can be **directly unit tested** (criterion group A feeds in various combinations);
          written inside `find_app_hwnd` it would be untestable.
        ⚠ Here **`VERSION` is not consulted** -- using the version number as an identifier was the previous version's mistake (see the paragraph above).
    """
    if not own:
        return False
    if str(cls or '') != _FLET_WINDOW_CLASS:
        return False
    t = str(title or '')
    return any(m in t for m in _OWN_TITLE_MARKS)


def is_own_window(hwnd: int) -> bool:
    """这个窗口句柄是不是**本程序自己**的（两道锁一起判）。

    进程归属认两种情况：
      · `pid == os.getpid()` —— 窗口就在本进程里（某些平台/版本的形态）；
      · `pid` 的父进程（或其父的父）是本进程 —— Flet 的 `flet.exe` 子进程。

    ⚠ 为什么要认"父的父"：`ft.run()` 在某些版本下会套一层启动器
      （`python → flet.exe → 真正的窗口进程`）。宁可多认一层，
      也不要因为认不出而**退化成不设图标**（那也是功能坏了）。
      但**只认到两层** —— 再往上就可能是别人的进程树了。
    
        English:
    Whether this window handle is **this program itself's** (two locks judged together).
        Process ownership recognizes two cases:
          · `pid == os.getpid()` -- the window is in this process (the form on some platforms/versions);
          · the parent process of `pid` (or its parent's parent) is this process -- Flet's `flet.exe` child process.
        ⚠ Why recognize "the parent's parent": `ft.run()` on some versions wraps an extra launcher layer
          (`python → flet.exe → the real window process`). Better to recognize one extra layer
          than to **degrade into not setting the icon** because it can't be recognized (that too is a broken feature).
          But **only up to two layers** -- any higher and it could be someone else's process tree.
    """
    if not hwnd:
        return False
    if hwnd_class(hwnd) != _FLET_WINDOW_CLASS:
        return False
    pid = hwnd_pid(hwnd)
    if not pid:
        return False
    me = os.getpid()
    if pid == me:
        return True
    p1 = _parent_pid(pid)
    if p1 and p1 == me:
        return True
    p2 = _parent_pid(p1) if p1 else 0
    return bool(p2 and p2 == me)


def find_app_hwnd(title: str = '') -> int:
    """找**本程序自己**的主窗口句柄（找不到返回 0）。

    ★★ 2026-10-07 重写。老实现是「标题关键词 + 取第一个」，会命中别人的窗口，
    而下游 `apply_icon_to_hwnd` 改的是**窗口类**图标 —— 于是把
    explorer.exe（文件夹窗口 `CabinetWClass`）和 Windows Terminal
    （`CASCADIA_HOSTING_WINDOW_CLASS`）的一整类窗口图标换掉了。
    详见本文件上面那段说明与 `developers/probe_window_icon_target.py`。

    现在的顺序：
      ① 标题精确查（`FindWindowW`）→ 找到也要过 `is_own_window` 那一关；
      ② 枚举兜底 → 每个候选都过 `is_own_window` + 窗口类 + 标题字样；
      ③ 都找不到 → 回 0（调用方退回"不设图标"，任务栏用默认图）。
    
        English:
    Find **this program itself's** main window handle (returns 0 if not found).
        ★★ Rewritten on 2026-10-07. The old implementation was "title keyword + take the first", which would hit someone else's window,
        and the downstream `apply_icon_to_hwnd` changed the **window class** icon -- thus turning
        explorer.exe (folder window `CabinetWClass`) and Windows Terminal
        (`CASCADIA_HOSTING_WINDOW_CLASS`) entire class of window icons were replaced.
        See the explanation above in this file and `developers/probe_window_icon_target.py`.
        Current order:
          ① Exact title match (`FindWindowW`) → even if found, must pass the `is_own_window` check;
          ② Enumeration fallback → every candidate must pass `is_own_window` + window class + title text;
          ③ If none found → return 0 (caller falls back to "don't set icon", taskbar uses default icon).
    """
    d = _u32_decls()
    if not d:
        return 0
    u32, _k32 = d
    ctypes, wintypes = _win32()

    if title:
        hwnd = u32.FindWindowW(None, title)
        # ⚠ 精确查也要校验：标题可能被别的东西复用（窗口标题不是身份）
        # [EN] ⚠ Even exact lookup needs validation: titles can be reused by something else (a window title is
        # [EN] not an identity)
        if hwnd and is_own_window(int(hwnd)):
            return int(hwnd)

    found: list[int] = []

    def _cb(h, _l):
        if not u32.IsWindowVisible(h):
            return True                     # 隐藏的辅助窗口不参与
            # [EN] Hidden helper windows don't participate
        pid = wintypes.DWORD()
        u32.GetWindowThreadProcessId(h, ctypes.byref(pid))
        own = bool(pid.value) and is_own_window(int(h))
        if should_take_window(hwnd_class(int(h)), hwnd_title(int(h)), own):
            found.append(int(h))
        return True

    WNDENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_bool, wintypes.HWND, wintypes.LPARAM)
    u32.EnumWindows(WNDENUMPROC(_cb), 0)
    return found[0] if found else 0


def apply_icon_to_hwnd(hwnd: int, ico_path: str) -> tuple[int, str]:
    """把 .ico 设到窗口上，返回 `(HICON 句柄, 说明)`。句柄为 0 表示失败。

    ★★ 2026-10-07 加了**拒绝护栏**（第二道防线，见本文件上面那段）。
    这个函数里有 `SetClassLongPtrW(hwnd, GCLP_HICON/SM, hicon)` ——
    它改的是**窗口【类】**图标，会波及**那个进程里所有同类窗口**。
    所以进来先问一句"这是不是我们自己的窗口"，不是就**什么都不做**。
    这样即使 `find_app_hwnd` 将来又被改坏（比如有人把那两道锁删了），
    也伤不到别的程序 —— 这正是用户报的那个 bug 的形状。

    **三个槽位都要设**（这是任务栏换图的关键）：
      - `ICON_BIG(1)`     → 任务栏按钮、Alt-Tab 用的大图；
      - `ICON_SMALL(0)`   → 标题栏左上角；
      - `ICON_SMALL2(2)`  → 新系统标题栏/任务栏用的第二个小图，**只设前两个时
        任务栏偶尔还是旧图**（Win10/11 常从这里取）。
    另外再设一次**窗口类图标**（`GCLP_HICON/-14`、`GCLP_HICONSM/-34`）：
    任务栏在某些情况下回退到类图标，只设窗口图标会看到旧图。
    
        English:
    Set the .ico onto the window, returns `(HICON handle, description)`. A handle of 0 means
    failure.
        ★★ 2026-10-07 added a **rejection guardrail** (second line of defense, see the explanation above in this file).
        This function contains `SetClassLongPtrW(hwnd, GCLP_HICON/SM, hicon)` ——
        it changes the **window [class]** icon, affecting **all windows of the same class in that process**.
        So on entry first ask "is this our own window", and if not, **do nothing**.
        This way, even if `find_app_hwnd` gets broken again in the future (e.g. someone removes those two locks),
        it won't harm other programs —— which is exactly the shape of the bug the user reported.
        **All three slots must be set** (this is the key to changing the taskbar image):
          - `ICON_BIG(1)`     → the large image used by taskbar buttons and Alt-Tab;
          - `ICON_SMALL(0)`   → top-left of the title bar;
          - `ICON_SMALL2(2)`  → the second small image used by the title bar/taskbar on newer systems, **when only the first two are set,
            the taskbar occasionally still shows the old image** (Win10/11 often takes it from here).
        Additionally set the **window class icon** once more (`GCLP_HICON/-14`, `GCLP_HICONSM/-34`):
        in some cases the taskbar falls back to the class icon, and setting only the window icon shows the old image.
    """
    w = _win32()
    if not w or not hwnd or not ico_path:
        return 0, '非 Windows 或参数缺失'
    # ★ 拒绝护栏：不是我们自己的窗口，一个字都不改
    # [EN] ★ Rejection guardrail: not our own window, don't change a single character
    if not is_own_window(hwnd):
        cls = hwnd_class(hwnd) or '（读不到）'
        return 0, (f'拒绝：hwnd {hwnd} 不是本程序的窗口（类 {cls}）—— '
                   f'不做任何改动')
    ctypes, _ = w
    u32 = ctypes.windll.user32

    IMAGE_ICON, LR_LOADFROMFILE, LR_DEFAULTSIZE = 1, 0x0010, 0x0040
    hicon = u32.LoadImageW(None, ico_path, IMAGE_ICON, 0, 0,
                           LR_LOADFROMFILE | LR_DEFAULTSIZE)
    if not hicon:
        return 0, f'图标文件读不出：{ico_path}'

    WM_SETICON = 0x0080
    for slot in (1, 0, 2):                      # ICON_BIG / SMALL / SMALL2
        u32.SendMessageW(hwnd, WM_SETICON, slot, hicon)
    # 类图标（32 位/64 位用不同的 SetClassLongPtr）
    # ⚠ 只在**确认是自己的窗口**之后才走到这里（上面那道护栏）
    # [EN] Class icon (use different SetClassLongPtr for 32-bit/64-bit)
    # [EN] ⚠ Only reach here after **confirming it is our own window** (the guardrail above)
    try:
        _setclass = getattr(u32, 'SetClassLongPtrW', None) or u32.SetClassLongW
        _setclass(hwnd, -14, hicon)             # GCLP_HICON
        _setclass(hwnd, -34, hicon)             # GCLP_HICONSM
    except Exception:                                       # noqa: BLE001
        pass
    return int(hicon), '已应用到 3 个图标槽 + 窗口类'


def read_window_icon(hwnd: int) -> int:
    """读回窗口当前的大图标句柄（`WM_GETICON`）—— 用来验证真的设上了。
        English:
    Read back the window's current large icon handle (`WM_GETICON`) —— used to verify it was
    actually set.
    """
    w = _win32()
    if not w or not hwnd:
        return 0
    ctypes, _ = w
    return int(ctypes.windll.user32.SendMessageW(hwnd, 0x007F, 1, 0)) or 0


def set_windows_window_icon(ico_path: str, title: str = '') -> bool:
    """Windows：用 Win32 API 直接给窗口设图标（含任务栏）。

    Flet 的 `window.icon` 只作用于 Flutter 内部，任务栏（由 flet.exe 客户端
    窗口承载）不会跟着变，这里直接给该窗口发 WM_SETICON 兜底。
    
        English:
    Windows: use the Win32 API to directly set the window icon (including the taskbar).
        Flet's `window.icon` only affects Flutter internals, the taskbar (carried by the flet.exe client
        window) won't change along with it; here we directly send WM_SETICON to that window as a fallback.
    """
    hwnd = find_app_hwnd(title)
    if not hwnd:
        return False
    hicon, _ = apply_icon_to_hwnd(hwnd, ico_path)
    return bool(hicon)


class NovelWorldApp:
    """小说世界AI模拟 · Flet GUI。
        English:
    Novel World AI Simulation · Flet GUI.
    """

    def __init__(self):
        self.current_project: Project | None = None
        self.page: ft.Page | None = None
        self._view: str = 'start'     # 当前所处界面：start / main
        # 导入向导的跨步骤状态
        # [EN] Current screen: start / main
        # [EN] Import wizard's cross-step state
        self._wizard_path: str = ''
        self._wizard_name: str = ''
        # ★ 「项目名称」默认用**所选文件夹的名字**填（用户 2026-10-06 要求：
        #   "开卷的时候，项目名字默认用我打开的文件夹名字填充，用户觉得不对再自己输入"）。
        #   `_wizard_name_auto` 记的是**上一次自动填进去的值** —— 靠它区分
        #   "这个名字还是我自动填的" 与 "用户自己改过了"，后者绝不再覆盖。
        # [EN] ★ "Project name" defaults to **the name of the selected folder** (user request 2026-10-06:
        # [EN] "When opening, the project name should default to the name of the folder I opened; the user can
        # [EN] type their own if it's wrong").
        # [EN] `_wizard_name_auto` records **the last value auto-filled** -- used to distinguish
        # [EN] "this name was still auto-filled by me" from "the user changed it themselves"; the latter is
        # [EN] never overwritten again.
        self._wizard_name_auto: str = ''
        self._wizard_name_field = None       # 第 2 步那个输入框的句柄（存在就能就地刷新）
        # ★ 「这本已经开过卷了」那条提示行的句柄（步骤 1 里，2026-10-07）——
        #   和第 2 步的项目名输入框同一个套路：控件建好时就存下来，
        #   选完文件夹 / 改了名字就地刷新，不必等用户翻到第 2 步才知道。
        # [EN] The handle of that input box in step 2 (if it exists, it can be refreshed in place)
        # [EN] ★ The handle of that "this volume has already been opened" hint line (in step 1, 2026-10-07) --
        # [EN] same pattern as the project name input box in step 2: save the widget when it is created,
        # [EN] refresh in place after selecting a folder / changing the name, no need to wait for the user to
        # [EN] navigate to step 2.
        self._wizard_dup_hint = None
        self._wizard_genre: str = 'auto'
        self._wizard_style: str = 'auto'
        # 输出语言：默认 `auto`（跟随界面语言）—— 和"老项目没有这个字段"时的兜底一致
        # [EN] Output language: defaults to `auto` (follows UI language) -- consistent with the fallback when
        # [EN] "old project doesn't have this field"
        self._wizard_outlang: str = outlang.AUTO
        self._wizard_opts: dict[str, bool] = {
            'ai_optimize': True, 'extract_settings': True,
            'generate_progress': True, 'generate_style': True,
            # ★ 「AI 补全并回写引用文件夹」（2026-10-06 用户要求）：
            #   开卷时 AI 找出来的、**它自己就能修好**的问题（缺伏笔 / 人物空字段 /
            #   非 UTF-8 编码 / 文件名看不出类别），补完之后写回**引用文件夹**。
            #   ⚠ 这个写盘动作**只发生在开卷阶段** —— 项目一旦创建，`ingest/repair`
            #   的写入口会一律拒绝（用户原话："后续项目开始了就不要去动引用文件夹了"）。
            #   默认开：用户要的就是"AI 主动修复"，而且动手前会列清单让他过一次目。
            # [EN] ★ "AI completes and writes back to the referenced folder" (user request 2026-10-06):
            # [EN] At open time, the issues AI finds and **can fix itself** (missing foreshadowing / empty
            # [EN] character fields /
            # [EN] non-UTF-8 encoding / filename doesn't reveal category), after fixing, write back to the
            # [EN] **referenced folder**.
            # [EN] ⚠ This disk write **only happens at open time** -- once the project is created, the write entry
            # [EN] points of `ingest/repair`
            # [EN] will all be refused (user's exact words: "once the project has started, don't touch the
            # [EN] referenced folder").
            # [EN] Default on: what the user wants is "AI actively fixes", and before acting it lists the items for
            # [EN] a once-over.
            'repair_source': True,
            # 打磨记录也追加一份到引用文件夹（同一份文本，项目侧也有一份）。
            # 默认开：用户原话就是「**同时**写到项目里和原始的设定文件夹里」。
            # 与上面那条一样，只在开卷阶段写，项目一开始就封口。
            # [EN] Also append a copy of the polish record to the referenced folder (same text, one copy on the
            # [EN] project side too).
            # [EN] Default on: the user's exact words were "write **both** to the project and to the original
            # [EN] settings folder".
            # [EN] Same as the entry above, only write at open time; sealed once the project starts.
            'polish_write_back': True,
        }
        # ★★ 「剧组 Agents」的项目级定制（2026-10-11 用户要求）：
        #   · `_wizard_agents`：作者在那一步**亲手填**的（key → 这一本要它多做什么）；
        #   · `_wizard_agents_ai`：没填的那些**交给 AI 依据类型卡/风格卡推**。
        #   两者都空 = 这一本书不给任何 Agent 定制（照软件默认跑）。
        # [EN] ★★ "Crew Agents" project-level customization (user request 2026-10-11):
        # [EN] · `_wizard_agents`: what the author **personally filled in** at that step (key -> what extra
        # [EN] this volume needs it to do);
        # [EN] · `_wizard_agents_ai`: those not filled in are **left to AI to infer from the type card / style
        # [EN] card**.
        # [EN] Both empty = this volume gets no Agent customization (runs on software defaults).
        self._wizard_agents: dict[str, str] = {}
        self._wizard_agents_ai: bool = True
        self._wizard_refresh_next = None
        # 正在跑的摄取任务（防止重复开卷）
        # [EN] The running ingest task (to prevent duplicate opens)
        self._ingest_state: dict | None = None

        # ── 运行会话（§七）：一次推演的起 / 停 / 暂停 / 继续 ──
        # 以前这一层是空的 —— `RunLoop` 根本没接进 GUI，所以运行界面的
        # 「暂停」「停止」只能是灰的（不许放点了没反应的死按钮）。
        self.session = None            # 当前 RunSession；未开始为 None
        self._pending_round: dict | None = None   # 已装配、还没起跑的那一轮（开场屏用）
        #: ★★ 起笔的**启动守卫**（2026-10-12）：`idle` / `starting`。
        #: 为什么不能只看 `self.session`：那一项要等装配完才建出来，而用户报的正是
        #: "装配那几秒里连点两次" —— 两次都看到 `None`，两次都放行。
        #: 配套还有 `_launch_token`（每趟启动领一个号，落地前对号）与
        #: `_launch_t0`（状态条上那个"已 N 秒"）。见 `_launch_arm`。
        # [EN] ★★ The **launch guard** for start-writing (2026-10-12): `idle` / `starting`.
        # [EN] Why `self.session` alone is not enough: it is not created until assembly finishes, and
        # [EN] what the user reported is exactly "clicking twice during those assembly seconds" -- both
        # [EN] clicks saw `None`, both were let through.
        # [EN] It comes with `_launch_token` (each launch takes a number and re-checks it before taking
        # [EN] over) and `_launch_t0` (the "N s elapsed" on the status bar). See `_launch_arm`.
        self._launch_phase: str = LAUNCH_IDLE
        self._launch_token: int = 0
        self._launch_t0: float = 0.0
        self._launch_fut = None        # 这一趟启动的 future（`page.run_task` 给的）
        #: 当前这一轮**属于哪一趟启动**（`_begin_run` 接管界面前拿它对号）。
        # [EN] Which launch the current round **belongs to** (`_begin_run` checks it before taking over
        # [EN] the UI).
        self._round_tok: int | None = None
        #: 「起笔」时算好的**从哪儿开始**（`sim/resume.plan()`，2026-10-08）。
        #: 存在这里是为了让对话框上那一块提示与真正开跑时的起点**同源** ——
        #: 分头各算一次的话，用户看到的和实际跑的可能不是同一件事。
        # [EN] -- Run session (§7): start / stop / pause / resume of one simulation run --
        # [EN] This layer used to be empty -- `RunLoop` was never wired into the GUI, so the run screen's
        # [EN] "Pause" "Stop" could only be grayed out (no dead buttons that do nothing when clicked).
        # [EN] Current RunSession; None if not started
        # [EN] The round that is assembled but hasn't started yet (used by the opening screen)
        # [EN] : The **where to start from** computed at "start writing" (`sim/resume.plan()`, 2026-10-08).
        # [EN] : Stored here so that the hint block in the dialog and the actual starting point when running
        # [EN] are **from the same source** --
        # [EN] : if computed separately, what the user sees and what actually runs might not be the same thing.
        self._pending_resume: dict | None = None
        #: ★ 作者对这轮走向的建议（「起笔」对话框那一栏，2026-10-11）——
        #:  装配时交给 `assemble(user_directive=…)`，**取一次就清**。
        # [EN] ★ Author's suggestion for this round's direction (the "Start Writing" dialog field, 2026-10-11)
        # [EN] ——
        # [EN] Passed to `assemble(user_directive=…)` at assembly time, **cleared once consumed**.
        self._pending_directive: str = ''
        #: 本轮攒下的叙事行，**四元** `(priority, text, kind, ts)`。
        #: ★★ 2026-10-11 加第 4 项 `ts` —— 每条左上角那行「真实时间 · 剧情时间」。
        #: 为什么加在**元组尾部**而不是换结构：`display/story_render` 那套
        #: （`group` / `join_text` / `_mk_para`）一律用 `len(row) > 2` 加 `row[2]`
        #: 的容错写法读它 —— 多一项**一个字都不用改**就兼容。
        #: 存量条目（读回的历史 / 加这个功能之前跑的）`ts` 是空串 ⇒ 不标时间。
        #: ⚠⚠ **这一列是「本轮所有内容」的唯一事实来源，绝不裁剪**。以前界面那侧
        #:   有**两处**偷偷丢内容（都在 `_on_narrative` 一带）：
        #:   ① `tail = self._live_lines[-200:]` —— 只渲染最近 200 条；
        #:   ② `if len(col.controls) > 400: del col.controls[:100]` —— 控件超 400
        #:      就把**最前面 100 个删掉**，而且**不同步 `_live_lines`**。
        #:   用户 2026-10-11：「我往前拉 有些信息在窗口看不见了 是不是会被吞掉一些东西？」
        #:   —— 是的，被吞了。现在两处都换成分页（见 `_page_slice`）。
        # [EN] Narrative lines accumulated this round, a **4-tuple** `(priority, text, kind, ts)`.
        # [EN] ★★ 2026-10-11 added the 4th item `ts` -- the "real time · story time" line at each
        # [EN] entry's top-left. Why appended at the **tail** instead of restructuring: the whole
        # [EN] `display/story_render` family (`group` / `join_text` / `_mk_para`) reads it with the
        # [EN] tolerant `len(row) > 2` plus `row[2]` form, so one extra item is compatible with **not a
        # [EN] single character changed**. Existing entries (history read back from disk / anything from
        # [EN] before this feature) have an empty `ts` ⇒ no time is shown.
        # [EN] ⚠⚠ **This list is the single source of truth for "everything in this round" and is never
        # [EN] trimmed.** The UI used to silently drop content in **two** places (both around
        # [EN] `_on_narrative`): (1) `tail = self._live_lines[-200:]` -- only the last 200 entries were
        # [EN] rendered; (2) `if len(col.controls) > 400: del col.controls[:100]` -- once widgets exceeded
        # [EN] 400 it deleted the **first 100**, and did **not** sync `_live_lines`. User 2026-10-11: "when
        # [EN] I scroll back, some information is no longer visible in the window -- is something being
        # [EN] swallowed?" -- yes, it was. Both places are now paging (see `_page_slice`).
        self._live_lines: list = []
        #: ★★ 中栏分页状态（2026-10-11）：**从最新一页往回数第几页**。
        #:   `0` = 最新（跟随新内容），`1` = 往前一页，`2` = 再往前一页……
        #:   用"往回数"而不是"绝对页号"，是因为页数会随着新内容不停增长 ——
        #:   绝对页号会让用户看着看着"页码自己变了"，而"往后翻退几页"永远是稳的。
        # [EN] ★★ Middle-column paging state (2026-10-11): **how many pages back from the newest**.
        # [EN] `0` = newest (following new content), `1` = one page back, `2` = two pages back…
        # [EN] Counting "from the newest" rather than using an absolute page number, because the page
        # [EN] count keeps growing as content arrives -- an absolute number would "change by itself"
        # [EN] while the user is reading, while "N pages back" is always stable.
        self._narr_back: int = 0
        #: 不在最新页时，攒下的**新条目数**（分页条上提示「有 N 条新内容」）。
        # [EN] While not on the newest page, the number of **new entries** accumulated (the pager shows
        # [EN] "N new items").
        self._narr_new: int = 0
        # ★★ **上一轮留下的正文**（续跑时中栏先渲染它，2026-10-11）。
        # [EN] Narrative lines accumulated this round (priority, text, kind)
        # [EN] ★★ **Main text left over from the previous round** (on resume the middle column renders it
        # [EN] first, 2026-10-11).
        # 用户原话：「运行界面 对话显示窗口也应该带着之前的记录 继续输出
        #   现在是会清空 然后重新开始的样子」。
        # [EN] User's exact words: "The run screen's dialog display window should also carry the previous
        # [EN] records and keep outputting
        # [EN] right now it clears and then looks like it starts over."
        # 查下来：`_start_round` 里一句 `self._live_lines = []` 把中栏清了，
        # 而起笔后立刻 `show_main_screen()` 重建界面 —— 于是屏幕上是空的，
        # 看着就像"重新开始了"（进度其实都在，停点一条不缺）。
        # [EN] Investigation: in `_start_round`, the line `self._live_lines = []` clears the middle column,
        # [EN] and right after starting writing `show_main_screen()` rebuilds the UI —— so the screen is empty,
        # [EN] which looks like "starting over" (the progress is all there, not a single stop point missing).
        # ⚠ 存的是**幕的数据**（scenes），不是渲染好的控件：
        #   控件只能挂在一棵树上，`show_main_screen()` 每次重建都要**重新渲染**
        #   一份新的，缓存控件会在第二次重建时炸（"已在树上"）。
        # [EN] ⚠ What is stored is the **scene data** (scenes), not rendered widgets:
        # [EN] a widget can only hang on one tree, and `show_main_screen()` re-renders a **fresh** one
        # [EN] on every rebuild; a cached widget will blow up on the second rebuild ("already on the tree").
        self._prev_scenes: list = []
        #: 上一轮是第几天（中栏那条分界要写"以上是第 N 天"）。0 = 没有。
        # [EN] : Which day the previous round was (the middle column's divider must say "above is day N"). 0 =
        # [EN] none.
        self._prev_day: int = 0
        #: ★ **本轮第几天之内该显示那段历史**（起笔时 = 当时的天数）。
        # [EN] : ★ **Within which day of this round that history should be shown** (at start-writing = the day
        # [EN] count at that time).
        #: ⚠ 为什么不能只看 `_prev_day`：跨天（`next_day`）时本轮从第 2 天起、
        #   上一轮演完的是第 1 天 —— 按"`world.game_day > _prev_day` 就别显示"
        #   判，跨天续跑**一进来就看不到历史**（而那正是最需要看的时候）。
        #   改判"**还在起笔那一天之内**"：跨到下一日自然就不显示了。
        # [EN] : ⚠ Why we can't just look at `_prev_day`: when crossing days (`next_day`) this round starts
        # [EN] from day 2,
        # [EN] while the previous round finished day 1 —— judged by "`world.game_day > _prev_day` → don't show"
        # [EN] a cross-day resume **shows no history the moment it comes in** (and that's exactly when you most
        # [EN] need to see it).
        # [EN] Changed the check to "**still within the day the writing started**": once it crosses to the next
        # [EN] day it naturally stops showing.
        self._prev_for_day: int = 0
        self._ui_run: dict = {}        # 运行界面的控件句柄（状态刷新时用）
        self._ui_help: dict = {}       # 帮助「问个问题」的句柄（验证脚本用）
        # 小地图（矢量，2026-10-06）：**当天的图**（美术按当天剧情画的）+
        # 每次切场景重画。⚠ 2026-10-08 起**不再有"全书布局"这一层** ——
        # 见 `_reset_map_state()` 与 `_draw_minimap()`。
        self._map_layout = None        # **已废弃**（全书布局不再上屏，见 `_reset_map_state`）
        self._map_local = None         # **已废弃**（同上；`local_view` 不再上屏）
        self._map_day = None           # **当天地图**：剧组美术按今天的戏画的
        #: 上一次**已经画上屏**的那张当天地图（比对象身份用）。
        #: 秒表拿它做兜底：主循环那边要是漏了重画通知，图变了这里也能补上
        #: （见 `_sync_day_map` —— 2026-10-08 用户报「小地图一直没画」的根因）。
        # [EN] Run screen's widget handle (used for status refresh)
        # [EN] Help "Ask a question" handle (used by validation scripts)
        # [EN] Minimap (vector, 2026-10-06): **that day's map** (drawn by art per that day's story) +
        # [EN] redrawn on every scene switch. ⚠ As of 2026-10-08 there is **no longer a "whole-book layout"
        # [EN] layer** ——
        # [EN] see `_reset_map_state()` and `_draw_minimap()`.
        # [EN] **Deprecated** (whole-book layout no longer goes on screen, see `_reset_map_state`)
        # [EN] **Deprecated** (same as above; `local_view` no longer goes on screen)
        # [EN] **Today's map**: drawn by the crew's art per today's play
        # [EN] : The last today's map that was **already drawn on screen** (used by object identity
        # [EN] comparison).
        # [EN] : The stopwatch uses it as a fallback: if the main loop misses the redraw notification, this
        # [EN] catches the change too
        # [EN] : (see `_sync_day_map` —— the root cause of the user's 2026-10-08 report "the minimap was never
        # [EN] drawn").
        self._map_day_seen = None
        self._map_here = ''            # 当前地点（图上那个朱砂点）
        self._map_cast: dict[str, str] = {}   # {人名: 地点名}
        self._map_people: list = []    # 在场人名
        self._map_world = None         # 当前这一轮的世界（取人物位置用）
        self._ui_saves: dict = {}      # 拾卷三栏的滚动条句柄（验证脚本用）
        self._ui_msgs: dict = {}       # 消息列表的滚动条句柄（验证脚本用）
        # 用户是否亲手按过 F11 切换全屏。按过之后 `_ensure_maximized` 就
        # **不再自动全屏** —— 否则他刚退出来、两秒后又被按回去（见那个方法）。
        # [EN] Current location (the cinnabar dot on the map)
        # [EN] {person name: location name}
        # [EN] Names of people present
        # [EN] The world of the current round (used to get character positions)
        # [EN] Scrollbar handle of the three-column reading view (used by validation scripts)
        # [EN] Scrollbar handle of the message list (used by validation scripts)
        # [EN] Whether the user personally pressed F11 to toggle fullscreen. After pressing it
        # [EN] `_ensure_maximized`
        # [EN] **no longer auto-fullscreens** —— otherwise he'd just exit it and two seconds later be forced
        # [EN] back (see that method).
        self._user_toggled_fullscreen: bool = False

        # ── 底部状态条（`_mk_run_status_bar`）的两样东西 ──
        #   · `_run_status_key` —— 主循环报来的细粒度状态（deciding / idle …）
        #   · `_run_status_at`  —— **那个状态是什么时候开始的**（秒表起点）
        # ⚠ 这两个必须**在建实例时就初始化**。秒表算的是 `time.time() - _run_status_at`，
        #   没有初值就取到 0 → "未运行"时屏幕上是「已 1791256630 秒」
        #   （用户 2026-10-06 问"里面的内容对吗，特别是时间信息"，就是这条）。
        # [EN] ── Two things in the bottom status bar (`_mk_run_status_bar`) ──
        # [EN] · `_run_status_key` —— fine-grained status reported by the main loop (deciding / idle …)
        # [EN] · `_run_status_at`  —— **when that status started** (stopwatch start point)
        # [EN] ⚠ These two must be **initialized at instance construction**. The stopwatch computes
        # [EN] `time.time() - _run_status_at`,
        # [EN] with no initial value it gets 0 → when "not running" the screen shows "1791256630 seconds
        # [EN] elapsed"
        # [EN] (the user's 2026-10-06 question "is the content inside right, especially the time info" was this
        # [EN] one).
        self._run_status_key = 'idle'
        self._run_status_at = time.time()
        self._status_task = None       # 秒表的定时任务（开跑时启动，见 `_start_status_ticker`）
        # [EN] The stopwatch's timer task (started when running begins, see `_start_status_ticker`)

        # ── 全局消息（状态栏那块「消息」显示框的数据源）──
        # 以前所有提示都走 SnackBar：冒一下、几秒后消失、不留痕。
        # 像「LLM 配置与模型不符，已自动改回，需重启生效」这种**必须让人看见、
        # 而且可能过一会儿才回来处理**的消息，靠看一眼是留不住的，
        # 所以统一收进这里，界面上固定一块地方显示，随时能翻。
        # [EN] ── Global messages (data source of the status bar's "Messages" display box) ──
        # [EN] Previously all prompts went through SnackBar: flash once, disappear after a few seconds, leave
        # [EN] no trace.
        # [EN] Messages like "LLM config doesn't match the model, auto-reverted, restart required" that **must
        # [EN] be seen
        # [EN] and may only be handled later** can't be kept by one glance,
        # [EN] so they're collected here, shown in a fixed area of the UI, browseable anytime.
        # ★★ 2026-10-09：**跨启动保留**（用户报的「关闭再启动就没了」）。
        #    这些消息的价值**全在"回来再处理"**上 —— 一次运行内看完就丢，
        #    等于把它们降级成了 SnackBar。现在落盘到 `.nws_messages.jsonl`
        #    （一行一条、只追加），启动时读回来；**只有用户点「清空」才消失**。
        # [EN] ★★ 2026-10-09: **persisted across launches** (user reported "it's gone after closing and
        # [EN] relaunching").
        # [EN] The value of these messages is **entirely in "come back and handle later"** —— if read and
        # [EN] discarded within one run,
        # [EN] they'd be downgraded to SnackBars. Now they're persisted to `.nws_messages.jsonl`
        # [EN] (one per line, append-only), read back at startup; **they only disappear when the user clicks
        # [EN] "Clear"**.
        self._messages: list[dict] = load_messages()
        self._ui_msg: dict = {}        # 消息框的控件句柄（原地刷新用）
        self._msg_unread: int = 0      # 从上次打开消息列表以来新增的条数
        # 「没配模型」时**自动**打开的演示模式，是不是我开的。
        # 用来在用户配好模型、点保存时**自动关回去**（见 show_global_settings）——
        # 不然他会一直跑假数据，却以为自己配好了。
        # [EN] Message box widget handle (used for in-place refresh)
        # [EN] Count of new entries since the message list was last opened
        # [EN] Whether the demo mode **auto**-opened when "no model configured" was opened by me.
        # [EN] Used to **auto-close it back** when the user configures a model and clicks save (see
        # [EN] show_global_settings) ——
        # [EN] otherwise he'd keep running on fake data while thinking he's configured correctly.
        self._mock_auto_on: bool = False

    def main(self, page: ft.Page):
        """Flet 入口。
                English:
        Flet entry point.
        """
        self.page = page
        # 标题里带上**界面源码的改动时间** —— 一眼看出这个窗口是不是最新的
        # [EN] Include the **UI source code's modification time** in the title —— at a glance see whether this
        # [EN] window is the latest
        page.title = window_title()

        # 窗口：启动即**最大化**（铺满工作区，标题栏和任务栏都留着）
        # [EN] Window: **maximized** on launch (fills the work area, title bar and taskbar both kept)
        # ⚠ 这里有两个开关，**别搞混**（2026-10-06 为此来回改过一次）：
        #   · `maximized=True`   → 铺满工作区，**标题栏与任务栏都在** ← **默认就是这个**
        #   · `full_screen=True` → 真全屏，整个屏幕都归它，任务栏被盖住
        #     ← **不默认开**，交给用户按 **F11** 自己切
        # 用户的原话（第一次问 + 后来的更正）：
        #   「为何默认不全屏了？」→「我是说你刚才默认没有全屏，而我希望默认打开全屏才对」
        #   →「我可能有的地方说错了 我是想默认最大化 不是默认全屏把屏幕都占满」
        # 所以：**默认最大化**；全屏是可选项，按 F11 进/出。
        # 退出全屏之后会回到最大化（见 `_on_keyboard`），不会掉成小窗。
        # [EN] ⚠ There are two switches here, **don't mix them up** (2026-10-06 went back and forth on this
        # [EN] once):
        # [EN] · `maximized=True` → fills the work area, **title bar and taskbar both present** ← **this is the
        # [EN] default**
        # [EN] · `full_screen=True` → true fullscreen, the whole screen is its, taskbar covered
        # [EN] ← **not on by default**, left to the user to toggle with **F11**
        # [EN] User's exact words (first question + later correction):
        # [EN] "Why is it no longer fullscreen by default?" → "I mean you just defaulted to not fullscreen, but
        # [EN] I want it to open fullscreen by default"
        # [EN] → "I may have said some things wrong I want maximized by default, not fullscreen covering the
        # [EN] whole screen"
        # [EN] So: **maximized by default**; fullscreen is optional, F11 to enter/exit.
        # [EN] After exiting fullscreen it returns to maximized (see `_on_keyboard`), won't drop to a small
        # [EN] window.
        w = page.window
        w.width = 1440          # 兜底尺寸：万一平台不给最大化
        # [EN] Fallback size: in case the platform doesn't grant maximization
        w.height = 900
        w.min_width = 1024
        w.min_height = 700
        w.maximized = True
        page.bgcolor = C['bg']

        # ★ 注册随程序附带的三套字体（思源宋体 / 思源黑体 / 霞鹜文楷，都是 SIL OFL 1.1
        #   —— 可商用、可嵌入）。**必须在建任何控件之前**：`page.fonts` 是页面级的
        #   字体注册表，控件创建那一下就去查表了。三份**全部注册**（不是只注册当前
        #   选中的那份）—— 用户在「天机 · 界面外观」里换字体时要能立刻生效。
        #   缺文件时 `bundled_font_files()` 里就没有那一项，`resolve_ui_font()` 也会
        #   回落到系统字体 —— 少一个字体文件不会崩
        #   （用户自己把字体丢进 `assets/fonts/` 就能生效）。
        # [EN] ★ Register the three fonts bundled with the program (Noto Serif SC / Noto Sans SC / LXGW
        # [EN] WenKai, all SIL OFL 1.1 —— commercially usable, embeddable).
        # [EN] **Must be before creating any controls**: `page.fonts` is the page-level font registry,
        # [EN] and controls look up the table the moment they are created. Register **all three** (not
        # [EN] just the currently selected one) —— switching fonts in "Tianji · UI appearance" must take
        # [EN] effect immediately.
        # [EN] When a file is missing that entry is simply absent from `bundled_font_files()`, and
        # [EN] `resolve_ui_font()` falls back to a system font —— missing one font file won't crash
        # [EN] (users can drop their own font into `assets/fonts/` to make it take effect).
        try:
            _fonts = bundled_font_files()
            if _fonts:
                page.fonts = _fonts
                get_logger('nws.ui').info(
                    '已注册随附字体 / Bundled fonts registered: %s', '、'.join(_fonts))
        except Exception:                                     # noqa: BLE001
            log_exception(t("注册字体失败"), category="ui")

        page.theme = ft.Theme(
            color_scheme_seed=C['gold'],
            font_family=UI_FONT,
            # 滚动条调细一档。默认连轨道约 18~20px，压在选项卡右侧很扎眼；
            # 8px 的细条配上 `TAB_GUTTER` 的 24px 车道，既看得见、又不压控件。
            # （判据见 `developers/measure_controls.py` 的「车道 ≥ 24px」一条。）
            # [EN] Make the scrollbar one notch thinner. By default including the track it's about 18~20px, which
            # [EN] is glaring pressed against the right side of the tab;
            # [EN] an 8px thin bar paired with `TAB_GUTTER`'s 24px lane is both visible and doesn't press on
            # [EN] controls.
            # [EN] (For the criterion see the "lane >= 24px" item in `developers/measure_controls.py`.)
            # ⚠ **别在这里加 `thumb_visibility=True`**（2026-10-06 试过了，无效）：
            #   Flutter 的滚动条默认 `thumbVisibility: false` —— 只在拖动时现身。
            #   这个构建里，无论把开关放在**主题**上还是控件上
            # [EN] ⚠ **Don't add `thumb_visibility=True` here** (tried it on 2026-10-06, no effect):
            # [EN] Flutter's scrollbar defaults to `thumbVisibility: false` —— it only shows up while dragging.
            # [EN] In this build, no matter whether the switch is put on the **theme** or on the control
            #   （`ListView(scroll=ft.Scrollbar(thumb_visibility=True,…))`），
            #   客户端都不理会（`developers/probe_help_scrollbar.py` 把车道里的
            #   像素逐列数过：`thickness` 从 8 调到 40，车道里始终是空的）。
            #   所以"常驻可见的滚动条"是**自己画的** —— 见 `App._scroll_bar()`。
            #   留着这个开关只会让人以为它在起作用（本项目最忌讳的"假旋钮"）。
            # [EN] the client ignores it (`developers/probe_help_scrollbar.py` counted the pixels in the lane
            # [EN] column by column: with `thickness` adjusted from 8 to 40, the lane was always empty).
            # [EN] So the "always-visible scrollbar" is **self-drawn** —— see `App._scroll_bar()`.
            # [EN] Keeping this switch only makes people think it works (the "fake knob" this project hates most).
            scrollbar_theme=ft.ScrollbarTheme(
                thickness=8, radius=4, cross_axis_margin=0),
        )

        # 窗口图标（水墨风）：Flet 侧用 assets 相对路径
        # [EN] Window icon (ink-wash style): on the Flet side use the assets relative path
        try:
            rel = get_window_icon_rel()
            if rel:
                page.window.icon = rel
        except Exception:
            log_exception(t("设置窗口图标失败"), category="ui")

        # 全局错误捕获 → 写入日志
        # [EN] Global error capture → write to log
        def on_error(e):
            msg = getattr(e, "data", None) or str(e)
            log_exception(f"UI 运行期错误: {msg}", category="ui")

        page.on_error = on_error

        # ★★ **关窗口也要落一次盘**（2026-10-08 用户原话：「平时也有可能随时
        #    关闭软件」）。用 `on_disconnect` 而不是 `on_close`：
        #      · `on_disconnect` 是**连接断了**（用户真的把窗口关掉 / 进程被杀）；
        #      · `on_close` 是"关闭请求"，某些平台点关闭后还能取消。
        #    落盘要的是"真的走了"那一刻。
        # [EN] ★★ **Closing the window must also flush to disk once** (user's exact words on 2026-10-08:
        # [EN] "normally it might also be at any time
        # [EN] close the software"). Use `on_disconnect` instead of `on_close`:
        # [EN] · `on_disconnect` means **the connection dropped** (the user really closed the window / the
        # [EN] process was killed);
        # [EN] · `on_close` is a "close request", and on some platforms it can still be cancelled after
        # [EN] clicking close.
        # [EN] Flushing to disk wants the moment of "really gone".
        # ⚠ 两件事必须做到：
        #   ① **不能覆盖别人已经设的钩子**（将来有人也要在断开时做事）——
        #      所以先取旧值、在回调里链式调用；
        #   ② **同步落盘**（`_stop_autosave` 里是同步的文件写，不进事件循环）——
        #      断开之后事件循环随时会停，`await` 排队的活干不完。
        # [EN] ⚠ Two things must be done:
        # [EN] ① **Don't overwrite a hook someone else already set** (in the future someone may also need to do
        # [EN] things on disconnect) ——
        # [EN] so first grab the old value, and chain-call inside the callback;
        # [EN] ② **Flush to disk synchronously** (`_stop_autosave` does synchronous file writes, doesn't enter
        # [EN] the event loop) ——
        # [EN] after disconnect the event loop can stop at any time, and queued `await` work won't get done.
        _old_disconnect = getattr(page, 'on_disconnect', None)

        def on_disconnect(e=None):
            try:
                self._stop_autosave()          # 先补落一次，再收掉定时器
                # [EN] First do an extra flush, then shut down the timer
            except Exception:                                  # noqa: BLE001
                log_exception(t('关窗口前的自动落盘失败'), category='ui')
            if callable(_old_disconnect):
                try:
                    _old_disconnect(e)
                except Exception:                              # noqa: BLE001
                    pass
            # ★★ 2026-10-10：**主窗口退出 ⇒ 创作服务也跟着退出**
            #    （用户原话：「必须主窗口退出的时候后台服务也跟着退出」）。
            #    那一刀的主路在启动器（`launchers/flow.go` 拉完主程序、等它退出、
            #    再调 `novelservice.py stop`）；这里是**第二条路**，
            #    管的是"不经启动器直接跑 main_gui.py"的情形。
            #    ⚠ 三个要点：
            #      ① 必须**甩出去就不等**（`stop_service_detached`）——
            #         此刻事件循环随时会停、下面那个看门狗 5 秒后强制 `os._exit`，
            #         同步等 `taskkill`（最坏 10 秒）根本等不到；
            #      ② 开关是 `MUMU_FOLLOW_APP`（天机里那个勾），
            #         与启动器读的是**同一个键、同一个默认值**，不然两边会各说各话；
            #      ③ 失败**只记日志**：用户已经在关程序了，这时候弹什么都来不及看，
            #         而且它本来就是个"顺手收拾"，不是退出流程的必要条件。
            # [EN] ★★ 2026-10-10: **Main window exits ⇒ the creation service exits too**
            # [EN] (user's exact words: "the background service must also exit when the main window exits").
            # [EN] The main path for that cut is in the launcher (`launchers/flow.go` pulls up the main program,
            # [EN] waits for it to exit,
            # [EN] then calls `novelservice.py stop`); this is **the second path**,
            # [EN] handling the case of "running main_gui.py directly without going through the launcher".
            # [EN] ⚠ Three key points:
            # [EN] ① Must **throw it out and not wait** (`stop_service_detached`) ——
            # [EN] at this moment the event loop can stop at any time, and the watchdog below force-`os._exit`s
            # [EN] after 5 seconds,
            # [EN] synchronously waiting for `taskkill` (worst case 10 seconds) simply won't make it;
            # [EN] ② The switch is `MUMU_FOLLOW_APP` (the checkbox in Tianji),
            # [EN] and the launcher reads **the same key, the same default value**, otherwise the two sides will
            # [EN] say different things;
            # [EN] ③ On failure **only log**: the user is already closing the program, and anything popped up at
            # [EN] this point is too late to read,
            # [EN] and it's just a "cleanup while we're at it" anyway, not a necessary condition of the exit flow.
            try:
                if CFG.b('MUMU_FOLLOW_APP'):
                    from novelservices import mumu_bridge as _BRX
                    _BRX.stop_service_detached()
            except Exception:                                  # noqa: BLE001
                log_exception(t('关窗口时停创作服务失败'), category='ui')
            # ★★ 2026-10-10：**上最后一道闸**（用户报的第 4 条：退出之后
            #    "总是有一个控制台窗口在而且不退出"）。
            #    原因见 `util.flet_shutdown.arm_exit_watchdog` 的注释：
            #    `asyncio.to_thread` 用的是**默认线程池**，线程非守护、
            #    退出时被 join —— 只要有一个后台调用没回来（最典型的是
            #    「自动拉起创作服务」那次 `start_service(timeout=600)`），
            #    `python.exe` 就永远不退出，于是启动器那句"起主程序"
            #    一直没返回、**cmd 窗口就一直留着**。
            #    这一句是**兜底**，不是主要退出路径：正常收尾在几毫秒内就
            #    走完了，看门狗跟着进程一起消失，用户什么都察觉不到。
            # [EN] ★★ 2026-10-10: **Put up the last gate** (the user's reported issue #4: after exiting
            # [EN] "there's always a console window present and it doesn't exit").
            # [EN] For the cause see the comment on `util.flet_shutdown.arm_exit_watchdog`:
            # [EN] `asyncio.to_thread` uses the **default thread pool**, the threads are non-daemon,
            # [EN] and get joined at exit —— as long as one background call hasn't returned (the most typical being
            # [EN] that `start_service(timeout=600)` from "automatically pulling up the creation service"),
            # [EN] `python.exe` never exits, so the launcher's line "start the main program"
            # [EN] never returns, and **the cmd window just stays there**.
            # [EN] This line is a **fallback**, not the main exit path: normal cleanup finishes within a few
            # [EN] milliseconds,
            # [EN] the watchdog disappears along with the process, and the user notices nothing.
            try:
                arm_exit_watchdog()
            except Exception:                                  # noqa: BLE001
                pass

        page.on_disconnect = on_disconnect

        # 全局快捷键（F11 切换全屏）
        # [EN] Global hotkey (F11 toggles fullscreen)
        page.on_keyboard_event = self._on_keyboard

        apply_ui_opacity()      # 按 .env 的 UI_OPACITY 重算面板 alpha
        # ⚠ 顺序：**先**看有没有模型（没配就把 MOCK 打开并说清楚），
        #   再校验能力 —— 能力校验里那句「演示模式（MOCK_LLM）：不联网」
        #   要按最终状态说，反了就报错。
        # [EN] Recompute panel alpha according to .env's UI_OPACITY
        # [EN] ⚠ Order: **first** check whether there's a model (if not configured, turn on MOCK and explain
        # [EN] clearly),
        # [EN] then validate capabilities —— the line in capability validation that says "demo mode (MOCK_LLM):
        # [EN] no network"
        # [EN] must be stated according to the final state, otherwise it reports wrongly.
        self._run_llm_readiness_check()
        self._run_capability_check()    # 启动时校验 LLM 能力（可能改回 .env）
        self._maybe_autostart_service()  # 按开关在后台拉起「创作服务」（不弹窗）
        # [EN] Validate LLM capabilities at startup (may change back to .env)
        # [EN] Pull up the "creation service" in the background according to the switch (no popup)
        self.show_start_screen()
        # ★ 完全没配 LLM 时**弹一个对话框**（用户 2026-10-06 要的）。
        #   为什么不是只发一条消息：第一次上手的人**不知道去哪里配**，
        #   而消息框是常驻的、不解释下一步。这里给两条明确的出路
        #   （去配置 / 以后再说），并指到使用说明里"怎么申请 Key"那一节。
        # [EN] ★ When no LLM is configured at all, **pop up a dialog** (what the user asked for on 2026-10-06).
        # [EN] Why not just send one message: first-time users **don't know where to configure it**,
        # [EN] and the message box is persistent and doesn't explain the next step. Here give two clear ways
        # [EN] out
        # [EN] (go configure / do it later), and point to the "how to apply for a Key" section in the usage
        # [EN] instructions.
        self._maybe_show_llm_setup_dialog()
        self._ensure_maximized()
        self._apply_window_icon()

    def _run_llm_readiness_check(self) -> None:
        """启动时看一眼「到底配了模型没有」。没配就把话说透。

        用户 2026-10-06 的要求：「默认打开如果没配置模型，会提示只提供假数据和
        模拟运行」。为什么必须**同时**提示 + 真的降级：

        * 只提示不改行为 -> 每个 LLM 调用都会抛异常、被上层吞成"人物不出声"，
          屏幕上却写着"未配置模型"—— 一句正确的提示配上一屏看不懂的现象。
        * 只改行为不提示 -> 用户看到满屏假数据，以为自己配的模型坏了。

        ⚠ **只在内存里改 `MOCK_LLM`，不写 `.env`**：这是"本次运行没有可用的
        AI"，不是用户的配置决定。配好之后由保存那一步自动收回（见
        `show_global_settings.save` 里的 `_mock_auto_on`）。
        
                English:
        At startup, check "whether a model is configured at all". If not, spell it out clearly.
                User's 2026-10-06 request: "By default, if no model is configured on open, it will prompt that only fake data and
                simulated runs are provided". Why we must **both** prompt + actually degrade:
                * Prompt only without changing behavior -> every LLM call throws an exception, swallowed by the upper layer into "the character doesn't speak",
                  yet the screen says "model not configured" —— a correct prompt paired with a screen of incomprehensible behavior.
                * Change behavior only without prompting -> the user sees a screen full of fake data and thinks the model they configured is broken.
                ⚠ **Only change `MOCK_LLM` in memory, do not write `.env`**: this is "no usable
                AI for this run", not a user configuration decision. Once configured, it's automatically retracted by the save step (see
                `_mock_auto_on` in `show_global_settings.save`).
        """
        try:
            ready, why = probe.llm_ready()
        except Exception:                                   # noqa: BLE001
            log_exception(t('LLM 配置检查失败'), category='config')
            return
        if ready:
            return
        if not CFG.b('MOCK_LLM'):
            CFG.set('MOCK_LLM', 'true')
            self._mock_auto_on = True
        self._post_message(probe.missing_model_notice(why), level='warn', keep=True)

    def _maybe_show_llm_setup_dialog(self) -> None:
        """完全没配 LLM → 第一次上手就弹对话框，把人引到「天机 · 推演服务LLM设定」。

        用户 2026-10-06 的原话：「一开始如果一个完全空的软件，用户第一次跑，
        没配置 LLM，程序会弹出一个提示信息，告诉用户 LLM 还没配，无法进行有效推演，
        告诉用户去使用说明里找如何申请 LLM API Key……点了就会打开天机的 LLM
        接入对话框，点击取消或者关闭对话框则后续再回来」。

        三条判据（都是刻意的）：
          ① **`llm_ready()` 说配好了就不弹** —— 不打扰已经在用的人；
          ② **用户自己选了「演示模式」就不弹** —— 那是他的明确选择，不是"没配"；
             判断依据是 `_mock_auto_on`（程序替他在内存里打开的才算"没配"）；
          ③ 关掉之后**下次启动还会来** —— "点击取消或者关闭对话框则后续再回来"。
             （不做"不再提示"的复选框：一个连模型都没配的程序，
              提示一次就永远闭嘴才是真的坑人。）
        
                English:
        No LLM configured at all → on first use pop up a dialog guiding the user to "Tianji · Inference
        Service LLM Settings".
                User's 2026-10-06 exact words: "At the start, if a completely empty piece of software, the user runs it for the first time,
                with no LLM configured, the program will pop up a prompt telling the user the LLM isn't configured yet and effective inference cannot proceed,
                Tell the user to look in the instructions for how to apply for an LLM API Key... clicking it will open Tianji's LLM
                access dialog; if the user clicks cancel or closes the dialog, come back again later".
                Three criteria (all intentional):
                  ① **If `llm_ready()` says it's configured, don't pop up** -- don't disturb people who are already using it;
                  ② **If the user chose "demo mode" themselves, don't pop up** -- that's their explicit choice, not "unconfigured";
                     the basis is `_mock_auto_on` (only what the program turned on for them in memory counts as "unconfigured");
                  ③ After closing it, **it will come again next startup** -- "if the user clicks cancel or closes the dialog, come back again later".
                     (No "don't show again" checkbox: for a program that hasn't even configured a model,
                      shutting up forever after one prompt is what really screws people over.)
        """
        page = self.page
        if page is None:
            return
        try:
            ready, why = probe.llm_ready()
        except Exception:                                       # noqa: BLE001
            log_exception(t("LLM 配置检查失败"), category='config')
            return
        if ready:
            return
        # 用户自己开着演示模式 → 他知道自己在干什么，别烦他
        # [EN] The user has demo mode on themselves → they know what they're doing, don't bother them
        if CFG.b('MOCK_LLM') and not getattr(self, '_mock_auto_on', False):
            return

        body = ft.Column([
            mk_text(t("这一轮还**没有可用的模型接口**，所以推演跑不起来。"),
                    size=BODY_FS, color=C['text']),
            ft.Divider(height=10, color='transparent'),
            mk_text(t("现在能做什么：程序可以正常打开，也能翻看设定与文档；"
                      "但人物不会真的思考 —— 出来的东西是**内置的演示语料**，"
                      "不是你的故事。"),
                    size=HINT_FS, color=C['muted']),
            ft.Divider(height=8, color='transparent'),
            ft.Text(t("缺什么：{why}", why=why or t("（没说清）")),
                    size=HINT_FS, color=C['muted']),
            ft.Divider(height=12, color='transparent'),
            ft.Container(
                content=ft.Text(
                    t("怎么申请 API Key、怎么填进来：看使用说明的"
                      "「2.4 API Key 获取」与「3.4 怎么把 Key 配进来」两节"
                      "（README 旁边的 `使用说明.md`），里面按厂商列了网址与步骤 —— "
                      "DeepSeek / OpenAI / Claude / Google / 微软 / 智谱 GLM / "
                      "通义千问 / MiniMax 等都有。"),
                    size=HINT_FS, color=C['muted']),
                width=SET_W),
            ft.Divider(height=8, color='transparent'),
            ft.Text(t("点「去配置」直接打开「天机 · 推演服务LLM设定」；"
                      "点「以后再说」就这样先用着，下次启动还会提醒你。"),
                    size=HINT_FS, color=C['muted']),
        # ⚠ `scroll` 是**兜底**：写死高度一定会有人字号放大 / 文案变长的时候，
        #   裁掉最后一段"下次还会提醒你"是最糟的（那句话是给用户的安全感）。
        #   滚动条画在 `Column` 右边缘、`DLG_W - SET_W = 80px` 的车道里。
        # [EN] ⚠ `scroll` is a **fallback**: a hardcoded height will definitely break someday when someone
        # [EN] enlarges the font / the text gets longer,
        # [EN] cutting off the last paragraph "we'll remind you next time" is the worst (that line is the sense
        # [EN] of safety for the user).
        # [EN] The scrollbar is drawn on the right edge of the `Column`, in the `DLG_W - SET_W = 80px` lane.
        ], spacing=2, tight=True, width=SET_W, scroll=ft.ScrollMode.ADAPTIVE)

        def _go(e):
            page.pop_dialog()
            # `self.TAB_LLM` = 推演服务LLM设定（见那个常量的说明：加了「常规」之后
            # 它**不是**第一个了，写死 1 会落到「常规」页上）。
            # [EN] `self.TAB_LLM` = inference service LLM settings (see the note on that constant: after adding
            # [EN] "General"
            # [EN] it's **not** the first one anymore, hardcoding 1 will land on the "General" page).
            self.show_global_settings(tab=self.TAB_LLM)

        def _later(e):
            page.pop_dialog()

        dlg = mk_dialog(
            t("还没有配置 LLM"),
            ft.Container(content=body, width=DLG_W, height=DLG_H_LLM_NOTICE),
            [
                mk_btn(t("去配置"), _go, primary=True),
                mk_btn(t("以后再说"), _later),
            ],
        )
        try:
            page.pop_dialog()          # 先清掉可能挂在屏上的旧帧（本项目的坑）
            # [EN] First clear out old frames that may be hanging on screen (a pitfall of this project)
        except Exception:                                       # noqa: BLE001
            pass
        page.show_dialog(dlg)
        # 同时留一条常驻消息：对话框关掉之后，这条还在「消息」里
        # [EN] At the same time leave a persistent message: after the dialog is closed, this one is still in
        # [EN] "Messages"
        self._post_message(
            t("还没有配置 LLM：当前只有演示数据与模拟运行。"
              "去「天机 · 推演服务LLM设定」填 API Key 与 Base URL，"
              "申请办法见使用说明「2.4 API Key 获取」。"),
            level='warn', keep=True)

    def _maybe_autostart_service(self) -> None:
        """按 `MUMU_AUTOSTART` 在后台把「创作服务」拉起来（**无窗口、不冻界面**）。

        ★★ 2026-10-10 补：这个开关**以前是个假旋钮** —— 界面上有、说明里写着
          「程序启动时自动拉起服务」，但全项目 `grep` 下来**只有写、没有读**
          （启动器里那段是另一回事：它不看这个开关）。
          按本项目"对假按钮零容忍"的规矩，要么删掉、要么做实 —— 这里做实。

        三条约束：
          · 只在**总开关 + 本开关都开**时才拉（默认就都是开，行为与以前一致）；
          · 起服务最坏要等几分钟（首次下模型），所以 **`asyncio.to_thread`** ——
            界面绝不冻住；而且**结果回到事件循环里再发消息**（`_post_message`
            会碰界面，从线程里直接调是本项目踩过的坑）；
          · 无论成败**只留一条消息**、不弹窗 —— 启动时弹窗拦人是打扰。
        
                English:
        Use `MUMU_AUTOSTART` to pull up the "creation service" in the background (**no window, doesn't
        freeze the UI**).
                ★★ 2026-10-10 addendum: this switch **used to be a fake knob** -- it was in the UI, and the docs said
                  "automatically start the service on program startup", but a full-project `grep` found **only writes, no reads**
                  (the part in the launcher is a different matter: it doesn't look at this switch).
                  Per this project's rule of "zero tolerance for fake buttons", either delete it or make it real -- here we make it real.
                Three constraints:
                  · Only pull it when **both the master switch and this switch are on** (both default to on, so behavior matches before);
                  · Starting the service can take several minutes in the worst case (first-time model download), so use **`asyncio.to_thread`** --
                    the UI must never freeze; and **post the result back in the event loop before sending messages** (`_post_message`
                    touches the UI; calling it directly from a thread is a pit this project has stepped in before);
                  · Regardless of success or failure, **keep only one message**, no popup -- blocking people with a popup at startup is disturbing.
        """
        if not (CFG.b('MUMU_ENABLED') and CFG.b('MUMU_AUTOSTART')):
            return

        async def _boot():
            try:
                from novelservices import mumu_bridge as BR
            except Exception:                              # noqa: BLE001
                return                                     # 没装/被删了，静默跳过
                # [EN] Not installed/deleted, silently skip
            try:
                st = await asyncio.to_thread(BR.service_status, timeout=2.0)
                if st.ok:
                    return                  # 已经在跑（别再起一遍）
                    # [EN] Already running (don't start another one)
                okk, why = await asyncio.to_thread(BR.start_service, timeout=600.0)
            except Exception as e:                          # noqa: BLE001
                log_exception(t('自动拉起创作服务失败'), category='ui')
                self._post_message(t('自动拉起创作服务失败：{e}', e=repr(e)[:120]),
                                   level='warn')
                return
            if okk:
                self._post_message(t('创作服务已自动拉起（MuMuAINovel）'),
                                   level='info', keep=True)
            else:
                self._post_message(
                    t('创作服务没拉起来：{why}（小说作家会退回自写，不影响推演）',
                      why=why), level='warn')

        self.page.run_task(_boot)

    def _run_capability_check(self) -> None:
        """启动时校验 LLM 能力配置是否与模型名相符。

        不符就**按模型特性改回 `.env`**（用户不必记住哪个模型支持什么），
        改了什么、依据是哪个模型、为什么需要重启 —— 全部写进全局消息框。
        这里只播报，不弹对话框：启动时弹窗拦人是打扰，而消息框是常驻的。
        
                English:
        On startup, validate whether the LLM capability config matches the model name.
                If it doesn't match, **change it back in `.env` according to the model's characteristics** (users shouldn't have to remember which model supports what);
                what was changed, which model it was based on, and why a restart is needed -- all written to the global message box.
                Here it only reports, no dialog popup: blocking people with a popup at startup is disturbing, while the message box is persistent.
        """
        try:
            rep = check_capabilities()
        except Exception:                                   # noqa: BLE001
            log_exception(t('LLM 能力校验失败'), category='config')
            return
        for text, level in rep.messages():
            # `keep=True`：这几条虽然是 info（"已按模型 X 自动填入能力"、
            # "演示模式"），但它们是**唯一**告诉用户「.env 被程序改写过了」
            # 的地方，而且一次启动最多出一条，不是过程播报。
            # [EN] `keep=True`: although these are info ("capabilities auto-filled per model X",
            # [EN] "demo mode"), they are the **only** place that tells the user ".env has been rewritten by the
            # [EN] program",
            # [EN] and at most one appears per startup, not process narration.
            self._post_message(text, level=level, keep=True)
        if rep.changed:
            get_logger('nws.config').warning(
                'LLM 能力校验改写了 %d 项配置：%s', len(rep.fixes),
                '；'.join(f.human() for f in rep.fixes))

    def _apply_window_icon(self) -> None:
        """窗口/任务栏图标：等窗口真正创建出来，再设图标**并读回校验**。

        两处曾经出问题的地方，都在这里兜住了：
        1. **窗口还没建好就设** → 以前一次性 `sleep(1.0)` 后设一把，窗口来得慢就白设。
           现在**轮询重试**（最多约 6 秒），每次设完都读回 `WM_GETICON` 确认。
        2. **图标文件是旧的** → 产物刷新交给 `get_window_icon_ico()` →
           `ensure_icon_assets()`（按图标代码指纹判定），换图标就会重做
           `assets/app_icon.ico`，任务栏不会再停在上一版。
        
                English:
        Window/taskbar icon: wait until the window is actually created, then set the icon **and read it
        back to verify**.
                Two places that once had problems are both covered here:
                1. **Setting it before the window is ready** → previously a one-shot `sleep(1.0)` then set it once; if the window came up slowly, it was a wasted set.
                   Now **poll and retry** (max about 6 seconds), reading back `WM_GETICON` to confirm after each set.
                2. **The icon file was stale** → refreshing the artifact is delegated to `get_window_icon_ico()` →
                   `ensure_icon_assets()` (keyed on the icon code fingerprint); changing the icon will redo
                   `assets/app_icon.ico`, so the taskbar won't stay stuck on the previous version.
        """
        ico = get_window_icon_ico()
        if not ico:
            get_logger('nws.gui').warning(
                '任务栏图标 / Taskbar icon: 没有可用的 .ico，跳过（no .ico available; skipped）', extra={'category': 'ui'})
            return

        async def _run():
            for attempt in range(12):
                await asyncio.sleep(0.8 if attempt < 2 else 0.5)
                try:
                    hwnd = find_app_hwnd(self.page.title or '')
                    if not hwnd:
                        continue
                    hicon, detail = apply_icon_to_hwnd(hwnd, ico)
                    back = read_window_icon(hwnd)
                    if hicon and back == hicon:
                        get_logger('nws.gui').info(
                            '任务栏图标: 已应用并校验通过（第 %d 次尝试，%s）  /  Taskbar icon applied and verified',
                            attempt + 1, detail, extra={'category': 'ui'})
                        return
                    if hicon:
                        get_logger('nws.gui').info(
                            '任务栏图标: 已发送但读回不一致（hwnd=%s，期望 %s，读回 %s）  /  Taskbar icon set but read-back differs',
                            hwnd, hicon, back, extra={'category': 'ui'})
                except Exception:                           # noqa: BLE001
                    log_exception(t("设置窗口图标失败"), category="ui")
            get_logger('nws.gui').warning(
                '任务栏图标: 未应用（没找到窗口或句柄读不回来）—— '
                '图标文件已是最新，任务栏仍显示旧图多半是系统图标缓存，重启程序即可'
                '  /  Taskbar icon not applied (no window/handle); the icon file is'
                ' current, so a stale taskbar image is usually the system icon'
                ' cache — restarting the app fixes it',
                extra={'category': 'ui'})

        self.page.run_task(_run)

    def _ensure_maximized(self) -> None:
        """窗口创建后再确认几次**最大化**（首次那一下常被平台忽略）。

        ★ 先把实测摆出来（`developers/probe_window_max.py`）：
        `main()` 刚返回时页面还是 `1440×900`（那是 `w.width/height` 的初值），
        **0.5 秒后**就到 `1920×1129` —— 最大化的兜底本来是好的。

        但原来的实现有两个**真隐患**，正好能解释"有时候是个小窗"：

          · 只试**两次**（0.35s / 1.55s），之后**再也不管**；
          · 失败路径是 `except: pass` —— **完全静默**，
            屏幕上没有提示、日志里没有痕迹。

        于是只要这台机器启动慢一点（OneDrive 同步目录、首次加载、
        或正好在弹「没配 LLM」那个引导框），两次都撞在"窗口还没建好"的那一刻，
        这个窗口就**永远停在 1440×900** 了。而"上次是好的"也说得通：上次启动快。

        现在：**多试几次（最晚 3.2 秒）** + 每次都**读回来校验**，
        4 次都没成功就**写进日志**（"静默失败"是这个项目最忌讳的）。

        ⚠⚠ **"已经最大化"时不能 `return`**（第一版就是这么写的，被
        `tools/verify_window_max.py` 的 A2 当场抓住）：那样一来，0.9 秒那次
        一旦读回 True 就退出循环，**后面 3.2 秒那次兜底就永远不会跑了** ——
        而"启动后一两秒被平台还原"恰恰是这条重试唯一要防的事。
        正确做法是**一直盯到最后一轮**：已经最大化的轮次只读不写（开销为零）。

        ⚠ **用户自己按过 F11 就不再插手**（`_user_toggled_fullscreen`）——
        他可能就想全屏着用，那时再补一次最大化会把他的全屏顶掉；
        也可能刚从全屏退出来，两秒后又被按回去，那是在跟人对着干。
        两种都不该由程序替他决定，所以一旦他动过手，这条兜底就收工。
        
                English:
        After the window is created, confirm **maximize** a few more times (the first one is often
        ignored by the platform).
                ★ First, let's lay out the measurements (`developers/probe_window_max.py`):
                when `main()` just returns, the page is still `1440×900` (that's the initial value of `w.width/height`),
                **0.5 seconds later** it reaches `1920×1129` -- the maximize fallback was fine to begin with.
                But the original implementation had two **real hazards**, which neatly explain "sometimes it's a small window":
                  · Only tries **twice** (0.35s / 1.55s), then **never again**;
                  · The failure path is `except: pass` -- **completely silent**,
                    no hint on screen, no trace in the logs.
                So as long as this machine starts a bit slowly (OneDrive sync directory, first load,
                or happens to be showing that "no LLM configured" guidance dialog), both attempts hit the moment when "the window isn't ready yet",
                and this window is **stuck at 1440×900 forever**. And "last time it was fine" also makes sense: last time startup was fast.
                Now: **try more times (latest 3.2 seconds)** + **read back to verify** each time,
                and if all 4 fail, **write to the log** ("silent failure" is what this project dreads most).
                ⚠⚠ **When "already maximized", you must not `return`** (the first version was written that way, and was caught red-handed by
                A2 in `tools/verify_window_max.py`): that way, once the 0.9-second attempt reads back True it exits the loop,
                **and the later 3.2-second fallback will never run** --
                and "being restored by the platform a second or two after startup" is exactly the one thing this retry exists to prevent.
                The correct approach is **keep watching until the last round**: rounds that are already maximized only read, don't write (zero cost).
                ⚠ **If the user pressed F11 themselves, stop interfering** (`_user_toggled_fullscreen`) --
                they may just want to use it fullscreen, and adding a maximize then would override their fullscreen;
                or they may have just exited fullscreen and get pushed back in two seconds later, which is fighting the user.
                Neither should be decided by the program for them, so once they've touched it, this fallback packs up.
        """
        delays = (0.35, 0.9, 1.8, 3.2)

        async def _run():
            prev = 0.0
            for t in delays:
                await asyncio.sleep(max(0.05, t - prev))
                prev = t
                if getattr(self, '_user_toggled_fullscreen', False):
                    return                      # 用户自己接管了，别再插手
                    # [EN] The user has taken over, don't interfere
                try:
                    win = self.page.window
                    # 全屏也是一种"铺满"，不用再补最大化
                    # [EN] Fullscreen is also a kind of "fill", no need to also maximize
                    if (bool(getattr(win, 'full_screen', False))
                            or bool(getattr(win, 'maximized', False))):
                        continue          # 这一轮没事 —— 继续盯着，别退出
                        # [EN] Nothing wrong this round -- keep watching, don't exit
                    win.maximized = True
                    self.page.update()
                except Exception:                             # noqa: BLE001
                    log_exception(t('确认最大化失败'), category='ui')
            try:
                w = self.page.window
                if not (bool(getattr(w, 'maximized', False))
                        or bool(getattr(w, 'full_screen', False))):
                    get_logger('nws.gui').warning(
                        '窗口最大化没能生效（试了 %d 次）—— 手动点窗口右上角的'
                        '「□」即可；按 F11 也可以全屏', len(delays),
                        extra={'category': 'ui'})
            except Exception:                                 # noqa: BLE001
                pass

        try:
            self.page.run_task(_run)
        except Exception:
            log_exception(t("确认最大化失败"), category="ui")

    def _on_keyboard(self, e) -> None:
        """全局快捷键：**F11 切换全屏**（默认是最大化，全屏是可选的手动动作）。

        两条：
          · 用户一旦按过 F11，启动那条 `_ensure_maximized` 兜底就**收工**
            （`_user_toggled_fullscreen`）—— 他可能就想全屏用，别去顶掉；
          · 退出全屏之后**要回到最大化** —— `_ensure_maximized` **只在启动时跑**
            （而且上面刚说它会收工），所以一旦窗口在全屏往返里被平台还原成
            "普通尺寸"，这一次会话就再也回不去了
            （用户按一下 F11 再按回来，屏幕上就只剩一个小窗）。
        
                English:
        Global shortcut: **F11 toggles fullscreen** (default is maximized; fullscreen is an optional
        manual action).
                Two points:
                  · Once the user has pressed F11, the startup `_ensure_maximized` fallback **stops**
                    (`_user_toggled_fullscreen`) — they may just want to use fullscreen, don't override it;
                  · After exiting fullscreen, **must return to maximized** — `_ensure_maximized` **only runs at startup**
                    (and as just noted above, it stops after F11), so once the window gets restored by the platform to
                    "normal size" during a fullscreen round-trip, this session can never go back
                    (user presses F11 and back again, and only a small window remains on screen).
        """
        key = (getattr(e, 'key', '') or '').upper()
        if key != 'F11':
            return
        self._user_toggled_fullscreen = True
        try:
            win = self.page.window
            win.full_screen = not bool(win.full_screen)
            self.page.update()
        except Exception:                                     # noqa: BLE001
            log_exception(t("切换全屏失败"), category="ui")
            return

        async def _restore():
            # 平台把窗口还原成普通尺寸需要一点时间，所以隔一下再补
            # [EN] The platform needs a moment to restore the window to normal size, so wait a bit before
            # [EN] re-applying
            await asyncio.sleep(0.35)
            try:
                win = self.page.window
                if not bool(win.full_screen) and not bool(win.maximized):
                    win.maximized = True
                    self.page.update()
            except Exception:                                 # noqa: BLE001
                pass

        try:
            self.page.run_task(_restore)
        except Exception:                                     # noqa: BLE001
            pass

    def _sync_window_title(self) -> None:
        """窗口标题带上当前项目名。

        设计稿 §11.1 的原话是「终端窗口标题同步『小说世界AI模拟 — 项目名』
        （多开/任务栏可辨）」—— 换成 GUI 之后这条依然成立：
        开两个窗口时，任务栏上要能一眼看出哪个是哪个项目。
        
                English:
        Window title includes the current project name.
                The design doc §11.1 states "Terminal window title syncs『Novel World AI Simulation — Project Name』
                (distinguishable across multiple instances / on taskbar)" — after switching to GUI this still holds:
                with two windows open, the taskbar should make it obvious at a glance which is which project.
        """
        try:
            proj = self.current_project
            self.page.title = window_title(proj.name if proj else '')
        except Exception:                                   # noqa: BLE001
            pass

    def show_start_screen(self):
        """显示开始界面（水墨丹青风）。
                English:
        Show the start screen (ink-wash / shuimo style).
        """
        page = self.page
        self._view = 'start'
        page.controls.clear()
        self._sync_window_title()

        bg_path = get_or_generate_bg()
        icon_path = get_or_generate_icon()
        projects = scan_projects(CFG.projects_dir())
        n = len(projects)

        # 背景图（拉伸铺满，随窗口自适应）
        # [EN] Background image (stretched to fill, adapts to window)
        bg = ft.Image(
            src=bg_path,
            fit=ft.BoxFit.COVER,
            left=0, top=0, right=0, bottom=0,
            opacity=1.0,
        )

        # 当前项目有没有（项目名条与下面的菜单都要用）
        # [EN] Whether the current project exists (used by both the project name bar and the menu below)
        has_run = self.current_project is not None

        # 图标 + 标题
        # [EN] Icon + title
        # 这几行字**直接写在背景图上**（没有纸底），所以大号的字带一圈白描边
        # 护边 —— 背景是淡彩水彩，中部虽然刻意留空，但换个窗口比例，樱枝、
        # 柳岸仍可能蹭到字上。见 `ink_text()`。
        # [EN] These lines are **written directly on the background image** (no paper backing), so large text
        # [EN] gets a white outline
        # [EN] as a protective border -- the background is light watercolor; although the middle is
        # [EN] deliberately left blank, with a different window ratio, cherry branches
        # [EN] and willow banks may still brush against the text. See `ink_text()`.
        # 小字**不描边**：13px 的字加 2~3px 描边会把笔画糊成一团。
        # 「尚未开卷」那行本来就落在画面正中的留白处，直接写没问题。
        # [EN] Small text is **not outlined**: adding a 2~3px outline to 13px text smears the strokes into a
        # [EN] blob.
        # [EN] The "Not yet opened" line already sits in the blank area at the center of the frame, so writing
        # [EN] it directly is fine.
        icon_img = ft.Image(src=icon_path, width=76, height=76, fit=ft.BoxFit.CONTAIN)
        title = ink_text(
            t("小 说 世 界 A I 模 拟"), SZ(38), INKC['ink'],
            stroke=5, weight=ft.FontWeight.BOLD, font_family=UI_FONT,
            text_align=ft.TextAlign.CENTER,
        )
        subtitle = ink_text(
            t("── 把 故 事 ， 活 一 遍 ──"), SZ(16), INKC['ink_soft'],
            stroke=2.5, font_family=UI_FONT, text_align=ft.TextAlign.CENTER,
        )

        # 当前项目：放在标题块里、副标题下面。
        # 回到开始界面第一眼就要能确认「我现在在哪个项目里」——
        # 以前只有「回卷」菜单那行小字提到项目名，太隐蔽（设计稿 §11.1 要求
        # 项目名醒目、永不省略；多开时也靠它分辨哪个窗口是哪个项目）。
        # [EN] Current project: placed in the title block, below the subtitle.
        # [EN] On returning to the start screen, the first glance should confirm "which project am I in now" --
        # [EN] previously only the small text of the "回卷" menu mentioned the project name, too hidden (design
        # [EN] doc §11.1 requires
        # [EN] the project name to be prominent and never truncated; with multiple windows it's also how you
        # [EN] tell which window is which project).
        if has_run:
            # 2026-10-06 用户：「有项目的时候 初始画面的项目名字那个栏 我也不想要
            # 背景图 直接显示就行」→ **去掉底色和描金边框**，项目名直接写在背景图上。
            # 既然没有纸底垫着了，就按上面标题/副标题的老规矩加一圈白描边护边
            # （背景是淡彩水彩，换个窗口比例，樱枝、柳岸仍可能蹭到字上）。
            # [EN] 2026-10-06 user: "when there's a project, that project name bar on the initial screen, I don't
            # [EN] want it either",
            # [EN] "just show the background image directly" -> **remove the background color and gold border**,
            # [EN] write the project name directly on the background image.
            # [EN] Since there's no paper backing anymore, follow the old rule for the title/subtitle above and add
            # [EN] a white outline as a protective border
            # [EN] (the background is light watercolor; with a different window ratio, cherry branches and willow
            # [EN] banks may still brush against the text).
            project_chip = ft.Row([
                ink_text(t('当前项目'), SZ(13), INKC['ink_soft'], stroke=2,
                         font_family=UI_FONT),
                ink_text(f'【{self.current_project.name}】', SZ(21), INKC['gold'],
                         stroke=3, weight=ft.FontWeight.BOLD, font_family=UI_FONT),
            ], spacing=8, alignment=ft.MainAxisAlignment.CENTER)
        else:
            project_chip = ft.Text(t('尚未开卷 —— 从「开　卷」开始'), size=SZ(13),
                                   color=INKC['ink_soft'], font_family=UI_FONT)

        title_block = ft.Container(
            content=ft.Column(
                [
                    ft.Row([icon_img], alignment=ft.MainAxisAlignment.CENTER),
                    ft.Divider(height=6, color='transparent'),
                    title,
                    subtitle,
                    ft.Divider(height=8, color='transparent'),
                    project_chip,
                ],
                spacing=2,
                horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            ),
            # **不铺底色** —— 图标与标题直接写在背景图上。
            # [EN] **No background fill** -- icon and title are written directly on the background image.
            # 这里原来有 `bgcolor=with_alpha(C['panel'], panel_alpha())`。
            # 内层的 `ft.Row`（图标那一行）会横向撑满，所以那个 Container
            # 跟着被撑成**通栏**：实测在 1920 的窗口里占 1900px 宽、205px 高，
            # 看上去就是横在画面中间的一条白带（用户截图指的就是它）。
            # 背景图本来就是为此把画面中部留空的 —— 白底反而把这层设计盖掉了。
            # [EN] Here there used to be `bgcolor=with_alpha(C['panel'], panel_alpha())`.
            # [EN] The inner `ft.Row` (the icon row) stretches horizontally to fill, so that Container
            # [EN] gets stretched into a **full-width bar**: measured in a 1920 window it takes 1900px wide, 205px
            # [EN] tall,
            # [EN] looking like a white band lying across the middle of the frame (this is what the user's
            # [EN] screenshot pointed at).
            # [EN] The background image leaves the middle blank precisely for this -- the white background actually
            # [EN] covers up this design layer.
            bgcolor=None,
            padding=ft.Padding(0, 0, 0, 0),
        )

        # 菜单项（水墨风：墨字 + 朱砂序号）
        # 元组：(图标, 标题, 说明, 处理器, 是否可用)
        # [EN] Menu items (ink style: ink text + cinnabar index)
        # [EN] Tuple: (icon, title, description, handler, enabled)
        # **标题雅，说明要短、要直白。** 说明是给第一次打开的人扫一眼的，
        # 不是产品介绍 —— 一条控制在 **14 字以内**（验证脚本会卡这个数）。
        # 最容易混的两处直接点破：「天机=程序设置」vs「书斋=本书设置」，
        # 以及「开卷=把小说读进来」vs「起　笔=开始推演」。
        # [EN] **Title elegant, description short and direct.** The description is for people opening it for
        # [EN] the first time to glance at,
        # [EN] not a product pitch -- keep each to **14 characters or fewer** (the verification script enforces
        # [EN] this).
        # [EN] Point out the two most easily confused spots directly: "天机 = program settings" vs "书斋 = book
        # [EN] settings",
        menu_items = [
            # ★★ 八项的图标全部写成 `img:<槽位>` —— **彩色位图**（见 `mk_menu_icon`）。
            #   2026-10-10 一天里换了两轮：彩色 emoji → 单色矢量 → 彩色位图。
            #   最后这一步的理由就是用户那句「现在不好看，要之前那种彩色图标」：
            #   单色线条配纸色卡片显得冷、像工具面板，彩色才跟水墨界面一路。
            #   ⚠ 素材与槽位的对照、许可、怎么换素材：`assets/images/menu_icons/README.md`。
            #     换素材**不用改这里**（槽位名不变），重跑生成脚本即可。
            # [EN] ★★ All eight icons are written as `img:<slot>` -- **color bitmaps** (see `mk_menu_icon`).
            # [EN] 2026-10-10 changed twice in one day: color emoji -> monochrome vector -> color bitmap.
            # [EN] The reason for this last step is the user's line "it doesn't look good now, want the color icons
            # [EN] like before":
            # [EN] monochrome lines on paper-colored cards look cold, like a tool panel; color is what matches the
            # [EN] ink interface.
            # [EN] ⚠ Asset-to-slot mapping, license, how to swap assets: `assets/images/menu_icons/README.md`.
            # [EN] Swapping assets **doesn't require changing this** (slot names stay the same), just rerun the
            # [EN] generation script.
            ('img:open_book', t('开　卷'), t('导入小说文件夹'), self._on_new_story, True),
            # 顺序是「先把书找出来，再动笔」：开卷 = 带一本**新**书进来，
            # 拾卷 = 打开**以前**的书，起笔 = 在选中的这本书上开始推演。
            # （2026-10-06 用户要求把起笔与拾卷对调 —— 原先是开卷→起笔→拾卷，
            #   那让"拾卷"看着像起笔的后续动作。）
            # [EN] The order is "find the book first, then start writing": 开卷 = bring in a **new** book,
            # [EN] 拾卷 = open a **previous** book, 起笔 = start inference on the selected book.
            # [EN] which made "拾卷" look like a follow-up action of 起笔.)
            ('img:books', t('拾　卷'),
             # ★ 2026-10-07 去掉那个「（N 个）」。
             #   用户原话：「2个小说 我删除一个之后 初始界面的拾卷下面的小字
             #   部分的数字不变（你把这个数字去掉算了，没有用处）」。
             #   它数的是**这本书的册数**（`len(scan_projects())`），而菜单那句
             #   小字是**构建时算好的** —— 删掉一本之后不重画就还是旧数字。
             #   与其去追每一处"什么时候得重画"，不如不要这个没人用的计数。
             # [EN] ★ 2026-10-07 removed that "(N 个)".
             # [EN] User's exact words: "2 novels, after I delete one, the small text under 拾卷 on the initial screen
             # [EN] the number doesn't change (just remove this number, it's useless)".
             # [EN] It counted **the number of volumes of this book** (`len(scan_projects())`), while that menu
             # [EN] small text is **computed at build time** -- after deleting a book it stays the old number unless
             # [EN] redrawn.
             # [EN] Rather than chasing every place for "when do we need to redraw", better to drop this count
             # [EN] nobody uses.
             t('打开以前的故事') if n else t('还没有做过的故事'),
             # 一个都没有 → 灰掉。否则点开是个空列表，
             # 跟「回卷」在没跑过时的处理不一致（同样是"没东西"，一个灰一个能点）。
             # [EN] None at all -> grey out. Otherwise clicking opens an empty list,
             # [EN] inconsistent with how "回卷" is handled when never run (both are "nothing there", one greyed one
             # [EN] clickable).
             self._on_old_story, bool(n)),
            ('img:play', t('起　笔'),
             t('开始推演一轮') if has_run else t('先开卷导入小说'),
             self._on_new_round, has_run),
            # ★ 「拆　书」（2026-10-07）：把**别人写得好的书**读成写法，
            #   存进技能库，以后写同类故事时被剧组取用。
            #   位置放在「起笔」之后、「天机」之前：它属于"开卷那一族"的
            #   准备工作（读书 → 学写法），但**不依赖任何项目** —— 所以恒可点
            #   （手上还没有自己的书时，正好可以先拆一本别人的学一学）。
            # ★ 图像 = **拼图**（槽位 `puzzle`）—— 用户 2026-10-10 点名要的：
            #   拆书拆出来的正是"可复用的写法模块"，一块一块拼到自己的故事上。
            #   中英界面同一张图（图标本来就不翻译）。
            # [EN] ★ "拆　书" (2026-10-07): read **a book someone else wrote well** as a writing method,
            # [EN] store it in the skill library so the crew can use it later when writing similar stories.
            # [EN] preparation work (read a book -> learn the method), but **depends on no project** -- so always
            # [EN] clickable
            # [EN] (when you don't have your own book yet, it's exactly the time to dissect someone else's and
            # [EN] learn).
            # [EN] ★ Icon = **puzzle** (slot `puzzle`) -- user requested by name on 2026-10-10:
            # [EN] what 拆书 produces is exactly "reusable writing modules", pieced together into your own story one
            # [EN] by one.
            # [EN] Same image for Chinese and English interfaces (icons aren't translated anyway).
            ('img:puzzle', t('拆　书'), t('读一本好书，学写法'), self._on_booklab, True),
            # ★ 图像 = **齿轮**（槽位 `gear`）—— 用户 2026-10-10：
            #   「天机 按照全局设置的意思找一个图标」。齿轮是"设置"的通用图形，
            #   与隔壁「书斋」（画笔 = 本书设置）一眼分得开。
            # [EN] ★ Icon = **gear** (slot `gear`) -- user 2026-10-10:
            # [EN] "for 天机, find an icon meaning global settings". The gear is the universal symbol for "settings",
            # [EN] visually distinct at a glance from the neighboring "书斋" (paintbrush = book settings).
            ('img:gear', t('天　机'), t('程序设置：模型、预算'),
             self._on_global_settings, True),
            # 书斋是**本书**设置 —— 没有书就没有什么可设的。
            # 早些时候它恒可点，点下去只是弹「拾卷」列表（`show_project_settings`
            # 里的兜底），等于骗用户点一下。跟拾卷/回卷一个规矩：
            # **没有对象就灰掉，并且用小字说清下一步做什么**。
            # [EN] 书斋 is **book** settings -- with no book there's nothing to set.
            # [EN] Earlier it was always clickable, and clicking just popped up the "拾卷" list (the fallback in
            # [EN] `show_project_settings`), effectively tricking the user into a click. Same rule as 拾卷/回卷:
            # [EN] **no object -> grey out, and use small text to say clearly what to do next**.
            ('img:brush', t('书　斋'),
             t('本书设置：类型、风格') if has_run else t('先开卷导入小说'),
             self._on_project_settings, has_run),
            # ★ 图像 = **倒回箭头**（槽位 `rewind`）—— 用户 2026-10-10 原话：
            #   「Resume 的中英文图标改成一个横线在下面，箭头在上面往左的
            #    逆时针箭头」。那个字形是 Material 的 `SETTINGS_BACKUP_RESTORE`，
            #   ⚠ **emoji / 这套素材里没有一模一样的**，所以挑了语义最贴的
            #   「倒回 / 回到之前」（⏪）。同批候选（逆时针箭头 ⏄ / 左箭头 /
            #   返回箭头…）在 `assets/screenshots/menu_icons_sheet.png` 里，
            #   想换一张就改 `developers/make_menu_icons.py` 的 `SLOTS` 那一行。
            # [EN] ★ Image = **rewind arrow** (slot `rewind`) -- user's exact words on 2026-10-10:
            # [EN] "Change the Resume Chinese and English icons to a horizontal line at the bottom, with an arrow
            # [EN] above it pointing left, counterclockwise." That glyph is Material's `SETTINGS_BACKUP_RESTORE`,
            # [EN] ⚠ **emoji / this asset set has no exact match**, so we picked the closest semantically:
            # [EN] "rewind / go back" (⏪). Other candidates from the same batch (counterclockwise arrow ⏄ / left
            # [EN] arrow /
            # [EN] back arrow...) are in `assets/screenshots/menu_icons_sheet.png`;
            # [EN] to swap one, edit the `SLOTS` line in `developers/make_menu_icons.py`.
            ('img:rewind', t('回　卷'),
             t('回到推演界面') if has_run else t('没有在推演的故事'),
             self._on_resume_story, has_run),
            # ★ 图像 = **门**（槽位 `door`）—— 用户 2026-10-10：「归去的图标
            #   **强化一下门和从门里离开的意思**」。一扇门 + 右边"退出程序"
            #   四个字，合起来就是"从门里出去"。
            #   ⚠ 别换回 `EXIT_TO_APP`（那是个方框，看不出是门）；
            #     emoji 的 `🚪` 只有门、没有"离开"那一半（所以现在用位图）。
            # [EN] ★ Image = **door** (slot `door`) -- user on 2026-10-10: "the exit icon
            # [EN] **should emphasize the door and the meaning of leaving through the door**". A door + "Exit
            # [EN] program"
            # [EN] on the right; together they read as "going out through the door".
            # [EN] ⚠ Don't switch back to `EXIT_TO_APP` (that's a box, doesn't read as a door);
            # [EN] the emoji `🚪` is only a door, without the "leaving" half (so we use a bitmap now).
            ('img:door', t('归　去'), t('退出程序'), self._on_exit, True),
        ]

        menu_column = ft.Column(spacing=4)
        for icon, title_text, desc, handler, enabled in menu_items:
            title_ctrl = ft.Text(title_text, size=SZ(17), color=INKC['ink'],
                                weight=ft.FontWeight.BOLD, font_family=UI_FONT)
            desc_ctrl = ft.Text(desc, size=SZ(12), color=INKC['ink_soft'])
            if not enabled:
                # 没有正在运行的故事 → 灰掉，不可点
                # [EN] No story currently running -> grayed out, not clickable
                title_ctrl.color = '#b3aca0'
                desc_ctrl.color = '#b3aca0'
            item = ft.Container(
                content=ft.Row([
                    # ★ 图标也要一起灰：彩色位图有配套的去色版（`_dim.png`），
                    #   与标题/说明用同一个"褪色"语汇 —— 见 `mk_menu_icon`。
                    # [EN] ★ The icon should be grayed out too: the color bitmap has a matching desaturated version
                    # [EN] (`_dim.png`),
                    # [EN] using the same "faded" vocabulary as the title/description -- see `mk_menu_icon`.
                    mk_menu_icon(icon, color=INKC['ink'], dim=not enabled),
                    ft.Column([title_ctrl, desc_ctrl], spacing=1, expand=True),
                ], spacing=12),
                padding=ft.Padding(16, 11, 16, 11),
                border_radius=6,
                bgcolor='transparent',
                on_hover=(lambda e: self._on_hover(e)) if enabled else None,
                on_click=handler if enabled else None,
                animate=ft.Animation(180, 'easeInOut'),
            )
            menu_column.controls.append(item)

        menu_card = ft.Container(
            content=menu_column,
            bgcolor=INKC['card'],
            border=make_border(1, INKC['card_border']),
            border_radius=10,
            padding=ft.Padding(20, 18, 20, 18),
            width=420,
            # 不透明度交给 bgcolor 的 alpha（INKC['card'] 随 UI_OPACITY 变）。
            # 原来这里是控件级 opacity=0.96 —— 那是「连文字一起变半透明」，
            # 效果和「卡片半透明」不是一回事，也会让菜单文字发虚。
            # [EN] Opacity is delegated to the bgcolor's alpha (INKC['card'] changes with UI_OPACITY).
            # [EN] Originally this was a control-level opacity=0.96 -- that's "make the text semi-transparent too",
            # [EN] which is not the same as "semi-transparent card", and also makes the menu text look blurry.
        )

        version = ft.Text(
            t('v{VERSION} · 本地运行 · Python + Flet', VERSION=VERSION),
            size=SZ(12),
            color=INKC['ink_soft'],
            text_align=ft.TextAlign.CENTER,
        )

        # 布局
        # 全局消息框放在标题块下面、菜单上面：这块位置一进界面就看得见，
        # 而且不遮标题。**开始界面也必须有** —— 「LLM 配置与模型不符、
        # 已自动改回、需要重启」这类消息如果只在运行界面显示，用户回来
        # 看菜单的时候就已经错过了（而那正是他要去改设置的时候）。
        # [EN] Layout
        # [EN] The global message box goes below the title block and above the menu: this spot is visible as
        # [EN] soon as you enter the screen,
        # [EN] and it doesn't cover the title. **The start screen must have it too** -- messages like "LLM
        # [EN] config doesn't match the model,
        # [EN] automatically reverted, restart required" would be missed if they only showed on the running
        # [EN] screen, since by the time the user
        # [EN] comes back and looks at the menu they've already missed it (and that's exactly when they're
        # [EN] going to change settings).
        content = ft.Column(
            controls=[
                ft.Divider(height=36, color='transparent'),
                title_block,
                ft.Divider(height=18, color='transparent'),
                ft.Row([self._message_bar(width=SET_W)],
                       alignment=ft.MainAxisAlignment.CENTER),
                ft.Divider(height=18, color='transparent'),
                ft.Row([menu_card], alignment=ft.MainAxisAlignment.CENTER),
                ft.Divider(height=24, color='transparent'),
                version,
            ],
            alignment=ft.MainAxisAlignment.CENTER,
            horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            spacing=0,
        )

        # 右上角「帮助」（2026-10-06 用户要求）。
        # [EN] "Help" in the top right (user request, 2026-10-06).
        # 为什么放这个位置、这个样式：
        #   · **右上角**：运行界面右上角本来就有「❓ 帮助」，两处位置一致，
        #     手不用重新学；而且这个角落**不挤菜单卡**（菜单卡固定 420 宽、居中），
        #     也不压标题块（它只有 76px 图标 + 两行字，居中排）。
        #   · 字写在背景图上 → 走 `ink_text()` 加白描边（跟标题/副标题同一套道理：
        #     背景是淡彩水彩，不加护边换个窗口比例就可能被樱枝柳岸蹭上）。
        #   · 悬停用 `_on_hover`（跟菜单项一份实现），点开就是那个帮助面板（含检索）。
        # [EN] Why this position and this style:
        # [EN] · **Top right**: the running screen already has "❓ Help" in the top right; consistent position
        # [EN] in both places,
        # [EN] so the hand doesn't have to relearn; and this corner **doesn't crowd the menu card** (the menu
        # [EN] card is fixed 420 wide, centered),
        # [EN] and doesn't press on the title block (it's just a 76px icon + two lines of text, centered).
        # [EN] · Text drawn on top of the background image -> use `ink_text()` with a white outline (same
        # [EN] reasoning as title/subtitle:
        # [EN] the background is light watercolor; without a guard edge, at a different window ratio it can get
        # [EN] grazed by the cherry branches and willow bank).
        # [EN] · Hover uses `_on_hover` (same implementation as menu items); clicking opens that help panel
        # [EN] (with search).
        help_btn = ft.Container(
            content=ink_text(t('❓ 帮 助'), SZ(15), INKC['ink'], stroke=2.5,
                             weight=ft.FontWeight.BOLD, font_family=UI_FONT),
            padding=ft.Padding(12, 6, 12, 6),
            border_radius=8,
            bgcolor=None,
            top=16, right=20,
            tooltip=t('打开使用说明'),
            on_hover=self._on_hover,
            on_click=self.show_help_dialog,
        )

        # Stack 布局：背景 + 顶部留白 + 内容 + 右上角帮助（自适应窗口）
        # [EN] Stack layout: background + top margin + content + top-right help (adapts to window)
        stack = ft.Stack(
            controls=[bg, content, help_btn],
            expand=True,
        )

        page.add(stack)
        page.update()

    def _on_hover(self, e):
        """悬停效果（水墨风）。
                English:
        Hover effect (ink-wash style).
        """
        try:
            if e.data == 'true':
                e.control.bgcolor = INKC['hover']
            else:
                e.control.bgcolor = 'transparent'
            e.control.update()
        except Exception:
            pass

    def _on_new_story(self, e):
        """开卷：打开导入向导。
                English:
        Open Volume: open the import wizard.
        """
        self.show_import_wizard()

    def _on_old_story(self, e):
        """拾卷：显示项目列表。
                English:
        Pick Volume: show the project list.
        """
        self.show_projects_dialog()

    def _on_global_settings(self, e):
        """天机：全局设置。
                English:
        Heaven's Mechanism: global settings.
        """
        self.show_global_settings()

    def _on_project_settings(self, e):
        """书斋：项目设置。

        没有项目时菜单项本来就是灰的（点不到）；这里再兜一道，
        免得别处（快捷键、将来加的入口）绕过菜单直接调进来。
        
                English:
        Study: project settings.
                The menu items are already greyed out when there are no projects (unclickable); this is an extra guard
                in case elsewhere (shortcuts, future entry points) bypasses the menu and calls in directly.
        """
        if self.current_project is None:
            self._show_snack(t('暂无正在运行的故事，请先开卷'), error=True)
            return
        self.show_project_settings()

    def _on_resume_story(self, e):
        """回卷：回到运行界面，接着看当前这一卷。
                English:
        Return Volume: return to the running screen, continue viewing the current volume.
        """
        if self.current_project is None:
            self._show_snack(t('暂无正在运行的故事，请先开卷'), error=True)
            return
        log_ui_action(t("回到运行界面"), self.current_project.name)
        self.show_main_screen()

    async def _on_exit(self, e):
        """归去：退出程序。
                English:
        Leave: exit the program.
        """
        log_ui_action(t("退出程序"))
        # ★ 与"点窗口右上角的 ×"走的是同一条收尾路，所以这里也要上那道闸
        #   （`page.window.destroy()` 抛的是 `CancelledError`，
        #    `except Exception` 接不住 —— 后面那行 `raise SystemExit(0)`
        #    在过去是**死代码**，见 `util/flet_shutdown` 的说明）。
        #   先落盘、再上闸：顺序反了就成了"先杀进程、后落盘"。
        # [EN] ★ It follows the same shutdown path as "clicking the × in the window's top right", so the same
        # [EN] gate must be applied here
        # [EN] (`page.window.destroy()` throws `CancelledError`,
        # [EN] `except Exception` can't catch it -- the following line `raise SystemExit(0)`
        # [EN] was **dead code** in the past, see the explanation in `util/flet_shutdown`).
        # [EN] Persist to disk first, then raise the gate: reversing the order becomes "kill the process first,
        # [EN] persist afterwards".
        try:
            self._stop_autosave()
        except Exception:                                      # noqa: BLE001
            log_exception(t('关窗口前的自动落盘失败'), category='ui')
        try:
            arm_exit_watchdog()
        except Exception:                                      # noqa: BLE001
            pass
        try:
            await self.page.window.destroy()
        except BaseException:               # ⚠ CancelledError 是 BaseException
        # [EN] ⚠ CancelledError is a BaseException
            raise SystemExit(0)

    def _refresh_view(self, msg: str | None = None) -> None:
        """按当前所处界面重建（语言 / 不透明度切换后即时生效）。
                English:
        Rebuild based on the current view (takes effect immediately after language / opacity toggles).
        """
        try:
            if self._view == 'main' and self.current_project:
                self.show_main_screen()
            else:
                self.show_start_screen()
        except Exception:
            log_exception(t("重建界面失败"), category="ui")
        self._show_snack(msg or t("✅ 语言已切换"))

    def _release_run_files(self, run_dir) -> str:
        """把**某一轮**占着的文件句柄放开。返回 `''` = 可以搬了；非空 = 不能删的原因。

        ★ 为什么必须有这一步（2026-10-07，用户报「最后一个存档无法删除」）：

        推演用的 sqlite 就放在运行文件夹里（`<运行文件夹>/state.db`），
        而 `RunLoop` 拿着那个连接**一直没关**。Windows 上只要有句柄开着，
        整个目录的改名就会失败（`WinError 32`）—— `shutil.move` 于是回退成
        「复制 + 删除」：复制进了备份、删除卡在 `state.db` 上。
        用户看到的就是"点了几次都删不掉"，而备份目录里攒下一堆**半成品备份**。
        （现场实证：`已删除备份/` 里有 4 个同名的存档备份，后 3 个只剩 7 个
        文件 —— 正是 copytree 成功、rmtree 失败留下的指纹。）

        两件事都做：
          · **还在跑** → 不删，并且说清"先点停止"（正在写的目录删了就真丢了）；
          · 已经停下 → 关掉它的连接、解开引用，让目录能搬得动。
        
                English:
        Release the file handles held by **a given round**. Returns `''` = can move now; non-empty =
        reason it can't be deleted.
                ★ Why this step is mandatory (2026-10-07, user reported "the last save can't be deleted"):
                The sqlite used for simulation lives in the run folder (`<run folder>/state.db`),
                and `RunLoop` holds that connection **without ever closing it**. On Windows, as long as any handle is open,
                renaming the entire directory fails (`WinError 32`) — `shutil.move` then falls back to
                "copy + delete": copy succeeds into the backup, delete gets stuck on `state.db`.
                What the user sees is "clicked several times and it won't delete", while the backup folder accumulates **half-finished backups**.
                (On-site evidence: `已删除备份/` contains 4 save backups with the same name; the last 3 have only 7
                files left — exactly the fingerprint of copytree succeeding and rmtree failing.)
                Do both:
                  · **Still running** → don't delete, and clearly say "click Stop first" (deleting a directory that is being written truly loses it);
                  · Already stopped → close its connection, release references, so the directory can be moved.
        """
        path = Path(run_dir)

        def _same(run) -> bool:
            try:
                return run is not None and Path(run.root) == path
            except Exception:                                   # noqa: BLE001
                return False

        ses = self.session
        if ses is not None and _same(getattr(ses, 'run', None)):
            if ses.is_alive:
                return t('这一轮还在跑 —— 先点「停止」，再删它的存档。')
            self._close_loop_db(getattr(ses, 'loop', None))
            # 这一轮的会话指向一个马上就不存在的目录了，解开引用
            # （界面各处都做了 `session is None` 的保护，解掉是安全的）。
            # [EN] This round's session points to a directory that's about to not exist; release the reference
            # [EN] (all UI spots guard with `session is None`, so releasing is safe).
            self.session = None

        pr = getattr(self, '_pending_round', None)
        if isinstance(pr, dict) and _same(pr.get('run')):
            self._close_loop_db(pr.get('loop'))
            self._pending_round = None
        return ''

    @staticmethod
    def _close_loop_db(loop) -> None:
        """关掉一轮推演的 DB 连接（**幂等、不抛**）。

        `RunLoop` 上的 `db` 与各 `Agent` 上的是**同一个连接对象**
        （`sim/setup.assemble` 里只 `DB(...)` 了一次），所以关一次就够。
        
                English:
        Close the DB connection for one simulation round (**idempotent, does not throw**).
                `db` on `RunLoop` and those on each `Agent` are **the same connection object**
                (in `sim/setup.assemble` only `DB(...)` is called once), so closing once is enough.
        """
        db = getattr(loop, 'db', None)
        if db is None:
            return
        try:
            db.close()
        except Exception:                                       # noqa: BLE001
            pass

    def _refresh_start_screen(self) -> bool:
        """**当场把已经画在屏幕上的开始界面重画一遍**（盘面变了的时候调）。

        踩过的坑（2026-10-06）：在「拾卷」里把小说删光之后，代码只 `pop_dialog()`
        就把人丢回开始界面 —— 而那块界面是**删除之前**建的：小字还写着
        「打开以前的故事」，拾卷 / 书斋 / 回卷都还是亮的，点下去只得到
        一个空列表或一句报错。**菜单的可用性是构建时算好的**（`scan_projects()`
        一扫就够了，不值当做成响应式），所以盘面一变就必须重建，
        否则界面说的和磁盘上的不是一回事。

        只在**开始界面正显示着**的时候重建 —— 在运行界面里删掉别的书，
        没必要把人踢回菜单（`_view == 'main'` 时这里直接返回）。
        返回是否真的重建过。
        
                English:
        **Redraw the start screen that is already on screen right now** (called when the layout
        changes).
                Pitfall encountered (2026-10-06): after deleting all novels in "Pick Volume", the code just called `pop_dialog()`
                and dropped the user back to the start screen — but that screen was built **before deletion**: the small text still said
                "Open a previous story", and Pick Volume / Study / Return Volume were all still enabled; clicking them just returned
                an empty list or an error. **Menu availability is computed at build time** (`scan_projects()`
                a single scan is enough, not worth making it reactive), so when the layout changes it must be rebuilt,
                otherwise what the UI shows and what's on disk don't match.
                Only rebuild while **the start screen is actually showing** — deleting other books from the running screen
                doesn't need to kick the user back to the menu (when `_view == 'main'` this just returns here).
                Returns whether it actually rebuilt.
        """
        if getattr(self, '_view', '') != 'start':
            return False
        try:
            self.show_start_screen()
            return True
        except Exception:                                       # noqa: BLE001
            log_exception(t('重建开始界面失败'), category='ui')
            return False

    # ══════════════════════════════════════════════════════════
    #  全局消息（状态栏那块「消息」显示框）
    # [EN] Global messages (the "messages" display box in the status bar)
    # ══════════════════════════════════════════════════════════
    def _post_message(self, text: str, level: str | None = None, *,
                      keep: bool = False, snack: bool = False) -> None:
        """把一条要给人看的消息**记下来**（并在界面上刷新那块消息框）。

        所有面向用户的提示都应走这里 —— 走 SnackBar 的话几秒就没了，
        用户去喝口水的功夫就漏掉了「配置已被自动改回、需要重启」这种关键提示。
        `snack=True` 时**额外**冒一次提示条（给正在盯着屏幕的人即时反馈）。

        ★ **不是每条都进状态栏**（见 `MSG_KEEP_LEVELS`）：过程播报（info）只进日志，
        状态栏留给 warn / error / ok。以前连"已打开帮助""已切换语言"都往里塞，
        常驻那块框很快就被噪音填满，真正要紧的那条反而没人看。
        要硬留的 info 传 `keep=True`。
        
                English:
        **Record** a message meant for the user (and refresh that message box on the UI).
                All user-facing notices should go through here — using SnackBar loses them in a few seconds,
                and by the time the user goes for a sip of water, critical notices like "config was auto-reverted, restart needed" are missed.
                When `snack=True`, **additionally** pop a notification bar (immediate feedback for whoever is watching the screen).
                ★ **Not every message goes to the status bar** (see `MSG_KEEP_LEVELS`): process announcements (info) go only to the log,
                Status bar is reserved for warn / error / ok. Previously even things like "help opened" and "language switched" were stuffed into it,
                and the persistent box quickly filled with noise, so the messages that actually mattered went unseen.
                For info that must persist, pass `keep=True`.
        """
        text = str(text)
        lv = level or msg_level_of(text)
        if lv not in MSG_STYLE:
            lv = 'info'
        # 先落日志：**不论进不进状态栏，消息都要有据可查**。
        # [EN] Log first: **whether or not it enters the status bar, every message must be traceable**.
        try:
            get_logger('nws.ui').info('[消息/%s] %s', lv, _clip(text, 300))
        except Exception:                                   # noqa: BLE001
            pass
        if not keep and lv not in MSG_KEEP_LEVELS:
            if snack:
                self._snack_raw(text, error=False)
            return
        rec = {'ts': now_str('%H:%M:%S'), 'day': now_str('%Y-%m-%d'),
               'text': text, 'level': lv}
        self._messages.append(rec)
        if len(self._messages) > 200:
            del self._messages[:-200]        # 只留最近 200 条，别让内存无限涨
        # ★ 同步落盘：关掉程序再打开，这一条还在（用户 2026-10-09 要的）。
            # [EN] Keep only the most recent 200, don't let memory grow unbounded
            # [EN] ★ Sync to disk: close the program and reopen, and this item is still there (user request,
            # [EN] 2026-10-09).
        append_message(rec)
        self._msg_unread += 1
        self._render_message_bar()
        if snack:
            self._snack_raw(text, error=(lv == 'error'))

    def _snack_raw(self, text: str, error: bool = False) -> None:
        """真正弹 SnackBar 的那一层（不记录，避免和 _post_message 互相调用）。
                English:
        The layer that actually pops up the SnackBar (does not record, to avoid mutual calls with
        _post_message).
        """
        try:
            bg = '#e74c3c' if error else C['border']
            self.page.show_dialog(ft.SnackBar(ft.Text(text), bgcolor=bg))
        except Exception:
            log_exception(t("显示提示条失败"), category="ui")

    def _show_snack(self, text: str, error: bool = False):
        """显示提示条。**同时记进全局消息框** —— 界面上的提示从此不会漏看。
                English:
        Show the toast. **Also record it into the global message box** - so UI notifications are never
        missed.
        """
        lv = 'error' if error else msg_level_of(text)
        self._post_message(text, level=lv, snack=True)

    def _headline_message(self) -> dict | None:
        """消息框该显示哪一条。

        **不是"最新一条"，而是"最近这批里最该被看到的一条"**：
        启动校验连着发好几条（改了什么、依据是什么、要重启、演示模式提示），
        最后一条往往是「演示模式」这类 info —— 按"最新一条"显示，
        真正要紧的「需要重启」就被顶掉了（实测就是这么被顶掉的）。
        所以规则是：**最近 20 条里有警告/错误就先显示最靠后的那条**，
        没有才显示最新一条。
        
                English:
        Which message the message box should display.
                **Not "the latest one", but "the one most worth seeing among the recent batch"**:
                Startup validation sends several in a row (what was changed, on what basis, need to restart, demo mode notice),
                and the last one is often something like "demo mode" info - if you display by "latest one",
                the genuinely important "restart required" gets pushed out (in practice that is exactly what happened).
                So the rule is: **if there is a warning/error among the latest 20, display the most recent one of those first**;
                only if there is none, display the latest one.
        """
        if not self._messages:
            return None
        recent = self._messages[-MSG_LOOKBACK:]
        serious = [m for m in recent if MSG_SEVERITY.get(m['level'], 0) >= 2]
        return serious[-1] if serious else self._messages[-1]

    def _render_message_bar(self) -> None:
        """原地刷新消息框（界面重建后句柄会更新到新的控件上）。

        **空列表也要刷新**：清空之后这块框不能还挂着最后一条消息的内容。
        
                English:
        Refresh the message box in place (after UI rebuild the handle updates to the new widget).
                **An empty list must also be refreshed**: after clearing, this box must not still be showing the content of the last message.
        """
        ui = self._ui_msg
        if not ui:
            return
        if not self._messages:
            try:
                ui['icon'].value = '·'
                ui['icon'].color = C['muted']
                ui['text'].value = t('暂无消息')
                ui['text'].color = C['muted']
                ui['time'].value = ''
                ui['count'].value = t('共 {n} 条', n=0)
                ui['bar'].update()
            except Exception:                               # noqa: BLE001
                pass
            return
        last = self._headline_message() or self._messages[-1]
        icon, color = MSG_STYLE[last['level']]
        try:
            ui['icon'].value = icon
            ui['icon'].color = color
            ui['text'].value = last['text'].replace('\n', ' ')
            ui['text'].color = C['text'] if last['level'] != 'info' else C['muted']
            ui['time'].value = f"{last['ts']} · {t(MSG_LABEL[last['level']])}"
            ui['time'].color = color
            n = len(self._messages)
            ui['count'].value = (
                t('共 {n} 条 · 未读 {u}', n=n, u=self._msg_unread)
                if self._msg_unread else t('共 {n} 条', n=n))
            ui['bar'].update()
        except Exception:                                   # noqa: BLE001
            pass

    def _message_bar(self, width: int | None = None) -> ft.Container:
        """全局消息显示框（开始界面与运行界面共用同一块）。

        左边一个级别图标 + 最新一条的内容，右边是「共 N 条（未读 M）」和两个动作。
        内容一行截断（完整内容点「查看」）；**常驻不消失**，这就是它和 SnackBar
        的分工：SnackBar 管「现在发生了什么」，这块管「发生过什么、还没处理」。
        
                English:
        Global message display box (the start screen and the runtime screen share the same one).
                On the left a level icon + the content of the latest message, on the right "N total (M unread)" and two actions.
                Content is truncated to one line (click "View" for the full content); **persistent, does not disappear** - that is the division of labor between it and the SnackBar:
                the SnackBar handles "what is happening now", this box handles "what has happened, not yet dealt with".
        """
        last = self._headline_message()
        icon, color = (MSG_STYLE[last['level']] if last else ('·', C['muted']))
        icon_txt = ft.Text(icon, size=SZ(15), color=color, width=16,
                           text_align=ft.TextAlign.CENTER)
        body_txt = ft.Text(
            (last['text'].replace('\n', ' ') if last else t('暂无消息')),
            size=BODY_FS, color=(C['text'] if last and last['level'] != 'info'
                                 else C['muted']),
            expand=True, no_wrap=True, overflow=ft.TextOverflow.ELLIPSIS)
        time_txt = ft.Text(f"{last['ts']} · {t(MSG_LABEL[last['level']])}" if last else '',
                           size=HINT_FS, color=color)
        n = len(self._messages)
        count_txt = ft.Text(
            t('共 {n} 条 · 未读 {u}', n=n, u=self._msg_unread) if self._msg_unread
            else t('共 {n} 条', n=n),
            size=HINT_FS, color=C['muted'])

        bar = ft.Container(
            content=ft.Row([
                icon_txt, body_txt, time_txt, count_txt,
                mk_btn(t('查看'), on_click=lambda e: self.show_messages_dialog(),
                       primary=False, height=SET_H),
                mk_btn(t('清空'), on_click=lambda e: self._clear_messages(),
                       primary=False, height=SET_H),
            ], spacing=8, vertical_alignment=ft.CrossAxisAlignment.CENTER),
            width=width,
            bgcolor=with_alpha(C['panel'], panel_alpha()),
            border=make_border(1, C['border']),
            border_radius=6,
            padding=ft.Padding(10, 3, 8, 3),
        )
        self._ui_msg = {'bar': bar, 'icon': icon_txt, 'text': body_txt,
                        'time': time_txt, 'count': count_txt}
        return bar

    def _clear_messages(self) -> None:
        """清空消息列表。

        **只原地刷新那块框，不整屏重建** —— 重建会闪一下，而且消息对话框
        还开着的时候重建很容易留下一个内容过期的框。
        
                English:
        Clear the message list.
                **Only refresh that box in place, do not rebuild the whole screen** - a rebuild flashes, and while the
                message dialog is still open a rebuild easily leaves a box with stale content.
        """
        n = len(self._messages)
        self._messages.clear()
        # ★ 盘上的也要删 —— 否则"清空"只是清掉了屏幕上的，
        #   下次启动它们**原样回来**（用户会以为清空坏了，或者更糟：
        #   以为消息是删不掉的）。这是"主动删除"的唯一入口。
        # [EN] ★ On-disk ones must be deleted too -- otherwise "clear" only clears what's on screen,
        # [EN] and next start they **come back exactly as before** (the user will think clearing is broken, or
        # [EN] worse:
        # [EN] think messages can't be deleted). This is the only entry point for "active deletion".
        clear_message_file()
        self._msg_unread = 0
        self._render_message_bar()
        # 消息列表对话框开着的话，顺手关掉（里面的内容已经没意义了）
        # [EN] If the message list dialog is open, close it too (its contents are meaningless now)
        try:
            if getattr(self.page, '_dialogs', None):
                self.page.pop_dialog()
        except Exception:                                   # noqa: BLE001
            pass
        get_logger('nws.ui').info('已清空 %d 条消息', n)

    def show_messages_dialog(self) -> None:
        """查看全部消息（倒序：最新的在最上面）。
                English:
        View all messages (reverse order: newest at the top).
        """
        page = self.page
        self._msg_unread = 0
        rows: list[ft.Control] = []
        if not self._messages:
            rows.append(ft.Text(t('暂无消息'), size=BODY_FS, color=C['muted']))
        _today = now_str('%Y-%m-%d')
        for m in reversed(self._messages):
            icon, color = MSG_STYLE.get(m['level'], MSG_STYLE['info'])
            # 非今天的条目带上日期（`msg_time_label` 里有理由）
            # [EN] Entries not from today get a date (`msg_time_label` explains why)
            _t = msg_time_label(m, _today)
            rows.append(ft.Container(
                content=ft.Row([
                    ft.Text(f'{_t} {icon}', size=HINT_FS, color=color,
                            width=MSG_TS_W),
                    ft.Text(m['text'], size=BODY_FS, color=C['text'],
                            selectable=True, expand=True, no_wrap=False),
                ], spacing=8, vertical_alignment=ft.CrossAxisAlignment.START),
                padding=ft.Padding(0, 3, 0, 3),
            ))
        # 消息条数一多就要能看出"还有更多" —— 常驻滚动条（用户 2026-10-06
        # 说的"别的地方"之一）。车道做进 ListView 自己的 padding。
        # [EN] When there are many messages, you need to show "there's more" -- always-visible scrollbar (one
        # [EN] of the "other
        # [EN] "places" the user mentioned on 2026-10-06). The track goes into ListView's own padding.
        msg_list = ft.ListView(rows, spacing=2, expand=True,
                               padding=ft.Padding(0, 0, MSG_BAR_LANE, 0))
        msg_bar = self._scroll_bar(msg_list, DLG_H_LIST, lane=MSG_BAR_LANE)
        msg_bar.reset(len(rows) * 40 > DLG_H_LIST)
        self._ui_msgs = {'bar': msg_bar, 'list': msg_list}
        dlg = mk_dialog(
            t('消 息 · 共 {n} 条', n=len(self._messages)),
            ft.Container(content=msg_bar, width=DLG_W, height=DLG_H_LIST),
            [
                mk_btn(t('清空'), on_click=lambda e: self._clear_messages(),
                       primary=False),
                mk_btn(t('关闭'), on_click=lambda e: page.pop_dialog(), primary=True),
            ],
        )
        page.show_dialog(dlg)

    # ══════════════════════════════════════════════════════════
    #  帮助面板（运行界面右上角「❓ 帮助」/ 命令框 `help`）
    # [EN] Help panel ("❓ Help" in the running screen's top right / `help` in the command box)
    # ══════════════════════════════════════════════════════════
    def _md_style(self) -> "ft.MarkdownStyleSheet":
        """说明书正文的排版。**实现搬到模块级 `md_style_sheet()`** 了 ——
        拾卷那边也要渲染 Markdown，两处各写一份迟早不一致（本项目的老规矩：
        一份实现，多处调用）。这里保留方法名，免得老调用点全要改。
        
                English:
        Layout of the manual body text. **The implementation was moved to module level
        `md_style_sheet()`** -
                the juanshu side also needs to render Markdown, and two copies written separately will inevitably diverge (this project's old rule:
                one implementation, called from multiple places). Keep the method name here so that all the old call sites do not have to change.
        """
        return md_style_sheet()

    def show_help_dialog(self, e=None, tab: int = 0, question: str = '') -> None:
        """打开帮助：**一个窗口两个选项卡** —— 「帮助信息」（翻说明书）/「问个问题」（问说明书）。

        两页的内容都是随程序附带的说明书（中文读 `使用说明.md`、英文读 `User_Manual.md`）。
        分工：一页用来**翻**（左栏目录 + 右栏正文），一页用来**问**（聊天式，后台照着说明书答）。

        2026-10-06 用户要求合成一个窗口 —— 原来是"帮助面板底部挂个按钮，跳去另一个对话框"，
        来回跳容易迷路；而且问问题本身就该长得像聊天，不是一张表单。

        `tab=1` 直接落在「问个问题」那页（`show_help_qa_dialog()` 与命令框走它）；
        `question` 可以预填输入框。
        
                English:
        Open help: **one window with two tabs** - "Help Info" (browse the manual) / "Ask a Question"
        (ask the manual).
                Both pages show the manual shipped with the program (Chinese reads `使用说明.md`, English reads `User_Manual.md`).
                Division of labor: one page is for **browsing** (left column table of contents + right column body), one is for **asking** (chat style, answering in the background based on the manual).
                2026-10-06 user requested merging into a single window - it used to be "a button at the bottom of the help panel that jumps to another dialog",
                and jumping back and forth easily gets you lost; also, asking a question should look like a chat, not a form.
                `tab=1` lands directly on the "Ask a Question" page (`show_help_qa_dialog()` and the command box go through it);
                `question` can pre-fill the input box.
        """
        page = self.page
        doc = APP_DIR / ('使用说明.md' if get_lang() == 'zh' else 'User_Manual.md')
        intro, sections = read_manual(doc)
        # 第一项是**合成的**（说明书正文之前那段），不是标题 —— 所以给它一个自己的名字，
        # 且要走 `t()`（英文界面下露「开篇」两个字，`verify_ui_english` 抓到过）。
        # [EN] The first item is **synthesized** (the passage before the manual body), not a title -- so give
        # [EN] it its own name,
        # [EN] and it must go through `t()` (in the English UI it showed the two characters "开篇";
        # [EN] `verify_ui_english` caught this).
        items: list = ([(t('开篇'), intro)] if intro.strip() else []) + list(sections)
        log_ui_action(t("打开帮助"), doc.name)

        reader_pane = self._help_reader_pane(items, doc)

        tabs = ft.Tabs(
            length=2,
            selected_index=max(0, min(1, int(tab))),
            content=ft.Column([
                ft.TabBar(
                    tabs=[ft.Tab(label=t('帮助信息'),
                                 tooltip=t('按目录翻《使用说明》——'
                                           '想自己找。')),
                          ft.Tab(label=t('问个问题'),
                                 tooltip=t('直接用一句话问，答案从《使用说明》里找。'
                                           '答不上来时它会说不知道，而不是编。'))],
                    scrollable=False,
                    label_padding=ft.Padding(12, 0, 12, 0),
                    label_text_style=ft.TextStyle(size=BODY_FS,
                                                  weight=ft.FontWeight.BOLD),
                    unselected_label_text_style=ft.TextStyle(size=BODY_FS),
                ),
                ft.TabBarView(
                    controls=[reader_pane, self._help_chat_pane(question)],
                    expand=True,
                ),
            ], expand=True),
            expand=True,
        )

        dlg = mk_dialog(
            t('帮 助 · 使用说明'),
            ft.Container(content=tabs, width=HELP_W, height=HELP_H),
            [mk_btn(t('关闭'), on_click=lambda e: page.pop_dialog(), primary=True)],
        )
        page.show_dialog(dlg)

    def _scroll_bar(self, lv: ft.Control, pane_h: int, *, lane: int,
                    scroller: ft.Control | None = None) -> ft.Control:
        """给一个可滚动控件套一条**自己画的、常驻显示**的细滚动条。

        实现搬到了模块级 `mk_scroll_bar()`（天机/书斋的选项卡也要用，而那里是
        模块级函数，拿不到 `self`）。留下这个方法名，免得所有调用点都改。
        
                English:
        Wrap a scrollable widget with a **custom-drawn, always-visible** thin scrollbar.
                The implementation was moved to module level `mk_scroll_bar()` (the tabs of tianji/shuzhai also need it, and there
                are module-level functions where `self` is not available). Keep this method name so that all call sites do not have to change.
        """
        return mk_scroll_bar(lv, pane_h, lane=lane, scroller=scroller)

    # ── 帮助 · 第 1 页：翻说明书（关键字检索 + 左栏目录 + 右栏正文）──
    # [EN] ── Help · Page 1: browse the manual (keyword search + left column TOC + right column body) ──
    def _help_reader_pane(self, items: list, doc: Path) -> ft.Control:
        """帮助的「翻」那一页。

        2026-10-06 加了**关键字检索**（用户：「帮助对话框再加上关键字检索
        （不需要 LLM），放在默认帮助信息页」）。说明书几百节，靠翻目录找一句话
        太慢 —— 检索纯本地（`search_manual()`，**一次模型都不调**），
        所以没配 LLM 也能用，这正好是「问个问题」用不了时的退路。
        
                English:
        The "browse" page of help.
                2026-10-06 added **keyword search** (user: "add keyword search to the help dialog
                (no LLM needed), put it on the default help info page"). The manual has hundreds of sections, and finding one line by browsing the TOC
                is too slow - search is purely local (`search_manual()`, **does not call the model even once**),
                so it works even without an LLM configured, which is exactly the fallback when "Ask a Question" is unusable.
        """
        page = self.page
        # ★ 减掉 `HELP_PANE_RESERVED_H`（实测 99）—— 只减搜索行（`SET_H + 10`）不够，
        #   框架还会拿走标题行 / 选项卡条真实高度 / 底部按钮那些，
        #   不减就会被**静默裁掉一截**（见 `HELP_PANE_RESERVED_H` 的说明）。
        # [EN] ★ Subtract `HELP_PANE_RESERVED_H` (measured 99) -- subtracting only the search row (`SET_H +
        # [EN] 10`) isn't enough,
        # [EN] the framework also takes the title row / the tabs' actual height / the bottom buttons, etc.;
        # [EN] without subtracting, content gets **silently clipped** (see the explanation of
        # [EN] `HELP_PANE_RESERVED_H`).
        pane_h = HELP_PANE_H - SET_H - 10 - HELP_PANE_RESERVED_H
        # 两栏都用 `ListView`（不是 `Column(scroll=…)`）—— 理由见 `HELP_BAR_W`
        # 那段的注释；车道做进各自的 `padding`（跟「拾卷」的 `_new_list()` 同一套）。
        # [EN] Both columns use `ListView` (not `Column(scroll=…)`) -- for the reasoning see the comment around
        # [EN] `HELP_BAR_W`
        # [EN] That comment; the track goes into each one's `padding` (same as "拾卷"'s `_new_list()`).
        # ★★ 「看得见的下拉条」= **自己画的**（`self._scroll_bar`，见它的 docstring：
        #   控件级与主题级的 `thumb_visibility=True` 在这个 Flet 构建里都不生效）。
        #   `scroll=ScrollMode.ADAPTIVE` 留着只是为了"能滚"，不指望它画出条。
        # [EN] ★★ "A visible scrollbar" = **drawn by ourselves** (`self._scroll_bar`, see its docstring:
        # [EN] control-level and theme-level `thumb_visibility=True` both have no effect in this Flet build).
        # [EN] `scroll=ScrollMode.ADAPTIVE` is kept only so it "can scroll"; don't count on it to draw the bar.
        body_col = ft.ListView(
            spacing=8, expand=True,
            padding=ft.Padding(0, 0, HELP_BODY_LANE, 0),
            scroll=ft.ScrollMode.ADAPTIVE)
        toc_col = ft.ListView(
            spacing=2, expand=True,
            padding=ft.Padding(0, 0, HELP_TOC_LANE, 0),
            scroll=ft.ScrollMode.ADAPTIVE)
        # 粗估"这一屏装得下吗"——只用来决定**初次**那一下画不画滚动条
        # （准确的数值要等客户端报滚动事件；见 `_scroll_bar.reset`）。
        # ★ 右栏用 `md_height_est()` **按行类型**估（别按字数：表格/代码字少行多，
        #   按字数会把 §1 §7 §8 §11 §12 全判成"不用滚"，内容被截断还没条）。
        #   可用高度 = 面板高 − 容器上下内边距（`body` 容器 padding 8+8）。
        # [EN] Roughly estimate "does this fit on one screen" -- used only to decide whether to draw the
        # [EN] scrollbar the **first** time
        # [EN] (the exact value has to wait for the client to report a scroll event; see `_scroll_bar.reset`).
        # [EN] ★ The right column uses `md_height_est()` to estimate **by line type** (not by character count:
        # [EN] tables/code have few chars but many lines;
        # [EN] by character count, §1 §7 §8 §11 §12 would all be judged "no scroll needed", and content gets
        # [EN] truncated with no bar).
        # [EN] Available height = panel height − container top/bottom padding (`body` container padding 8+8).
        body_avail = pane_h - 16

        def _too_long(text: str) -> bool:
            return md_height_est(text) > body_avail

        # 左栏：行高按实测 30px（`HINT_FS` 13.5 × 1.4 + 上下 padding 8 + spacing 2），
        # 可用高度 = 面板高 − 容器内边距（`toc` 容器 padding 6+6）。
        # ⚠ 原来写的是 `len(rows) * 34 > pane_h` —— 两个数都不对：
        #   行高偏大（实测 30）、分母用的是**面板高**而不是**容器内高**
        #   （少减了 12px 的 padding），于是边界情形判反。
        # [EN] Left column: row height from measurement, 30px (`HINT_FS` 13.5 × 1.4 + top/bottom padding 8 +
        # [EN] spacing 2),
        # [EN] Available height = panel height − container padding (`toc` container padding 6+6).
        # [EN] ⚠ Originally written as `len(rows) * 34 > pane_h` —— both numbers are wrong:
        # [EN] Line height too large (measured 30), and the denominator uses **panel height** instead of
        # [EN] **container inner height**
        # [EN] (missing the subtraction of 12px of padding), so the boundary case is judged backwards.
        toc_avail = pane_h - 12
        _TOC_ROW_H = toc_row_h()

        # 左栏当前显示哪些节（**下标是 `items` 里的真下标**，检索过滤后仍指得回原文）
        # [EN] Which sections the left column currently displays (**the indices are the real indices in
        # [EN] `items`**, still pointing back to the original text after search filtering)
        rows: list[dict] = []
        cur: list[int] = [0]           # 当前正在读的那一节
        cur_q: list[str] = ['']        # 当前检索词（正文头那行"命中 N 次"要用）
        # [EN] The section currently being read
        # [EN] Current search term (used by the "N hits" line at the top of the body)

        def _paint_toc(sel: int) -> None:
            for ctrl, row in zip(toc_col.controls, rows):
                ctrl.bgcolor = C['border'] if row['idx'] == sel else None

        def _pick(idx: int) -> None:
            if not (0 <= idx < len(items)):
                return
            cur[0] = idx
            title, md = items[idx]
            # ★ 标题**过一道纯文本清洗**：说明书里有几个章节名自带行内语法
            #   （`4.2.2 …正文是**小说体**`、`` 6.1 …`samples/` ``），
            #   而这行是 `ft.Text` —— 不清洗就会原样露出星号和反引号
            #   （用户报的「markdown 渲染没成功」，2026-10-06）。
            # [EN] ★ The title **goes through a plain-text cleanup pass**: a few chapter names in the manual carry
            # [EN] inline syntax
            # [EN] (`4.2.2 …the body is **novel-style**`, `` 6.1 …`samples/` ``),
            # [EN] and this line is `ft.Text` —— without cleanup the asterisks and backticks show through verbatim
            # [EN] (the user-reported "markdown rendering did not work", 2026-10-06).
            head: list = [ft.Text(_plain_title(title), size=SEC_FS, color=C['gold'],
                                  weight=ft.FontWeight.BOLD)]
            row = next((r for r in rows if r['idx'] == idx), None)
            q = cur_q[0]
            if q and row and row.get('count'):
                # 「这个词在哪儿」比"有没有"更有用：先给次数，再给几处上下文
                # [EN] "Where is this word" is more useful than "does it exist": give the count first, then a few
                # [EN] context locations
                head.append(ft.Text(t('「{q}」在这一节出现 {n} 次', q=q, n=row['count']),
                                    size=HINT_FS, color=C['accent']))
                snips = list(row.get('snippets') or ([row['snippet']]
                                                    if row.get('snippet') else []))
                if snips:
                    head.append(ft.Column(
                        [ft.Text(s, size=HINT_FS, color=C['muted']) for s in snips],
                        spacing=1))
            body_col.controls = head + [
                # 渲染走 `mk_md()`（唯一入口）：三个开关 + 纸墨配色都在里面。
                # 插图是**相对路径**（`assets/images/manual/<lang>/…`），基准是
                # **进程工作目录** —— `ft.Markdown` 不认绝对路径、也不认 `file://`
                # （`developers/probe_md_image.py` 实测四种写法，只有相对路径能显示；
                # 启动器会 `cd` 到自己所在目录，所以正常启动一定对得上）。
                # 万一对不上（比如从别处起的进程），**降级要说人话**，别只留个破图图标。
                # [EN] Rendering goes through `mk_md()` (the single entry point): the three toggles + the paper-and-ink
                # [EN] color scheme are all in there.
                # [EN] Illustrations use **relative paths** (`assets/images/manual/<lang>/…`), based on
                # [EN] **the process working directory** —— `ft.Markdown` does not accept absolute paths, nor `file://`
                # [EN] (in `developers/probe_md_image.py` all four variants were tested, only the relative path
                # [EN] displays;
                # [EN] the launcher `cd`s to its own directory, so a normal launch always matches up).
                # [EN] If it somehow does not match (e.g. a process started from elsewhere), **the fallback must speak
                # [EN] plainly**, not just leave a broken-image icon.
                # ★★ **按小节拆成多个 Markdown**，不是整章一个（2026-10-06）。
                #   `ft.Markdown` 在 `ListView` 里、**首次挂载之前**就设好内容时
                #   高度**算不准** —— ListView 会以为"内容没超出"，于是既不滚动、
                #   也不出滚动条：右栏 §4 两万多字被截在 552px 里读不完
                #   （用户问的"有没有下拉条"，底下压着的其实是这个）。
                #   拆小之后每块高度可靠，整栏的高度才算得对。
                #   实测见 `developers/probe_help_scroll_fill.py`。
                # [EN] ★★ **Split into multiple Markdowns by subsection**, not one per whole chapter (2026-10-06).
                # [EN] When `ft.Markdown` has its content set inside a `ListView`, **before the first mount**
                # [EN] the height is **computed inaccurately** —— the ListView thinks "the content does not overflow",
                # [EN] so it neither scrolls
                # [EN] nor shows a scrollbar: the right column's §4 with over twenty thousand characters is truncated
                # [EN] at 552px and unreadable
                # [EN] (what the user asked about as "is there a scrollbar", what is actually underneath is this).
                # [EN] After splitting small, each block's height is reliable, and only then can the whole column's
                # [EN] height be computed correctly.
                # [EN] For measurements see `developers/probe_help_scroll_fill.py`.
                mk_md(_block, image_error=True)
                for _block in (_blocks_of(md) or [t('（这一节是空的）')])
            ]
            _paint_toc(idx)
            # 换章之后重判"要不要画条"（`_pick` 时才知道这一章多长）
            # [EN] After switching chapters, re-evaluate "whether to draw the bar" (only at `_pick` time do we know
            # [EN] how long this chapter is)
            body_bar.reset(_too_long(md))
            try:
                page.update()
            except Exception:                               # noqa: BLE001
                pass

        count_text = ft.Text('', size=HINT_FS, color=C['muted'])

        def _rebuild(q: str) -> None:
            """按检索词重建左栏（空词 = 显示全部目录）。
                        English:
            Rebuild the left column by search term (empty term = show all catalog entries).
            """
            q = (q or '').strip()
            cur_q[0] = q
            rows.clear()
            if q:
                rows.extend(search_manual(items, q))
            else:
                rows.extend({'idx': i, 'title': _ti, 'count': 0, 'in_title': False,
                             'loose': False, 'snippet': ''}
                            for i, (_ti, _md) in enumerate(items))
            toc_col.controls = [
                ft.Container(
                    content=(ft.Row([
                        # ⚠ `_plain_title` **要在 `_clip` 之前**过：标题里的
                        #   `**` 占两个字符，先截断会把标记切成半截（屏幕上就剩
                        #   一个孤零零的星号/反引号，比不处理还难看）。
                        # [EN] ⚠ `_plain_title` **must run before `_clip`**: the title's
                        # [EN] `**` occupies two characters, truncating first would cut the marker in half (on screen there
                        # [EN] would be just
                        # [EN] a lone asterisk/backtick, uglier than not handling it at all).
                        ft.Text(_clip(_plain_title(r['title']), 17 if q else 22),
                                size=HINT_FS,
                                color=C['text'] if r.get('in_title') or not q
                                else C['muted'],
                                no_wrap=True,
                                overflow=ft.TextOverflow.ELLIPSIS, expand=True),
                        # 命中次数：一眼看出"这一节讲得最多"，省得挨个点
                        # [EN] Hit count: at a glance see "this section talks about it the most", saving you from clicking one
                        # [EN] by one
                        ft.Text(str(r['count']), size=HINT_FS, color=C['gold'],
                                width=24, text_align=ft.TextAlign.RIGHT),
                    ], spacing=4)
                        if q else
                        ft.Text(_clip(_plain_title(r['title']), 22), size=HINT_FS,
                                color=C['text'],
                                no_wrap=True,
                                overflow=ft.TextOverflow.ELLIPSIS)),
                    padding=ft.Padding(6, 4, 6, 4), border_radius=4,
                    on_click=(lambda e, _i=r['idx']: _pick(_i)))
                for r in rows]
            if not q:
                count_text.value = t('共 {n} 节', n=len(items))
                count_text.color = C['muted']
            elif not rows:
                count_text.value = t('没有找到包含「{q}」的章节', q=q)
                count_text.color = C['seal']
                body_col.controls = [
                    ft.Text(t('没有找到包含「{q}」的章节', q=q),
                            size=BODY_FS, color=C['seal']),
                    ft.Text(t('换一个词试试（一个词往往比一句话准），'
                              '或者清空检索框翻目录。'),
                            size=HINT_FS, color=C['muted']),
                ]
                _paint_toc(-1)
            elif rows[0].get('loose'):
                # 一个词都没全命中 → 只给"沾边"的，并且**明说它们可能不相关**
                # [EN] If not a single word hits fully → only give "loosely related" ones, and **say plainly they may
                # [EN] be irrelevant**
                count_text.value = t('只沾到一部分：{n} 节（下面这些不一定相关）',
                                     n=len(rows))
                count_text.color = C['seal']
            else:
                count_text.value = t('命中 {n} 节', n=len(rows))
                count_text.color = C['accent']
            try:
                page.update()
            except Exception:                               # noqa: BLE001
                pass
            toc_bar.reset(len(rows) * _TOC_ROW_H > toc_avail)
            if rows:
                _pick(rows[0]['idx'])          # 直接落到第一条命中，省一次点击
                # [EN] Jump directly to the first hit, saving one click
            elif q:
                pass                           # 没命中 → 上面已经把正文换成说明
                # [EN] No hits → the body has already been replaced above with the explanation
            elif items:
                _pick(cur[0] if 0 <= cur[0] < len(items) else 0)

        if not items:
            body_col.controls = [
                ft.Text(t('没找到随程序附带的说明书（{f}）。', f=doc.name),
                        size=BODY_FS, color=C['seal']),
                ft.Text(t('可以在程序目录里直接打开《使用说明.md》查看。'),
                        size=HINT_FS, color=C['muted']),
            ]
            return ft.Container(content=body_col, width=HELP_W, height=HELP_PANE_H,
                                bgcolor=C['input_bg'],
                                border=make_border(1, C['border']),
                                border_radius=6, padding=ft.Padding(12, 8, 12, 8))

        search = ft.TextField(
            hint_text=t('在说明书里检索关键字…'), width=HELP_SEARCH_W,
            height=SET_H, text_size=SET_FS,
            content_padding=ft.Padding(8, 4, 8, 4),
            bgcolor=C['input_bg'], color=C['text'], border_color=C['border'],
            on_change=lambda e: _rebuild(e.control.value),
            on_submit=lambda e: _rebuild(e.control.value),
        )
        # 句柄：验证脚本要**走真实接线**检索（直接调 `_rebuild` 就绕开了 on_change
        # 那一行，接没接上都测不出来 —— 这是本项目的老规矩）。
        # ★ 2026-10-09：把 `toc_avail` / `_TOC_ROW_H` **也交出去** ——
        #   判据要判"这条该不该露"，就必须用**产品自己那两个数**。
        #   以前判据把"16 节 × 32px < 540px"写死在自己身上，于是
        #   `pane_h` 一修（那是修一个真 bug），判据**当场假红** ——
        #   而且它红得让人以为是产品坏了。这与 `TAB_LLM` 是同一条教训：
        #   **判据不许把被测对象的算术再抄一遍。**
        # [EN] Handles: the validation script must search **through the real wiring** (calling `_rebuild`
        # [EN] directly bypasses the on_change
        # [EN] line, so whether it is wired up cannot be tested —— this is an old rule in this project).
        # [EN] ★ 2026-10-09: **also hand out** `toc_avail` / `_TOC_ROW_H` ——
        # [EN] for the criterion to judge "whether this one should appear", it must use **the product's own two
        # [EN] numbers**.
        # [EN] Previously the criterion hard-coded "16 sections × 32px < 540px" onto itself, so
        # [EN] once `pane_h` was fixed (that was fixing a real bug), the criterion **turned falsely red on the
        # [EN] spot** ——
        # [EN] and it was red in a way that made people think the product was broken. This is the same lesson
        # [EN] as `TAB_LLM`:
        # [EN] **the criterion must not re-copy the arithmetic of the object under test.**
        self._ui_help.update({'search': search, 'rebuild': _rebuild,
                              'rows': rows, 'body_col': body_col,
                              'toc_col': toc_col,
                              'toc_avail': toc_avail, 'toc_row_h': _TOC_ROW_H})
        def _clear(e=None) -> None:
            search.value = ''
            _rebuild('')

        # ★★ 两栏容器：**显式给 `height`**（跟下面的 `Row` 同一个值）。
        #   ⚠ `Row` 的 `vertical_alignment` 默认是 **CENTER，不是 STRETCH** ——
        #   不给高度的话，这两个 `Container` 会跟着**内容**长高、不受 Row 的高度
        #   约束：右栏正文（§4 两万多字）会被 Row 直接裁掉，看不到也滚不动
        #   （实测：探针在修复前量到车道里**一条竖条都没有**）。
        #   滚动条与车道都在里面的 `ListView` 上（见 `scroll=ft.Scrollbar(...)`）。
        # [EN] ★★ Two-column container: **explicitly give `height`** (the same value as the `Row` below).
        # [EN] ⚠ `Row`'s `vertical_alignment` defaults to **CENTER, not STRETCH** ——
        # [EN] without giving a height, these two `Container`s grow tall with their **content**, unconstrained
        # [EN] by the Row's height:
        # [EN] the right column's body (§4 with over twenty thousand characters) gets clipped directly by the
        # [EN] Row, neither visible nor scrollable
        # [EN] (measured: before the fix the probe measured **not a single vertical bar** in the lane).
        # [EN] Both the scrollbar and the lane are on the `ListView` inside (see `scroll=ft.Scrollbar(...)`).
        toc_bar = self._scroll_bar(toc_col, pane_h, lane=HELP_TOC_LANE)
        body_bar = self._scroll_bar(body_col, pane_h, lane=HELP_BODY_LANE)
        # 把两条也交出去给验证脚本：这一页的**判据全是估算**（框架的
        # `thumb_visibility` 在本 Flet 构建里不生效、`scroll_to` 又会阻塞事件循环），
        # 所以"该露条的时候露了没"必须真机量 `thumb.visible` 才作数。
        # [EN] Also hand out these two to the validation script: this page's **criteria are all estimates**
        # [EN] (the framework's
        # [EN] `thumb_visibility` does not take effect in this Flet build, and `scroll_to` blocks the event
        # [EN] loop),
        # [EN] so "whether the bar showed when it should" can only count if `thumb.visible` is measured on a
        # [EN] real machine.
        self._ui_help.update({'toc_bar': toc_bar, 'body_bar': body_bar})
        toc = ft.Container(
            content=toc_bar,
            width=HELP_TOC_W, height=pane_h,
            bgcolor=C['input_bg'], border=make_border(1, C['border']),
            border_radius=6, padding=ft.Padding(6, 6, 6, 6))
        body = ft.Container(
            content=body_bar,
            expand=True, height=pane_h,
            bgcolor=C['input_bg'], border=make_border(1, C['border']),
            border_radius=6, padding=ft.Padding(12, 8, 12, 8))
        pane = ft.Row([toc, body], spacing=10, width=HELP_W, height=pane_h)

        _rebuild('')
        root = ft.Column([
            ft.Row([search, mk_btn(t('清除'), width=64, height=SET_H, on_click=_clear),
                    count_text],
                   spacing=8, width=HELP_W,
                   vertical_alignment=ft.CrossAxisAlignment.CENTER),
            pane,
        ], spacing=10, width=HELP_W)
        # ★★ 给外面留一个"再刷一次"的钩子（`show_help_dialog` 在对话框挂载后调它）。
        # [EN] ★★ Leave a "refresh once more" hook for the outside (`show_help_dialog` calls it after the
        # [EN] dialog mounts).
        # 为什么非要这一步（实测，见 `developers/probe_help_scroll_fill.py`）：
        #   `ListView` 在**首次挂载之前**就设好内容时，里面那个超长 `ft.Markdown`
        #   的高度**算不准** —— 于是 ListView 以为"内容没超出"，既不滚动、
        #   也不出滚动条。右栏 §4 两万多字就被截在 552px 里读不完
        #   （用户报「有没有下拉条」时，底下压着的其实是这个）。
        #   证据：**同一个 ListView、同样的内容**，挂载后再设一次 controls，
        #   就能滚了（探针里 ②③⑤⑥ 全是 True，而"原样"是 False）。
        #   试过但**没用**的办法：`build_controls_on_demand=False`、
        #   给 ListView 显式 height、`Markdown.fit_content/shrink_wrap`、
        #   多等几秒 + 反复 update（都还是 False）。
        # [EN] Why this step is necessary (measured, see `developers/probe_help_scroll_fill.py`):
        # [EN] When a `ListView` has its content set **before the first mount**, that over-long `ft.Markdown`
        # [EN] inside
        # [EN] has its height **computed inaccurately** —— so the ListView thinks "the content does not
        # [EN] overflow", and neither scrolls
        # [EN] nor shows a scrollbar. The right column's §4 with over twenty thousand characters is truncated
        # [EN] at 552px and unreadable
        # [EN] (when the user reported "is there a scrollbar", what is actually underneath is this).
        # [EN] Evidence: **the same ListView, the same content**, if controls are set once more after mounting,
        # [EN] then it can scroll (in the probe ②③⑤⑥ are all True, while "as-is" is False).
        # [EN] Approaches tried but **useless**: `build_controls_on_demand=False`,
        # [EN] giving the ListView an explicit height, `Markdown.fit_content/shrink_wrap`,
        # [EN] waiting a few more seconds + repeated update (all still False).
        return root

    # ── 帮助 · 第 2 页：问个问题（**聊天式**）────────────────────────
    # [EN] ── Help · Page 2: Ask a question (**chat-style**) ────────────────────
    def _help_chat_pane(self, question: str = '') -> ft.Control:
        """以《使用说明》为根据的问答页。

        **做成聊天**（用户 2026-10-06 要求）：气泡一来一往，作者问的在右、回答在左。
        多轮 —— 每问一次就把「问 + 答」记进 `history`，下一问连历史一起给模型，
        否则"那怎么改""在哪里点"这类追问，模型不知道"那"指什么。

        回答的根据**只有**随程序附带的说明书：没写的它会直说没写。
        检索为空时**一次请求都不发**（见 `research.manual_qa.answer`）——
        什么都不给模型还要它答，等于让它编，用户照着点又点不到。
        
                English:
                **Made into a chat** (user requested on 2026-10-06): bubbles go back and forth, the author's question on the right, the answer on the left.
                Multi-turn - each question records "question + answer" into `history`, and the next question is given to the model along with the history,
                otherwise for follow-ups like "then how to change it" or "where to click", the model does not know what "it" refers to.
                The basis for answers is **only** the manual shipped with the program: if it is not written, it will say so directly.
                When the search is empty, **do not send a single request** (see `research.manual_qa.answer`) -
                giving the model nothing and still asking it to answer is equivalent to making it up, and the user clicks where there is nothing to click.
        """
        from research import manual_qa
        page = self.page
        lang = get_lang()
        doc = manual_qa.manual_path(lang)
        history: list = []          # [{'role': 'user'|'assistant', 'content': str}]

        # ★ **LLM 没配置 → 整块变灰**（2026-10-06 用户要求：「问个问题功能在
        #   LLM 没配置的时候变灰，提示 LLM 没配不能用」）。
        #   为什么不把那个选项卡直接藏起来：藏起来用户只看到"少了个东西"；
        #   灰着 + 说清缺什么 + 给一个「去配置」，他才知道下一步干什么。
        #   判据只用**静态配置**（`probe.llm_ready()` 一次请求都不发）——
        #   打开帮助不该卡在网络上。
        # [EN] ★ **LLM not configured → the whole block turns gray** (2026-10-06 user request: "the
        # [EN] ask-a-question feature turns gray when the LLM is not configured, with a hint that the LLM is
        # [EN] not configured and cannot be used").
        # [EN] Why not just hide that tab: hiding it leaves the user only seeing "something is missing";
        # [EN] grayed out + stating clearly what is missing + giving a "Go configure" makes him know what to do
        # [EN] next.
        # [EN] The criterion uses only **static configuration** (`probe.llm_ready()` sends not a single
        # [EN] request) ——
        # [EN] opening help should not get stuck on the network.
        ready, why = probe.llm_ready()
        off = not ready
        off_why = why or t('没有可用的模型接口')

        # ⚠ 这里**必须用 `ft.ListView`**（AI 优化的对话区也是它）。
        #   `ft.Column(scroll=...)` 的子项在横向是**贴合内容**的 —— 于是气泡外层
        #   那个 Column 的宽度就等于气泡宽，"靠右"（`horizontal_alignment=END`）
        #   一点效果都没有，屏幕上所有气泡全堆在左边。
        #   实测：换成 Column 之后，作者气泡的像素 x∈[410,544]（对话框左边缘），
        #   与 AI 气泡同一起点（`tools/verify_help_qa.py` 的 B8 抓到的）。
        #   ListView 的子项在交叉轴**撑满视图宽度**，气泡自己那层的对齐才作数。
        # [EN] ⚠ Here **must use `ft.ListView`** (the AI-optimized chat area also uses it).
        # [EN] The children of `ft.Column(scroll=...)` **hug their content** horizontally —— so the bubble's
        # [EN] outer
        # [EN] Column's width equals the bubble's width, and "align right" (`horizontal_alignment=END`)
        # [EN] No effect at all, all bubbles on screen are piled up on the left.
        # [EN] Verified: after switching to Column, the author bubble's pixel x∈[410,544] (dialog left edge),
        # [EN] same starting point as the AI bubble (caught by B8 in `tools/verify_help_qa.py`).
        # [EN] ListView's children **fill the view width** on the cross axis, so only the alignment on the
        # [EN] bubble's own layer counts.
        # ★ 常驻滚动条（2026-10-06 用户：「回答问题的地方回答区也需要滚动条」）。
        #   车道做进 ListView 自己的 `padding`（`HELP_CHAT_LANE`），条才贴着
        #   面板右边缘、又不压气泡的右边那列字。
        # [EN] ★ Persistent scrollbar (2026-10-06 user: "the answer area where questions are answered also
        # [EN] needs a scrollbar").
        # [EN] Put the lane into ListView's own `padding` (`HELP_CHAT_LANE`), so the bar hugs
        # [EN] the panel's right edge and doesn't squeeze the right column of text in the bubble.
        chat_col = ft.ListView(expand=True, spacing=8, auto_scroll=True,
                               padding=ft.Padding(4, 4, HELP_CHAT_LANE, 4))
        chat_bar = self._scroll_bar(chat_col, HELP_CHAT_H, lane=HELP_CHAT_LANE)
        # ⚠ 用 `update()` 而不是 `=`：这一页是**后建**的，重新赋值会把前一个
        #   tab（帮助信息）刚存进去的 `search` / `rows` 句柄整份丢掉 ——
        #   丢得很安静：验证脚本只会拿到 `None`，看着像"没接上"。
        # [EN] ⚠ Use `update()` instead of `=`: this page is **built later**, reassigning would lose the
        # [EN] previous
        # [EN] tab's (help info) just-stored `search` / `rows` handles entirely ——
        # [EN] lost very quietly: the verification script only gets `None`, looking like "not wired up".
        self._ui_help.update({'chat_col': chat_col, 'chat_bar': chat_bar})
        status = ft.Text('', size=HINT_FS, color=C['muted'])

        def _note(text: str) -> ft.Control:
            """回答下面那行小字（依据 / 说明）。**不进气泡** —— 它是注脚，不是说的一句话。
                        English:
            The small line of text below the answer (basis / explanation). **Does not go into the bubble**
            -- it is a footnote, not something said.
            """
            return ft.Row([ft.Text(text, size=HINT_FS, color=C['muted'],
                                   no_wrap=False)])

        def _push(role: str, text: str, *, placeholder: bool = False) -> ft.Control:
            """加一条气泡，返回它的控件（占位气泡要留着引用，好原地换掉）。
                        English:
            Add a bubble and return its control (the placeholder bubble must keep a reference so it can be
            swapped in place).
            """
            ctrl = chat_bubble(text, role == 'user', placeholder=placeholder)
            chat_col.controls.append(ctrl)
            # 初次就让条现身：`max_scroll_extent` / `viewport_dimension` 只在
            # 滚动事件里才有，而"一打开就已经有好几轮问答"这种情况没人滚过
            # （见 `_scroll_bar.reset`）。52px ≈ 一条气泡的行高 + 间距。
            # [EN] Make the bar appear from the start: `max_scroll_extent` / `viewport_dimension` only exist
            # [EN] in scroll events, and "already several rounds of Q&A on open" means nobody has scrolled
            # [EN] (see `_scroll_bar.reset`). 52px ≈ one bubble's line height + spacing.
            chat_bar.reset(len(chat_col.controls) * 52 > HELP_CHAT_H)
            return ctrl

        q_row = mk_field(t('问题'), question, width=HELP_CHAT_INPUT_W,
                         hint=t('例如：怎么设置运行模式'))
        q_field = getattr(q_row, '_field', None)
        self._ui_help['push'] = _push          # 验证脚本用它灌气泡（走真实的接线）
        # [EN] The verification script uses it to feed bubbles (through the real wiring)
        send_btn = mk_btn(t('发送'), primary=True, width=80, height=SET_H)
        if off:
            # 「变灰」就在这两行：输入框与发送按钮都不可点、也不可编辑
            # [EN] "Grayed out" is exactly these two lines: both the input box and send button are unclickable and
            # [EN] uneditable
            send_btn.disabled = True
            if q_field is not None:
                q_field.disabled = True

        def _ask(text: str = '') -> None:
            """提问。`text` 非空 = 来自示例按钮；空 = 取输入框。
                        English:
            Ask a question. `text` non-empty = from the example button; empty = take from the input field.
            """
            if off:
                # 按钮已经灰了，这里再兜一道：万一有别的调用点（命令框 / 未来的
                # 快捷入口）不看着 UI 状态，也不能真的发出去 —— 发出去必然是
                # 一次失败调用，用户只会看到"出错了"。
                # [EN] The button is already gray; add another guard here: in case some other call site (command box /
                # [EN] future
                # [EN] shortcut entry) doesn't check UI state, it still must not actually send —— sending would
                # [EN] necessarily be
                # [EN] a failed call, and the user only sees "an error occurred".
                self._show_snack(t('LLM 还没配置，「问个问题」用不了'), error=True)
                return
            q = (text or field_value(q_row)).strip()
            if not q:
                self._show_snack(t('先写下你的问题'), error=True)
                return
            if q_field is not None:
                q_field.value = ''
            _push('user', q)
            hold = _push('assistant', t('正在查《使用说明》…'), placeholder=True)
            send_btn.disabled = True
            status.value = t('正在查《使用说明》…')
            try:
                page.update()
            except Exception:                               # noqa: BLE001
                pass

            async def work() -> None:
                try:
                    res = await manual_qa.answer(q, lang, history=list(history))
                except Exception as ex:                     # noqa: BLE001
                    # **不许静默**：异常也得变成屏幕上一句话，别让气泡永远停在"正在查"
                    # [EN] **No silence allowed**: exceptions must become a sentence on screen, don't let the bubble sit at
                    # [EN] "searching" forever
                    res = {'ok': False, 'sources': [], 'why': 'exception',
                           'text': t('这次没能问到模型：{e}', e=str(ex)[:120])}
                try:
                    idx = chat_col.controls.index(hold)
                except ValueError:                          # 控件被换过位置
                # [EN] the control was swapped to a different position
                    idx = len(chat_col.controls) - 1
                chat_col.controls[idx] = chat_bubble(res.get('text') or '', False)
                # 依据单独一行小字。模型自己写了「依据」就不重复（它是照标题抄的，更贴题）。
                # [EN] basis on a separate line in small text. If the model wrote "basis" itself, don't repeat (it
                # [EN] copied the heading, more on-topic).
                tail = str(res.get('text') or '')[-40:]
                if res.get('sources') and '依据' not in tail:
                    chat_col.controls.insert(idx + 1, _note(
                        t('依据 {n} 个章节：{s}', n=len(res['sources']),
                          s=' · '.join(res['sources'][:3]))))
                elif res.get('why') == 'no_hit':
                    chat_col.controls.insert(idx + 1, _note(
                        t('没有找到相关章节，模型没有被调用。')))
                history.append({'role': 'user', 'content': q})
                history.append({'role': 'assistant',
                                'content': str(res.get('text') or '')})
                if len(history) > manual_qa.HISTORY_MAX_TURNS * 4:
                    del history[:len(history) - manual_qa.HISTORY_MAX_TURNS * 2]
                status.value = ''
                send_btn.disabled = False
                try:
                    page.update()
                except Exception:                           # noqa: BLE001
                    pass

            page.run_task(work)

        if q_field is not None:
            q_field.on_submit = lambda e: _ask()
        send_btn.on_click = lambda e: _ask()

        # 开局给几个能直接点的问题 —— 空输入框最难的是"不知道该问什么"
        # [EN] Start with a few directly clickable questions —— the hardest thing about an empty input box is
        # [EN] "not knowing what to ask"
        examples = ([t('怎么设置运行模式'), t('顶级规则怎么写'), t('对话插图有哪几种')]
                    if lang == 'zh'
                    else [t('How do I set the run mode?'),
                          t('How do I write top-level rules?'),
                          t('What dialogue image modes are there?')])
        ex_row = ft.Row(
            [mk_btn(qq, primary=False, height=BTN_H,
                    on_click=lambda e, _q=qq: _ask(_q)) for qq in examples],
            spacing=8, wrap=True)
        if off:
            # 示例按钮也一起灰掉：它们点了也是走 `_ask`，留着能点就成了骗人
            # [EN] Gray out the sample buttons too: clicking them also goes through `_ask`, leaving them clickable
            # [EN] is deceptive
            for _b in ex_row.controls:
                _b.disabled = True

        def _go_configure(e=None) -> None:
            """从帮助里直接跳去配 LLM —— 跟首启引导框的「去配置」同一个落点。

            ⚠ `tab=` **必须取 `self.TAB_LLM`**（2026-10-08 判据查出来的第二处）：
            这里原来写死 `1`，而 `1` 现在是「常规」页 ——
            用户从帮助里点"去配 LLM"，看到的是**项目根目录**。
            （首启引导框那一处早就用常量了，这一处当时漏改；
              是 `tools/verify_regular_tab.py` 的 A4 按行查出来的。）
            
                        English:
            Jump straight from help to LLM config -- same destination as the "Go configure" in the first-run
            guide dialog.
                        ⚠ `tab=` **must be `self.TAB_LLM`** (the second occurrence found by the 2026-10-08 check):
                        here it was originally hardcoded as `1`, and `1` is now the "General" page --
                        when the user clicks "go configure LLM" from help, what they see is the **project root directory**.
                        (The first-run guide dialog already used the constant long ago; this occurrence was missed at the time;
                          it was found by line-by-line A4 check in `tools/verify_regular_tab.py`.)
            """
            try:
                page.pop_dialog()
            except Exception:                               # noqa: BLE001
                pass
            self.show_global_settings(tab=self.TAB_LLM)

        if off:
            chat_col.controls.append(ft.Text(
                t('（配置好 LLM 之后，这里会显示问答记录）'),
                size=HINT_FS, color=C['muted']))
            head: list = [ft.Container(
                content=ft.Column([
                    ft.Text(t('LLM 还没配置，「问个问题」暂时用不了。'),
                            size=BODY_FS, color=C['seal'],
                            weight=ft.FontWeight.BOLD),
                    ft.Text(t('缺什么：{why}', why=off_why),
                            size=HINT_FS, color=C['muted']),
                    ft.Text(t('它要调模型照着《使用说明》答题。没配好之前，'
                              '可以先用「帮助信息」页的关键词检索 —— 那个不调模型。'),
                            size=HINT_FS, color=C['muted']),
                    ft.Row([mk_btn(t('去配置'), primary=True, height=BTN_H,
                                   on_click=_go_configure),
                            ft.Text(t('申请与填写步骤见使用说明的'
                                      '「2.4 API Key 获取」与「3.4 怎么把 Key 配进来」。'),
                                    size=HINT_FS, color=C['muted'])],
                           spacing=10, vertical_alignment=ft.CrossAxisAlignment.CENTER),
                ], spacing=3),
                bgcolor=C['input_bg'], border=make_border(1, C['border']),
                border_radius=6, padding=ft.Padding(10, 8, 10, 8), width=HELP_W)]
        else:
            head = [
                ft.Text(t('回答只依据随程序附带的《{f}》；说明书里没写的会直说。',
                          f=doc.name), size=HINT_FS, color=C['muted']),
                ft.Text(t('可以问使用上的任何问题。下面几个是现成的例子 ——'),
                        size=BODY_FS, color=C['muted']),
            ]

        return ft.Column(head + [
            ex_row,
            # 车道在 `chat_col` 自己的 padding 里（`HELP_CHAT_LANE`），
            # 条由 `_scroll_bar` 画在车道中——外层的右内边距就给一个小值，
            # 别跟车道叠成两道（叠起来条会离右边缘很远，看着像没贴着边）。
            # [EN] The lane is in `chat_col`'s own padding (`HELP_CHAT_LANE`),
            # [EN] the bar is drawn in the lane by `_scroll_bar` —— the outer right padding just gets a small
            # [EN] value,
            # [EN] don't stack two lanes (stacking pushes the bar far from the right edge, looking like it's not
            # [EN] hugging the edge).
            ft.Container(content=chat_bar, expand=True, bgcolor=C['input_bg'],
                         border=make_border(1, C['border']), border_radius=6,
                         padding=ft.Padding(12, 8, 4, 8)),
            ft.Row([q_row, send_btn], spacing=8,
                   vertical_alignment=ft.CrossAxisAlignment.CENTER),
            status,
        ], spacing=8, width=HELP_W, height=HELP_PANE_H)

    def show_help_qa_dialog(self, e=None, question: str = '') -> None:
        """直接打开帮助面板的「问个问题」那一页。

        保留这个入口：命令框、以及上一版留下的调用点都走它
        —— 现在两页在同一个窗口里，所以它只是"开帮助 + 切到第 2 个选项卡"。
        
                English:
        Directly open the "Ask a Question" page of the help panel.
                Keep this entry point: both the command box and the call sites left over from the previous version go through it
                — now both pages are in the same window, so it just "opens help + switches to the 2nd tab".
        """
        self.show_help_dialog(tab=1, question=question)

    # ── 运行界面命令框：只接了文档第 5 节里最基础的几条 ──
    # [EN] ── Run screen command box: only the most basic few from section 5 of the doc are wired up ──
    # 说明书的命令表列了 20 多条（progress / snapshot / rewind / focus …），
    # 现实是**一条都没接**，而输入框的提示语却写着"输入 /help 获得帮助"。
    # 与其留着这个空头承诺，不如先把这几条真接上、其余老实说"还没实现"。
    # [EN] The manual's command table lists 20+ (progress / snapshot / rewind / focus …),
    # [EN] in reality **not a single one is wired up**, yet the input box placeholder says "type /help for
    # [EN] help".
    # [EN] Rather than keep this empty promise, better to actually wire up these few first and honestly say
    # [EN] "not implemented yet" for the rest.
    _RUN_CMDS = {
        'help': 'help', '?': 'help', 'h': 'help',
        'status': 'status', 'st': 'status',
        'settings': 'settings', 'set': 'settings',
        # `opening`（2026-10-06）：重看本轮开场 —— 它是这一轮的扉页，
        # 中途回看"我们这一轮是从哪开始的"比翻日志快得多（§3.6.1 / §11.3）。
        # [EN] `opening` (2026-10-06): re-view this round's opening —— it's the title page of this round,
        # [EN] mid-way re-viewing "where did we start this round" is much faster than digging through logs
        # [EN] (§3.6.1 / §11.3).
        'opening': 'opening', 'op': 'opening',
    }

    def show_current_opening(self) -> str:
        """重看本轮开场（命令 `opening`）。读**落盘的那份**，不重算。

        为什么读文件：开场是「那一刻」的扉页 —— 重算会带上"现在"的在场人物与
        天气，那就不是当时那一屏了。没有这个文件（旧一轮 / 关掉了开关）就说清楚。

        **再推一张卡到中栏，不弹对话框**（2026-10-06 用户改的）：开场在这一轮里
        始终是一张卡，形态统一；推到流末尾也比"关掉再打开一个框"好找。
        
                English:
        Re-read this round's opening (command `opening`). Read **the persisted copy**, don't recompute.
                Why read the file: the opening is the title page of "that moment" — recomputing would bring in the characters present "now" and
                the weather, and that wouldn't be the screen from back then. If the file doesn't exist (old round / switch turned off), say so clearly.
                **Push another card to the middle column, no dialog popup** (changed by user on 2026-10-06): the opening stays as one card
                throughout this round, consistent in form; pushing it to the end of the stream is also easier to find than "close then open a box".
        """
        s = self.session
        if s is None or s.run is None:
            self._post_message(t('还没有在跑的故事 —— 开一轮才有开场'),
                               level='info', snack=True)
            return t('没有在跑的故事')
        from sim import opening as OP
        txt = OP.read_saved(s.run)
        if not txt:
            self._post_message(
                t('本轮没有开场.md —— 可能是关掉了「每轮开场」，或是旧的一轮'),
                level='warn', snack=True)
            return t('没有开场')
        self._push_live_card(txt, 'opening')
        self._post_message(t('已把本轮开场重新推到中栏'), level='info', snack=True)
        return t('已把本轮开场重新推到中栏')

    def run_command(self, text: str) -> str:
        """执行命令框里的一行命令，返回给作者看的结果（同时进消息框）。
                English:
        Execute a one-line command from the command box, and return the result for the author to see
        (also goes into the message box).
        """
        raw = (text or '').strip()
        parts = raw.lstrip('/').split()
        key = parts[0].lower() if parts else ''
        what = self._RUN_CMDS.get(key)
        if what == 'help':
            self.show_help_dialog()
            return t('已打开帮助')
        if what == 'status':
            status, _color = self._run_status_text()
            self._post_message(t('状态：{s}', s=status), level='info', snack=True)
            return status
        if what == 'settings':
            self.show_global_settings()
            return t('已打开天机（程序设置）')
        if what == 'opening':
            return self.show_current_opening()
        self._post_message(
            t('命令「{c}」还没接上 —— 说明书第 5 节里列的那些命令目前只有 '
              'help / status / settings 三条可用', c=raw),
            level='warn', snack=True)
        return t('未实现的命令：{c}', c=raw)

    def _get_file_picker(self) -> ft.FilePicker:
        """获取（懒创建）单例 FilePicker，并注册到 page.services。
                English:
        Get (lazily create) the singleton FilePicker and register it with page.services.
        """
        if getattr(self, '_file_picker', None) is None:
            fp = ft.FilePicker()
            self._file_picker = fp
            try:
                self.page.services.append(fp)
            except Exception:
                try:
                    self.page.overlay.append(fp)
                except Exception:
                    log_exception(t("注册 FilePicker 失败"), category="ui")
        return self._file_picker

    def _wizard_body(self, controls: list, head: list | None = None) -> ft.Container:
        """向导一步的内容区（**两步共用**：首屏那次 + 每次翻页）。

        ★ 加自绘常驻条（用户 2026-10-06：「标框的地方没有滚动条」）。
        这里**不用另留车道**：`DLG_W` 的定义本来就含一条 24px 的车道
        （`DLG_W = 控件宽 520 + 滚动条车道 24 + 纸框内边距 56`），
        而步骤内容不超过 `WIZ_W`(580) —— 车道里那 4px 上下的地方是空着的，
        条画进去不压任何控件（这也是为什么 `lane=TAB_GUTTER`）。

        ★★ `head` 给「这一步的标题」用时，**标题被钉在滚动区外面**
        （用户 2026-10-11：「滚动条动的时候 标题不能动 标题下面的动才对」）。
        做法不是在标题上做手脚，而是**换一层结构**：
          · 不给 `head` → 老结构（一个 `Container` 包住 `Stack`），
            **前 4 步之外的地方逐字节不变**；
          · 给了 `head` → `Column([钉住的标题, 滚动区(expand=True)])`。
            滚动区用 `expand=True` 吃掉**剩余高度**，所以"标题多高"不用猜
            （字号设置一改，标题就变高；写死一个数迟早溢出）。
        ⚠ 滚动那层仍要有**确定的高度**（`Column` 自己能滚、但没高度就撑成
          内容那么高）：靠的就是外面那个 `Container(height=DLG_H_WIZARD)`
          给 `Column` 的**紧约束**，`expand` 再把剩下的分给滚动区。

        ⚠ 原来这里写着 `scroll=ft.ScrollMode.AUTO` 就以为有滚动条了 ——
        Flutter 的滚动条**只在拖动时现身**（见 `mk_scroll_bar` 的文件头）。
        
                English:
        Content area for one wizard step (**shared by two steps**: the initial screen + every page
        turn).
                ★ Add a custom-drawn persistent bar (user 2026-10-06: "the framed area has no scrollbar").
                No **need to reserve a separate lane** here: the definition of `DLG_W` already includes a 24px lane
                (`DLG_W = control width 520 + scrollbar lane 24 + paper frame inner padding 56`),
                and step content never exceeds `WIZ_W` (580) — the 4px or so inside the lane is free space,
                so drawing the bar there doesn't squeeze any control (this is also why `lane=TAB_GUTTER`).
                ★★ When `head` is given (this step's title), **the title is pinned outside the scroll
                area** (user 2026-10-11: "when the scrollbar moves the title must not move; what is below
                the title should").
                The trick is not to fiddle with the title but to **swap the structure**:
                  · No `head` -> the old structure (one `Container` wrapping a `Stack`), so everything
                    outside the wizard's step 4 stays **byte-identical**;
                  · With `head` -> `Column([pinned title, scroll area (expand=True)])`.
                    The scroll area uses `expand=True` to take the **remaining height**, so "how tall the
                    title is" never has to be guessed (change the font size and the title grows; a
                    hardcoded number would overflow sooner or later).
                ⚠ The scrolling layer must still have a **definite height** (a `Column` can scroll, but
                  without a height it grows as tall as its content): this comes from the **tight
                  constraint** the outer `Container(height=DLG_H_WIZARD)` puts on the `Column`, and
                  `expand` then hands the remainder to the scroll area.
                ⚠ Originally it said `scroll=ft.ScrollMode.AUTO` here and assumed there was a scrollbar —
                Flutter's scrollbar **only appears while dragging** (see the file header of `mk_scroll_bar`).
        """
        col = ft.Column(controls, spacing=12, scroll=ft.ScrollMode.AUTO,
                        width=DLG_W)
        if not head:
            bar = mk_scroll_bar(col, DLG_H_WIZARD, lane=TAB_GUTTER, scroller=col)
            return ft.Container(content=bar, width=DLG_W, height=DLG_H_WIZARD)
        # 有标题：标题**不参与滚动**（它连 `col` 都不是），滚动区吃掉剩下的高度。
        # [EN] With a title: the title **does not scroll** (it isn't even inside `col`); the scroll area
        # [EN] takes the remaining height.
        head_col = ft.Column(list(head), spacing=0, width=DLG_W)
        bar = mk_scroll_bar(col, DLG_H_WIZARD - WIZ_HEAD_H, lane=TAB_GUTTER,
                            scroller=col)
        return ft.Container(
            content=ft.Column([head_col, ft.Container(content=bar, expand=True)],
                              spacing=WIZ_HEAD_GAP, width=DLG_W, expand=True),
            width=DLG_W, height=DLG_H_WIZARD)

    def show_booklab_dialog(self):
        """**拆书对话框**（开始菜单「拆　书」）。

        用户 2026-10-07：「你加一个拆书功能，在开始菜单里放一个位置，打开之后是
        拆书对话框，**跟开卷类似但是我传入的是一本书籍或者一本书的一部分**，
        你问我**书籍名字 类型 觉得哪些地方好 重点拆什么**……」

        与「开卷」的区别（代码上也是两套东西，别混）：
          · 开卷（`show_import_wizard`）读的是**你要写的**那本书的素材 →
            变成设定集 → 进项目；
          · 拆书（这里）读的是**你觉得写得好的**那本书 → 变成**写法** →
            进 `skills/`，以后写同类书时被各职位引用。
          一句话：开卷是"把这本书变成我的世界"，拆书是"把这本书变成我的本事"。

        三段式（一个对话框内切换，不翻页 —— 拆书只有四问，翻页反而累）：
          ① 填四问 + 选书 → ② 跑（进度） → ③ 结果 + 已写入哪儿。
        
                English:
        **Book breakdown dialog** (start menu "拆　书").
                User 2026-10-07: "Add a book breakdown feature, put a spot in the start menu, and when opened it's
                the book breakdown dialog, **similar to opening a book but what I pass in is a book or part of a book**,
                you ask me **book name, type, which parts you think are good, what to focus on breaking down**……"
                Differences from "open book" (also two separate things in code, don't mix them up):
                  · Open book (`show_import_wizard`) reads the material of **the book you want to write** →
                    becomes a setting collection → goes into the project;
                  · Book breakdown (here) reads **the book you think is well written** → becomes **writing technique** →
                    goes into `skills/`, and is later referenced by each role when writing books of the same kind.
                  In one sentence: open book is "turn this book into my world", book breakdown is "turn this book into my skill".
                Three-stage form (switch within one dialog, no paging — book breakdown has only four questions, paging is more tiring):
                  ① Fill in four questions + choose book → ② run (progress) → ③ result + where it was written.
        """
        page = self.page
        # ★ 总开关（`BOOKLAB_ENABLED`）：关掉时说清是关掉了，**不是"点了没反应"**
        # [EN] ★ Master switch (`BOOKLAB_ENABLED`): when off, state clearly that it's off, **not "clicked and
        # [EN] nothing happened"**
        if not CFG.b('BOOKLAB_ENABLED'):
            self._show_snack(t('拆书功能被关掉了（天机里的 `BOOKLAB_ENABLED`）'),
                             error=True)
            return
        st: dict = {'busy': False, 'cancel': False,
                    'digest': None, 'written': None, 'err': ''}
        # ★ 「从哪儿读」的选择：**四选一、互斥**（文件 / 文件夹 / 网址 / samples）。
        #   `mode` 是 `'' | 'file' | 'dir' | 'url' | 'sample'`，`path` 是本地那个来源的路径。
        #   —— 放在 `self` 上而不是 `st` 上：`st` 每次打开都新建（对：运行结果不该跨次留），
        #   但"我上次选的是哪本书"跨次记住才顺手（关掉看一眼再打开不用重选）。
        # [EN] ★ The "read from where" choice: **pick one of four, mutually exclusive** (file / folder / URL /
        # [EN] samples).
        # [EN] `mode` is `'' | 'file' | 'dir' | 'url' | 'sample'`, `path` is the path of that local source.
        # [EN] —— Stored on `self` rather than `st`: `st` is recreated on every open (correct: run results
        # [EN] shouldn't persist across opens),
        # [EN] but remembering "which book I chose last time" across opens is convenient (close to peek and
        # [EN] reopen without re-selecting).
        if not hasattr(self, '_booklab_src'):
            self._booklab_src = {'mode': '', 'path': '', 'url': ''}
        body = ft.Column([], spacing=10, scroll=ft.ScrollMode.AUTO)

        def _log(text: str, level: str = 'stage') -> None:
            """进度行（对话框内的那一小块日志）。
                        English:
            Progress line (that little log inside the dialog).
            """
            try:
                body.controls.append(ft.Text(text, size=HINT_FS,
                                             color=C['muted'],
                                             selectable=True))
                page.update()
            except Exception:                                     # noqa: BLE001
                pass

        def render() -> None:
            body.controls = self._booklab_body(st, body, render, _log, dlg)
            try:
                page.update()
            except Exception:                                     # noqa: BLE001
                pass

        dlg = mk_dialog(
            t('拆　书'),
            ft.Container(body, width=DLG_W, height=DLG_H),
            [mk_btn(t('关闭'), on_click=lambda e: page.pop_dialog(), primary=False)],
        )
        render()
        page.show_dialog(dlg)

    def _booklab_body(self, st: dict, body, render, _log, dlg) -> list:
        """拆书对话框的内容（按 `st` 的三段状态画）。
                English:
        Contents of the book breakdown dialog (drawn according to `st`'s three-stage state).
        """
        from booklab import theory as BT
        out: list = []

        if st['busy']:
            out.append(ft.Text(t('正在拆……这一步会有几十次模型调用，'
                                 '可以关掉窗口去干别的（拆完会写进技能库）'),
                               size=BODY_FS, color=C['gold']))
            out.append(ft.Text(t('每读完一批就报一行 —— 下面这些能看出它读到哪儿了'),
                               size=HINT_FS, color=C['muted']))
            return out

        if st['digest'] is not None:
            d = st['digest']
            out.append(ft.Text(t('拆完了。'), size=SEC_FS, color=C['gold']))
            bk = getattr(d, 'book', None)
            if bk is not None:
                # **从哪儿读的、读了哪一段** —— 必须显示：不然以后回头看
                # "这份结论"分不清它拆的是整本还是别人圈的一截。
                # [EN] **Where it was read from, which segment was read** —— must be shown: otherwise when looking back
                # [EN] later
                # [EN] "this conclusion" can't be told apart from whether it parsed the whole book or a segment someone
                # [EN] circled.
                _sk = {'file': t('文件'), 'dir': t('文件夹'), 'url': t('网址')}
                out.append(ft.Text(
                    t('读了（{k}）：{s}', k=_sk.get(bk.source_kind, t('文件')),
                      s=bk.summary()),
                    size=HINT_FS, color=C['muted']))
                _sel = getattr(bk, 'selection', None)
                if _sel is not None and _sel.active():
                    out.append(mk_text(
                        t('**只拆了这一部分**：{x}（源里一共 {n} {u}）',
                          x=_sel.describe(bk.n, bk.unit_kind),
                          n=bk.total_units, u=bk.unit_kind),
                        size=HINT_FS, color=C['gold']))
            if d.ok:
                out.append(ft.Text(
                    t('归纳出 {n} 条可复用的写法（粗扫 {c}，精读 {d} 条笔记，'
                      '用时 {s:.0f} 秒）',
                      n=len(d.modules), c=d.coverage, d=len(d.deep),
                      s=d.seconds),
                    size=BODY_FS, color=C['text']))
            else:
                out.append(mk_text(
                    t('这一轮**没归纳出可用的写法** —— 报告仍然写出来了，'
                      '可以打开看看问题出在哪一步。'),
                    size=BODY_FS, color=DANGER))
            for i, m in enumerate(d.modules, 1):
                out.append(ft.Text(f'{i}. {m.get("名称")}', size=BODY_FS,
                                   color=C['text'], weight=ft.FontWeight.BOLD))
                out.append(ft.Text(str(m.get('怎么做') or '')[:170],
                                   size=HINT_FS, color=C['muted'], selectable=True))
            w = st['written']
            if w is not None:
                out.append(ft.Divider(height=10, color='transparent'))
                out.append(ft.Text(t('已写入技能库：{p}', p=str(w.dir)),
                                   size=BODY_FS, color=C['gold']))
                out.append(mk_text(t('以后写**同类型**的书时，各职位会自动拿到这一份'
                                     '（三人小组拿到的是完整版）。'),
                                   size=HINT_FS, color=C['muted']))
                out.append(ft.Row([
                    mk_btn(t('打开文件夹'), lambda e: self._open_path(w.dir)),
                    mk_btn(t('看拆书记录'), lambda e: self._open_path(
                        w.dir / '拆书记录.md'), primary=False),
                    mk_btn(t('再拆一本'), lambda e: (
                        st.update({'digest': None, 'written': None, 'err': ''}),
                        # 来源也一起清空：选中的那个要**同时**在界面上取消高亮，
                        # 不然"再拆一本"之后按钮还亮着，看起来像已经选好了新书。
                        # [EN] Also clear the source: the selected one must **simultaneously** be de-highlighted in the UI,
                        # [EN] otherwise after "parse another book" the button is still lit, looking like a new book is already
                        # [EN] selected.
                        self._booklab_src.update({'mode': '', 'path': ''}),
                        render()), primary=False),
                ], spacing=8))
            if d.notes:
                out.append(ft.Divider(height=8, color='transparent'))
                out.append(ft.Text(t('这一步的说明（照实记）：'), size=HINT_FS,
                                   color=C['muted']))
                for x in d.notes[:5]:
                    out.append(ft.Text(f'· {x}', size=HINT_FS,
                                       color=C['muted'], selectable=True))
            return out

        # ── ① 输入 ──
        # [EN] ── ① Input ──
        f = self._booklab_fields = getattr(self, '_booklab_fields', {})
        out.append(mk_text(t('拆书不是读书笔记 —— 它读的是**写法**：'
                             '节奏怎么控、人物怎么立、情节怎么推。'
                             '拆出来的东西会进技能库，以后写同类故事时被剧组用上。'),
                           size=BODY_FS, color=C['muted']))
        for q in BT.questions_text():
            key = q['key']
            if key not in f:
                f[key] = mk_field(t(q['ask']), '', width=SET_W,
                                  hint=t(q['hint']))
            out.append(f[key])

        # ── 从哪儿读（**四选一，互斥**：文件 / 文件夹 / 网址 / samples）──
        #  用户 2026-10-10（加这个功能时）：「同时支持传入文件（PDF docx md html txt等
        #  文档格式）或者包含这些类型文件的文件夹 或者一个网址 里面是书籍的索引网页」。
        #  用户 2026-10-10（本轮改）：「把网址移动到下面，可以改成一个名字叫网址的
        #  按钮，点了之后输入网址。而且你要让这几个选项互斥，只能够选择一个」。
        # [EN] ── Read from where (**pick one of four, mutually exclusive**: file / folder / URL / samples) ──
        # [EN] User 2026-10-10 (when adding this feature): "also support passing in a file (PDF docx md html
        # [EN] txt etc
        # [EN] document formats) or a folder containing files of these types or a URL which is a book's index
        # [EN] page".
        # [EN] User 2026-10-10 (this round's change): "move the URL down, it can be changed into a button
        # [EN] named URL, clicking it then lets you input the URL. And you must make these options mutually
        # [EN] exclusive, only one can be selected".
        #  ★★ 为什么"互斥"不是件小事：上一版是**隐式优先级** —— 网址框填了就以网址
        #    为准，只在下面用一行小字解释"下面的文件/文件夹会被忽略"。两个毛病：
        #      ① 用户得**读那行小字**才知道到底用了哪个，不读就只能猜；
        #      ② 网址和文件**都填了**的时候，界面上两处都像"已选"，没有任何东西
        #         告诉他选重了 —— 而结果会**静默地**只用其中一个。
        #    改成显式互斥之后：**任一时刻只有一个来源是实心的**，
        #    而且"一个都没选"也看得见（四个都是文字按钮），开跑时直接指着他说。
        # [EN] ★★ Why "mutually exclusive" is not a small matter: the previous version was **implicit
        # [EN] priority** —— if the URL box was filled, the URL
        # [EN] took precedence, with only a line of small text below explaining "the file/folder below will be
        # [EN] ignored". Two problems:
        # [EN] ① The user has to **read that small line** to know which one was actually used, otherwise they
        # [EN] can only guess;
        # [EN] ② When **both** URL and file are filled, both spots in the UI look "selected", and nothing
        # [EN] tells them the selection is duplicated —— while the result **silently** uses only one of them.
        # [EN] After changing to explicit mutual exclusion: **at any moment only one source is solid**,
        # [EN] and "none selected" is also visible (all four are text buttons), and on start it points at them
        # [EN] directly.
        #  四个按钮是一组的（含 samples —— 它本质也是"给一个本地路径"）：
        #      [选一个文件] [选一个文件夹] [网址]
        #      [用 sample 测试]
        #  选中的那个是**实心按钮**，其余是文字按钮 ⇒ 一眼看出当前用的哪个。
        # [EN] The four buttons are one group (including samples —— it's essentially also "give a local path"):
        # [EN] [Select a file] [Select a folder] [URL]
        # [EN] [Test with sample]
        # [EN] The selected one is a **solid button**, the rest are text buttons ⇒ see at a glance which is in
        # [EN] use.
        #  ★ 网址那一格从"最上面一个常驻输入框"改成"按钮点开才出现的框"（用户点名）：
        #    它原先挤在四个问题下面、看着像"必填的主入口"，而它其实只是四种来源之一。
        # [EN] ★ The URL cell changed from "a permanent input box at the top" to "a box that appears only when
        # [EN] the button is clicked" (user-pointed):
        # [EN] it used to be squeezed below the four questions, looking like a "required main entry", while
        # [EN] it's actually just one of four sources.
        #  ★ 来源选择存在 `self` 上、**不**存在 `st` 上：`st` 每次打开对话框都新建
        #    （那是对的 —— 上一次的运行结果不该跨次留着），但"我上次选的是哪本书"
        #    跨次记住才顺手（关掉看一眼再打开，不用从头重选）。
        # [EN] ★ Source selection is stored on `self`, **not** on `st`: `st` is recreated every time the dialog
        # [EN] is opened
        # [EN] (that's correct —— the last run's result shouldn't persist across opens), but "which book I
        # [EN] chose last time"
        # [EN] persisting across opens is convenient (close to peek and reopen without re-selecting from
        # [EN] scratch).
        src_st = self._booklab_src
        # 范围那一行的**实时回显**（写错了当场看得见，不用等跑完）
        # [EN] The **live echo** of the scope line (typos visible on the spot, no need to wait for the run to
        # [EN] finish)
        sel_line = f.get('__sel_line')
        if sel_line is None:
            sel_line = f['__sel_line'] = ft.Text('', size=HINT_FS,
                                                 color=C['muted'])

        def _sync_sel(e=None) -> None:
            """把范围输入框的内容解析一遍，回显成人话（或报错）。
                        English:
            Parse the contents of the range input field once, and echo it back in plain words (or report an
            error).
            """
            from booklab import selection as BSEL
            raw = field_value(f.get('__range')) if f.get('__range') else ''
            s = BSEL.parse(raw)
            if not raw.strip():
                sel_line.value = t('留空 = 整本（按分层取样读）')
                sel_line.color = C['muted']
            elif s.ok:
                sel_line.value = t('只拆：{x}', x=s.label())
                sel_line.color = C['gold']
            else:
                sel_line.value = '⚠ ' + s.err
                sel_line.color = DANGER
            try:
                self.page.update()
            except Exception:                                     # noqa: BLE001
                pass

        def _src_text() -> str:
            """回显**当前唯一那个来源**（互斥之后就不需要"以谁为准"那句话了）。
                        English:
            Echo **the currently unique source** (after mutual exclusion there is no need for the "which one
            takes precedence" line).
            """
            m = src_st['mode']
            if m == 'url':
                # ★ 2026-10-10 改：网址改成**弹对话框**输入之后，这一行要把地址
                #   显示出来 —— 不然关掉那个对话框，界面上就只剩一个「网址」按钮
                #   亮着，**看不出填的是什么**（原来框常驻在下面，所以不存在这个问题）。
                # [EN] ★ 2026-10-10 change: after the URL was changed to a **popup dialog** input, this line must
                # [EN] display the address —— otherwise after closing that dialog, the UI is left with just a "URL"
                # [EN] button
                # [EN] lit, **with no way to tell what was filled in** (previously the box was permanent below, so this
                # [EN] problem didn't exist).
                u = str(src_st.get('url') or '').strip()
                return (t('网址：{u}', u=u) if u
                        else t('网址还没填 —— 再点一次「网址」填上'))
            if m and src_st['path']:
                return t('选了：{p}', p=src_st['path'])
            return t('还没选书 —— 在上面选一个，或者点「网址」填地址')

        def _resolve_src() -> str:
            """真实要读的那个来源（`_start` 与 `_booklab_start` 都走这里）。
                        English:
            The source actually to be read (`_start` and `_booklab_start` both go through here).
            """
            if src_st['mode'] == 'url':
                return str(src_st.get('url') or '').strip()
            return str(src_st['path'] or '') if src_st['mode'] else ''

        def _set_src(mode: str, path: str = '') -> None:
            """切来源 —— **互斥**：切到哪个，其余自动撤销（这就是用户要的那条）。

            切完立刻重画：实心按钮、回显行都跟着变。
            
                        English:
            Switch source -- **mutually exclusive**: switching to one automatically deselects the others
            (this is the one the user wanted).
                        Redraw immediately after switching: the solid button and the echo line both follow.
            """
            src_st['mode'] = mode
            if path:
                src_st['path'] = path
            render()

        def _ask_url() -> None:
            """点「网址」→ **弹一个小对话框**让用户填地址（用户 2026-10-10 要求）。

            用户原话：「点击网址时候 弹出一个对话框 输入网址 而不是在下面」。

            ★ 为什么这个改动顺带修掉一类隐患：原来那个输入框是**常驻在主对话框里**
              的控件（缓存在 `self._booklab_fields`）。而"关掉对话框再打开"时，
              同一个控件对象会被挂到**新的**控件树上 —— Flet 对"一个控件同时属于
              两棵树"是会报错的。改成每次弹新对话框、每次新建一个输入框，
              这个隐患从结构上就没了（`_booklab_fields` 里只剩 `__range` 还在常驻）。
            ★ 取消/填了地址都只做一件事：**确定**才把地址记下来并选中「网址」；
              **取消**不改变当前来源（用户点了取消又没取消掉当前选择，才符合直觉）。

            ⚠ 第二版（用户 2026-10-10 下午）：「网址对话框是不是太高了 但又太窄了」。
              两个毛病都在**那一次调用的写法**上：
                · 高度没给 —— 传进去的是**裸 `ft.Column`**，而 `mk_dialog` 是从
                  `content` 身上读尺寸的（`getattr(content,'height',None)` → None），
                  读不到就被内层 `expand=True` **拉到接近满屏**（实测 1081px）；
                · 宽度自创了 440（`DLG_W - 160`），而全软件只有一档对话框宽度。
              ⇒ 现在包成 `ft.Container(width=DLG_W_URL, height=DLG_H_URL)`。
            
                        English:
            Click "URL" -> **pop up a small dialog** for the user to enter the address (requested by the
            user on 2026-10-10).
                        User's exact words: "when clicking URL pop up a dialog to enter the URL instead of below".
                        ★ Why this change incidentally fixes a class of hidden issue: the original input field was a control
                          **permanently living in the main dialog** (cached in `self._booklab_fields`). And when "closing the dialog then reopening it",
                          the same control object gets attached to a **new** control tree -- Flet does report errors for
                          "one control belonging to two trees at the same time". Changing to popping a new dialog each time, creating a new input field each time,
                          structurally eliminates this hidden issue (only `__range` remains permanently in `_booklab_fields`).
                        ★ Cancel / after entering an address, only one thing is done either way: only **OK** records the address and selects "URL";
                          **Cancel** does not change the current source (the user clicked cancel and didn't cancel the current selection, which is intuitive).
                        ⚠ Second version (user, 2026-10-10 afternoon): "isn't the URL dialog too tall but also too narrow".
                          Both problems are in **the way that one call was written**:
                            · Height not given -- what was passed in was a **bare `ft.Column`**, and `mk_dialog` reads the size
                              from `content` (`getattr(content,'height',None)` -> None),
                              failing to read it, it gets **stretched to near full screen** by the inner `expand=True` (measured 1081px);
                            · The width invented 440 (`DLG_W - 160`), while the whole app has only one dialog width tier.
                          => Now wrapped as `ft.Container(width=DLG_W_URL, height=DLG_H_URL)`.
            """
            fld = mk_field(t('网址'), str(src_st.get('url') or ''),
                           width=SET_W,
                           hint=t('书籍的章节目录页，http… 开头'))

            def _ok(e=None):
                v = field_value(fld).strip()
                self.page.pop_dialog()                    # 先收掉这一层，再改主对话框
                # [EN] Dismiss this layer first, then change the main dialog
                if v:
                    src_st['url'] = v
                    _set_src('url')                  # 记下地址并选中「网址」
                    # [EN] Record the address and select "URL"
                render()

            def _cancel(e=None):
                self.page.pop_dialog()
                render()

            dlg2 = mk_dialog(
                t('网址'),
                # ★ 尺寸**必须挂在这一层 Container 上**（`mkdir`/`mk_dialog` 的约定）
                # [EN] ★ Size **must be attached to this layer's Container** (`mkdir`/`mk_dialog` convention)
                ft.Container(
                    ft.Column([
                        mk_text(t('填书的**索引页**（章节目录那一页）地址 —— '
                                  '程序逐章去爬，只读来看写法，不会转发别人的正文。'),
                                size=HINT_FS, color=C['muted']),
                        fld,
                    ], spacing=8),
                    width=DLG_W_URL, height=DLG_H_URL),
                [mk_btn(t('确定'), _ok),
                 mk_btn(t('取消'), _cancel, primary=False)],
            )
            self.page.show_dialog(dlg2)

        if '__range' not in f:
            f['__range'] = mk_field(
                t('选择范围'), '', width=SET_W - TIP_D - 8,
                hint=t('留空=整本；也可写 1-10,15-21 / 前3章 / 第5章-第8章'),
                on_change=_sync_sel)
        _sync_sel()          # 首屏就把这一行填上（不然它空着，看不出有什么用）
        # [EN] Fill in this line on the first screen (otherwise it stays empty and its purpose is unclear)

        out.append(ft.Divider(height=6, color='transparent'))

        def _src_btn(mode: str, label: str, handler) -> ft.Control:
            """来源按钮：**选中的那个是实心**，其余是文字按钮。

            这一行就是"互斥"在界面上的落点：**看得见当前用的是哪一个**。
            ★ 不钉宽度：实测四个标签的自然宽度加起来只有约 426px（< 520），
              排一行绰绰有余；钉死宽度反而会挤出换行（用户 2026-10-10：
              「这几个按钮之间距离可以近一些 以保证在一行里显示出来」）。
            
                        English:
            Source buttons: **the selected one is solid**, the rest are text buttons.
                        This line is where "mutual exclusion" lands in the UI: **you can see which one is currently in use**.
                        ★ Don't pin the width: measured, the natural widths of the four labels add up to only about 426px (< 520),
                          so one row has plenty of room; pinning the width instead squeezes out a line break (user, 2026-10-10:
                          "the spacing between these buttons can be a bit closer to ensure they display in one row").
            """
            return mk_btn(label, handler, primary=(src_st['mode'] == mode))

        async def _pick_file(e):
            p = await self._booklab_pick(st, want_dir=False)
            if p:
                _set_src('file', p)

        async def _pick_dir(e):
            p = await self._booklab_pick(st, want_dir=True)
            if p:
                _set_src('dir', p)

        def _pick_url(e):
            """点「网址」→ 亮起来 + **弹出输入地址的对话框**（见 `_ask_url`）。
                        English:
            Click "URL" -> lights up + **pops up the dialog to enter the address** (see `_ask_url`).
            """
            _ask_url()

        def _use_sample(e):
            """用 `samples/` 里的一本试拆 —— 手上没有书时最快的上手路径。

            ★ 优先挑**书**（一个文件夹里好几章），而不是随便一个 .md：
              挑到设定文件（`伏笔.md` 那种）时，拆出来的东西会让人以为
              "这功能拆不明白"，而问题出在样本选错了。
            ★ 它也是一个**来源**（`mode='sample'`），跟另外三个互斥 ——
              它给的同样是"一个本地路径"，若还让网址同时亮着就又回到老毛病上了。
            
                        English:
            Use a book in `samples/` to try dissecting -- the fastest way to get started when you don't have
            a book on hand.
                        ★ Prefer picking a **book** (several chapters in one folder), not just any .md:
                          when you pick a settings file (a `伏笔.md` kind), what gets dissected will make people think
                          "this feature can't dissect properly", while the problem is that the wrong sample was picked.
                        ★ It is also a **source** (`mode='sample'`), mutually exclusive with the other three --
                          it likewise provides "a local path"; if the URL is also lit up at the same time, we're back to the old problem.
            """
            try:
                from booklab import reader as BR
                root = APP_DIR / 'samples'
                cands = [d for d in sorted(root.rglob('*'))
                         if d.is_dir() and '__pycache__' not in d.parts
                         and any(f.suffix.lower() in ('.txt', '.md', '.docx')
                                 for f in d.iterdir() if f.is_file())]
                best, best_n = None, 0
                for d in cands:
                    try:
                        n = BR.read_book(str(d)).n
                    except Exception:                             # noqa: BLE001
                        n = 0
                    if n > best_n:
                        best, best_n = d, n
                if best is None or best_n < 2:
                    self._show_snack(t('samples/ 里没有可拆的书'), error=True)
                    return
                _set_src('sample', str(best))
            except Exception as ex:                               # noqa: BLE001
                self._show_snack(t('选示例失败: {ex}', ex=ex), error=True)

        # 四个来源**并排一行**（互斥）——
        #  · 「网址」放**最后一个**：用户 2026-10-10「把网址移动到下面」；
        #  · samples 也在这一行：它是这一组里的第四个（"用随附的样例试一遍"，
        #    本质同样是给一个本地路径）。用户上一轮的原话是
        #    「给问题 用samples/里的一个 这个改名叫做用sample测试」——
        #    名字缩短之后（202 + 28 → 129px）四个正好排得下。
        #  · `spacing=6`：四个标签的自然宽度合计约 426px，520px 的车道放得下还有余量；
        #    间距收紧是为了留出这点余量（用户："这几个按钮之间距离可以近一些"）。
        # [EN] Four sources **in one row** (mutually exclusive) --
        # [EN] · Put "URL" **last**: user 2026-10-10 "move the URL to the bottom";
        # [EN] · samples is also in this row: it is the fourth in this group ("try once with the bundled
        # [EN] samples",
        # [EN] which is essentially also providing a local path). The user's exact words last round were
        # [EN] "for the question use one from samples/ rename this to test with sample" --
        # [EN] after shortening the names (202 + 28 -> 129px) all four fit exactly.
        # [EN] · `spacing=6`: the natural widths of the four labels total about 426px, and the 520px lane fits
        # [EN] them with room to spare;
        # [EN] tightening the spacing is to leave this margin (user: "the distance between these buttons can be
        # [EN] a bit smaller").
        out.append(ft.Row([
            _src_btn('file', t('选一个文件'), _pick_file),
            _src_btn('dir', t('选一个文件夹'), _pick_dir),
            _src_btn('url', t('网址'), _pick_url),
            _src_btn('sample', t('用 sample 测试'), _use_sample),
        ], spacing=6))
        # 当前来源那行回显：**替代**原来那句"以网址为准（下面的会被忽略）" ——
        #   那句话是在解释"谁优先"，而互斥之后不存在优先级，只存在"选中的那个"。
        #   （网址填了什么也在这里回显 —— 因为输入框改成弹对话框之后，
        #    平时界面上看不见那个地址了。）
        # [EN] Echo the current source on that line: **replace** the original sentence "URL takes precedence
        # [EN] (the one below is ignored)" --
        # [EN] that sentence was explaining "who has priority", but after making them mutually exclusive there
        # [EN] is no priority, only "the one selected".
        # [EN] (whatever is filled into the URL is also echoed here -- because after changing the input box
        # [EN] into a popup dialog,
        # [EN] that address is normally not visible on the UI.)
        out.append(ft.Text(
            _src_text(), size=HINT_FS,
            color=(C['muted'] if not src_st['mode']
                   else (C['gold'] if src_st['mode'] == 'url' else C['text']))))

        out.append(ft.Row(
            [f['__range'], mk_tip(t('**只拆其中一段** —— 拆书本来就不用全拆。\n'
                                    '能写：`1-10,15-21`（按第几段）、`前10页`、'
                                    '`前3章`、`第5章-第8章`、`最后2章`、'
                                    '`「井底」`（按章节名里的字）。\n'
                                    '留空 = 整本（程序自己分层取样，'
                                    '开头几章必读、末尾几章也读）。'))],
            spacing=6, vertical_alignment=ft.CrossAxisAlignment.CENTER))
        out.append(sel_line)
        out.append(ft.Text(t('支持 .txt / .md / .docx / .html / .pdf；'
                             '一本被拆成多个文件的，选文件夹。'),
                           size=HINT_FS, color=C['muted']))
        out.append(mk_text(t('长篇小说不用全传 —— **传一部分也行**：'
                             '程序会自己分层取样（开头几章必读），不会逐字读完。'),
                           size=HINT_FS, color=C['muted']))
        if st.get('err'):
            out.append(ft.Text(st['err'], size=HINT_FS, color=DANGER))
        out.append(ft.Divider(height=6, color='transparent'))

        def _start(e):
            # ★ 互斥之后"到底要用哪个"是**显式**的，所以这里能分别说清是哪种错：
            #   一个都没选 / 选了网址但没填 —— 而不是笼统一句"先选一本书"。
            # [EN] ★ After mutual exclusion, "which one to actually use" is **explicit**, so here we can separately
            # [EN] state which kind of error it is:
            # [EN] nothing selected / URL selected but not filled in -- rather than a vague "select a book first".
            if not src_st['mode']:
                self._show_snack(
                    t('先选一本书：文件 / 文件夹 / samples，'
                      '或者点「网址」填一个地址'), error=True)
                return
            if not _resolve_src():
                self._show_snack(
                    t('网址还空着 —— 先在上面那个框里填一个地址')
                    if src_st['mode'] == 'url' else t('还没选书，先选一个'),
                    error=True)
                return
            _sync_sel()
            if not _sel_ok():
                # 范围看不懂时**不许开跑** —— 跑了就等于按"全部"拆了，
                # 而用户以为只拆了 10 页（见 `booklab/selection` 第 1 条纪律）。
                # [EN] When the range cannot be understood, **do not start** -- running it is equivalent to splitting
                # [EN] by "all",
                # [EN] while the user thought only 10 pages were split (see discipline #1 of `booklab/selection`).
                self._show_snack(t('选择范围那行看不懂，改一下再开始'), error=True)
                return
            self._booklab_start(_resolve_src(), st, f, _log, render)

        def _sel_ok() -> bool:
            from booklab import selection as BSEL
            raw = field_value(f.get('__range')) if f.get('__range') else ''
            return BSEL.parse(raw).ok

        out.append(ft.Row([mk_btn(t('开 始 拆'), _start)], spacing=8))
        return out

    async def _booklab_pick(self, st: dict, *, want_dir: bool) -> str:
        """选文件或文件夹（Flet 1.0：这两个都**直接返回结果**，没有回调）。

        ⚠ 两者返回类型不一样：`get_directory_path()` 给**字符串**，
          `pick_files()` 给的是 `FilePickerFile` **列表**（要取 `.path`）——
          第一版按"都返回字符串"写，选文件那条路会静默拿到空串
          （用户点了文件却提示"还没选书"，而且看不出为什么）。
        
                English:
        Pick a file or folder (Flet 1.0: both **return the result directly**, no callback).
                ⚠ The two have different return types: `get_directory_path()` gives a **string**,
                  while `pick_files()` gives a **list** of `FilePickerFile` (need to take `.path`) —
                  the first version was written assuming "both return strings", so the file-picking path would silently get an empty string
                  (the user picked a file but it said "no book selected yet", and there was no way to tell why).
        """
        try:
            fp = self._get_file_picker()
            if want_dir:
                return str(await fp.get_directory_path() or '')
            files = await fp.pick_files(allow_multiple=False)
            if files:
                first = files[0]
                return str(getattr(first, 'path', '') or first)
            return ''
        except Exception as ex:                                   # noqa: BLE001
            log_exception(t('打开文件选择器失败'), category="ui")
            self._show_snack(t('无法打开文件选择器: {ex}', ex=ex), error=True)
            return ''

    def _booklab_start(self, src: str, st: dict, fields: dict, _log, render) -> None:
        """真正开跑（`asyncio.create_task` —— 不阻塞界面）。

        `src` 由调用方按**当前选中的那个来源**算好传进来（见 `_resolve_src`）——
        这里不再自己"网址优先"，因为界面上已经是**互斥**的三选一了：
        谁被选中就是谁，没有"谁优先"这回事（老版本那个隐式优先级已经拆掉）。
        
                English:
        Actually start running (`asyncio.create_task` — doesn't block the UI).
                `src` is computed and passed in by the caller according to **the currently selected source** (see `_resolve_src`) —
                here it no longer does its own "URL first", because the UI is already a **mutually exclusive** three-way choice:
                whoever is selected is the one, there's no such thing as "who takes priority" (the old version's implicit priority has been removed).
        """
        import asyncio

        async def _run() -> None:
            from booklab import analyzer as BA
            from booklab import skillgen as BS
            st['busy'] = True
            render()
            rng = field_value(fields.get('__range')) if fields.get('__range') else ''
            _log(t('开始：{p}', p=src))
            if str(rng).strip():
                _log(t('只拆：{x}', x=str(rng).strip()))
            brief = BA.Brief(
                title=field_value(fields.get('title')) if fields.get('title') else '',
                genre=field_value(fields.get('genre')) if fields.get('genre') else '',
                good=field_value(fields.get('good')) if fields.get('good') else '',
                focus=field_value(fields.get('focus')) if fields.get('focus') else '',
            )
            steps = {'read': t('① 分章'), 'read_done': t('① 分章完了'),
                     'web_index': t('① 打开网址'), 'web_chapters': t('① 找到章节'),
                     'web_one': t('① 抓取'),
                     'metrics': t('② 定量画像'),
                     'scan': t('② 粗扫'), 'deep': t('③ 精读'),
                     'final': t('④ 归纳'), 'done': t('④ 归纳完了')}

            def on_step(key: str, extra: str = '') -> None:
                label = steps.get(key, key)
                _log(f'{label} {extra}'.strip())

            try:
                d = await BA.run(src, brief, on_step=on_step, selection=rng)
            except Exception as ex:                               # noqa: BLE001
                log_exception(t('拆书失败'), category="ui")
                st.update({'busy': False, 'err': t('拆书失败：{ex}', ex=ex)})
                render()
                return
            # 拆完**自动写进技能库** —— 用户要的就是"整理之后变成 SKILL"。
            # 写失败不影响看结果（报告在内存里还在）。
            # [EN] After splitting, **automatically write into the skill library** -- what the user wants is "after
            # [EN] organizing, turn into a SKILL".
            # [EN] Write failure does not affect viewing the result (the report is still in memory).
            try:
                if d.book is not None:
                    w = BS.write(d)
                    BS.reload_registry()
                    st['written'] = w
            except Exception as ex:                               # noqa: BLE001
                log_exception(t('写入技能库失败（结果仍可查看）'), category="ui")
                st['err'] = t('写入技能库失败：{ex}', ex=ex)
            st.update({'busy': False, 'digest': d})
            log_ui_action(t('拆书'), f"{brief.title or d.book.name if d.book else ''}"
                                    f" · {len(d.modules)} 条")
            render()

        asyncio.create_task(_run())

    def _open_path(self, p) -> None:
        """用系统默认程序打开一个文件/文件夹（失败就提示，不静默）。
                English:
        Open a file/folder with the system default program (on failure, show a prompt, don't stay
        silent).
        """
        try:
            import os
            import subprocess
            import sys as _sys
            raw = str(p)
            if _sys.platform.startswith('win'):
                os.startfile(raw)                                 # noqa: S606
            elif _sys.platform == 'darwin':
                subprocess.Popen(['open', raw])                   # noqa: S603,S607
            else:
                subprocess.Popen(['xdg-open', raw])               # noqa: S603,S607
        except Exception as ex:                                   # noqa: BLE001
            log_exception(t('打开失败'), category="ui")
            self._show_snack(t('打开失败：{ex}', ex=ex), error=True)

    def _on_booklab(self, e):
        """开始菜单：拆　书。
                English:
        Start menu: 拆　书.
        """
        self.show_booklab_dialog()

    def show_import_wizard(self):
        """显示导入向导对话框（多步骤）。
                English:
        Show the import wizard dialog (multi-step).
        """
        page = self.page
        current_step = [0]  # 使用列表来在闭包中修改
        # 「这本开过卷没有」的项目清单缓存（见 `_dup_scan`）：每次打开向导重扫一次，
        # 免得上一轮删掉/新建的小说在这条判据里是过期的。
        # [EN] Use a list to modify in the closure
        # [EN] Cache of the project list for "has this book been opened before" (see `_dup_scan`): rescan every
        # [EN] time the wizard opens,
        # [EN] so that novels deleted/created last round are not stale for this criterion.
        self._dup_cache = None

        # 步骤内容
        # [EN] Step content
        steps = [
            self._wizard_step1_folder(page),
            self._wizard_step2_settings(page),
            self._wizard_step3_ai(page),
            # ★ 「剧组 Agents」（2026-10-11）：给各个 Agent 写这一本的定制，
            #   可整步跳过（跳过 = 照 AI 推断 / 软件默认）。
            # [EN] ★ "Crew Agents" (2026-10-11): write the customization for this book for each Agent,
            # [EN] can skip the whole step (skip = follow AI inference / software default).
            self._wizard_step5_agents(page),
            self._wizard_step4_confirm(page),
        ]

        # 向导对话框
        # [EN] Wizard dialog
        # ★ 每一步都带 `head`（标题）与 `content`（会滚的正文）：标题钉在滚动区外面
        #   （用户 2026-10-11「滚动条动的时候标题不能动」），见 `_wizard_body`。
        # [EN] ★ Every step carries `head` (the title) and `content` (the scrolling body): the title is
        # [EN] pinned outside the scroll area (user 2026-10-11: "when the scrollbar moves the title must
        # [EN] not move"), see `_wizard_body`.
        dlg = mk_dialog(
            t("开 卷 · 导 入 向 导"),
            self._wizard_body(steps[0]['content'], steps[0].get('head')),
            [
                ft.FilledButton(content=ft.Text(t("上一步"), size=BTN_FS),
                                on_click=lambda e: prev_step(dlg), disabled=True, height=BTN_H),
                ft.FilledButton(content=ft.Text(t("下一步"), size=BTN_FS),
                                on_click=lambda e: next_step(dlg), height=BTN_H),
                mk_btn(t("取消"), on_click=lambda e: _close_dlg(dlg), primary=False),
            ],
        )
        # 初始：步骤 1 未选文件夹 → 不允许进入下一步
        # [EN] Initial: step 1 has no folder selected -> not allowed to proceed to next step
        dlg.actions[1].disabled = not bool(self._wizard_path)

        def next_step(d):
            if current_step[0] < len(steps) - 1:
                current_step[0] += 1
                update_wizard_content(d)

        def prev_step(d):
            if current_step[0] > 0:
                current_step[0] -= 1
                update_wizard_content(d)

        def _refresh_next_button():
            """按当前步骤的可完成条件刷新「下一步」按钮。
                        English:
            Refresh the "Next" button according to the current step's completion condition.
            """
            step = steps[current_step[0]]
            can = step.get('can_proceed')
            try:
                dlg.actions[1].disabled = bool(can is not None and not can())
            except Exception:
                pass

        self._wizard_refresh_next = _refresh_next_button

        def update_wizard_content(d):
            step = steps[current_step[0]]
            on_enter = step.get('on_enter')
            if callable(on_enter):
                try:
                    on_enter()
                except Exception:
                    log_exception(t("刷新向导内容失败"), category="ui")
            d.content = self._wizard_body(step['content'], step.get('head'))
            # 「上一步」：第一步时禁用
            # [EN] "Previous": disabled on the first step
            d.actions[0].disabled = current_step[0] == 0
            # 「下一步」按钮文案（Flet 1.0：按钮文本在 content，不是 text 属性）
            # [EN] "Next" button text (Flet 1.0: button text is in content, not the text attribute)
            next_btn = d.actions[1]
            try:
                next_btn.content = ft.Text(step.get('next_text', t('下一步')), size=BTN_FS)
            except Exception:
                pass
            # 「下一步」：按步骤条件判定
            # [EN] "Next": determined by step conditions
            _refresh_next_button()
            d.actions[1].on_click = step.get('next_action', lambda e: next_step(d))
            page.update()

        def _close_dlg(d):
            page.pop_dialog()

        page.show_dialog(dlg)
        return dlg

    def _wizard_step1_folder(self, page):
        """步骤 1：选择文件夹。

        注意：Flet 1.0 的 FilePicker 不再通过 on_result 回调返回结果，
        而是 `await get_directory_path()` **直接返回路径字符串**。
        
                English:
        Step 1: choose folder.
                Note: Flet 1.0's FilePicker no longer returns results via the on_result callback,
                but instead `await get_directory_path()` **directly returns the path string**.
        """
        # 左侧标签 + 右侧输入框，和其他对话框统一（不是 Material 浮动标签）
        # [EN] Label on the left + input box on the right, consistent with other dialogs (not Material floating
        # [EN] label)
        path_field = mk_field(
            t("小说文件夹路径"), self._wizard_path or '',
            hint=t(r"E:\我的小说\悬疑故事"),
            # 同一行还有个按钮 → 让出「按钮 96 + 间距 8」，两者加起来正好一行 520
            # [EN] There is also a button on the same row -> give up "button 96 + spacing 8", the two together
            # [EN] exactly make one row of 520
            width=SET_W - 104,
            on_change=self._on_wizard_path_changed,
        )
        # ★ 「这本已经开过卷了」那条提示行（默认藏着）。建好就刷一次：
        #   用户可能**上一次开卷走到一半退出了**，这次重新打开向导、
        #   路径还在（`_wizard_path` 是实例级的），那就该当场看见提示。
        # [EN] ★ The "this book has already been opened" hint row (hidden by default). Refresh once after it is
        # [EN] built:
        # [EN] the user may have **exited halfway through opening last time**, and this time reopened the
        # [EN] wizard,
        # [EN] the path is still there (`_wizard_path` is instance-level), so the hint should be visible right
        # [EN] away.
        dup_hint = ft.Text('', color=C['seal'], size=BODY_FS, visible=False)
        self._wizard_dup_hint = dup_hint
        self._refresh_wizard_dup(update_ui=False)

        async def pick_folder(e):
            try:
                picked = await self._get_file_picker().get_directory_path()
            except Exception as ex:
                log_exception(t("打开文件夹选择器失败"), category="ui")
                self._show_snack(t('无法打开文件选择器: {ex}', ex=ex), error=True)
                return
            if picked:
                self._wizard_path = picked
                path_field._field.value = picked
                log_ui_action(t("选择文件夹"), picked)
                self._on_wizard_path_changed(None)      # 放行「下一步」
                # [EN] Allow "Next"
                page.update()

        # ★ 标题单独交出去（`head`）：它**不跟着滚**，钉在滚动区上面。
        #   用户 2026-10-11：「滚动条动的时候 标题不能动 标题下面的动才对」。
        # [EN] ★ Hand the title out separately (`head`): it **does not scroll**, it is pinned above the
        # [EN] scroll area. User 2026-10-11: "when the scrollbar moves the title must not move; what is
        # [EN] below the title should".
        head = [
            ft.Text(t("步骤 1/5：选择文件夹"), size=SEC_FS, color=C['gold']),
            ft.Divider(height=14, color='transparent'),
        ]
        content = [
            ft.Text(t("选择小说项目文件夹，支持 .md / .txt / .docx / .html"),
                    color=C['muted'], size=BODY_FS),
            ft.Row([
                path_field,
                # 和输入框同一行 → 高度跟输入框对齐（不然一个 34 一个 42）
                # [EN] Same row as the input box -> height aligned with the input box (otherwise one is 34 and the
                # [EN] other is 42)
                mk_btn(t("浏览…"), pick_folder, width=96, height=SET_H),
            ], spacing=8),
            # ★ 「这本已经开过卷了」提示（用户 2026-10-07 报的问题）——
            #   选完文件夹**当场**就告诉他，别等到点「开始摄取」才拦。
            #   文案与可见性由 `_refresh_wizard_dup()` 就地刷新。
            # [EN] ★ "this book has already been opened" hint (the problem reported by the user on 2026-10-07) --
            # [EN] tell him **right when** the folder is selected, do not wait until "Start Ingestion" is clicked
            # [EN] to block it.
            # [EN] Text and visibility are refreshed in place by `_refresh_wizard_dup()`.
            dup_hint,
            ft.Text(t("提示：文件夹中应包含大纲、设定、人物等文件"),
                    color=C['muted'], size=HINT_FS),
            # 顺手指路：程序目录下的 `samples/`（说明书 §6.1 里详细写了每个故事）
            # [EN] By the way, point the way: `samples/` under the program directory (every story is described in
            # [EN] detail in section 6.1 of the manual)
            ft.Text(t("程序目录下的 samples/ 里有 6 篇现成示例（每个题材一篇，中英各一版），"
                      "可以直接挑一篇试跑"),
                    color=C['muted'], size=HINT_FS),
        ]

        return {'head': head, 'content': content, 'next_text': t('下一步'),
                'can_proceed': lambda: bool(self._wizard_path)}

    # ══════════════════════════════════════════════════════════
    #  「这本已经开过卷了」—— 检查 + 提示 + 拦一道
    # [EN] "this book has already been opened" -- check + hint + block once
    #  用户原话（2026-10-07）：「如果小说已经存在 则后续再开卷的话 要提示已经存在
    #  而不是继续可以开卷这本小说」。
    # [EN] User's exact words (2026-10-07): "if the novel already exists then if it is opened again later,
    # [EN] prompt that it already exists
    # [EN] instead of continuing to allow opening this novel".
    #  判定在 `store.project.find_existing`（同名 或 同素材，纯函数、可单测）；
    #  这里只管**怎么让用户知道**、以及**他坚持要重开时怎么不让他毁掉旧的那本**。
    # [EN] The determination is in `store.project.find_existing` (same name or same material, pure
    # [EN] function, unit-testable);
    # [EN] here we only handle **how to let the user know**, and **how not to let him destroy the old one
    # [EN] when he insists on reopening**.
    # ══════════════════════════════════════════════════════════
    def _dup_scan(self, refresh: bool = False) -> list:
        """扫一遍已有项目（**带一次缓存**）。

        为什么要缓存：这条路径挂在输入框的 `on_change` 上，用户改一个字就要
        查一次；`scan_projects` 要 rglob 整个项目目录并逐个读 `.nwsproj`，
        几十本书就是几十次文件读取 —— 每敲一个字都做一遍会卡手。
        向导是**模态**的，打开期间基本不会有新项目冒出来，所以缓一次够用；
        真正的拦阻（`_do_import`）会 `refresh=True` 重新扫，那一处必须准。
        
                English:
        Scan existing projects (**with a single cache**).
                Why cache: this path is attached to the input box's `on_change`, so every character the user changes requires a
                lookup; `scan_projects` has to rglob the entire project directory and read each `.nwsproj` one by one,
                dozens of books means dozens of file reads — doing that on every keystroke would feel laggy.
                The wizard is **modal**, and basically no new projects will appear while it's open, so caching once is enough;
                the real blocker (`_do_import`) will `refresh=True` and rescan, and that one must be accurate.
        """
        if refresh or getattr(self, '_dup_cache', None) is None:
            try:
                self._dup_cache = scan_projects(CFG.projects_dir())
            except Exception:                                    # noqa: BLE001
                log_exception(t('扫描已有项目失败'), category="ui")
                self._dup_cache = []
        return self._dup_cache

    def _duplicates_for_wizard(self, refresh: bool = False) -> list:
        """照向导里当前那两项（文件夹 / 项目名）查「是不是已经开过卷了」。
                English:
        Check "has this volume already been started" against the two current items in the wizard (folder
        / project name).
        """
        try:
            return matches(self._dup_scan(refresh),
                           name=self._wizard_name,
                           source_folder=self._wizard_path)
        except Exception:                                        # noqa: BLE001
            log_exception(t('检查是否已经开过卷失败'), category="ui")
            return []

    def _refresh_wizard_dup(self, *, update_ui: bool = True) -> None:
        """刷新步骤 1 里那条提示行（没有重复就整行藏掉，不留空白）。

        `update_ui=False` 给**向导构造期间**用：那会儿控件还没挂上页面，
        `page.update()` 没意义（也会白抛一次异常）。
        
                English:
        Refresh that hint line in step 1 (if there's no duplicate, hide the whole line, leave no blank
        space).
                `update_ui=False` is for **during wizard construction**: at that point the controls aren't attached to the page yet,
                so `page.update()` is meaningless (and will just throw once for nothing).
        """
        hint = getattr(self, '_wizard_dup_hint', None)
        if hint is None:
            return
        dup = self._duplicates_for_wizard()
        if not dup:
            text, vis = '', False
        else:
            first = dup[0]
            text = t('⚠ 这本已经开过卷了：「{name}」。再走一遍会重新读一次'
                     '素材 —— 只想看故事的话，去开始界面点「拾　卷」打开它。',
                     name=first.name)
            vis = True
        # ⚠ 内容没变就**别刷页面**：这个函数挂在两个输入框的 `on_change` 上，
        #   用户每敲一个字都会进来一次；每次都 `page.update()` 整屏太重。
        # [EN] ⚠ If the content has not changed, **do not refresh the page**: this function is hooked onto the
        # [EN] `on_change` of the two input boxes,
        # [EN] the user enters it on every keystroke; calling `page.update()` for the whole screen every time
        # [EN] is too heavy.
        if (text, vis) == getattr(self, '_dup_hint_state', None):
            return
        self._dup_hint_state = (text, vis)
        try:
            hint.value = text
            hint.visible = vis
        except Exception:                                        # noqa: BLE001
            return
        try:
            if update_ui and self.page is not None:
                self.page.update()
        except Exception:                                        # noqa: BLE001
            pass

    def _on_wizard_path_changed(self, e):
        """路径变化（选择或手输）：记录并刷新「下一步」可用性。
                English:
        Path change (selection or manual input): record and refresh "Next" availability.
        """
        if e is not None:
            self._wizard_path = (e.control.value or '').strip()
        self._autofill_project_name(self._wizard_path)
        # ★ 选完文件夹**当场**查一次「这本开过卷没有」—— 用户报的就是
        #   "开过了还让我一路开下去"，所以提示要出现在最早能出现的地方。
        # [EN] ★ **Right when** the folder is selected, check once for "has this book been opened" -- what the
        # [EN] user reported was
        # [EN] "it has already been opened and you still let me go all the way", so the hint should appear at
        # [EN] the earliest possible place.
        self._refresh_wizard_dup()
        refresh = getattr(self, '_wizard_refresh_next', None)
        if callable(refresh):
            refresh()

    @staticmethod
    def _folder_basename(path: str) -> str:
        """取路径最后一段（文件夹名）。取不到就返回 `''`（调用方据此"别填"）。

        ⚠ **不直接用 `Path(path).name`**：Windows 的 `E:\\a\\b` 在 Linux/macOS 上
        会被当成"一个整串文件名"（`\\` 不是分隔符），返回 `'E:\\a\\b'`。
        本程序三平台都要能跑，所以先把反斜杠换成斜杠再取。
        代价是"POSIX 下文件名里真的带反斜杠"这种极端情况会取错 —— 可以接受。

        ⚠★ **盘根要单独判**（2026-10-06 写判据时抓到的真 bug）：`'E:/'` 剥掉尾斜杠
        之后剩下 `'E:'`，而 `'E:'.rsplit('/', 1)[-1]` 是 `'E:'` ——
        于是"选了个盘根"会填出一个**叫「E:」的项目名**。
        所以剥完之后再判一次"这是不是光秃秃一个盘符"。
        
                English:
        Take the last segment of the path (folder name). If it can't be taken, return `''` (the caller
        uses this to decide "don't fill").
                ⚠ **Don't use `Path(path).name` directly**: Windows's `E:\\a\\b` on Linux/macOS
                gets treated as "a single whole filename" (`\\` is not a separator), returning `'E:\\a\\b'`.
                This program must run on all three platforms, so replace backslashes with forward slashes first, then take it.
                The cost is that the extreme case "a filename on POSIX really contains a backslash" would be taken wrong -- acceptable.
                ⚠★ **Drive roots must be judged separately** (a real bug caught on 2026-10-06 when writing the criterion): `'E:/'` after stripping the trailing slash
                leaves `'E:'`, and `'E:'.rsplit('/', 1)[-1]` is `'E:'` --
                so "selected a drive root" would fill in a **project name called "E:"**.
                So after stripping, check once more "is this a bare drive letter".
        """
        p = (path or '').strip().replace('\\', '/').rstrip('/')
        if not p or re.fullmatch(r'[A-Za-z]:', p):
            return ''                     # 盘根（`E:`）与空串都取不出名字
            # [EN] The drive root (`E:`) and the empty string both cannot yield a name
        return p.rsplit('/', 1)[-1].strip()

    def _autofill_project_name(self, path: str) -> None:
        """把「项目名称」默认填成**所选文件夹的名字**。

        两条规矩（用户明确要"觉得不对再自己输入"）：
        1. **用户改过就不动** —— 当前值既不空、又不等于上次自动填的那个值，说明是人打的，
           此后换文件夹也不再覆盖（否则用户改完名字回头换个文件夹，名字又被冲掉）。
        2. 取不到名字（选了盘根 `E:\\`、或路径为空）→ **什么都不做**，
           不留下半个像名字的东西。

        判据用一张表说完（`prev_auto` = 上次我自动填进去的值）：

        | 当前值 | `prev_auto` | 结论 |
        |---|---|---|
        | 空 | 空 | 还没填过 → **填** |
        | 空 | 非空 | 用户**主动清空**了 → 不再填（他说了不要） |
        | == `prev_auto` | 同上 | 还是我填的、他没碰 → **换成新文件夹的名字** |
        | 别的 | 任意 | 用户**自己打的** → 一个字都不动 |
        
                English:
        Fill in the default for "Project Name" as **the name of the selected folder**.
                Two rules (the user explicitly asked for "if it feels wrong, type it yourself"):
                1. **If the user has changed it, don't touch it** -- if the current value is neither empty, nor equal to the last auto-filled value, that means a human typed it,
                   and switching folders afterwards won't overwrite it either (otherwise if the user edits the name and then switches folders, the name gets clobbered again).
                2. If the name can't be taken (a drive root `E:\\` was selected, or the path is empty) -> **do nothing**,
                   don't leave behind half a name-like thing.
                State the criterion in one table (`prev_auto` = the value I auto-filled last time):
                | Current value | `prev_auto` | Conclusion |
                |---|---|---|
                | empty | empty | not filled yet -> **fill** |
                | empty | non-empty | user **actively cleared** it -> don't fill again (they said they don't want it) |
                | == `prev_auto` | same as above | still what I filled, they haven't touched it -> **replace with the new folder name** |
                | anything else | any | the user **typed it themselves** -> don't change a single character |
        """
        base = self._folder_basename(path)
        if not base:
            return
        cur = (self._wizard_name or '').strip()
        prev_auto = (self._wizard_name_auto or '').strip()
        if not cur:
            if prev_auto:
                return                    # 用户主动清空过 → 别再塞回去
                # [EN] The user has actively cleared it -> do not stuff it back
        elif cur != prev_auto:
            return                        # 用户自己改过 → 尊重他的输入
            # [EN] The user has modified it himself -> respect his input
        if cur == base:
            return                        # 已经是它了，别白刷一次控件
            # [EN] It is already it, do not waste a control refresh
        self._wizard_name = base
        self._wizard_name_auto = base
        # 第 2 步的输入框在建向导时就一起建好了（`steps` 是一次性铺开的），
        # 所以这里能直接就地刷新 —— 用户走到第 2 步时看到的就是填好的名字。
        # [EN] The input box for step 2 is also built when the wizard is built (`steps` is laid out all at
        # [EN] once),
        # [EN] so here it can be refreshed directly in place -- what the user sees when reaching step 2 is the
        # [EN] filled-in name.
        fld = getattr(self, '_wizard_name_field', None)
        try:
            if fld is not None and getattr(fld, '_field', None) is not None:
                fld._field.value = base
        except Exception:                                        # noqa: BLE001
            log_exception(t('自动填写项目名称失败'), category="ui")

    def _wizard_step2_settings(self, page):
        """步骤 2：项目设置。
                English:
        Step 2: Project Settings.
        """
        name_field = mk_field(
            t("项目名称"), self._wizard_name or '',
            width=SET_W, on_change=self._on_wizard_name_changed,
        )
        # 存个句柄：第 1 步选完文件夹时，`_autofill_project_name` 要**就地**把名字刷进去。
        # （`steps` 是一次性铺开的，这些控件在建向导时就都建好了，所以拿得到。）
        # [EN] Store a handle: when the folder is selected in step 1, `_autofill_project_name` must refresh the
        # [EN] name **in place**.
        # [EN] (`steps` is laid out all at once, these controls are all built when the wizard is built, so they
        # [EN] can be obtained.)
        self._wizard_name_field = name_field

        def _on_genre(e):
            self._wizard_genre = e.control.value or 'auto'

        def _on_style(e):
            self._wizard_style = e.control.value or 'auto'

        def _on_outlang(e):
            self._wizard_outlang = e.control.value or outlang.AUTO

        genre_dropdown = mk_dropdown(t("故事类型"), genre_options(),
                                     self._wizard_genre or 'auto', width=SET_W)
        genre_dropdown._field.on_change = _on_genre

        style_dropdown = mk_dropdown(t("风格来源"), style_source_options(),
                                     self._wizard_style or 'auto', width=SET_W)
        style_dropdown._field.on_change = _on_style

        # 输出语言：**在开卷这一步就要定** —— 后面那几步（提设定、判类型、
        # 建进度表）都要按它来写，开完卷再改就晚了。
        # [EN] Output language: **must be decided at the book-opening step** -- the later steps (extract
        # [EN] settings, determine type,
        # [EN] build progress table) all have to be written according to it, and changing it after opening is
        # [EN] too late.
        outlang_dropdown = mk_dropdown(t("输出语言"), outlang.options(),
                                       self._wizard_outlang or outlang.AUTO,
                                       width=SET_W)
        outlang_dropdown._field.on_change = _on_outlang

        # 标题不跟着滚（见 `_wizard_body(head=…)`）。
        # [EN] The title does not scroll (see `_wizard_body(head=...)`).
        head = [
            ft.Text(t("步骤 2/5：项目设置"), size=SEC_FS, color=C['gold']),
            ft.Divider(height=14, color='transparent'),
        ]
        content = [
            name_field,
            ft.Text(t("项目名称默认用你选的文件夹名，不对就直接改"),
                    color=C['muted'], size=HINT_FS),
            genre_dropdown,
            style_dropdown,
            outlang_dropdown,
            ft.Text(t("提示：都选「自动判断」就交给 AI 读正文自己定；"
                      "手动指定类型会跳过那一步的类型判定"),
                    color=C['muted'], size=HINT_FS),
            ft.Text(t("「输出语言」= 推演出来的叙事、文档、小结、建议用哪种语言写。"
                      "原稿是别的语言也没关系。"),
                    color=C['muted'], size=HINT_FS),
        ]

        def _on_enter():
            """进到这一步时，把输入框和 `_wizard_name` 对齐一次。

            正常情况下第 1 步选完文件夹就已经刷好了；这里是**保险**：
            万一有别的地方改了 `_wizard_name`（或者控件被重建），
            屏幕上显示的也必须是同一个值 —— 否则用户看到 A、存下去是 B。
            
                        English:
            When entering this step, align the input field and `_wizard_name` once.
                        Normally step 1 is already refreshed after the folder is picked; this is **insurance**:
                        in case something else changed `_wizard_name` (or the control was rebuilt),
                        what's shown on screen must also be the same value -- otherwise the user sees A, but B is what gets saved.
            """
            try:
                fld = getattr(name_field, '_field', None)
                if fld is not None:
                    fld.value = self._wizard_name or ''
            except Exception:                                    # noqa: BLE001
                log_exception(t('刷新项目名称失败'), category="ui")

        return {'head': head, 'content': content, 'next_text': t('下一步'), 'on_enter': _on_enter}

    def _wizard_step3_ai(self, page):
        """步骤 3：AI 优化设置。
                English:
        Step 3: AI Optimization Settings.
        """
        opts = self._wizard_opts

        def _mk(key: str, label: str, default: bool = True) -> ft.Checkbox:
            cb = mk_check(t(label), bool(opts.get(key, default)))

            def _on_change(e, k=key, c=cb):
                opts[k] = bool(c.value)
            cb.on_change = _on_change
            return cb

        # ★ `OPTIMIZE_ON_IMPORT`（以前零读取）：开卷时**默认**要不要跑 AI 优化。
        #   现在它就是那个复选框的初值 —— 关掉的人不必每轮手动取消勾选。
        # [EN] ★ `OPTIMIZE_ON_IMPORT` (previously zero reads): whether to run AI optimization by **default**
        # [EN] when opening.
        # [EN] Now it is the initial value of that checkbox -- people who turn it off do not have to manually
        # [EN] uncheck it every round.
        ai_optimize = _mk('ai_optimize', "使用 AI 优化项目设定",
                          default=CFG.b('OPTIMIZE_ON_IMPORT'))
        extract_settings = _mk('extract_settings', "自动提取世界观和人物设定")
        generate_progress = _mk('generate_progress', "生成故事进度表")
        generate_style = _mk('generate_style', "生成风格卡")
        # ★ AI 主动补全 + 回写**引用文件夹**（2026-10-06）。这一步会**写你的原始
        #   素材文件夹**，所以文案必须说清两件事：① 先列清单给我看；② 只在开卷时写。
        # [EN] ★ AI actively completes + writes back to the **reference folder** (2026-10-06). This step will
        # [EN] **write to your original
        # [EN] material folder**, so the text must clearly state two things: 1. list the manifest for me first;
        # [EN] 2. only write when opening.
        repair_source = _mk('repair_source', "AI 补全缺口，并回写引用文件夹")
        # ★ 打磨结论也要落一份到**引用文件夹**（2026-10-07 用户要求：
        #   「最终优化结果需要同时写到项目里和原始的设定文件夹里」）。
        # ⚠ 默认值取自配置项（与 `ai_optimize` 同一个做法）：不这么写，
        #   `POLISH_WRITE_BACK` 就成了"SPEC 里有、产品里没人读"的**假旋钮** ——
        #   `verify_config_sweep` 的 D1（"每个旋钮都被产品源码读到过"）当场抓到了它。
        # [EN] ★ The polish conclusion should also be saved to the **reference folder** (user request on
        # [EN] 2026-10-07:
        # [EN] "the final optimization result needs to be written both into the project and into the original
        # [EN] settings folder").
        # [EN] ⚠ The default value is taken from the config item (same approach as `ai_optimize`): otherwise,
        # [EN] `POLISH_WRITE_BACK` becomes a **fake knob** that "exists in SPEC but no one reads in the
        # [EN] product" --
        # [EN] D1 of `verify_config_sweep` ("every knob is read by product source code") caught it on the spot.
        polish_write_back = _mk('polish_write_back',
                                "打磨结论也写一份到引用文件夹（只追加）",
                                default=CFG.b('POLISH_WRITE_BACK'))

        # 标题不跟着滚（见 `_wizard_body(head=…)`）。
        # [EN] The title does not scroll (see `_wizard_body(head=...)`).
        head = [
            ft.Text(t("步骤 3/5：AI 优化设置"), size=SEC_FS, color=C['gold']),
            ft.Divider(height=14, color='transparent'),
        ]
        content = [
            ft.Text(t("选择 AI 自动优化选项："), color=C['muted'], size=BODY_FS),
            ai_optimize,
            extract_settings,
            generate_progress,
            generate_style,
            repair_source,
            polish_write_back,
            ft.Text(t("提示：勾选「使用 AI 优化」后，摄取完成会停下来，"
                      "你可以和 AI 对话把设定打磨到满意再进入运行界面"),
                    color=C['muted'], size=HINT_FS),
            mk_text(t("「补全缺口并回写引用文件夹」：AI 会把缺的伏笔、人物空字段、"
                      "编码不对的文档补好，**写回你导入的那个文件夹**。"
                      "动手前会先列一份清单让你过目；每个被改的文件都留 .bak 备份，"
                      "你的原文只增不改。**项目一旦开始推演，就再也不会碰这个文件夹**。"),
                    color=C['muted'], size=HINT_FS),
            ft.Text(t("「打磨结论也写一份到引用文件夹」：把「这次改了什么」追加成 "
                      "`AI打磨记录.md`。同样只追加、留备份；项目里也留一份同样的。"),
                    color=C['muted'], size=HINT_FS),
            mk_text(t("打磨 Agent：它会**记得整场对话**（你说过的、它查过的、改过的都在），"
                      "会自己动手改设定、读你的素材、必要时**现场写一个小工具**"
                      "（在沙盒里跑，只能写打磨暂存区），做完还会**自查一遍**有没有漏改、"
                      "改坏或越权。想关掉：天机 ·「运行」→「开卷打磨」那一节。"),
                    color=C['muted'], size=HINT_FS),
            # ★ 轮数上限 + 强制停止（2026-10-08 用户要求）。
            #   这两件事**必须在这里就讲清楚**：作者是在这一步决定"打不开启 AI 优化"
            #   的，等他进了那一屏才发现"怎么还不让我发了 / 有没有办法停"就晚了。
            # [EN] ★ Round upper limit + forced stop (user request on 2026-10-08).
            # [EN] These two things **must be made clear right here**: the author decides at this step whether to
            # [EN] "turn off AI optimization"
            # [EN] and it's too late once he's on that screen and finds "why won't it let me submit / is there any
            # [EN] way to stop".
            ft.Text(t("轮数与叫停：AI 优化最多来回 {n} 轮（你每发一条指令算一轮），"
                      "到上限就不再收新指令，让你点「完成优化并进入」；"
                      "正在跑的那一轮随时可以用「⏹ 强制停止」打断"
                      "（已经改好的设定保留）。这两个数都能在"
                      "天机 ·「运行」→「开卷打磨」里改。",
                      n=max(1, int(CFG.i('POLISH_MAX_ROUNDS') or 10))),
                    color=C['muted'], size=HINT_FS),
        ]

        return {'head': head, 'content': content, 'next_text': t('下一步')}

    def _wizard_step5_agents(self, page):
        """步骤 4：**剧组 Agents**（这一本的定制，可整步跳过）。

        用户 2026-10-11：「支持在开卷的时候有一个步骤给各个Agent进行自定义，
        不进行自定义则使用AI推断的项目级别自定义属性。」

        ★ 两件事分开说清（界面上也这么写）：
          · 你填了的 → 就按你填的（写进 `<项目>/agents/`）；
          · 没填的、且勾着「让 AI 推断」→ 摄取完成后由 AI 依据**这本书的
            类型与风格**推一句"这一本要它多做什么"，同样落 `<项目>/agents/`。
        ★ 分页口径与「天机/书斋 · 剧组 Agents」**一致**（默认 5、可调）——
          两处不一样的话，作者会以为"怎么少了几个职位"。
        
                English:
        Step 4: **Crew Agents** (custom for this book, the whole step can be skipped).
                User 2026-10-11: "Support a step at volume-start time for customizing each Agent,
                and if not customized, use the AI-inferred project-level custom attributes."
                ★ State the two things clearly and separately (the UI says it this way too):
                  · What you filled in -> goes by what you filled in (written to `<项目>/agents/`);
                  · What you didn't fill in, and "let AI infer" is checked -> after ingestion, AI infers one sentence based on **this book's
                    genre and style** saying "what more this one wants it to do", also written to `<项目>/agents/`.
                  if the two places differ, the author will think "why are a few positions missing".
        """
        from crew import catalog as CAT
        state = {'page': 0, 'size': AGENT_PAGE_DEFAULT}
        # ★★ **每一步的宽度都要自己钉住**（2026-10-11 用户报"滚动条压住文字与列表"）。
        #   `_wizard_body()` 的注释写着"步骤内容只有 520 宽，右边那 80px 一直是空着的，
        #   条画进去不压任何控件" —— 那句话**只对显式带 `width` 的控件成立**。
        #   这一步里凡是 `expand=True` 或不带宽度的控件（列表行里的 TextField、
        #   那段长说明文字），都会**撑满 `col` 的宽度**，而 `col` 宽 = `DLG_W`(600)。
        #   于是内容一路顶到 600，正好钻进 24px 的滚动条车道 ——
        #   探针实测：行宽 598、内容右边界 632、滚动条在 620..623 ⇒ **重叠 13px**。
        #   ⇒ 这一页每个"会自己长宽"的东西都显式给 `WIZ_W`。
        #     （不是"顺手写一下"：判据 `verify_wizard_agent_lane` 就按"内容右边界
        #      必须留在车道左边"钉住它，谁再加一个不带宽度的控件就会红。）
        #   ★ 2026-10-11 当天第二次：钉成 `SET_W`(520) 之后用户又说「**你又调整的
        #     太窄了 稍微加宽一些 刚好贴着滚动条就好了**」—— 520 是"控件默认宽"，
        #     **不是**这一步的上限；上限是 `WIZ_W`(580)，见它的定义。
        # [EN] ★★ **Each step must pin its own width** (user report 2026-10-11: "the scrollbar covers the
        # [EN] text and the list").
        # [EN] `_wizard_body()`'s comment says "the step content is only 520 wide, those 80px on the right
        # [EN] have always been empty, so drawing the bar there squeezes nothing" -- that is **only true for
        # [EN] controls that carry an explicit `width`**. Anything here with `expand=True` or no width (the
        # [EN] TextField inside a list row, that long explanatory paragraph) **fills `col`**, and `col` is
        # [EN] `DLG_W` (600). So the content runs out to 600 and slides right into the 24px scrollbar lane --
        # [EN] measured by the probe: row width 598, content right edge 632, scrollbar at 620..623 ⇒
        # [EN] **13px of overlap**.
        # [EN] ⇒ Every element on this page that can grow on its own gets an explicit `WIZ_W`.
        # [EN] (Not a courtesy: the criterion `verify_wizard_agent_lane` pins "the content's right edge must
        # [EN] stay left of the lane", so anyone adding a width-less control will go red.)
        # [EN] ★ Later the same day, the second round: after pinning to `SET_W` (520) the user said
        # [EN] "**you made it too narrow again, widen it a bit, just touching the scrollbar**" -- 520 is
        # [EN] the "default control width", **not** this step's ceiling; the ceiling is `WIZ_W` (580), see
        # [EN] its definition.
        body = ft.Column([], spacing=6, width=WIZ_W)
        head_line = ft.Text('', size=HINT_FS, color=C['muted'], width=WIZ_W)
        pager = ft.Row([], spacing=8)
        specs_all = []
        try:
            specs_all = CAT.effective(project=None)
        except Exception as e:                                   # noqa: BLE001
            log_exception(t('读 Agent 设置失败：{e}', e=f'{e!r}'), category='ui')

        def _row(spec) -> ft.Control:
            fld = ft.TextField(
                value=self._wizard_agents.get(spec.key, ''),
                hint_text=t('（不填 = 交给 AI 推断，或就用软件默认）'),
                multiline=True, min_lines=1, max_lines=3,
                height=48, text_size=SET_FS, expand=True,
                bgcolor=C['input_bg'], border_color=C['border'],
                border_radius=4, color=C['text'],
                content_padding=ft.Padding(8, 4, 8, 4))

            def _on_change(e, k=spec.key):
                self._wizard_agents[k] = e.control.value or ''

            fld.on_change = _on_change
            return ft.Container(
                content=ft.Column([
                    ft.Row([ft.Text(t(spec.name), size=BODY_FS,
                                    weight=ft.FontWeight.BOLD, color=C['text']),
                            ft.Text(t(spec.intro or ''), size=HINT_FS,
                                    color=C['muted'], expand=True)],
                           spacing=8),
                    fld,
                ], spacing=2),
                # ⚠ 行宽**必须写死 `WIZ_W`**：这一行的 TextField 是 `expand=True`，
                #   不给宽度就会跟着父列撑到 `DLG_W`(600) 去（探针实测 598），
                #   右端就钻到滚动条底下。见上面那段说明。
                # [EN] ⚠ The row width **must be hardcoded to `WIZ_W`**: this row's TextField is
                # [EN] `expand=True`; without a width it fills the parent column out to `DLG_W` (600,
                # [EN] measured 598 by the probe) and its right end slides under the scrollbar. See the note
                # [EN] above.
                width=WIZ_W,
                bgcolor=C['input_bg'], border=make_border(1, C['border']),
                border_radius=4, padding=ft.Padding(10, 6, 10, 6))

        def refresh() -> None:
            n = len(specs_all)
            size = max(1, int(state['size']))
            pages = max(1, (n + size - 1) // size)
            state['page'] = min(max(0, int(state['page'])), pages - 1)
            lo = state['page'] * size
            body.controls = [_row(s) for s in specs_all[lo:lo + size]]
            head_line.value = t('共 {n} 个职位 · 第 {p}/{m} 页',
                                n=n, p=state['page'] + 1, m=pages)
            pager.controls = self._agent_pager(state, pages, refresh)

        ai_cb = mk_check(t('没填的那些，让 AI 依据这本书的类型与风格推断'),
                         bool(self._wizard_agents_ai))

        def _ai_change(e) -> None:
            self._wizard_agents_ai = bool(ai_cb.value)

        ai_cb.on_change = _ai_change
        refresh()

        # ★ 标题单独交出去（`head`）—— 它钉在滚动区外面，滚的是下面那一层。
        #   用户 2026-10-11：「滚动条动的时候 标题不能动 标题下面的动才对」。
        # [EN] ★ The title is handed out separately (`head`) -- it is pinned outside the scroll area, and
        # [EN] the layer below it is what scrolls. User 2026-10-11: "when the scrollbar moves the title must
        # [EN] not move; what is below the title should".
        head = [
            ft.Text(t("步骤 4/5：剧组 Agents（可以整步跳过）"),
                    size=SEC_FS, color=C['gold'], width=WIZ_W),
            ft.Divider(height=14, color='transparent'),
        ]
        content = [
            # ⚠ 这里每一个控件都**必须自带宽度**（理由见上面那段长注释）：
            #   长说明 / 勾选框 / 状态行 —— 少给一个，它就会撑到 600 顶进车道。
            # [EN] ⚠ Every control here **must carry its own width** (reasoning in the long note above):
            # [EN] the long paragraph / the checkbox / the status line -- miss one and it stretches to 600
            # [EN] and runs into the lane.
            mk_text(t("这里的每一行是**这个剧组里的一个职位**（写小说的、改剧本的、"
                      "场记、美术、审读…）。你可以给**这一本书**写一句：'这本书要它"
                      "多做什么、少做什么'。\n"
                      "· 你填了 → 就按你填的（只影响这一本）；\n"
                      "· 没填、且勾了下面那个勾 → 摄取完成后由 AI 依据这本书的"
                      "类型与风格替你推一句（推荐）；\n"
                      "· 什么都不填又不勾 → 照「天机 · 剧组 Agents」里的软件默认跑。\n"
                      "想改得更细（名字、系统提示词、出工时机），开完卷去"
                      "「书斋 · 剧组 Agents」。"),
                    color=C['muted'], size=HINT_FS, width=WIZ_W),
            # 勾选框：`Checkbox` 的宽度由标签撑，标签长时也会超出 —— 同样钉住。
            # [EN] The checkbox: its width comes from the label, which also overflows when long -- pin it too.
            ft.Container(content=ai_cb, width=WIZ_W),
            head_line, body, pager,
        ]
        return {'head': head, 'content': content, 'on_enter': refresh,
                'next_text': t('下一步')}

    async def _apply_wizard_agents(self, proj, settings, result, add_log) -> int:
        """把向导那一步的 Agent 定制落进 `<项目>/agents/`。返回落了几条。

        ⚠ **只写作者填了的 + AI 推断出来的**（未推出来的不写文件）——
          给每个职位都写一份"平凡的一句话"，等于把软件默认冻结成项目定制，
          以后改软件默认它就不跟了（那是"越改越死"的一种）。
        
                English:
        Write the Agent customization from that wizard step into `<项目>/agents/`. Return how many entries
        were written.
                ⚠ **Only write what the author filled in + what AI inferred** (don't write a file for what wasn't inferred) --
                  writing a "plain one-liner" for every position is equivalent to freezing the software's defaults into project customization,
                  so that later when the software defaults change it won't follow along (that's one kind of "the more you change, the deader it gets").
        """
        from crew import catalog as CAT
        written = 0
        mine = {k: str(v).strip() for k, v in (self._wizard_agents or {}).items()
                if str(v).strip()}
        inferred: dict[str, str] = {}
        if self._wizard_agents_ai:
            todo = [s.key for s in CAT.effective(project=None)
                    if s.builtin and s.key not in mine]
            if todo:
                try:
                    inferred = await CAT.infer_project_agents(
                        name=str(getattr(proj, 'name', '') or ''),
                        genre=str(getattr(result, 'genre_hint', '')
                                  or (result.genre or {}).get('主题材', '') or ''),
                        style=str((result.style or {}).get('语气') or '')
                              if isinstance(result.style, dict) else '',
                        summary=CAT.settings_digest(settings),
                        keys=todo)
                except Exception as e:                           # noqa: BLE001
                    log_exception(t('AI 推断 Agent 定制失败（改用你的填写）'),
                                  category='ui')
                    add_log(f"[{now_str('%H:%M:%S')}] ! AI 没法为各 Agent 推断定制"
                            f"（{e!r}）—— 你填的那几条照常生效", 'err')
        merged = dict(inferred)
        merged.update(mine)          # 作者填的**压过** AI 推的
        # [EN] What the author fills in **overrides** what the AI suggests
        for key, note in merged.items():
            try:
                CAT.save_project(proj, key, usage=note)
                written += 1
            except Exception as e:                               # noqa: BLE001
                _LOG = __import__('logging').getLogger('nws.gui')
                _LOG.warning('Agent 定制落盘失败（%s）：%r', key, e)
        if written:
            try:
                CAT.bind_project(proj)
            except Exception:                                    # noqa: BLE001
                pass
        return written

    def _wizard_step4_confirm(self, page):
        """步骤 5：确认并开始（进入时按已填内容刷新）。
                English:
        Step 5: Confirm and start (refresh according to what's filled in when entering).
        """
        summary_text = ft.Text('', color=C['text'], size=BODY_FS)

        def _refresh_summary():
            # 摘要里也要说人话：以前这里写死「类型：auto / 风格：auto」，
            # 把变量值直接摆到用户眼前（和第 2 步的下拉是同一个毛病）。
            # [EN] The summary must also speak plainly: this used to hardcode "Type: auto / Style: auto",
            # [EN] putting raw variable values right in front of the user (the same flaw as the dropdown in step
            # [EN] 2).
            summary_text.value = t(
                "将创建项目：\n• 源文件夹：{src}\n• 项目名称：{name}\n"
                "• 故事类型：{genre}\n• 风格来源：{style}",
                src=self._wizard_path or t('（未选择）'),
                name=self._wizard_name or t('（未填写）'),
                genre=genre_label(self._wizard_genre or 'auto'),
                style=style_source_label(self._wizard_style or 'auto'))

        _refresh_summary()

        # 标题不跟着滚（见 `_wizard_body(head=…)`）。
        # [EN] The title does not scroll (see `_wizard_body(head=...)`).
        head = [
            ft.Text(t("步骤 5/5：确认并开始"), size=SEC_FS, color=C['gold']),
            ft.Divider(height=14, color='transparent'),
        ]
        content = [
            ft.Text(t("请确认以下设置："), color=C['muted'], size=BODY_FS),
            summary_text,
            ft.Divider(height=20, color='transparent'),
            ft.Text(t("点击「开始摄取」开始导入过程"), color=C['muted'], size=HINT_FS),
        ]

        return {'head': head, 'content': content, 'next_text': t('开始摄取'),
                'next_action': lambda e: self._do_import(page),
                'on_enter': _refresh_summary}

    def _on_wizard_name_changed(self, e):
        """项目名称输入。
                English:
        Project name input.
        """
        self._wizard_name = (e.control.value or '').strip()
        # 名字改了，撞不撞名也跟着变（比如用户把默认的文件夹名改成别的）
        # [EN] If the name changes, whether it collides changes too (e.g. the user renames the default folder
        # [EN] to something else)
        self._refresh_wizard_dup()

    def _do_import(self, page, *, force: bool = False):
        """执行导入：进度条 + 实时日志 + AI 优化对话，完成后关框进入运行界面。

        流程：
          ① 自动摄取（进度条 0→90%，日志实时滚动，含每一次 LLM 请求/响应全文摘要）
          ② 若勾选「使用 AI 优化」→ 停在 90%，弹出 AI 体检报告，
             作者可**一边看完整 AI 对话一边打字下指令**打磨设定（多轮）
          ③ 点「完成优化并进入」→ 100% → 关框 → 运行界面

        `force=True`：已经在「这本已经开过卷了」那个框里按过「仍然重新开卷」，
        跳过下面那道重复检查（他知道了，且项目名已经被改成不撞车的了）。
        
                English:
        Execute import: progress bar + realtime log + AI optimization conversation, close the box when
        done and enter the run interface.
                Flow:
                  ① Auto-ingest (progress bar 0->90%, log scrolls in realtime, including a full-text summary of every LLM request/response)
                  ② If "use AI optimization" is checked -> stop at 90%, pop up the AI checkup report,
                     the author can **watch the full AI conversation while typing instructions** to polish the settings (multiple rounds)
                  ③ Click "finish optimization and enter" -> 100% -> close box -> run interface
                `force=True`: "still re-start the volume" has already been pressed in the "this volume has already been started" box,
                skip the duplicate check below (they know, and the project name has already been changed to one that doesn't collide).
        """
        if self._ingest_state and self._ingest_state.get('running'):
            self._show_snack(t('已有一个摄取任务正在进行'))
            return

        src = (self._wizard_path or '').strip()
        name = (self._wizard_name or '').strip() or Path(src).name or t('未命名')
        if not src or not Path(src).exists():
            self._show_snack(t('请先选择一个存在的小说文件夹'), error=True)
            return

        # ★★ 闸门（用户 2026-10-07）：「如果小说已经存在 则后续再开卷的话
        #   要提示已经存在 而不是继续可以开卷这本小说」。
        #   ⚠ 必须在 `pop_dialog()` **之前**：这里要从向导里退出来问用户，
        #     所以得先**别关向导** —— 他一按「取消」，人还在原来那一步上。
        #   ⚠ 也要在 `run_ingest` 之前：真正的成本（读素材、调模型）从这里才开始。
        # [EN] ★★ Gate (user 2026-10-07): "If the novel already exists, then when opening a later volume
        # [EN] it should warn that it already exists, rather than still allowing this novel to be opened".
        # [EN] ⚠ Must be **before** `pop_dialog()`: here we need to exit the wizard to ask the user,
        # [EN] so we must **not close the wizard** first -- once he hits "Cancel", he's still on the same step.
        # [EN] ⚠ Also must be before `run_ingest`: the real cost (reading materials, calling the model) only
        # [EN] starts here.
        if not force:
            dup = self._duplicates_for_wizard(refresh=True)
            if dup:
                log_ui_action(t('开卷被拦下（已经开过卷）'), f'{name} / {src}')
                self._ask_duplicate(page, dup, src, name)
                return

        try:
            page.pop_dialog()   # 关掉向导
            # [EN] Close the wizard
        except Exception:
            pass

        opts = self._wizard_opts
        ai_optimize = bool(opts.get('ai_optimize', True))
        # AI 补全并回写**引用文件夹**（默认开；动手前有清单确认，见 `_repair_gate`）
        # [EN] AI completes and writes back to the **reference folder** (on by default; there's a checklist
        # [EN] confirmation before acting, see `_repair_gate`)
        repair_source = bool(opts.get('repair_source', True))
        # ★ 把**打磨结论**也追加回引用文件夹（2026-10-07）。用户原话：
        #   「最终优化结果需要**同时**写到项目里和原始的设定文件夹里」。
        #   它与 `repair_source` 是**两件事**：那个补"缺的东西"，这个记"改了什么"。
        # [EN] ★ Also append the **polish conclusion** back to the reference folder (2026-10-07). User's exact
        # [EN] words:
        # [EN] "The final optimization result must be written **both** into the project and into the original
        # [EN] settings folder".
        # [EN] It is **two different things** from `repair_source`: that one fills in "what's missing", this
        # [EN] one records "what changed".
        polish_back = bool(opts.get('polish_write_back', True))
        # ★ AI 优化**轮数上限**（2026-10-08 用户要求：「开卷 AI 优化 要有轮数上限
        #   且有地方配置」）。这里**现读**配置而不是在模块级读死 —— 天机里改完
        #   下一次开卷就生效，不用重启（打磨 Agent 本来就是开卷那一刻建的）。
        # [EN] ★ AI optimization **round limit** (2026-10-08 user request: "Opening-volume AI optimization must
        # [EN] have a round limit
        # [EN] and a place to configure it"). Here it **reads the config live** rather than hardcoding it at
        # [EN] module level -- after changing it in Tianji
        # [EN] the next volume opening takes effect without a restart (the polish Agent is created at the
        # [EN] moment of volume opening anyway).
        try:
            max_rounds = max(1, int(CFG.i('POLISH_MAX_ROUNDS') or 10))
        except Exception:                                    # noqa: BLE001
            max_rounds = 10

        state: dict = {'running': True, 'cancel': False, 'phase': 'auto',
                       'task': None, 'settings': None, 'result': None,
                       'history': [], 'exchange': 0,
                       # ★ 轮数上限与"正在跑的那一轮"（2026-10-08）：
                       #   `round_task` 是**当前这一轮**的任务句柄 —— 「⏹ 强制停止」
                       #   取消的是它，**不是** `task`（那是整趟摄取；取消它连项目都不建）。
                       # [EN] ★ Round limit and "the round currently running" (2026-10-08):
                       # [EN] `round_task` is the task handle of **the current round** -- "⏹ Force stop"
                       # [EN] cancels it, **not** `task` (that's the whole ingestion; canceling it means not even building the
                       # [EN] project).
                       'max_rounds': max_rounds, 'round_task': None,
                       'round_stopped': False, 'rounds_full': False,
                       'ai_busy': False,
                       # ★ 打磨 Agent（2026-10-07）：`agent` 是活的实例，
                       #   `polish_report` 是收工时要落到项目/引用文件夹的那份文本。
                       # [EN] ★ Polish Agent (2026-10-07): `agent` is a live instance,
                       # [EN] `polish_report` is the text to be written to the project/reference folder when done.
                       'agent': None, 'polish_report': '', 'polish_out': None,
                       'stage_n': 0,      # 已经开始的阶段数（>0 才在日志里画分隔线）
                       # ★ 熔断标记：项目一落地就置 True —— 表示"引用文件夹从此不再
                       #   被动"（用户要的就是这条边界）。真正的拦截在
                       #   `ingest.repair.write_back` 的 `.nwsproj` 检查里，这个标记
                       #   是给界面/验证脚本看的事实。
                       # [EN] Number of phases already started (>0 to draw a separator line in the log)
                       # [EN] ★ Circuit-breaker flag: set to True as soon as the project lands -- meaning "the reference
                       # [EN] folder will no longer
                       # [EN] be modified from now on" (this is exactly the boundary the user wants). The actual interception
                       # [EN] is in
                       # [EN] the `.nwsproj` check in `ingest.repair.write_back`; this flag
                       # [EN] is a fact for the UI/validation scripts to see.
                       'sealed': False}
        self._ingest_state = state

        user_q: asyncio.Queue = asyncio.Queue()
        FINISH = object()

        # ══════════════════════ 控件 ══════════════════════
        # [EN] ══════════════════════ Widgets ══════════════════════
        prog = ft.ProgressBar(value=0.0, color=C['accent'],
                              bgcolor=C['border'], height=12, border_radius=6)
        pct_text = ft.Text('0%', size=BODY_FS, color=C['gold'],
                           weight=ft.FontWeight.BOLD, width=54,
                           text_align=ft.TextAlign.RIGHT)
        stage_text = ft.Text(t('正在准备…'), size=BODY_FS, color=C['text'])
        # ★ 「跟大模型沟通到哪一步了」那一行小字（v1.39）。
        # [EN] ★ The small line "how far the LLM communication has gotten" (v1.39).
        # 用户 2026-10-06：「摄取进度旁边是否可以用一行小字显示跟大模型沟通的状态，
        # 比如正在思考 / 读取文件 / 等待回复 / 完成 之类的，**让我看到进展**」。
        # 光有一根进度条 + 一个阶段名是不够的：等模型回复那几十秒里屏幕上什么都不动，
        # 分不清是"在跑"还是"卡住了"。这行专门播报与模型的往返，
        # 而且**等待时带秒表**（每秒 +1），"在跑"这件事才有证据。
        # [EN] User 2026-10-06: "Next to the ingestion progress, can a small line show the state of
        # [EN] communication with the LLM,
        # [EN] e.g. thinking / reading file / waiting for reply / done, **so I can see the progress**".
        # [EN] A progress bar + a phase name is not enough: during those tens of seconds waiting for the
        # [EN] model's reply nothing moves on screen,
        # [EN] and you can't tell if it's "running" or "stuck". This line specifically announces the
        # [EN] round-trips with the model,
        # [EN] and **it has a stopwatch while waiting** (+1 per second), so "it's running" has evidence.
        llm_status = ft.Text(t('待机 —— 还没开始'), size=HINT_FS, color=C['muted'],
                             no_wrap=True, overflow=ft.TextOverflow.ELLIPSIS)
        # ★ 两栏各一条**自绘常驻滚动条**（用户 2026-10-06：「开卷的AI部分左侧和
        #   右侧也需要滚动条」）。车道做进 ListView 自己的 `padding`（`ING_LANE`），
        #   条由 `_scroll_bar` 画在车道里 —— 两条都是 `auto_scroll`，内容一超出一屏
        #   就会自己滚一次，`on_scroll` 随即把条的位置与长度校正过来。
        # [EN] ★ One **custom-drawn persistent scrollbar** per column (user 2026-10-06: "The AI part of volume
        # [EN] opening needs scrollbars on both the left
        # [EN] and right"). The lane is made into the ListView's own `padding` (`ING_LANE`),
        # [EN] the bar is drawn in the lane by `_scroll_bar` -- both are `auto_scroll`, so as soon as content
        # [EN] exceeds one screen
        # [EN] it scrolls by itself once, and `on_scroll` immediately corrects the bar's position and length.
        log_list = ft.ListView(expand=True, spacing=2, auto_scroll=True,
                               padding=ft.Padding(8, 6, ING_LANE, 6))
        chat_list = ft.ListView(expand=True, spacing=6, auto_scroll=True,
                                padding=ft.Padding(8, 6, ING_LANE, 6))
        log_bar = self._scroll_bar(log_list, ING_LIST_H, lane=ING_LANE)
        chat_bar = self._scroll_bar(chat_list, ING_LIST_H, lane=ING_LANE)

        # ★★ 输入框 **3 行高**（用户 2026-10-11：「你看下快卷(开卷)摄取的步骤 最下面那个
        #   聊天输入的框 **我希望可以高度高一些 比如3行** 然后对应的右侧的
        #   发送/强制停止的按钮 **移动到中间行**」）。
        #   · 三行**只能靠 `min_lines` / `max_lines`** —— ⚠ 实测（2026-10-11）：
        #     `TextField.height` 在本版 Flet 上**根本不起作用**：
        #     写 `height=72` + `min_lines=3` 画出来 62px；只写 `height=72` 画出来 45px
        #     （一号字一行是 24px）。所以这里**不写 `height`**：写了它也是谎话，
        #     将来谁按那个数去算版面就会算错。
        #   · 按钮落在**中间行**：⚠ 实测（2026-10-11）**本版 Flet 的 `Row`
        #     `vertical_alignment` 默认就是 `CENTER`**（与 Flutter 的 `START` 相反），
        #     所以那一行**不写也是居中**；显式写出来只是**防将来默认值变了**
        #     （这是唯一理由，别读成"是我让它居中的"）。真正的行为保证在判据里：
        #     `verify_ingest_rounds` 的 B4b 量"按钮文字中心 y 与输入框中心 y 差 ≤ 8px"，
        #     变异 ⑬ 把对齐改成 `START` 时它当场变红。
        # [EN] ★★ The input is **3 lines tall** (user 2026-10-11: "look at the ingestion step of
        # [EN] opening a book -- the chat input at the very bottom, **I'd like it taller, say 3 lines**,
        # [EN] and the Send / Force-stop buttons on its right should **move to the middle line**").
        # [EN] · Three lines can **only** come from `min_lines` / `max_lines` -- ⚠ measured
        # [EN] (2026-10-11): `TextField.height` **has no effect at all** in this version of Flet:
        # [EN] `height=72` + `min_lines=3` paints 62px; `height=72` alone paints 45px (one line of the
        # [EN] body font is 24px). So no `height` here: writing it would be a lie, and whoever computes
        # [EN] the layout from that number later would get it wrong.
        # [EN] · The buttons landing on the **middle line**: ⚠ measured (2026-10-11) -- **in this version
        # [EN] of Flet `Row.vertical_alignment` already defaults to `CENTER`** (opposite of Flutter's
        # [EN] `START`), so that line is not what centres them; writing it explicitly is only a **guard
        # [EN] against a future change of that default** (the only reason -- do not read it as "this is
        # [EN] what centres them"). The real behavioural guarantee is in the criterion: B4b of
        # [EN] `verify_ingest_rounds` measures "button text centre vs input centre differ by <= 8px", and
        # [EN] mutant ⑬ changes the alignment to `START`, which turns it red on the spot.
        chat_input = ft.TextField(
            hint_text=t('输入修改意见，让 AI 打磨设定…'),
            multiline=True, min_lines=CHAT_INPUT_LINES, max_lines=CHAT_INPUT_LINES,
            expand=True, text_size=SET_FS,
            content_padding=CP_FIELD, bgcolor=C['input_bg'], color=C['text'],
            border_color=C['border'], disabled=True,
        )
        send_btn = mk_btn(t('发送'), on_click=lambda e: _send(None), primary=True)
        send_btn.disabled = True
        finish_btn = mk_btn(t('完成优化并进入'), on_click=lambda e: _finish(), primary=True)
        finish_btn.disabled = True
        # ★ 「⏹ 强制停止」（2026-10-08 用户要求：「可以点击某个按钮强制停止」）。
        # [EN] ★ "⏹ Force stop" (2026-10-08 user request: "A button should be clickable to force stop").
        # 为什么非要有它：一轮 AI 优化**内部**可能要走好几步工具 + 一次自查，
        # 真模型下一轮几分钟很正常；这几分钟里**只有等**。
        # 旁边那个「取消摄取」不是"停一下" —— 它是把整趟摄取整个掐掉（连项目都不建），
        # 代价太大，没人会为了"这轮跑偏了"去按它。
        # [EN] Why it's a must: a round of AI optimization may **internally** go through several tool steps +
        # [EN] one self-check,
        # [EN] and with a real model a few minutes per round is normal; during those minutes there is **only
        # [EN] waiting**.
        # [EN] The "Cancel ingestion" next to it is not "pause for a bit" -- it cuts off the entire ingestion
        # [EN] (not even building the project),
        # [EN] too costly; nobody would press it just because "this round went off the rails".
        # 两种状态、两种动作（后果完全不同，所以日志里都要说清）：
        #   · AI 正在跑 → 打断**这一轮**，留在这一屏接着说（已经改好的设定保留）；
        #   · 在等你输入 → 优化到此为止，直接收尾进运行界面（等同「完成优化并进入」）。
        # [EN] Two states, two actions (the consequences are completely different, so the log must spell both
        # [EN] out):
        # [EN] · AI is running → interrupt **this round**, stay on this screen and continue (settings already
        # [EN] changed are kept);
        # [EN] · Waiting for your input → optimization ends here, wrap up directly into the run screen
        # [EN] (equivalent to "Finish optimization and enter").
        stop_btn = mk_btn(t('⏹ 强制停止'), on_click=lambda e: _stop_ai(), primary=False)
        stop_btn.disabled = True      # 进 AI 优化阶段之前不接这一手
        # [EN] Do not wire this up before entering the AI optimization phase

        # ══════════ 「交给 AI 之前」的确认面板（默认藏起来）══════════
        # [EN] ══════════ "Before handing to AI" confirmation panel (hidden by default) ══════════
        # 本地几步（扫描/读取/分章）走完、第一次调用 LLM **之前**弹出来。
        # 用户要的是两件事：① 先让我大概看看传进来了什么；
        # ② 对「正文外发」和「内容多→花 token」分别取一次同意。
        # 做成**内嵌面板**而不是新开一个对话框：外层这个开着模态框，
        # 再叠一层对话框既容易拿到旧帧、也会把进度与日志遮住。
        # [EN] Pops up after the local steps (scan/read/chapter split) finish and **before** the first LLM
        # [EN] call.
        # [EN] The user wants two things: ① first let me roughly see what was brought in;
        # [EN] ② get consent once each for "sending body text out" and "more content → more tokens spent".
        # [EN] Made as an **embedded panel** rather than opening a new dialog: the outer layer already has a
        # [EN] modal open,
        # [EN] and stacking another dialog both easily gets a stale frame and covers the progress and log.
        consent_evt = asyncio.Event()
        consent_answer = {'ok': False}
        required: list[ft.Checkbox] = []

        consent_title = ft.Text('', size=BODY_FS, color=C['gold'],
                                weight=ft.FontWeight.BOLD)
        consent_facts = ft.ListView(expand=True, spacing=2,
                                    padding=ft.Padding(6, 2, 6, 2))
        # 警告区**可滚动**：两条警告各占三行，加上勾选框会顶破固定高度，
        # 被裁掉的话"树里有控件、屏幕上什么都没有"（这个项目栽过好几次）。
        # [EN] The warning area is **scrollable**: the two warnings take three lines each, plus the checkboxes
        # [EN] would blow past a fixed height,
        # [EN] and if clipped you get "widgets in the tree, nothing on screen" (this project has been bitten by
        # [EN] this several times).
        warn_box = ft.Column([], spacing=4, expand=True,
                             scroll=ft.ScrollMode.ADAPTIVE)
        agree_btn = mk_btn(t('同意，开始 AI 处理'),
                           on_click=lambda e: _consent(True), primary=True)
        agree_btn.disabled = True

        def _recheck(e=None):
            agree_btn.disabled = not all(bool(b.value) for b in required)
            _flush()

        # 面板**吃掉剩余高度**（`expand`），不写死高度 —— 内容多少都能装下。
        # 面板显示时 `panes` 是 hidden 的，两者不会抢空间。
        # [EN] The panel **eats the remaining height** (`expand`), no fixed height -- it fits no matter how
        # [EN] much content there is.
        # [EN] While the panel is shown, `panes` is hidden, so the two don't compete for space.
        consent_panel = ft.Container(
            content=ft.Column([
                consent_title,
                ft.Container(content=consent_facts, height=96),
                warn_box,
                ft.Row([agree_btn,
                        mk_btn(t('不同意，取消'), on_click=lambda e: _consent(False),
                               primary=False)], spacing=8),
            ], spacing=6),
            visible=False, expand=True,
            bgcolor=C['input_bg'], border=make_border(1, C['border_gold']),
            border_radius=6, padding=ft.Padding(10, 8, 10, 8),
        )

        # ══════════ 「AI 补全并回写引用文件夹」的确认面板（默认藏起来）══════════
        # [EN] ══════════ "AI completes and writes back to reference folder" confirmation panel (hidden by
        # [EN] default) ══════════
        # AI 体检之后弹出来。**必须先列清单、作者点头才动手** —— 因为这是全程序
        # 唯一会写用户**原始素材**的地方（`ingest/repair.py` 的 `write_back`：
        # 它是唯一有 `phase='ingest'` + `.nwsproj` 熔断的写入口）。
        # 面板做成跟「交给 AI 之前」同一个长相：同一个对话框里不该有两种确认脸。
        # [EN] Pops up after the AI checkup. **It must list the items first and get the author's nod before
        # [EN] acting** -- because this is the
        # [EN] only place in the whole program that writes to the user's **original materials** (`write_back`
        # [EN] in `ingest/repair.py`:
        # [EN] it is the only write entry with `phase='ingest'` + `.nwsproj` circuit breaker).
        # [EN] The panel is styled the same as "Before handing to AI": there shouldn't be two kinds of
        # [EN] confirmation face in the same dialog.
        repair_evt = asyncio.Event()
        repair_answer = {'ok': False}
        repair_title = ft.Text('', size=BODY_FS, color=C['gold'],
                               weight=ft.FontWeight.BOLD)
        repair_list = ft.ListView(expand=True, spacing=3,
                                  padding=ft.Padding(6, 2, 6, 2))
        repair_cb = mk_check(t('我同意让 AI 按上面的做法修复，并写回引用文件夹'), False)
        repair_btn = mk_btn(t('同意修复并回写'),
                            on_click=lambda e: _repair(True), primary=True)
        repair_btn.disabled = True

        def _recheck_repair(e=None):
            repair_btn.disabled = not bool(repair_cb.value)
            _flush()

        repair_cb.on_change = _recheck_repair

        repair_panel = ft.Container(
            content=ft.Column([
                repair_title,
                repair_list,
                repair_cb,
                ft.Row([repair_btn,
                        mk_btn(t('跳过，不改引用文件夹'),
                               on_click=lambda e: _repair(False),
                               primary=False)], spacing=8),
            ], spacing=6),
            visible=False, expand=True,
            bgcolor=C['input_bg'], border=make_border(1, C['border_gold']),
            border_radius=6, padding=ft.Padding(10, 8, 10, 8),
        )

        def _repair(ok: bool):
            repair_answer['ok'] = bool(ok)
            try:
                repair_evt.set()
            except Exception:                               # noqa: BLE001
                pass

        def _flush():
            try:
                page.update()
            except Exception:
                pass

        def _now() -> str:
            return time.strftime('%H:%M:%S')

        # ══════════ ★ 报错与关键信息**也要进右侧「AI 优化对话」** ══════════
        # [EN] ══════════ ★ Errors and key info **also go into the right-side "AI optimization conversation"**
        # [EN] ══════════
        # 用户 2026-10-07：「开卷 摄取的时候如果有报错以及AI回复的关键信息
        # 则请将其放到右侧AI优化对话的回复里 **否则可能看不见**」。
        # [EN] User 2026-10-07: "During volume-opening ingestion, if there are errors as well as key info from
        # [EN] the AI reply,
        # [EN] please put them into the replies of the right-side AI optimization conversation, **otherwise
        # [EN] they might not be seen**.
        # 为什么必须这么做：右侧那一栏是**作者盯着看的地方**（他在那里跟 AI
        # 一来一往），而左侧「运行日志」是一条快速滚动的流水 —— 一轮开卷几十次
        # 调用、几百行日志，超过 600 行还会**把最前面的 100 行裁掉**。
        # 报错只落在左边 → 作者多半没看见，只会觉得"卡住了 / 没反应"，
        # 于是反复重试、或者把已经跑了一半的流程关掉（那才是真损失）。
        # [EN] Why this must be done: the right column is **where the author stares** (he's there going back
        # [EN] and forth
        # [EN] with the AI), while the left "run log" is a fast-scrolling stream -- a single volume opening has
        # [EN] dozens of
        # [EN] calls, hundreds of log lines, and past 600 lines it even **trims the first 100 lines**.
        # [EN] Errors only land on the left → the author mostly doesn't see them, and just thinks it's "stuck /
        # [EN] no response",
        # [EN] so they retry repeatedly, or close a flow that's already half done (that's the real loss).
        # 规矩刻意**克制** —— 右边是「对话」，不是日志的副本，塞满就没人看了：
        #   · `level='err'` **自动**进（报错是作者必须知道的）；
        #   · 关键节点**手动**调 `_mirror_chat(...)`（完成 / 落盘 / 降级）；
        #   · **同一条文本只进一次**（LLM 重试三轮别刷成三条一模一样的）；
        #   · 加 `【系统】` 前缀 —— 一眼区别于"AI 说的话"，别让它冒充对话。
        # [EN] The rule is deliberately **restrained** — the right side is a "conversation", not a copy of the
        # [EN] log; stuff it full and nobody reads it:
        # [EN] · `level='err'` goes in **automatically** (errors are something the author must know about);
        # [EN] · key nodes call `_mirror_chat(...)` **manually** (done / persisted / degraded);
        # [EN] · **the same text only goes in once** (don't let three rounds of LLM retries spam three
        # [EN] identical entries);
        # [EN] · add the `【系统】` prefix — so it's distinguishable at a glance from "what the AI said", and can't
        # [EN] masquerade as conversation.
        _MIRRORED: set[str] = set()

        def _mirror_chat(text: str, kind: str = 'err') -> None:
            """把一条**系统消息**放进右侧对话（与 AI 的气泡同栏、带前缀）。

            ⚠ 去重按**文本本身**：LLM 重试那几条带 `（1/3）`/`（2/3）`…
              各不相同，**都会进**（那正是作者想看的"它在重试"）；
              而同一句话反复出现（循环里同一个失败）只留第一条。

            ⚠ 这个函数**吞掉所有异常**：它只是播报员，报错本身绝不能因为它挂了
              而丢（那正好就是本节要解决的病）。
            
                        English:
            Put a **system message** into the right-side conversation (same column as the AI bubbles, with a
            prefix).
                        ⚠ Deduplicate by **the text itself**: the LLM retries carry `（1/3）`/`（2/3）`...
                          All different, **all will be ingested** (that's exactly what the author wants to see: "it's retrying");
                          whereas the same line appearing repeatedly (the same failure inside a loop) keeps only the first.
                        ⚠ This function **swallows all exceptions**: it is only an announcer, and an error itself must never be lost because it crashed
                          (that is exactly the disease this section is meant to cure).
            """
            try:
                raw = str(text or '').strip()
                if not raw:
                    return
                # 剥掉日志前缀里的时间戳 —— 对话栏里不需要它
                # （气泡的先后顺序就是时间顺序；带上反而像日志行）
                # [EN] Strip the timestamp from the log prefix — it isn't needed in the conversation pane
                # [EN] (the order of the bubbles is the chronological order; keeping it just makes it look like a log
                # [EN] line)
                body = re.sub(r'^\[?\d{1,2}:\d{2}(?::\d{2})?\]?\s*', '', raw)
                body = body.strip()
                if not body or body in _MIRRORED:
                    return
                _MIRRORED.add(body)
                if len(_MIRRORED) > 400:
                    # 极端长流程（几百次调用）时别让这个集合无限涨。
                    # 清掉只会让**很早以前**那条允许再进一次，无伤大雅。
                    # [EN] With extremely long flows (hundreds of calls), don't let this set grow without bound.
                    # [EN] Clearing it only lets that **long-ago** entry in one more time; harmless.
                    _MIRRORED.clear()
                _add_chat('ai', t('【系统】') + body)
            except Exception:                                    # noqa: BLE001
                pass

        def _add_log(text: str, level: str = 'info'):
            color = {'stage': C['gold'], 'ok': C['accent'], 'err': '#b23028',
                     'llm_req': '#7a6a4f', 'llm_resp': '#4a6b4a',
                     'body': C['muted'], 'user': '#2b5f8a'}.get(level, C['text'])
            log_list.controls.append(
                ft.Text(text, size=SZ(12), color=color, selectable=True,
                        font_family='Consolas', no_wrap=False))
            if len(log_list.controls) > 600:
                del log_list.controls[:100]
            # 滚动条：一行日志约 17px，超过一屏就让条先现身
            # （`on_scroll` 随后会用真实数据校正位置与长度）。
            # [EN] Scrollbar: one log line is about 17px; once it exceeds one screen, show the bar first
            # [EN] (`on_scroll` will later correct the position and length with real data).
            log_bar.sync(len(log_list.controls) * 17 > ING_LIST_H)
            # ① 落盘：界面上这几行只活在内存里（超过 600 行还会被裁掉头 100 行），
            #    关掉程序就没了 —— 用户 2026-10-05 要求「所有的对话也放到日志里」。
            #    ⚠ `llm_req / llm_resp / body` 三种**不在这里写**：
            #    它们来自 `llm.add_listener`，而**路由器已经把原样的全文写进对话日志了**
            #    （`LLMRouter._log_dialogue`）。在这里再写一遍，同一句话会出现两次，
            #    而且界面上这份是**截断过的**（700 / 1200 字），留着反而误导。
            #    `user` 也不算：作者那句话已经由 `_add_chat` 记成「作者 → AI」，
            #    再写一遍就是同一句话出现两次。
            # [EN] ① Persist to disk: these lines in the UI live only in memory (over 600 lines, the first 100 get
            # [EN] trimmed anyway),
            # [EN] and are gone when the program closes — user requested on 2026-10-05 that "all conversations also
            # [EN] go into the log".
            # [EN] ⚠ `llm_req / llm_resp / body` — these three are **not written here**:
            # [EN] they come from `llm.add_listener`, and **the router already writes the full verbatim text into
            # [EN] the conversation log**
            # [EN] (`LLMRouter._log_dialogue`). Writing them again here makes the same sentence appear twice,
            # [EN] and the copy in the UI is **truncated** (700 / 1200 chars), so keeping it is actually
            # [EN] misleading.
            # [EN] `user` doesn't count either: the author's line has already been recorded by `_add_chat` as
            # [EN] "author → AI",
            # [EN] writing it again means the same sentence appears twice.
            if level not in ('llm_req', 'llm_resp', 'body', 'user'):
                log_dialogue_line(text)
            # ★ **报错同时进右侧对话**（2026-10-07 用户要求：只落左侧日志
            #   "可能看不见"）。见上面 `_mirror_chat` 那段说明 ——
            #   这里**只管 `err`**，其余级别要进右侧得由调用方显式调 `_mirror_chat`
            #   （克制：右边是对话，不是日志副本）。
            # [EN] ★ **Errors also go into the right-side conversation** (user request 2026-10-07: only persisting
            # [EN] to the left log
            # [EN] "might not be seen"). See the `_mirror_chat` explanation above —
            # [EN] here we **only handle `err`**; other levels need the caller to explicitly call `_mirror_chat` to
            # [EN] get into the right side
            # [EN] (restraint: the right side is a conversation, not a log copy).
            if level == 'err':
                _mirror_chat(text, 'err')
            _flush()

        def _add_chat(role: str, text: str):
            """一条对话。作者的消息靠右、AI 的靠左，气泡**贴着内容长**、
            碰到面板右边界就换行。

            ⚠ **别用 `ft.Row` 来排这个气泡。** `Row` 会给"非 flex"的子控件
            **无限宽**约束 —— 老写法 `Row([bubble, Container(expand=True)])`
            里 bubble 就是非 flex 的，于是里面的 `Text` 既不换行、也不管面板
            多宽，整段一路横向涨到面板外面被裁掉：屏幕上就是「软件给我的字
            和我打的回复看不见，都被右侧吞掉了」（2026-10-05 用户报）。
            更隐蔽的是：那个 `expand=True` 的留白在气泡超宽时会被压到 0，
            于是"靠右"的用户气泡**看着像靠左**，两头都被裁。

            `ft.Column` 的横向约束是**有界**的（子控件拿到 maxWidth），
            所以 Text 会正常换行；`horizontal_alignment` 负责靠左/靠右。
            判据：`developers/probe_chat_bubble.py`（量墨迹右端到面板右边界的车道）。
            
                        English:
            One conversation. The author's messages are right-aligned, the AI's are left-aligned, and the
            bubble **grows to fit the content**,
                        wrapping when it hits the right edge of the panel.
                        ⚠ **Do not use `ft.Row` to lay out this bubble.** `Row` gives non-flex children
                        **unbounded width** constraints -- in the old form `Row([bubble, Container(expand=True)])`
                        the bubble is the non-flex child, so the `Text` inside neither wraps nor cares how wide
                        the panel is; the whole thing keeps growing horizontally past the panel and gets clipped: on screen this looks like "the text the software gave me
                        and the reply I typed are invisible, both swallowed by the right side" (2026-10-05 user report).
                        More insidious still: that `expand=True` spacer gets squeezed to 0 when the bubble is too wide,
                        so a "right-aligned" user bubble **looks left-aligned**, clipped on both ends.
                        `ft.Column`'s horizontal constraints are **bounded** (children get a maxWidth),
                        so Text wraps normally; `horizontal_alignment` handles left/right alignment.
                        Criterion: `developers/probe_chat_bubble.py` (measures the lane from the ink's right end to the panel's right edge).
            """
            is_user = (role == 'user')
            # ★ **空气泡防护**（2026-10-06 用户报：AI 优化里 AI 一句话都没说）。
            #   推理模型的额度被思考内容吃光时 `content` 是空串，`Container` 里放一个
            #   空 `Text` 只画出个 0 高度的条 —— 屏幕上就是"点开 AI 优化，AI 没动静"，
            #   作者分不清是"AI 没意见"还是"这一步挂了"。所以**任何一条气泡都保证有字**。
            #   真正的兜底文案在 `optimize.review_settings`，这里只是最后一道网：
            #   宁可写一句"没拿到内容"，也别让界面上出现一个看不见的气泡。
            # 气泡构造统一走 `chat_bubble()`（AI 优化与帮助聊天**共用一份实现**）——
            # 那里面记着"为什么不能用 `ft.Row` 排气泡"这条血泪教训，改之前先看它。
            # 兜底文案也在那一层，但日志要记**屏幕上那条**，所以这里先补一次。
            # [EN] ★ **Empty-bubble guard** (user report 2026-10-06: in AI optimization, the AI didn't say a single
            # [EN] word).
            # [EN] When a reasoning model's budget is eaten up by thinking content, `content` is an empty string;
            # [EN] putting an
            # [EN] empty `Text` in a `Container` only draws a 0-height strip — on screen it's "open AI
            # [EN] optimization, AI does nothing",
            # [EN] and the author can't tell whether it's "AI has no opinion" or "this step is broken". So **every
            # [EN] bubble is guaranteed to have text**.
            # [EN] The real fallback copy is in `optimize.review_settings`; here it's just the last line of
            # [EN] defense:
            # [EN] better to write "no content received" than to leave an invisible bubble on screen.
            # [EN] Bubble construction uniformly goes through `chat_bubble()` (AI optimization and help chat
            # [EN] **share one implementation**) —
            # [EN] it records the hard-earned lesson of "why you can't use `ft.Row` to lay out bubbles"; read it
            # [EN] before changing anything.
            # [EN] The fallback copy is also at that layer, but the log needs to record **the one on screen**, so
            # [EN] we patch it once here first.
            text = (str(text if text is not None else '').strip()
                    or t('（这次没有拿到内容）'))
            chat_list.controls.append(chat_bubble(text, is_user))
            # 滚动条：气泡普遍比日志行高（正文要折行），按 56px 一条估
            # [EN] Scrollbar: bubbles are generally taller than log lines (body text wraps), estimate 56px each
            chat_bar.sync(len(chat_list.controls) * 56 > ING_LIST_H)
            # 落盘：**两边都要写**。此前只有作者那句走 `_add_log`（进界面日志），
            # AI 的回复**只在气泡里** —— 关掉窗口什么都没留下（2026-10-05 用户要求）。
            # [EN] Persist to disk: **both sides must be written**. Previously only the author's line went through
            # [EN] `_add_log` (into the UI log),
            # [EN] and the AI's reply **only existed in the bubble** — closing the window left nothing behind (user
            # [EN] request 2026-10-05).
            log_dialogue_turn(role, text)
            _flush()

        def _set_progress(pct: float, label: str = ''):
            prog.value = max(0.0, min(1.0, pct))
            pct_text.value = f"{int(pct * 100)}%"
            if label:
                stage_text.value = label
            _flush()

        # ── 「跟大模型沟通」那行小字 ──
        # 记一份历史：验证脚本没法跟时间赛跑（MOCK 模式下"正在思考"可能只存在几毫秒），
        # 所以每次刷新都留一条 (时刻, 文字)，断言改成"这段时间里出现过这几种状态"。
        _STATUS_ERR = '#b23028'          # 与日志里 'err' 同一支朱红
        # [EN] ── That small line "communicating with the LLM" ──
        # [EN] Keep a history: verification scripts can't race against time (in MOCK mode "thinking" may only
        # [EN] exist for a few milliseconds),
        # [EN] so each refresh records a (time, text) entry, and assertions become "these states appeared
        # [EN] during this period".
        # [EN] Same vermilion as 'err' in the log
        status_hist: list = []

        def _set_llm_status(text: str, color: str) -> None:
            """刷新那行小字。**任何一步出错都不许打断摄取**（它只是个播报员）。
                        English:
            Refresh that small status line. **No error at any step may interrupt ingestion** (it is only an
            announcer).
            """
            try:
                llm_status.value = text
                llm_status.color = color
                status_hist.append((time.strftime('%H:%M:%S'), text))
                if len(status_hist) > 200:
                    del status_hist[:-200]
                _flush()
            except Exception:                                   # noqa: BLE001
                pass

        # 等回复时的秒表：「正在思考」四个字一动不动，用户分不清在跑还是卡住。
        # 每秒刷一次「已等 N 秒」，这也是"进展"最直接的证据。
        # [EN] Stopwatch while waiting for a reply: "thinking" sits there motionless, and the user can't tell
        # [EN] whether it's running or stuck.
        # [EN] Refresh "waited N seconds" once per second; this is also the most direct evidence of "progress".
        _wait = {'task': None, 't0': 0.0}

        def _stop_wait_timer() -> None:
            tsk = _wait['task']
            _wait['task'] = None
            if tsk is not None:
                try:
                    tsk.cancel()
                except Exception:                               # noqa: BLE001
                    pass

        async def _wait_ticks(plabel: str, model: str) -> None:
            try:
                while True:
                    await asyncio.sleep(1.0)
                    _set_llm_status(
                        t('正在思考 · 等待回复（已等 {s} 秒 · {m} · {p}）',
                          s=int(time.time() - _wait['t0']), m=model or '—',
                          p=plabel),
                        C['seal'])
            except asyncio.CancelledError:
                return
            except Exception:                                   # noqa: BLE001
                return                                          # 播报失败不该影响摄取
                # [EN] A failed announcement shouldn't affect ingestion

        def _start_wait_timer(plabel: str, model: str) -> None:
            _stop_wait_timer()
            _wait['t0'] = time.time()
            # 先立刻显示一次（别让"0 秒"那一行等满一秒才出现）
            # [EN] Show it once immediately first (don't make the "0 seconds" line wait a full second to appear)
            _set_llm_status(
                t('正在思考 · 等待回复（已等 0 秒 · {m} · {p}）',
                  m=model or '—', p=plabel), C['seal'])
            try:
                _wait['task'] = page.run_task(_wait_ticks, plabel, model)
            except Exception:                                   # noqa: BLE001
                _wait['task'] = None                            # 没有秒表也能继续
                # [EN] Can continue without the stopwatch

        def _add_stage_sep() -> None:
            """一个阶段结束时，在日志里画**一条横线 + 一个空行**，再开下一个阶段。

            用户 2026-10-06：「左侧我想完成一个阶段，下一行出一个横线，然后再下一行
            一个空行，然后再继续」—— 日志里 request/response 的正文动辄十几行，
            不划线根本看不出阶段之间的分界。
            ⚠ **第一个阶段之前不画**（开头就顶一条横线很难看），所以用 `stage_n` 计数。
            ⚠ 用 `Container(height=1)` 而不是 `ft.Divider`：Divider 走 Material 主题，
            在深色/浅色两套主题下颜色不一样，这里要的是稳定的纸边线。
            
                        English:
            When a stage ends, draw **a horizontal line + a blank line** in the log, then start the next
            stage.
                        User 2026-10-06: "On the left I want to finish a stage, next line a horizontal line, then next line
                        a blank line, then continue" -- the request/response bodies in the log run a dozen lines each,
                        and without a line you simply cannot see the boundaries between stages.
                        ⚠ **Do not draw before the first stage** (starting right off with a horizontal line looks ugly), so use the `stage_n` counter.
                        ⚠ Use `Container(height=1)` instead of `ft.Divider`: Divider goes through the Material theme,
                        and its color differs between dark/light themes; what is wanted here is a stable paper-edge line.
            """
            if state.get('stage_n', 0) <= 0:
                return
            log_list.controls.append(
                ft.Container(height=1, bgcolor=C['border']))
            log_list.controls.append(ft.Container(height=10))   # 空行
            # [EN] Blank line
            _flush()

        def _set_chat_enabled(on: bool):
            chat_input.disabled = not on
            send_btn.disabled = not on
            finish_btn.disabled = not on
            _flush()

        def _lock_input() -> None:
            """到轮数上限：**锁输入框但把「完成优化并进入」留着**。

            ⚠ 别图省事用 `_set_chat_enabled(False)` —— 那个把 `finish_btn` 一起禁了。
            到上限那一刻正是**最该让他收工**的时候，把出口也关掉就成了死胡同。
            
                        English:
            On reaching the round limit: **lock the input box but keep "Finish optimization and enter"**.
                        ⚠ Do not take the easy route with `_set_chat_enabled(False)` -- that disables `finish_btn` too.
                        The moment the limit is hit is exactly when **he most needs to wrap up**; closing the exit too makes it a dead end.
            """
            chat_input.disabled = True
            send_btn.disabled = True
            finish_btn.disabled = False
            _flush()

        def _set_ai_busy(on: bool, what: str = '') -> None:
            """AI 正在跑 / 跑完了 —— 只改状态与小字（按钮的可点性由阶段决定）。
                        English:
            AI is running / has finished -- only change the status and the small line (button clickability
            is decided by the stage).
            """
            state['ai_busy'] = bool(on)
            if on:
                _set_llm_status(
                    t('AI 正在处理：{what}（想停就点「⏹ 强制停止」）',
                      what=what or t('打磨中')), C['seal'])
            _flush()

        def _stop_ai(e=None):
            """★ **强制停止**（2026-10-08 用户要求）。

            两种状态、两种动作 —— 都叫"停下来"，但后果差得远，所以都要明说：
              · AI 正在跑 → 打断**这一轮**：已经改好的设定保留，可以继续说下一句；
              · AI 在等你输入 → 优化到此为止，直接收尾进运行界面。
            第三种（还没进 AI 优化阶段 / 已经收工了）只留一行日志，不做任何事。
            
                        English:
            ★ **Force stop** (2026-10-08 user request).
                        Two states, two actions -- both called "stop", but the consequences differ greatly, so both must be spelled out:
                          · AI is running → interrupt **this round**: settings already changed are kept, and you can continue with the next line;
                          · AI is waiting for your input → optimization ends here, wrap up directly and enter the run interface.
                        The third case (not yet in the AI optimization stage / already wrapped up) only logs one line and does nothing.
            """
            task_now = state.get('round_task')
            if task_now is not None and not task_now.done():
                state['round_stopped'] = True
                _add_log(t('[{ts}] ⏹ 你按了「强制停止」—— 正在打断这一轮 AI…',
                           ts=_now()), 'err')
                _set_llm_status(t('⏹ 已强制停止（这一轮作废，已改的设定保留）'),
                                _STATUS_ERR)
                try:
                    task_now.cancel()
                except Exception:                            # noqa: BLE001
                    pass
                _flush()
                return
            if state.get('phase') == 'chat':
                _add_log(t('[{ts}] ⏹ 你按了「强制停止」—— 优化到此为止，开始收尾',
                           ts=_now()), 'stage')
                _finish(None)
                return
            _add_log(t('[{ts}] （现在没有正在跑的 AI）', ts=_now()), 'info')

        # ── 确认面板：填内容 / 收同意 ──
        # [EN] ── Confirmation panel: fill in content / collect consent ──
        def _fmt_chars(n: int) -> str:
            n = int(n or 0)
            return f'{n / 10000:.1f} 万字' if n >= 10000 else f'{n} 字'

        def _fmt_money(v: float) -> str:
            v = float(v or 0)
            if v <= 0:
                return '0'
            return f'{v:.4f}'.rstrip('0').rstrip('.') if v < 1 else f'{v:.2f}'

        def _fill_consent(brief: dict) -> None:
            """把 `ingest.preview` 算出来的概览铺进面板（只读数字，不做判断）。
                        English:
            Lay the overview computed by `ingest.preview` into the panel (read-only numbers, no judgment).
            """
            consent_facts.controls.clear()
            required.clear()
            warn_box.controls.clear()

            consent_facts.controls.append(ft.Text(
                t('文件：{n} 个（有内容 {m} 个）· 合计 {chars}',
                  n=brief['files_total'], m=brief['files_read'],
                  chars=_fmt_chars(brief['total_chars'])),
                size=BODY_FS, color=C['text'], selectable=True))
            for cat, n, chars in category_rows(brief):
                consent_facts.controls.append(ft.Text(
                    t('- {cat}：{n} 个 · {chars}',
                      cat=t(cat), n=n, chars=_fmt_chars(chars)),
                    size=HINT_FS, color=C['muted'], selectable=True))
            consent_facts.controls.append(ft.Text(
                t('预计发出去：约 {tin} token 输入 + {tout} token 输出 · '
                  '按摘要档 {model} 约 ¥{cost}',
                  tin=brief['est_input_tokens'], tout=brief['est_output_tokens'],
                  model=brief['model'] or t('（未配置）'),
                  cost=_fmt_money(brief['est_cost'])),
                size=HINT_FS, color=C['muted'], selectable=True))
            if brief['truncated']:
                # 这条是「真话」而不是吓唬：源内容超过单次上限，中间确实会被丢掉
                # [EN] This is the "truth", not a scare tactic: if the source content exceeds the single-run limit, the
                # [EN] middle really does get dropped
                consent_facts.controls.append(ft.Text(
                    t('※ 源内容超过单次上限（提取设定最多读 {cap} 字），'
                      '中间部分会被截断 —— 只保留开头与结尾各一段。',
                      cap=brief['caps']['extract']),
                    size=HINT_FS, color=C['seal'], selectable=True))

            n_warn = 0
            if brief['has_novel']:
                n_warn += 1
                where = (t('当前是演示模式（MOCK_LLM），不会真的联网。')
                         if brief['mock']
                         else (t('将发送到：{host}', host=brief['base_url'])
                               if brief['base_url'] else ''))
                warn_box.controls.append(ft.Text(
                    t('⚠ 含小说正文：{n} 个文件、共 {chars}', n=brief['novel_files'],
                      chars=_fmt_chars(brief['novel_chars'])),
                    size=BODY_FS, color=C['seal'], weight=ft.FontWeight.BOLD))
                warn_box.controls.append(ft.Text(
                    t('这些正文内容会被发送到你所配置的大模型服务。{where}'
                      '是否同意？', where=where),
                    size=HINT_FS, color=C['seal'], no_wrap=False))
                cb = mk_check(t('我同意把小说正文发送给大模型'), False)
                cb.on_change = _recheck
                required.append(cb)
                warn_box.controls.append(cb)

            if brief['big']:
                n_warn += 1
                warn_box.controls.append(ft.Text(
                    t('⚠ 内容比较多：源文件共 {chars}（超过 {limit}）',
                      chars=_fmt_chars(brief['total_chars']),
                      limit=_fmt_chars(brief['big_threshold'])),
                    size=BODY_FS, color=C['seal'], weight=ft.FontWeight.BOLD))
                warn_box.controls.append(ft.Text(
                    t('AI 处理这一趟会消耗较多 token（本次预计约 ¥{cost}）。'
                      '是否继续？', cost=_fmt_money(brief['est_cost'])),
                    size=HINT_FS, color=C['seal'], no_wrap=False))
                cb = mk_check(t('我同意这次可能产生较多 token 开销'), False)
                cb.on_change = _recheck
                required.append(cb)
                warn_box.controls.append(cb)

            if n_warn == 0:
                warn_box.controls.append(ft.Text(
                    t('没有需要特别确认的事项 —— 没读到正文，内容量也不大。'),
                    size=HINT_FS, color=C['accent_green']))
            consent_title.value = t('交给 AI 之前，先看看传进来了什么')
            agree_btn.disabled = not all(bool(b.value) for b in required)
            _flush()

        def _consent(ok: bool):
            consent_answer['ok'] = bool(ok)
            if not ok:
                state['cancel'] = True
            try:
                consent_evt.set()
            except Exception:                               # noqa: BLE001
                pass

        async def _consent_gate(brief: dict) -> bool:
            """管线在第一次 LLM 调用前调它 —— 停住，等作者表态。
                        English:
            The pipeline calls it before the first LLM call -- stop and wait for the author's response.
            """
            _fill_consent(brief)
            consent_panel.visible = True
            panes.visible = False        # 把版面让给确认面板（日志这时也没几条）
            # [EN] Yield the layout to the confirmation panel (there aren't many log lines at this point anyway)
            _set_chat_enabled(False)
            _set_progress(0.13, t('等你确认 —— 确认之前不会调用任何 AI'))
            _set_llm_status(t('已暂停：等你确认之后才会调用 AI'), C['gold'])
            _add_log(f"[{_now()}] ⏸ 本地文件已读完（{brief['files_read']} 个有内容，"
                     f"合计 {brief['total_chars']} 字）；"
                     f"下一次点击才会开始调用 AI", 'stage')
            _flush()
            await consent_evt.wait()
            consent_panel.visible = False
            panes.visible = True
            if not consent_answer['ok']:
                _add_log(f"[{_now()}] 未同意把内容交给 AI —— 摄取中止，"
                         f"没有发出任何 LLM 请求", 'err')
            _flush()
            return bool(consent_answer['ok'])

        # ── 「AI 补全并回写引用文件夹」：列清单 → 等一次确认 ──
        # [EN] ── "AI completes and writes back to the reference folder": list the items → wait for one
        # [EN] confirmation ──
        # ⚠ 这一步会**写用户的原始素材文件夹**，所以文案要把代价讲透：
        #   谁动、动什么、备份在哪、什么时候不再动。只写"确定吗"等于没确认。
        # [EN] ⚠ This step will **write to the user's original material folder**, so the copy must spell out
        # [EN] the cost clearly:
        # [EN] who touches it, what is touched, where the backup is, when it will stop touching it. Just
        # [EN] writing "are you sure" is no confirmation at all.
        def _fill_repair(issues: list) -> None:
            repair_list.controls.clear()
            repair_title.value = t('AI 发现 {n} 处它可以自己修好的问题', n=len(issues))
            for iss in issues:
                repair_list.controls.append(ft.Text(
                    '· ' + iss.title, size=BODY_FS, color=C['text'], selectable=True))
                repair_list.controls.append(ft.Text(
                    t('　→ 落点：{p} —— {plan}',
                      p=iss.target_label(Path(src)), plan=iss.plan),
                    size=HINT_FS, color=C['muted'], selectable=True))
            repair_list.controls.append(ft.Text(
                t('· 每个被改动的文件都会先留一份同名 .bak 备份；'
                  '你原有的文字只增不改，不会被删掉或改写。'),
                size=HINT_FS, color=C['accent_green'], no_wrap=False))
            repair_cb.value = False
            repair_btn.disabled = True
            _flush()

        async def _repair_gate(issues: list) -> bool:
            """停住等作者表态 —— 回来 True 才真的去改引用文件夹。
                        English:
            Stop and wait for the author's response -- only on True coming back does it actually go modify
            the referenced folder.
            """
            _fill_repair(issues)
            repair_panel.visible = True
            panes.visible = False          # 版面让给清单（跟同意门一个做法）
            # [EN] Yield the layout to the list (same approach as the consent gate)
            _set_chat_enabled(False)
            _set_progress(0.92, t('等你确认 —— 要不要把这些补全写回引用文件夹'))
            _set_llm_status(t('已暂停：等你确认之后才会改动引用文件夹'), C['gold'])
            _add_log(f"[{_now()}] ⏸ AI 找到 {len(issues)} 处可以自己修好的问题"
                     f"（清单已列出）—— 你同意才动手", 'stage')
            _flush()
            await repair_evt.wait()
            repair_panel.visible = False
            panes.visible = True
            # ★★ 「跳过，不改引用文件夹」是**对整个引用文件夹的表态**，不只是对补全那一步。
            #   所以把它记在 `state` 上：后面打磨收工时要把打磨记录写回引用文件夹
            #   （`polish_write_back`），那一步**也必须停下来** —— 否则用户明明说了
            #   "别动我的素材"，程序转头又往里面写了一个文件。
            #   ⚠ 这是 `verify_repair_writeback` 的 B2e 当场抓出来的：它断言"选了跳过
            #     → 引用文件夹一个字节都没变"，而我新加的那一步让它多出了
            #     `AI打磨记录.md`。判据是对的，产品错了。
            # [EN] ★★ "Skip, don't modify the reference folder" is **a stance on the entire reference folder**, not
            # [EN] just the completion step.
            # [EN] So record it on `state`: later when polishing wraps up and the polish record needs to be written
            # [EN] back to the reference folder
            # [EN] (`polish_write_back`), that step **must also stop** — otherwise the user clearly said
            # [EN] "don't touch my materials", and the program turns around and writes another file into it.
            # [EN] ⚠ This was caught red-handed by `verify_repair_writeback`'s B2e: it asserts "chose skip
            # [EN] → not one byte of the reference folder changed", but the step I newly added made it produce an
            # [EN] extra
            # [EN] `AI打磨记录.md`. The criterion was right; the product was wrong.
            state['src_touch_denied'] = not bool(repair_answer['ok'])
            if not repair_answer['ok']:
                _add_log(f"[{_now()}] 你选了不改引用文件夹 —— 已跳过（原文一字未动）",
                         'stage')
            _flush()
            return bool(repair_answer['ok'])

        def _send(e=None):      # ⚠ 带默认值：按钮/on_submit 会传 e，自动化脚本常常不传
        # [EN] ⚠ With a default value: buttons/on_submit pass an e, but automation scripts often don't
            txt = (chat_input.value or '').strip()
            if not txt:
                return
            chat_input.value = ''
            _add_chat('user', txt)
            _add_log(f"[{_now()}] 作者：{txt}", 'user')
            user_q.put_nowait(txt)

        def _finish(e=None):    # ⚠ 同上；本类句柄**一律 e=None**，免得测试脚本调错风格就静默不生效
        # [EN] ⚠ Same as above; handles in this class are **uniformly e=None**, so that a test script using the
        # [EN] wrong call style doesn't silently fail to take effect
            state['phase'] = 'finishing'
            finish_btn.disabled = True
            chat_input.disabled = True
            send_btn.disabled = True
            stop_btn.disabled = True
            user_q.put_nowait(FINISH)
            _flush()

        chat_input.on_submit = _send

        def _cancel(e=None):    # ⚠ 同上
        # [EN] ⚠ Same as above
            state['cancel'] = True
            _add_log(f"[{_now()}] 已请求取消摄取…", 'err')
            stop_btn.disabled = True
            user_q.put_nowait(FINISH)
            # 正在跑的那一轮也要收 —— 只取消外层的 `task`，它 awaits 的那个子任务
            # 有极短的一瞬是"孤儿"（已经建好、还没被 await 到）。两个都取消最稳。
            # [EN] The currently running round must also be collected — only cancelling the outer `task` leaves the
            # [EN] subtask it awaits
            # [EN] There's an extremely brief instant where it's an "orphan" (already created, not yet awaited).
            # [EN] Cancelling both is the most robust.
            rtask = state.get('round_task')
            if rtask is not None:
                try:
                    rtask.cancel()
                except Exception:
                    pass
            tsk = state.get('task')
            if tsk is not None:
                try:
                    tsk.cancel()
                except Exception:
                    pass
            _flush()

        # ══════════════════════ 对话框 ══════════════════════
        # [EN] ══════════════════════ Dialog ══════════════════════
        panes = ft.Row([
            _pane(t('运行日志 · 含 AI 调用全过程'), log_bar),
            _pane(t('AI 优化对话'), chat_bar),
        ], spacing=10, expand=True)

        # 宽度按当前窗口收一下：小屏幕上对话框比窗口还宽时，Flet 会把内容挤变形
        # （`page.width` 在布局前可能是 0 → 拿不到就按常量来）
        # [EN] Constrain the width to the current window: on a small screen, when the dialog is wider than the
        # [EN] window, Flet squeezes the content out of shape
        # [EN] (`page.width` may be 0 before layout → if you can't get it, fall back to the constant)
        ing_w = ING_W
        try:
            avail = float(page.width or 0) - 120
            if avail > 720:
                ing_w = int(min(ING_W, avail))
        except Exception:                                   # noqa: BLE001
            pass

        body = ft.Column([
            ft.Row([ft.Text(t('摄取进度'), size=SEC_FS, color=C['gold'],
                            weight=ft.FontWeight.BOLD),
                    # 这行小字占**中间的弹性位**：够长就整句显示，太长自动省略，
                    # 不会把右边的百分比顶出去。所以这里**不能再放 `expand` 的留白**
                    # （两个 expand 会各分一半，那行小字会被压得只剩几个字）。
                    # [EN] This small line takes the **middle flexible slot**: if it's long enough, show the whole
                    # [EN] sentence; if too long, ellipsize automatically,
                    # [EN] It will not push the percentage on the right out. So here **you cannot add `expand` whitespace
                    # [EN] again**
                    # [EN] (two expands would each take half, and that small line of text would be squeezed down to just a
                    # [EN] few characters).
                    ft.Container(content=llm_status, expand=True),
                    pct_text], spacing=8,
                   vertical_alignment=ft.CrossAxisAlignment.CENTER),
            prog,
            stage_text,
            consent_panel,          # 交给 AI 之前的确认（默认隐藏）
            repair_panel,           # AI 补全并回写引用文件夹的清单（默认隐藏）
            # [EN] Confirmation before handing to the AI (hidden by default)
            # [EN] Manifest of AI completion and write-back to the referenced folder (hidden by default)
            panes,
            ft.Row([chat_input, send_btn, stop_btn], spacing=8,
                   # ⚠ 本版 Flet 的默认**就是** CENTER（见上面那段），写出来是防默认值变。
                   # [EN] ⚠ This Flet's default **is** CENTER (see the note above); writing it is a guard
                   # [EN] against the default changing.
                   vertical_alignment=ft.CrossAxisAlignment.CENTER),
        ], spacing=8, height=ING_H, width=ing_w)

        dlg = mk_dialog(
            t('开 卷 · 摄 取'),
            body,          # body 自带 width/height，别再套一层改高度，否则会溢出裁切
            # [EN] body already has its own width/height, do not wrap it in another layer to change the height,
            # [EN] otherwise it will overflow and clip
            [
                finish_btn,
                mk_btn(t('取消摄取'), on_click=_cancel, primary=False),
            ],
        )
        dlg.modal = True          # 摄取期间不允许点外部关掉
        # [EN] Not allowed to click outside to close during ingestion
        page.show_dialog(dlg)

        # ══════════════════════ 事件桥接 ══════════════════════
        # [EN] ══════════════════════ Event bridging ══════════════════════
        _PURPOSE = {'extract': '提取设定', 'genre': '类型判定', 'style': '风格卡',
                    'progress': '故事进度表', 'alignment': '正文对齐',
                    'opening': '开局方案', 'optimize_review': 'AI 体检',
                    'optimize_apply': '按指令改设定',
                    'repair_source': '补全缺口'}

        def on_stage(stage_id, label, pct, extra=''):
            if state['cancel']:
                return
            # 上一个阶段到此为止：先画横线 + 空行（第一个阶段之前不画）
            # [EN] That is the end of the previous stage: draw a horizontal line + blank line first (do not draw
            # [EN] before the first stage)
            _add_stage_sep()
            state['stage_n'] = state.get('stage_n', 0) + 1
            _set_progress(pct, t(label) + (f' — {extra}' if extra else ''))
            _add_log(f"[{_now()}] ▶ {t(label)}" + (f" — {extra}" if extra else ''), 'stage')
            # 小字说清这一步**要不要联网**：以前只有一根不动的进度条，
            # 用户既不知道该等什么，也不知道什么时候会开始花钱。
            # [EN] The small text clearly states whether this step **needs network access**: previously there was
            # [EN] only a static progress bar,
            # [EN] the user neither knew what to wait for nor when money would start being spent.
            if stage_id == 'done':
                _set_llm_status(t('✓ 摄取完成'), C['accent_green'])
            elif stage_id in AI_STAGES:
                _set_llm_status(t('准备调用 AI：{label}', label=t(label)), C['gold'])
            else:
                _set_llm_status(t('本地处理：{label}（这一步不联网）', label=t(label)),
                                C['muted'])

        # ★ 「上一发是注定要被重试的空正文」这个标记（2026-10-07）。
        #   `router` 已经会自动关掉思考重试，但**成功这件事不发事件** ——
        #   所以要自己记一笔，等下一发非空响应到了就把"救回来了"讲出来。
        # [EN] ★ The marker "the previous shot was an empty body destined to be retried" (2026-10-07).
        # [EN] `router` already automatically turns off thinking and retries, but **success does not emit an
        # [EN] event** ——
        # [EN] so you have to note it yourself, and when the next non-empty response arrives, speak up that it
        # [EN] was "rescued".
        _was_no_think_retried = {'v': False}

        def on_llm(ev: dict):
            try:
                kind = ev.get('type')
                purpose = ev.get('purpose') or ''
                plabel = t(_PURPOSE.get(purpose, purpose or '通用'))
                if kind == 'request':
                    model = str(ev.get('model') or '')
                    _start_wait_timer(plabel, model)     # 小字切到「正在思考 + 秒表」
                    # [EN] The small text switches to "thinking + stopwatch"
                    _add_log(f"[{_now()}] → LLM 请求 · {plabel} · {model}"
                             f" · {len(ev.get('messages') or [])} {t('条消息')}", 'llm_req')
                    for m in (ev.get('messages') or [])[-2:]:
                        content = str(m.get('content') or '')
                        if content:
                            _add_log(f"    [{m.get('role')}] {_clip(content, 700)}", 'body')
                elif kind == 'response':
                    _stop_wait_timer()
                    cost_s = f"{ev.get('cost', 0):.5f}"
                    _set_llm_status(
                        t('✓ 已回复 · 用时 {ms} ms · {tin}+{tout} token · 花费 ¥{c}',
                          ms=ev.get('ms'), tin=ev.get('tin'), tout=ev.get('tout'),
                          c=cost_s), C['accent_green'])
                    _add_log(f"[{_now()}] ← LLM 响应 · {plabel} · "
                             f"{ev.get('tin')}+{ev.get('tout')} tok · {ev.get('ms')}ms"
                             f" · {t('花费 {c}', c=cost_s)}", 'llm_resp')
                    _add_log(f"    {_clip(str(ev.get('text') or ''), 1200)}", 'body')
                    # ★ 上一发是"注定要被重试"的空正文，这一发拿到东西了 →
                    #   **把"救回来了"说出来**（以前救回来这件事一个字都没说，
                    #   作者只看到了那条红字）。见下面那个分岔的说明。
                    # [EN] ★ The previous shot was an empty body "destined to be retried", and this shot got something →
                    # [EN] **Say it out loud that it was rescued** (previously not a single word was said about the rescue,
                    # [EN] the author only saw that red line of text). See the explanation of the branch below.
                    if (_was_no_think_retried['v']
                            and str(ev.get('text') or '').strip()):
                        _was_no_think_retried['v'] = False
                        try:
                            _learned = ((str(ev.get('model') or ''),
                                         str(ev.get('purpose') or ''))
                                        in llm.learned_no_think())
                        except Exception:                        # noqa: BLE001
                            _learned = False
                        _add_log(t(
                            '[{ts}] ✓ 关掉思考重试成功，拿到正文了{extra}',
                            ts=_now(),
                            extra=(t('；已记住这个用途，以后直接关思考发，'
                                     '不再白烧一次') if _learned else '')), 'ok')
                    # ★ 输出被 max_tokens 截断：**必须当场说**。
                    #   2026-10-06 的事故里这件事对界面完全不可见 —— 用户只看到
                    #   "提取完成：人物 0 位"，根本不知道是"输出写了一半被砍了"，
                    #   还是"文档里真没有人"。截断的原文就在上面那几行里，
                    #   这里点破一句，人才知道该去看哪里、该不该重试。
                    # [EN] ★ Output was truncated by max_tokens: **you must say it on the spot**.
                    # [EN] In the 2026-10-06 incident this was completely invisible in the UI —— the user only saw
                    # [EN] "Extraction complete: 0 characters", with no idea whether it was "output was half-written and
                    # [EN] cut off",
                    # [EN] or "there really are no people in the document". The truncated original text is right there in
                    # [EN] the lines above,
                    # [EN] calling it out here lets people know where to look and whether to retry.
                    if ev.get('empty_output') and ev.get('truncated'):
                        # 「一个字都没拿到」单独说：这跟"写了一半被砍断"不是一回事。
                        # 屏幕上也别写"内容可能不完整"——根本没有内容，
                        # "可能不完整"会让人以为是写了一半。
                        # ⚠ 这条**会画在日志栏里给用户看**，所以整条走 `t()`
                        #   （上一轮刚补过英文界面，新加的中文别再漏在外面）。
                        # [EN] "Not a single character obtained" should be stated separately: this is not the same thing as
                        # [EN] "half-written and cut off".
                        # [EN] Also do not write "content may be incomplete" on the screen —— there is no content at all,
                        # [EN] "may be incomplete" would make people think it was half-written.
                        # [EN] ⚠ This entry **will be drawn in the log panel for the user to see**, so the whole entry goes
                        # [EN] through `t()`
                        # [EN] (the English UI was just patched last round, do not leave newly added Chinese exposed again).
                        # ★★ 2026-10-07 分岔：**router 会不会自动救**。
                        #   用户原话：「[23:30:00] ⚠ 正文为空（撞到 max_tokens=2400…）
                        #   **这一直在报错** 这个要怎么修复」。
                        #   查真实日志：这个自愈触发 **101 次、失败 0 次** ——
                        #   每一次都救回来了。以前却在**第一发失败时**就报红字，
                        #   而随后"关掉思考重试成功"这件事**一个字都不说**。
                        #   于是作者看了一整屏假警报（还会被镜像进右侧对话栏），
                        #   以为功能坏了。
                        #   现在：注定要被重试的那一发**不是错误**，如实说明；
                        #   只有**真的没救回来**才报错。
                        # [EN] ★★ 2026-10-07 branch: **whether router will automatically rescue**.
                        # [EN] User's exact words: "[23:30:00] ⚠ Body is empty (hit max_tokens=2400…)
                        # [EN] **This keeps reporting errors** how should this be fixed".
                        # [EN] Check the real logs: this self-healing triggered **101 times, failed 0 times** ——
                        # [EN] every time it was rescued. But previously it reported a red line **on the first failure**,
                        # [EN] and then said **not a single word** about "turning off thinking and retrying succeeded".
                        # [EN] So the author saw a whole screen of false alarms (which also got mirrored into the right-side
                        # [EN] chat panel),
                        # [EN] and thought the feature was broken.
                        # [EN] Now: the shot destined to be retried **is not an error**, state it truthfully;
                        # [EN] only **when it is truly not rescued** do you report an error.
                        if ev.get('auto_retry'):
                            _was_no_think_retried['v'] = True
                            _set_llm_status(
                                t('⚠ 首次没拿到正文（额度被思考吃光）—— 正在关掉思考重试…'),
                                C['gold'])
                            _add_log(t(
                                '[{ts}] ⚠ 首次没拿到正文（max_tokens={mt} 被思考吃光）'
                                '—— 正在自动关掉思考重试（不用你管）',
                                ts=_now(), mt=ev.get('max_tokens', '?')), 'stage')
                        else:
                            _set_llm_status(
                                t('⚠ 这次一个字都没拿到（额度被思考过程吃掉了）'),
                                _STATUS_ERR)
                            _add_log(t(
                                '[{ts}] ⚠ 正文为空（撞到 max_tokens={mt}，{tout} token'
                                ' 全用光{rz}）：额度被思考吃光，而且这次**不会**自动重试'
                                '（关思考的开关关着 / 已经关过 / 这个模型不支持关思考）'
                                '—— 请把这个用途的额度调大，或打开「模型与额度」里的'
                                '「空正文自动关思考重试」',
                                ts=_now(), mt=ev.get('max_tokens', '?'),
                                tout=ev.get('tout'),
                                rz=(t('，含思考内容') if ev.get('has_reasoning') else '')),
                                'err')
                    elif ev.get('truncated'):
                        _set_llm_status(t('⚠ 输出被长度上限截断，内容可能不完整'),
                                        _STATUS_ERR)
                        _add_log(t(
                            '[{ts}] ⚠ 输出被截断（撞到 max_tokens={mt}）{rz}：'
                            '长文/JSON 很可能不完整，详见下面那行「提取」提示',
                            ts=_now(), mt=ev.get('max_tokens', '?'),
                            rz=(t('，且本次带思考内容（思考也占这个额度）')
                                if ev.get('has_reasoning') else '')),
                            'err')
                elif kind == 'error':
                    _stop_wait_timer()
                    attempt, retries = ev.get('attempt'), ev.get('retries')
                    more = (isinstance(attempt, int) and isinstance(retries, int)
                            and attempt < retries)
                    _set_llm_status(
                        t('! 调用失败（第 {n}/{m} 次）', n=attempt, m=retries)
                        + (t('，正在重试…') if more else t('，不再重试')),
                        _STATUS_ERR)
                    _add_log(f"[{_now()}] ! LLM 调用失败"
                             f"（{attempt}/{retries}）: {ev.get('error')}",
                             'err')
            except Exception:
                log_exception(t('刷新 LLM 过程失败'), category="ui")

        llm.add_listener(on_llm)

        # ══════════════════════ 后台工作协程 ══════════════════════
        # [EN] ══════════════════════ Background worker coroutine ══════════════════════
        def _finalize() -> Project:
            """创建项目、冻结设定集、建运行文件夹。
                        English:
            Create the project, freeze the settings set, create the run folder.
            """
            result = state['result']
            settings = state['settings'] or result.settings
            did_opt = state['exchange'] > 0
            # 类型：作者在向导里手动指定了就**以他为准**（那是覆盖，
            # 优先级高于 AI 判定）；留「自动判断」才用 AI 读出来的。
            # [EN] Type: if the author manually specified it in the wizard, **his choice prevails** (that is an
            # [EN] override,
            # [EN] with higher priority than the AI judgment); only "auto-detect" uses what the AI read out.
            picked_genre = (self._wizard_genre or '').strip()
            genre_v = picked_genre if picked_genre and picked_genre != 'auto' \
                else str(result.genre.get('主题材', '') or '')
            proj = Project.create_new(
                CFG.projects_dir(), name,
                genre=genre_v,
                style=str(self._wizard_style or ''),
                source_folder=src,
                # 输出语言：向导里选的那个（`auto` = 跟随界面语言）
                # [EN] Output language: the one selected in the wizard (`auto` = follow the UI language)
                output_lang=(self._wizard_outlang or outlang.AUTO))
            freeze_settings(proj.settings_dir, settings, result.genre,
                            result.style, result.nodes, result.alignment)
            if did_opt:
                freeze_settings(proj.optimized_dir, settings, result.genre,
                                result.style, result.nodes, result.alignment)
            # ★ 打磨产物搬进项目（2026-10-07）。引用侧那份是**追加**在作者的素材
            #   文件夹里（看得见、可回滚）；这一份是**项目自己的存档** ——
            #   项目以后可以整个搬走/备份，而它不该依赖素材夹还在原处。
            #   ⚠ 两边写的是**同一份文本**（`state['polish_report']`），
            #     各写各的迟早对不上。
            # [EN] ★ Polished output moved into the project (2026-10-07). The one on the reference side is
            # [EN] **appended** to the author's material
            # [EN] folder (visible, rollback-able); this one is **the project's own archive** ——
            # [EN] the project can later be moved/backed up as a whole, and it should not depend on the material
            # [EN] folder still being in place.
            # [EN] ⚠ Both sides write **the same text** (`state['polish_report']`),
            # [EN] writing separately will eventually fail to match.
            try:
                _report = str(state.get('polish_report') or '')
                if _report.strip():
                    (proj.root / '打磨记录.md').write_bytes(_report.encode('utf-8'))
                _scope = state.get('polish_scope')
                _src_tools = (Path(_scope.out_root) / 'AI工具') if _scope is not None \
                    and _scope.out_root else None
                if _src_tools is not None and _src_tools.is_dir():
                    import shutil as _sh
                    _sh.copytree(_src_tools, proj.root / 'AI工具', dirs_exist_ok=True)
            except Exception:
                log_exception(t('打磨产物搬进项目失败（不影响开卷）'), category="ui")

            rf = RunFolder(proj.root, make_run_name(proj.next_run_index())).create()
            rf.write_task_intro({
                t('项目'): name, t('源文件夹'): src,
                t('类型'): str(result.genre.get('主题材', '') or ''),
                t('评档'): result.tier,
                t('起始节点'): result.start_point,
                t('AI 优化轮次'): state['exchange'],
            })
            proj.run_count = 1
            proj.last_run = now_str('%Y-%m-%d %H:%M')
            proj.write_nwsproj()
            # ★ 熔断合上：项目落到盘上这一刻起，引用文件夹**不再被动**。
            #   对应 `ingest.repair.write_back` 里的 `.nwsproj` 检查 ——
            #   用户原话「后续项目开始了就不要去动引用文件夹了」。
            # [EN] ★ Circuit breaker closed: from the moment the project lands on disk, the referenced folder **is
            # [EN] no longer touched**.
            # [EN] Corresponds to the `.nwsproj` check in `ingest.repair.write_back` ——
            # [EN] User's exact words: "once the follow-up project has started, do not go touching the referenced
            # [EN] folder".
            state['sealed'] = True
            return proj

        async def worker():
            try:
                _add_log(f"[{_now()}] 开始摄取：{src}", 'stage')
                _set_llm_status(t('准备中 —— 先读本地文件'), C['muted'])
                # 向导里手动指定的类型要**真的传下去**：
                # `detect_genre(manual=...)` 只认 `CFG.STORY_GENRE`，
                # 不 set 的话这个下拉框就是个摆设（选了等于没选）。
                # [EN] The type manually specified in the wizard must **really be passed down**:
                # [EN] `detect_genre(manual=...)` only recognizes `CFG.STORY_GENRE`,
                # [EN] if not set, this dropdown is just decoration (selecting it is the same as not selecting).
                picked = (self._wizard_genre or 'auto').strip() or 'auto'
                CFG.set('STORY_GENRE', picked)
                if picked != 'auto':
                    _add_log(f"[{_now()}] 故事类型按你的指定：{genre_label(picked)}"
                             f"（跳过 AI 类型判定）", 'stage')
                else:
                    _add_log(f"[{_now()}] 故事类型：{genre_label('auto')}", 'info')
                # 确保 LLM 客户端/信号量已就绪（GUI 里懒启动）
                # [EN] Ensure the LLM client/semaphore is ready (lazy start in the GUI)
                try:
                    await llm.ensure_started(log_dir())
                except Exception:
                    log_exception(t('初始化 LLM 客户端失败'), category="ui")
                result = await run_ingest(Path(src), settings_dir=None,
                                          on_stage=on_stage,
                                          gate=_consent_gate)
                if state['cancel']:
                    raise asyncio.CancelledError()
                state['result'] = result
                state['settings'] = result.settings
                _add_log(f"[{_now()}] 自动摄取完成 · 评档 {result.tier} · "
                         f"人物 {len(result.settings.get('人物', []))} 位", 'ok')
                # ★ 这是**结论**（"这本书提炼成什么样了"）—— 右侧也放一条，
                #   别让作者为了看它去左侧翻几百行日志。
                # [EN] ★ This is the **conclusion** ("what has this book been distilled into") —— put one on the right
                # [EN] side too,
                # [EN] do not make the author flip through hundreds of lines of logs on the left just to see it.
                _mirror_chat(t(
                    '✓ 设定提取完成 · 评档 {tier} · 人物 {n} 位 · '
                    '接下来可以在这里让我改设定',
                    tier=result.tier or t('未评'),
                    n=len(result.settings.get('人物', []))), 'ok')

                if ai_optimize:
                    state['phase'] = 'chat'
                    _set_progress(0.90, t('AI 优化中 —— 可对话打磨设定'))
                    _set_chat_enabled(True)
                    try:   # Flet 1.0：focus() 是协程，要走任务调度
                    # [EN] Flet 1.0: focus() is a coroutine, must go through task scheduling
                        page.run_task(chat_input.focus)
                    except Exception:
                        pass
                    _flush()
                    # ★★ 打磨 Agent（2026-10-07）。用户的报修是「你没有生成一个
                    #   Agent，而且每次我输入新对话，你发给 LLM 的内容不包含之前的
                    #   历史信息」—— 下面这一段就是回答：
                    #   · `PolishAgent` 记住**整条事件流**（作者原话 / 工具调用 /
                    #     工具真实返回 / 我的结论 / 体检），每次调用都整条编进 messages；
                    #   · 它会**真的动手**（改设定 / 读素材 / 写记录 / 回写 / 现场造工具）；
                    #   · 收尾后 `_reflect()` 换一双眼睛自查，有问题就再走一轮。
                    # [EN] ★★ Polish Agent (2026-10-07). The user's bug report is "you did not generate an
                    # [EN] Agent, and every time I enter a new conversation, what you send to the LLM does not include the
                    # [EN] previous
                    # [EN] history information" —— the section below is the answer:
                    # [EN] · `PolishAgent` remembers **the entire event stream** (author's exact words / tool calls /
                    # [EN] actual tool returns / my conclusions / health checks), and every call compiles the whole thing
                    # [EN] into messages;
                    # [EN] · It will **really take action** (modify settings / read materials / write records / write back
                    # [EN] / build tools on the spot);
                    # [EN] · After wrapping up, `_reflect()` swaps in a fresh pair of eyes for self-check, and if there is
                    # [EN] a problem it goes another round.
                    agent = None

                    async def _intro_round() -> str:
                        """建 Agent + 开场体检，返回要贴进对话栏的那份体检报告。

                        ★ 也做成可取消的任务（2026-10-08）：`agent.intro()` 本身就是
                          一次完整的 AI 调用（真模型下十几秒到一分钟），作者在这段
                          时间里最容易想叫停 —— 不把它挂上 `round_task`，
                          「⏹ 强制停止」在那几十秒里就只是装饰。
                        
                                                English:
                        Create Agent + opening health check, returning the health check report to be pasted into the
                        conversation pane.
                                                ★ Also make it a cancellable task (2026-10-08): `agent.intro()` itself is
                                                  a complete AI call (tens of seconds to a minute with a real model), and this is when the author
                                                  is most likely to want to stop -- if it is not attached to `round_task`,
                                                  "⏹ Force stop" during those tens of seconds is just decoration.
                        """
                        nonlocal agent
                        if CFG.b('POLISH_AGENT'):
                            try:
                                agent = self._make_polish_agent(
                                    state, result, src=src, name=name,
                                    add_log=_add_log, write_src=polish_back)
                                state['agent'] = agent
                                for _t in agent.load_tools():
                                    _add_log(f"[{_now()}] 装回了上次生成的工具：{_t}", 'ok')
                                return await agent.intro()
                            except Exception as ex:
                                # ⚠ **降级必须吭声**（本项目最忌"静默降级"）。
                                #   第一次是这么踩的：`_make_polish_agent` 里误用了
                                #   `_now()`（那是个局部闭包）→ NameError 被这里吞掉 →
                                #   界面照旧跑得好好的，只是**悄悄退回了老的一问一答**，
                                #   而"用户以为在用 Agent"这件事完全看不出来。
                                #   所以：主日志 + 界面日志**两处都写**。
                                # [EN] ⚠ **Degradation must speak up** (this project most abhors "silent degradation").
                                # [EN] The first time it was stepped on like this: in `_make_polish_agent` it mistakenly used
                                # [EN] `_now()` (that is a local closure) → NameError was swallowed here →
                                # [EN] the UI kept running just fine, except it **quietly fell back to the old
                                # [EN] one-question-one-answer**,
                                # [EN] and "the user thought they were using the Agent" was completely undetectable.
                                # [EN] So: write to **both** the main log + the UI log.
                                log_exception(t('打磨 Agent 起不来（退回一问一答）'),
                                              category="ui")
                                add_log(f"[{now_str('%H:%M:%S')}] ! 打磨 Agent 没能起来"
                                        f"（这次退回一问一答）：{ex!r}", 'err')
                                agent = None
                        try:
                            return await opt.review_settings(
                                result.settings, name=name, tier=result.tier,
                                missing=result.missing_for_gold)
                        except Exception:
                            log_exception(t('AI 体检失败'), category="ui")
                            return t('（AI 体检未完成，你可以直接输入修改意见。）')

                    # 阶段一开始就让「⏹ 强制停止」可点 —— 起步体检也是 AI 在跑。
                    # [EN] Make "⏹ Force stop" clickable as soon as the stage begins —— the startup health check is also
                    # [EN] the AI running.
                    stop_btn.disabled = False
                    _set_ai_busy(True, t('开场体检'))
                    intro_task = asyncio.ensure_future(_intro_round())
                    state['round_task'] = intro_task
                    try:
                        review = await intro_task
                    except asyncio.CancelledError:
                        if state['cancel']:
                            raise                # 整趟摄取被取消 —— 继续往上抛
                            # [EN] The entire ingest was cancelled -- keep re-raising
                        review = t('（开场体检被你停掉了 —— 你可以直接告诉我'
                                   '你要改什么，不用等它。）')
                        _add_log(t('[{ts}] ⏹ 开场体检已强制停止', ts=_now()), 'err')
                    finally:
                        state['round_task'] = None
                        _set_ai_busy(False)

                    # 这次体检如果重试过／是抢救回来的，得让作者知道 ——
                    # 否则他看到一个"答得有点短"的体检，不会想到背后重试过一次。
                    # [EN] If this checkup was retried / rescued, the author needs to know --
                    # [EN] otherwise he sees a "somewhat short answer" checkup and won't think a retry happened behind the
                    # [EN] scenes.
                    for _n in opt.take_review_notes():
                        _add_log(f"[{_now()}] ! AI 体检：{_n}", 'err')
                    _add_chat('ai', review)
                    # ★★ 体检结论要**带上**（2026-10-11 用户报的"记不住之前说的话"）。
                    # [EN] ★★ The checkup conclusion must be **included** (user report on 2026-10-11 about "can't remember
                    # [EN] what was said before").
                    #   用户原话：「类似系统给我选项 1 2 3，我说处理1 2或者说处理前
                    #   两个，软件就听不懂我说的什么意思」。
                    # [EN] User's exact words: "Similar to the system giving me options 1 2 3, I say process 1 2 or say
                    # [EN] process the first
                    # [EN] two, and the software just can't understand what I mean."
                    #   根因：体检那条只 `_add_chat`（画到气泡里），而
                    #   `state['history']` 到这一步还是**空的** —— 下一轮
                    #   `apply_instruction` 拿到的只有"作者刚说的那一句"，
                    #   **没有它自己刚说过的那几条**，「处理 1 2」里的 1、2
                    #   就没有任何所指。
                    # [EN] Root cause: the checkup entry only does `_add_chat` (draws into the bubble), while
                    # [EN] `state['history']` is still **empty** at this step -- the next round
                    # [EN] `apply_instruction` only gets "the one sentence the author just said",
                    # [EN] **without the few it just said itself**, so the 1, 2 in "process 1 2"
                    # [EN] have no referent at all.
                    #   ⚠ 走 Agent 那条路时**不要**再塞一遍：`PolishAgent.intro()`
                    #   已经把体检推进它自己的事件流了（`_compose` 整条编进 messages），
                    #   再塞一次是同一段话说两遍。
                    # [EN] ⚠ When going the Agent route, **do not** stuff it again: `PolishAgent.intro()`
                    # [EN] already pushed the checkup into its own event stream (`_compose` compiles the whole thing into
                    # [EN] messages),
                    # [EN] stuffing it again means saying the same thing twice.
                    _review_ctx = (str(review or '').strip()
                                   if agent is None else '')
                    _set_llm_status(t('轮到你 —— 打字下指令，AI 在等你'), C['gold'])
                    _flush()

                    async def _one_round(text: str) -> str:
                        """跑**一轮**（Agent 或老的一问一答），返回要给作者看的回话。

                        抽成单独的协程只为一件事：**能在外面把它取消**
                        （见 `_stop_ai` 与主循环里那句 `asyncio.ensure_future`）。
                        ⚠ 这里**不碰** `state['exchange']`、也不写对话栏 ——
                          那是调用方的事：一轮被强制停止时"轮次怎么算、说什么"
                          必须由它统一决定，两处各写一遍迟早对不上。
                        
                                                English:
                        Run **one round** (Agent or the old question-answer), returning the reply to show the author.
                                                Extracted into a separate coroutine for one reason only: **to be able to cancel it from outside**
                                                (see `_stop_ai` and the `asyncio.ensure_future` line in the main loop).
                                                ⚠ This does **not touch** `state['exchange']`, nor write to the conversation pane --
                                                  that is the caller's job: when a round is force-stopped, "how the round is counted and what is said"
                                                  must be decided uniformly by it; writing it in two places will eventually diverge.
                        """
                        try:
                            if agent is not None:
                                turn = await agent.ask(text)
                                note = turn.question or turn.reply
                                # ★★ 先把「我懂你这句的意思了」打出来（2026-10-11 用户报的
                                #   「我说修复4个问题 但是它不知道我什么意思」）——
                                #   作者必须**看见**它理解对了，否则只会以为又没听懂。
                                #   走 `_add_chat`（右侧对话栏），那是作者看的地方；
                                #   左侧日志同步一条，便于复盘。
                                # [EN] ★★ Print "I understood that" first (user report 2026-10-11:
                                # [EN] "I said fix the 4 problems but it doesn't understand what I
                                # [EN] mean") -- the author must **see** that it understood, otherwise
                                # [EN] he will just think it failed again.
                                # [EN] Goes through `_add_chat` (the right-hand chat pane), which is
                                # [EN] where the author looks; the left log gets a copy for review.
                                for _nt in (turn.notes or []):
                                    _add_chat('ai', _nt)
                                    _add_log(f"[{_now()}] {_nt}", 'ok')
                                for _c in turn.changes:
                                    _add_log(f"[{_now()}] 改动：{_c}", 'ok')
                                for _r in turn.reflections:
                                    _add_log(f"[{_now()}] ! 自查：{_r}", 'err')
                                return note
                            new_settings, note = await opt.apply_instruction(
                                state['settings'], text, history=state['history'],
                                context=_review_ctx)
                            state['settings'] = new_settings
                            return note
                        except asyncio.CancelledError:
                            raise                    # 强制停止：交给调用方处理
                            # [EN] Force stop: hand it to the caller
                        except Exception as ex:
                            log_exception(t('打磨这一轮失败'), category="ui")
                            return t('（这一轮没走完：{ex}）').format(ex=ex)
                        finally:
                            # 中途被打断时，Agent 其实**已经改了一部分**（改设定是
                            # 同步的，取消拦不住它）—— 把手上这份收回来，
                            # 才对得起「强制停止」那句"已改的设定保留"。
                            # [EN] When interrupted mid-way, the Agent has actually **already changed part of it** (changing
                            # [EN] settings is
                            # [EN] synchronous, cancellation can't stop it) -- take back the copy in hand,
                            # [EN] only then does it live up to "force stop"'s "keep already-changed settings".
                            if agent is not None:
                                try:
                                    state['settings'] = agent.settings
                                except Exception:            # noqa: BLE001
                                    pass

                    while True:
                        msg = await user_q.get()
                        if msg is FINISH or state['cancel']:
                            break
                        if state['rounds_full']:
                            # 到上限之后还塞进来的（用户手快 / 脚本驱动）——
                            # **不跑**，只说明；否则"上限"就是个摆设。
                            # [EN] Anything squeezed in after the limit (user is fast / script-driven) --
                            # [EN] **do not run**, just explain; otherwise the "limit" is just for show.
                            _add_log(t('[{ts}] 已到轮数上限（{n} 轮）—— 这条指令没有执行',
                                       ts=_now(), n=state['max_rounds']), 'err')
                            continue

                        # ★★ 这一轮跑在自己的任务里（2026-10-08）。为什么不直接 await：
                        #   直接 await 就只有一个取消口 —— 那个口是外层 `task`，
                        #   也就是「取消摄取」（按下去连项目都不建）。用户要的是
                        #   "**中途停一下**"，那必须能只取消这一轮。
                        # [EN] ★★ This round runs in its own task (2026-10-08). Why not just await:
                        # [EN] just awaiting gives only one cancellation point -- that point is the outer `task`,
                        # [EN] i.e. "cancel ingest" (pressing it does not even create the project). What the user wants is
                        # [EN] "**pause midway**", which must be able to cancel only this one round.
                        state['round_stopped'] = False
                        _set_ai_busy(True, t('第 {n} 轮', n=state['exchange'] + 1))
                        round_task = asyncio.ensure_future(_one_round(str(msg)))
                        state['round_task'] = round_task
                        note, stopped = '', False
                        try:
                            note = await round_task
                        except asyncio.CancelledError:
                            # ⚠ 这里有两个来源，**必须分开**：
                            #   · 外层（整趟摄取）被取消 → 继续往上抛，别吞了；
                            #   · 只有这一轮被「强制停止」→ 就地消化，接着跑。
                            #   判据是 `state['cancel']`（`_cancel` 第一件事就是置它）。
                            # [EN] ⚠ There are two sources here, **must be kept separate**:
                            # [EN] · Outer (the whole ingest) cancelled -> keep re-raising, don't swallow it;
                            # [EN] · Only this round hit "force stop" -> absorb it in place, keep going.
                            # [EN] The criterion is `state['cancel']` (`_cancel` sets it as the very first thing).
                            if state['cancel']:
                                raise
                            stopped = True
                        finally:
                            state['round_task'] = None
                            _set_ai_busy(False)
                        if state['cancel']:
                            raise asyncio.CancelledError()

                        state['exchange'] += 1
                        state['history'].append({'role': 'user', 'content': str(msg)})
                        if stopped:
                            note = t('⏹ 这一轮被你停掉了（已经改好的设定保留，'
                                     '可以继续说下一句）。')
                            _add_log(t('[{ts}] ⏹ 第 {n} 轮已强制停止（改动的部分保留）',
                                       ts=_now(), n=state['exchange']), 'err')
                        else:
                            state['history'].append({'role': 'assistant', 'content': note})
                            _add_log(t("[{ts}] 设定已更新（第 {n} 轮）",
                                       ts=_now(), n=state['exchange']), 'ok')
                        _add_chat('ai', note)

                        # ── 轮数上限（2026-10-08）──
                        # 到上限就**锁输入、留出口**：不再收新指令，但「完成优化并进入」
                        # 必须是活的（那才是他要做的事）。两边都说清"下一步干什么"。
                        # [EN] -- Round limit (2026-10-08) --
                        # [EN] On hitting the limit, **lock input, leave an exit**: no longer accept new instructions, but
                        # [EN] "finish optimization and enter"
                        # [EN] must be alive (that is what he wants to do). Both sides make clear "what to do next".
                        if state['exchange'] >= state['max_rounds']:
                            state['rounds_full'] = True
                            _lock_input()
                            _add_log(t('[{ts}] ⏹ 已到 AI 优化轮数上限（{n} 轮）—— '
                                       '不再收新指令，请点「完成优化并进入」',
                                       ts=_now(), n=state['max_rounds']), 'stage')
                            _mirror_chat(t('⏹ AI 优化已到轮数上限（{n} 轮）—— 想接着聊就把'
                                           '「天机 · 运行 · 开卷打磨」里的「优化轮数」调大，'
                                           '或直接点「完成优化并进入」',
                                           n=state['max_rounds']), 'ok')
                            _set_llm_status(
                                t('⏹ 已达轮数上限（{n} 轮）—— 等你收工',
                                  n=state['max_rounds']), C['gold'])

                    # ── 打磨收工：把结论摊成一份记录（**项目侧与引用侧写同一份**）──
                    # [EN] -- Polish wrap-up: spread the conclusion into a record (**write the same copy on both project
                    # [EN] side and reference side**) --
                    if agent is not None:
                        try:
                            from polish.agent import render_report
                            report = render_report(agent)
                            state['polish_report'] = report
                            state['polish_out'] = agent.outcome()
                            # ⚠ **真正写回引用文件夹那一步不在这里** ——
                            #   它在补全清单那道门**之后**（见下面的「打磨记录写回」）。
                            #   原因是顺序：作者可能在那份清单上点「跳过，不改引用文件夹」，
                            #   那是**对整个引用文件夹**的表态；如果这里就先写了，
                            #   他明明说了"别动我的素材"，程序转头又往里塞了一个文件。
                            #   （`verify_repair_writeback` 的 B2e 当场抓到这个顺序错。）
                            # [EN] ⚠ **The actual step of writing back to the reference folder is not here** --
                            # [EN] it is **after** the completion-list gate (see "polish record write-back" below).
                            # [EN] The reason is order: the author may click "skip, don't change reference folder" on that list,
                            # [EN] which is a statement **about the entire reference folder**; if it were written here first,
                            # [EN] he clearly said "don't touch my material", yet the program turns around and stuffs another file
                            # [EN] into it.
                            # [EN] (B2e of `verify_repair_writeback` caught this order error on the spot.)
                            state['polish_report'] = report
                        except Exception:
                            log_exception(t('整理打磨记录失败（不影响开卷）'),
                                          category="ui")
                else:
                    _set_progress(0.90, t('自动摄取完成'))

                if state['cancel']:
                    raise asyncio.CancelledError()

                # ══════ AI 补全 + 回写**引用文件夹**（2026-10-06 用户要求）══════
                # [EN] ══════ AI completion + write back to **reference folder** (user request on 2026-10-06) ══════
                # 用户原话：「开卷的时候，AI 找出来的问题如果可以自己修复的，需要
                # AI 主动修复并回写引用文件夹里的文档，但是**后续项目开始了就不要去
                # 动引用文件夹了**。」
                # [EN] User's exact words: "When opening the book, if the problems the AI finds can be self-fixed, they
                # [EN] need
                # [EN] to be actively fixed by the AI and written back to the documents in the reference folder, but
                # [EN] **once a follow-up project has started, do not
                # [EN] touch the reference folder anymore**."
                # ⚠ 位置是**刻意**的：必须在 `_finalize()` 建项目**之前** —— 项目一落地
                #   （`<项目>/*.nwsproj`），`ingest/repair.write_back` 就会拒绝再动引用
                #   文件夹。这里传 `project_root=` 是为了顺带挡住"同名项目已存在"那种
                #   误覆盖。
                # ⚠ 顺序是「先本地列清单（零成本）→ 作者点头 → 才调模型生成补全」
                #   —— 反过来先花钱生成、再问要不要写，会白烧 token。
                # [EN] ⚠ The position is **deliberate**: it must be **before** `_finalize()` creates the project --
                # [EN] once the project lands
                # [EN] (`<project>/*.nwsproj`), `ingest/repair.write_back` will refuse to touch the reference
                # [EN] folder again. Passing `project_root=` here is to incidentally block the mis-overwrite
                # [EN] of "a project with the same name already exists".
                # [EN] ⚠ The order is "first list locally (zero cost) -> author nods -> only then call the model to
                # [EN] generate completions"
                # [EN] -- the reverse, spending money to generate first then asking whether to write, would burn tokens
                # [EN] for nothing.
                if repair_source:
                    await self._repair_sources(
                        state, result, src=src, name=name,
                        gate=_repair_gate, add_log=_add_log,
                        set_progress=_set_progress, set_status=_set_llm_status)

                if state['cancel']:
                    raise asyncio.CancelledError()

                # ── 打磨记录写回引用文件夹（**排在补全门之后**）──────────────
                # [EN] -- Polish record write-back to reference folder (**placed after the completion gate**)
                # [EN] --------------
                # 位置是刻意的：作者在那份补全清单上可能点了「跳过，不改引用文件夹」
                # —— 那是对**整个引用文件夹**的表态，`_repair_gate` 会把它记进
                # `state['src_touch_denied']`。排在这之后，那一票才管得住这里。
                # 同时它仍然在 `_finalize()` **之前** —— 项目一落地就封口。
                # [EN] The position is deliberate: the author may have clicked "skip, don't change reference folder" on
                # [EN] that completion list
                # [EN] -- that is a statement **about the entire reference folder**, and `_repair_gate` will record it
                # [EN] into
                # [EN] `state['src_touch_denied']`. Placed after this, that one vote can govern here.
                # [EN] At the same time it is still **before** `_finalize()` -- once the project lands, it seals off.
                _report = str(state.get('polish_report') or '')
                if _report.strip():
                    if state.get('src_touch_denied'):
                        _add_log(f"[{_now()}] 你选了不改引用文件夹 —— "
                                 f"打磨记录只进项目，不写回素材", 'stage')
                    elif polish_back:
                        _wrote = self._polish_write_back(_report, src=src,
                                                         add_log=_add_log)
                        if _wrote:
                            state['polish_wrote'] = _wrote

                if state['cancel']:
                    raise asyncio.CancelledError()

                # ── 落盘 ──
                # [EN] -- Writing to disk --
                _set_progress(0.96, t('正在创建项目与运行文件夹…'))
                proj = await asyncio.to_thread(_finalize)
                _add_log(f"[{_now()}] 项目已创建：{proj.root}", 'ok')
                # ★ 「这本书落在你磁盘的哪儿」是**结果**，不是过程噪音 ——
                #   作者常要照这个路径去开文件夹，所以右侧也放一条。
                # [EN] ★ "Where this book lands on your disk" is a **result**, not process noise --
                # [EN] the author often needs to follow this path to open the folder, so put one on the right side too.
                _mirror_chat(t('✓ 项目已创建：{p}', p=proj.root), 'ok')

                # ── 剧组 Agents 的项目级定制（2026-10-11）──────────────
                #  位置刻意排在 **项目已创建之后**：`<项目>/agents/` 要项目目录
                #  先存在；也排在肖像/底图**之前** —— 那些是慢步骤，先把这条
                #  便宜的落定（它失败也只退回软件默认）。
                # [EN] -- Project-level customization of crew Agents (2026-10-11) --------------
                # [EN] The position is deliberately placed **after the project has been created**: `<project>/agents/`
                # [EN] needs the project directory
                # [EN] to exist first; also placed **before** the portrait/background -- those are slow steps, so
                # [EN] settle this
                # [EN] cheap one first (if it fails it just falls back to the software default).
                if self._wizard_agents or self._wizard_agents_ai:
                    _set_progress(0.962, t('正在为各个 Agent 推断本书的定制…'))
                    _add_log(f"[{_now()}] 剧组 Agents：写入这本书的定制", 'stage')
                    try:
                        _n = await self._apply_wizard_agents(
                            proj, state['settings'], result, _add_log)
                    except Exception as e:                       # noqa: BLE001
                        _n = 0
                        log_exception(t('Agent 定制没落盘（不影响开卷）'),
                                      category='ui')
                        _add_log(f"[{_now()}] ! Agent 定制没写进去：{e!r}", 'err')
                    # 一条都不写 = 照软件默认（**说出来**，别让作者以为"写过了"）
                    # [EN] Writing not a single one = follow the software default (**say it out**, don't let the author
                    # [EN] think "it's been written")
                    _add_log(
                        (f"[{_now()}] 剧组 Agents：{_n} 个职位记下了这本书的定制"
                         if _n else
                         f"[{_now()}] 剧组 Agents：没有要写进项目的定制"
                         f"（照软件默认跑）"), 'ok' if _n else 'info')
                    _mirror_chat(
                        t('✓ 剧组 Agents：{n} 个职位记下了这本书的定制'
                          '（可在「书斋 · 剧组 Agents」里接着改）', n=_n)
                        if _n else
                        t('剧组 Agents：没有项目级定制，照软件默认跑'), 'ok')

                # ── 三级底图（`MAP_ATLAS`）：开卷时一次定下"这本书长什么样" ──
                # 用户原话：「在开卷的时候把一些整体地图 局部地图(房屋附近
                # 房屋内部) 提前画好，需要的时候基于这些地图让美术加细节」。
                # [EN] -- Three-level base maps (`MAP_ATLAS`): settle "what this book looks like" once at book opening
                # [EN] --
                # [EN] User's exact words: "At book opening, draw some overall maps, local maps (near the house,
                # [EN] inside the house) in advance, and when needed, have the art add details based on these maps."
                # ⚠ 上面那次 `run_ingest` 传的是 `settings_dir=None`（只提取、不落盘），
                #   落盘在 `_finalize` 里的 `freeze_settings()` —— 那是个**同步**函数，
                #   塞不进 await LLM 这一步。所以这里单独来一次。
                #   **只挂在 `run_ingest` 里的后果是"命令行有底图、界面上没有"**，
                #   而且两边都不报错（最坏的一种）。
                # [EN] ⚠ The `run_ingest` above passed `settings_dir=None` (extract only, don't write to disk),
                # [EN] writing to disk is in `freeze_settings()` inside `_finalize` -- that is a **synchronous**
                # [EN] function,
                # [EN] it can't be crammed into the await LLM step. So here it comes separately.
                # [EN] **The consequence of hooking it only into `run_ingest` is "command line has the base map, UI
                # [EN] doesn't"**,
                # [EN] and neither side reports an error (the worst kind).
                if CFG.b('MAP_ATLAS'):
                    _set_progress(0.965, t('正在生成三级底图（整体 / 局部 / 室内）…'))
                    _add_log(f"[{_now()}] 开始生成三级底图", 'stage')

                    def _atlas_note(m: str) -> None:
                        _add_log(f"[{time.strftime('%H:%M:%S')}] {m}", 'stage')

                    try:
                        await ensure_atlas(proj.settings_dir, state['settings'],
                                           on_note=_atlas_note)
                    except Exception as e:                      # noqa: BLE001
                        # 底图不是生死线 —— 拿不到就退回"每天现画"，照常开演
                        # [EN] The base map is not life-or-death -- if you can't get it, fall back to "draw on demand each
                        # [EN] day", and the show goes on as usual
                        log_exception(t('生成三级底图失败'), category="ui")
                        _add_log(f"[{_now()}] ✗ 三级底图没生成：{e}"
                                 f"（小地图退回每天现画）", 'err')
                if state['cancel']:
                    raise asyncio.CancelledError()

                # ── 肖像：**开卷时一次性生成**（文生图），之后各轮直接复用 ──
                # 用户的三条硬要求：肖像一律走文生图 / 只生成一次 / 模型不支持就
                # 明说并改用文字。所以这里**不是"出错才降级"**，而是把一个
                # 预期内的分支讲清楚。
                # [EN] ── Portrait: **generated once at volume opening** (text-to-image), reused directly in subsequent
                # [EN] rounds ──
                # [EN] The user's three hard requirements: portraits always go through text-to-image / generate only
                # [EN] once / if the model doesn't support it,
                # [EN] state it explicitly and switch to text. So here it is **not "degrade only on error"**, but
                # [EN] rather explaining a branch
                # [EN] that is within expectations.
                portrait_rep = await self._make_portraits(
                    proj, state['settings'], _add_log, _set_progress)
                if state['cancel']:
                    raise asyncio.CancelledError()

                # ── 地图底画（`MAP_ATLAS_BITMAP`）：可选、贵、与肖像同一套模式 ──
                # 三级**矢量**底图已经在 `run_ingest` 里生成好了（那是零成本的结构，
                # 位置稳定的保证）。这里出的是**画面**：整体一张 + 每处局部一张。
                # 默认关（每张一次出图），开了才跑。
                # [EN] ── Map base image (`MAP_ATLAS_BITMAP`): optional, expensive, same pattern as portraits ──
                # [EN] The three-level **vector** basemap is already generated in `run_ingest` (that is a zero-cost
                # [EN] structure,
                # [EN] a guarantee of stable positions). What is produced here is the **imagery**: one overall image +
                # [EN] one local image per location.
                # [EN] Off by default (one image generation each time), only runs when enabled.
                await self._make_map_bitmaps(
                    proj, _add_log, _set_progress)
                if state['cancel']:
                    raise asyncio.CancelledError()

                self._activate_project(proj)
                _set_progress(1.0, t('摄取完成，正在进入运行界面…'))
                _set_llm_status(t('✓ 全部完成'), C['accent_green'])
                await asyncio.sleep(0.7)

                _close()
                self.show_main_screen()
                if portrait_rep is not None and not portrait_rep.available:
                    # 对话框马上就关了，这句话必须在主界面上还能看见
                    # [EN] The dialog is about to close, so this message must still be visible on the main UI
                    self._show_snack(
                        t('肖像：文生图不可用（{why}），正文里不插肖像图',
                          why=portrait_rep.why))
            except asyncio.CancelledError:
                _add_log(f"[{_now()}] 摄取已取消。", 'err')
                _set_llm_status(t('已取消'), _STATUS_ERR)
                _close()
            except IngestDeclined as e:
                # 不是错误：作者在「交给 AI 之前」选了不同意（或确认环节出错）。
                # **一次 LLM 请求都没发**，所以也没有任何花费。
                # [EN] Not an error: the author chose to disagree "before handing off to AI" (or the confirmation step
                # [EN] errored).
                # [EN] **Not a single LLM request was sent**, so there is no cost either.
                _add_log(f"[{_now()}] 已中止，未调用任何 AI：{e}", 'err')
                _set_llm_status(t('已中止（没有发出任何请求）'), C['muted'])
                _close()
            except BaseException as e:
                log_exception(t('摄取过程失败: {e}', e=e), category="ui")
                _add_log(f"[{_now()}] ✗ 摄取失败：{e}", 'err')
                _set_progress(prog.value or 0.0, t('摄取失败（详见日志）'))
                _set_llm_status(t('✗ 失败 —— 详见左侧日志'), _STATUS_ERR)
                _set_chat_enabled(False)
                finish_btn.disabled = True
                stop_btn.disabled = True
                try:
                    page.show_dialog(ft.SnackBar(
                        ft.Text(t('摄取失败：{e}', e=e)), bgcolor='#e74c3c'))
                except Exception:
                    pass
            finally:
                state['running'] = False
                # 这一轮的任务句柄要清掉：留着的话，窗口关了之后「强制停止」
                # 还会对着一个已经结束的任务做取消（无害，但状态是假的）。
                # [EN] This round's task handle must be cleared: if left, after the window closes, "force stop"
                # [EN] would still be cancelling an already-finished task (harmless, but the state would be fake).
                state['round_task'] = None
                # 秒表必须收掉：对话框都要关了，让它继续每秒刷控件是白烧 CPU，
                # 而且会往已经销毁的控件上写值（Flet 会报更新失败）。
                # [EN] The stopwatch must be stopped: the dialog is about to close, letting it keep refreshing widgets
                # [EN] every second wastes CPU,
                # [EN] and it would write values to already-destroyed widgets (Flet would report an update failure).
                _stop_wait_timer()
                llm.remove_listener(on_llm)

        def _close():
            """只关自己的对话框（若已被关掉，别再误 pop 别的）。
                        English:
            Close only its own dialog (if already closed, don't wrongly pop another).
            """
            try:
                if dlg.open:
                    page.pop_dialog()
            except Exception:
                pass

        task = None
        try:
            task = page.run_task(worker)
        except Exception:
            task = asyncio.ensure_future(worker())
        state['task'] = task
        # 暴露内部句柄：供自动化测试驱动（点发送/完成/取消、读取日志与进度）
        # [EN] Expose internal handles: for automated tests to drive (click send/complete/cancel, read logs and
        # [EN] progress)
        state['ui'] = {'send': _send, 'finish': _finish, 'cancel': _cancel,
                       'add_chat': _add_chat,
                       # ★ 「⏹ 强制停止」（2026-10-08）：按钮本体 + 它的处理函数。
                       #   判据靠这两个句柄走**真实点击路径**（`btn.on_click(None)`），
                       #   并且直接读 `app._ingest_state['round_task']` 看它有没有被取消。
                       # [EN] ★ "⏹ Force stop" (2026-10-08): the button itself + its handler.
                       # [EN] The criterion uses these two handles to go through the **real click path**
                       # [EN] (`btn.on_click(None)`),
                       # [EN] and directly reads `app._ingest_state['round_task']` to see whether it has been cancelled.
                       'stop': _stop_ai, 'stop_btn': stop_btn,
                       # ★ 系统消息通道（报错 / 关键信息进右侧对话）。
                       #   判据 `verify_ingest_chat_mirror` 直接调它来验"同一句话
                       #   只进一次"与"前缀对不对"，不必真造一个 LLM 故障。
                       # [EN] ★ System message channel (errors / key info go to the right-side conversation).
                       # [EN] The criterion `verify_ingest_chat_mirror` calls it directly to verify "the same sentence
                       # [EN] only enters once" and "whether the prefix is correct", without having to actually fabricate an
                       # [EN] LLM failure.
                       'mirror_chat': _mirror_chat, 'mirrored': _MIRRORED,
                       'chat_input': chat_input, 'log_list': log_list,
                       'chat_list': chat_list, 'prog': prog, 'pct_text': pct_text,
                       # 底部那一排的三个按钮（2026-10-08）：判据要能验
                       # 「到上限时输入锁了、但出口还亮着」——这需要直接读它们的
                       # `disabled`，光看屏幕分不出"灰"是禁用还是配色就那样。
                       # [EN] The three buttons in the bottom row (2026-10-08): the criterion must be able to verify
                       # [EN] "when the limit is reached the input is locked, but the exit is still lit" — this requires
                       # [EN] directly reading their
                       # [EN] `disabled`, since from the screen alone you can't tell whether "grey" means disabled or just
                       # [EN] that colour scheme.
                       'send_btn': send_btn, 'finish_btn': finish_btn,
                       # 两栏的自绘滚动条（`_scroll_bar` 的产物）—— 验证脚本从这里
                       # 量"条到底画出来没有"（把 thumb 染成品红再数像素）。
                       # [EN] The two-column custom scrollbar (the product of `_scroll_bar`) — the verification script
                       # [EN] measures from here
                       # [EN] "whether the bar is actually drawn" (dye the thumb magenta and count pixels).
                       'log_bar': log_bar, 'chat_bar': chat_bar,
                       'stage_text': stage_text, 'dlg': dlg,
                       # 「跟大模型沟通」那行小字 + 它的历史（自动化断言"出现过哪些状态"）。
                       # ⚠ 别在这里塞 `state` 本身 —— `state['ui']` 装着 state 就成了自引用环。
                       # [EN] The small text line "communicate with the large model" + its history (automated assertion of
                       # [EN] "which states have appeared").
                       # [EN] ⚠ Don't stuff `state` itself in here — `state['ui']` containing state would create a
                       # [EN] self-reference cycle.
                       'llm_status': llm_status, 'status_hist': status_hist,
                       'set_llm_status': _set_llm_status,
                       'add_stage_sep': _add_stage_sep,
                       # 同意门：自动化测试靠这几个句柄驱动与断言
                       # [EN] Consent gate: automated tests rely on these handles to drive and assert
                       'consent_panel': consent_panel, 'consent_title': consent_title,
                       'consent_facts': consent_facts, 'warn_box': warn_box,
                       'consent_agree': agree_btn, 'consent_boxes': required,
                       'consent_answer': consent_answer, 'panes': panes,
                       'consent': _consent,
                       # 「AI 补全并回写引用文件夹」那块（验证脚本从这里驱动）
                       # [EN] the "AI completes and writes back to the reference folder" block (the verification script drives
                       # [EN] from here)
                       'repair_panel': repair_panel, 'repair_title': repair_title,
                       'repair_list': repair_list, 'repair_cb': repair_cb,
                       'repair_btn': repair_btn,
                       'repair_answer': repair_answer, 'repair': _repair}
        return dlg

    # ══════════════════════════════════════════════════════════════
    #  开卷打磨 Agent（2026-10-07）
    # [EN] Volume-opening polishing Agent (2026-10-07)
    # ══════════════════════════════════════════════════════════════
    def _make_polish_agent(self, state: dict, result, *, src: str, name: str,
                           add_log, write_src: bool):
        """建一个打磨 Agent：两个根（引用文件夹 + 打磨暂存区）+ 事件回调。

        ## 作用域是**这次打磨能碰的全部地方**（`polish.Scope`）

        ```
        引用文件夹  src:  读 + **只追加**（自动 .bak）
        打磨暂存区  out:  可新建可覆盖（一场结束随项目一起搬走）
        ```

        连 `POLISH_WRITE_BACK` 都参与进来：**关掉它，Agent 连"追加"这只手都没有**
        （只有"写暂存区"），而不是"照写然后再拦一道" —— 能写就写不出来，
        这比事后拒绝干净。

        ## 暂存区为什么在系统临时目录

        项目这一刻**还没建**（`_finalize` 在后面），所以没有一个"项目的目录"可写。
        而且把临时区放系统临时目录还有个好处：**这一场跑崩了不会在用户的 Projects
        里留一个半成品项目**（本项目为这件事踩过坑，见 `verify_ui_common.safe_rmtree`）。
        产物在 `_finalize` 里被搬进项目（`打磨记录.md` + `AI工具/`）。

        ## 上一场生成的工具会装回来

        同名项目已经存在的话，把它 `<项目>/AI工具/` 先拷进这次暂存区，
        `load_tools()` 才找得到 —— 否则"动态生成工具"就成了一次性的玩具。
        
                English:
        Create a polishing Agent: two roots (reference folder + polishing staging area) + event
        callback.
                ## The scope is **everything this polish pass can touch** (`polish.Scope`)
                ```
                Reference folder  src:  read + **append-only** (automatic .bak)
                Polish staging area  out:  can create new and overwrite (moved out with the project when a session ends)
                ```
                Even `POLISH_WRITE_BACK` is involved: **turn it off, and the Agent doesn't even have the "append" hand**
                (only "write to staging area"), rather than "write it anyway and then block it" -- if it can't write, it can't produce it,
                which is cleaner than rejecting after the fact.
                ## Why the staging area is in the system temp directory
                At this moment the project **doesn't exist yet** (`_finalize` comes later), so there is no "project directory" to write to.
                And putting the temp area in the system temp directory has another benefit: **if this session crashes it won't leave a half-finished project
                in the user's Projects** (this project has been burned by this before, see `verify_ui_common.safe_rmtree`).
                ## Tools generated in the previous session get reinstalled
                If a project with the same name already exists, first copy its `<项目>/AI工具/` into this session's staging area,
                only then can `load_tools()` find it -- otherwise "dynamically generated tools" become a one-off toy.
        """
        import tempfile as _tempfile

        from polish import PolishAgent, Scope

        out_root = Path(_tempfile.mkdtemp(prefix='nws_polish_out_'))
        try:
            proj_dir = CFG.projects_dir() / name
            old_tools = proj_dir / 'AI工具'
            if old_tools.is_dir():
                import shutil as _sh
                _sh.copytree(old_tools, out_root / 'AI工具', dirs_exist_ok=True)
        except Exception:                                        # noqa: BLE001
            pass                    # 搬不动就算了 —— 只是这一场没有旧工具可用
            # [EN] If it can't be moved, then forget it — it's just that this session has no old tools available

        scope = Scope(
            src_root=Path(src),
            out_root=out_root,
            allow_write_src=bool(write_src),
            timeout=float(CFG.i('POLISH_SANDBOX_TIMEOUT')),
            # 程序自己生成的资料**永远不在打磨范围内**（AI 补全那份附录也不该
            # 被当成"作者的原始素材"再回写一遍，见 `scanner.GENERATED_NAMES`）
            # [EN] Material generated by the program itself is **never within polishing scope** (the AI-completed
            # [EN] appendix should not
            # [EN] be treated as "the author's original material" and written back again, see
            # [EN] `scanner.GENERATED_NAMES`)
            never_touch=('AI补全设定.md', 'AI打磨记录.md'),
        )
        state['polish_scope'] = scope

        agent = PolishAgent(
            settings=state['settings'] or result.settings, scope=scope,
            name=name, tier=result.tier,
            missing=tuple(result.missing_for_gold or ()),
            allow_codegen=CFG.b('POLISH_TOOLS'),
            max_steps=CFG.i('POLISH_MAX_STEPS'),
            reflect=CFG.b('POLISH_REFLECT'),
            max_reflect=CFG.i('POLISH_REFLECT_ROUNDS'),
            on_event=lambda kind, text: add_log(f"[{_now()}] · {text}", 'info'))
        agent.box.max_calls = CFG.i('POLISH_MAX_TOOL_CALLS')
        # ⚠ `_now()` 是 `_do_import` 里的**局部闭包**，类方法里用不到它
        #   （本项目为这件事踩过坑：`_make_portraits` 那次 NameError
        #    之后窗口挂着不报错，看着像"脚本在慢慢跑"）。
        # [EN] ⚠ `_now()` is a **local closure** inside `_do_import`, unusable in class methods
        # [EN] (this project has been burned by this: the `_make_portraits` NameError
        # [EN] afterwards the window hung without reporting an error, looking like "the script is slowly
        # [EN] running").
        add_log(f"[{now_str('%H:%M:%S')}] 打磨 Agent 就位：{scope.describe()}",
                'stage')
        return agent

    def _polish_write_back(self, report: str, *, src: str, add_log) -> str:
        """把打磨记录**追加**到引用文件夹（只追加、自动 `.bak`）。

        走 `polish.sandbox.append_text` 而不是自己 `open(...,'a')`：
        **一份实现**（本项目的老规矩）。而且那个函数是按**字节**追加的 ——
        Windows 上 `write_text` 会把 `\\n` 翻成 `\\r\\n`，作者原文的行尾会被整篇改掉
        （`ingest/repair.py` 为这件事写过一段长注释）。
        
                English:
        **Append** the polish record to the reference folder (append-only, automatic `.bak`).
                Go through `polish.sandbox.append_text` instead of opening `open(...,'a')` yourself:
                **one implementation** (an old rule of this project). And that function appends by **bytes** --
                on Windows `write_text` turns `\\n` into `\\r\\n`, and the author's original line endings get changed throughout
                (`ingest/repair.py` has a long comment written about this).
        """
        try:
            from polish import Scope
            from polish import sandbox as SB
            scope = Scope(src_root=Path(src), out_root=None)
            p, fresh = SB.append_text(scope, SB.PREFIX_SRC + 'AI打磨记录.md', report)
            add_log(f"[{now_str('%H:%M:%S')}] 打磨记录已{'新建' if fresh else '追加'}"
                    f"到引用文件夹：{p}", 'ok')
            return str(p)
        except Exception as ex:                                  # noqa: BLE001
            log_exception(t('打磨记录写回引用文件夹失败'), category="ui")
            add_log(f"[{now_str('%H:%M:%S')}] ! 打磨记录没能写回引用文件夹：{ex}", 'err')
            return ''

    async def _repair_sources(self, state: dict, result, *, src: str, name: str,
                              gate, add_log, set_progress, set_status) -> None:
        """AI 补全缺口并**回写引用文件夹**（只在开卷阶段、项目创建之前调）。

        用户 2026-10-06：「开卷的时候，AI 找出来的问题如果可以自己修复的，需要 AI
        主动修复并回写引用文件夹里的文档，但是后续项目开始了就不要去动引用文件夹了。」

        三条边界写死在这里（也是唯一的三条）：
          ① 只走 `ingest.repair` 的写入口 —— 它自带 `phase='ingest'` 与
             `.nwsproj` 熔断，别在这个方法里另开一条 `open(..., 'w')`；
          ② 清单里没有"AI 能自己修"的问题时**什么都不做**（连模型都不调）；
          ③ 作者不同意就一条都不写（只记一行日志）。
        
                English:
        AI fills the gaps and **writes back to the reference folder** (only called during the ingest
        phase, before the project is created).
                User 2026-10-06: "During ingest, if the problems AI finds can be fixed by itself, AI needs to
                proactively fix them and write back to the documents in the reference folder, but once the subsequent project has started, don't touch the reference folder."
                Three boundaries are hard-coded here (and these are the only three):
                  ① Only go through `ingest.repair`'s write entry point -- it carries `phase='ingest'` and
                     the `.nwsproj` circuit breaker, don't open another `open(..., 'w')` in this method;
                  ② When there are no "AI can fix by itself" problems in the manifest, **do nothing** (don't even call the model);
                  ③ If the author disagrees, don't write a single line (just log one line).
        """
        def _stamp() -> str:
            return time.strftime('%H:%M:%S')     # `_now()` 是摄取对话框里的局部闭包，够不着
            # [EN] `_now()` is a local closure in the ingest dialog, out of reach

        root = Path(src)
        try:
            issues = src_repair.scan_issues(
                result.items, state['settings'],
                missing_for_gold=getattr(result, 'missing_for_gold', []),
                tier=getattr(result, 'tier', ''), src_root=root)
        except Exception as e:                              # noqa: BLE001
            log_exception(t('检查可修复问题时出错'), category="ui")
            add_log(f'[{_stamp()}] ! 检查可修复问题失败：{e}', 'err')
            return
        if not issues:
            add_log(f'[{_stamp()}] 没有发现 AI 能自己修好的问题（引用文件夹保持原样）',
                    'stage')
            return

        if not await gate(issues):          # 列清单 → 等作者点头
        # [EN] List inventory → wait for author's nod
            return

        add_log(f'[{_stamp()}] ▶ AI 补全（读正文补缺口）', 'stage')
        set_progress(0.93, t('AI 正在读正文补全缺口…'))
        set_status(t('正在补全 —— 稍后写回引用文件夹'), C['seal'])

        # ⚠ 项目根的**预判**：`Project.create_new` 会建在 `projects_dir()/<safe_name(name)>`。
        #   那里若已经有 `.nwsproj`（同名项目已存在），`write_back` 会当场拒绝 ——
        #   宁可少写一次，也别在一个**已经开卷**的项目上动用户的素材。
        # [EN] ⚠ **Pre-judgement** of the project root: `Project.create_new` creates at
        # [EN] `projects_dir()/<safe_name(name)>`.
        # [EN] If there is already a `.nwsproj` there (a project with the same name exists), `write_back` will
        # [EN] refuse on the spot —
        # [EN] better to write one less time than to touch the user's material on a project that has **already
        # [EN] been volume-opened**.
        guessed_root = CFG.projects_dir() / safe_name(name)
        try:
            new_settings, rep, notes = await src_repair.run_repairs(
                issues, result.items, state['settings'], src_root=root,
                project_root=guessed_root, name=name,
                tier=getattr(result, 'tier', ''),
                on_note=lambda line: add_log(f'[{_stamp()}] {line}',
                                             'ok' if line.startswith('·') else 'info'))
        except Exception as e:                              # noqa: BLE001
            log_exception(t('AI 补全失败'), category="ui")
            rep = src_repair.RepairReport(ok=False, why=str(e))
            new_settings = state['settings']

        if rep.ok and rep.changed:
            state['settings'] = new_settings
            result.settings = new_settings
            # 补完之后**重评一次档**：伏笔 / 秘密 / 大纲补上了，档位很可能就上去了
            # [EN] After completing, **re-evaluate the grade once**: with foreshadowing / secrets / outline filled
            # [EN] in, the grade very likely goes up
            try:
                tier2, miss2 = assess_tier(state['settings'], result.items)
            except Exception:                               # noqa: BLE001
                tier2, miss2 = (getattr(result, 'tier', ''),
                                getattr(result, 'missing_for_gold', []))
            if tier2 and tier2 != getattr(result, 'tier', ''):
                add_log(f'[{_stamp()}] 评档 {tier2}（补全后重评，原为 '
                        f'{getattr(result, "tier", "")}）', 'ok')
                result.tier, result.missing_for_gold = tier2, miss2
            add_log(f'[{_stamp()}] {rep.summary()}', 'ok')
            for line in rep.detail_lines():
                add_log(f'[{_stamp()}] {line}', 'info')
            add_log(f'[{_stamp()}] 接下来创建项目 —— 从此不再改动引用文件夹', 'stage')
        elif rep.ok:
            add_log(f'[{_stamp()}] {rep.summary()}', 'info')
        else:
            add_log(f'[{_stamp()}] {rep.summary()}', 'err')

    async def _make_portraits(self, proj, settings: dict, add_log, set_progress):
        """开卷时**一次性**生成人物肖像（文生图），并把每人的结果写进进度日志。

        三条硬要求（用户定的，改之前先读）：
          1. 肖像**一律走文生图**（本地画的那个几何头像太难看了，已弃用）；
          2. **只在开卷时生成一次** —— 存在 `<项目>/肖像/`，之后各轮直接复用；
          3. 模型不支持文生图就**说明白**，正文里这一段**不插肖像**
             （2026-10-07 起也不再另写人物介绍 —— 那由开场卡负责）。

        返回 `PortraitReport`，或 None（这张书不要图 / 生成过程整个失败）。
        
                English:
        At ingest, **generate character portraits once** (text-to-image), and write each person's result
        into the progress log.
                Three hard requirements (set by the user, read before changing):
                  1. Portraits **always go through text-to-image** (the locally drawn geometric avatar is too ugly, deprecated);
                  2. **Generate only once at ingest** -- stored in `<项目>/肖像/`, reused directly in subsequent rounds;
                  3. If the model doesn't support text-to-image, **say so clearly**, and **don't insert portraits** in this part of the body text
                     (as of 2026-10-07, no separate character introduction is written either -- that's handled by the opening card).
                Return `PortraitReport`, or None (this book doesn't want images / the generation process failed entirely).
        """
        # 时间戳自己拼：`_now()` 是摄取对话框里的**局部闭包**，这里够不着
        # （踩过：直接写 `_now()` → NameError，窗口还挂着，看起来像卡死）
        # [EN] Assemble the timestamp yourself: `_now()` is a **local closure** in the ingest dialog, out of
        # [EN] reach here
        # [EN] (been burned: writing `_now()` directly → NameError, window still hangs, looks like it's frozen)
        def _stamp() -> str:
            return time.strftime('%H:%M:%S')

        from image_gen.hook import effective_mode
        from image_gen.portraits import ensure_portraits

        # 「关闭」档 = 什么图都不要 → 连肖像也不生成（省 token）
        # [EN] "Off" grade = no images at all → not even portraits are generated (saves tokens)
        if effective_mode(proj) == 'off':
            add_log(f'[{_stamp()}] 对话图片已关闭 —— 跳过肖像生成', 'stage')
            return None

        people = list(settings.get('人物') or [])
        if not people:
            add_log(f'[{_stamp()}] 设定集里没有人物，跳过肖像', 'stage')
            return None

        set_progress(0.97, t('正在生成人物肖像（{n} 位）…', n=len(people)))
        add_log(f'[{_stamp()}] 开始生成人物肖像（{len(people)} 位，文生图）', 'stage')

        # ★ 生成是**同步阻塞**的（每次一张 HTTP 请求），所以丢进线程；
        #   但日志只能由主协程写（Flet 控件不能跨线程改）—— 于是线程里
        #   只往 `pending` 列表塞消息，主协程每 0.25s 掏一次。
        # [EN] ★ Generation is **synchronously blocking** (one HTTP request per image), so throw it into a
        # [EN] thread;
        # [EN] but logs can only be written by the main coroutine (Flet widgets cannot be modified across
        # [EN] threads) — so in the thread
        # [EN] only push messages into the `pending` list, and the main coroutine pulls once every 0.25s.
        pending: list[str] = []
        box: dict = {}

        def _work() -> None:
            try:
                box['rep'] = ensure_portraits(
                    proj, people, genre=str(settings.get('主题材') or ''),
                    on_progress=pending.append)
            except BaseException as e:                      # noqa: BLE001
                box['err'] = e

        task = asyncio.create_task(asyncio.to_thread(_work))
        while not task.done():
            while pending:
                add_log(f'[{_stamp()}] {pending.pop(0)}', 'stage')
            await asyncio.sleep(0.25)
        await task
        while pending:
            add_log(f'[{_stamp()}] {pending.pop(0)}', 'stage')

        if 'err' in box:
            log_exception(t('生成肖像失败'), category="ui")
            add_log(f'[{_stamp()}] ✗ 肖像生成中断：{box["err"]}', 'err')
            return None

        rep = box.get('rep')
        if rep is not None and not rep.available:
            add_log(f'[{_stamp()}] ✗ 文生图不可用：{rep.why} —— 正文里不插肖像图',
                    'err')
        elif rep is not None:
            add_log(f'[{_stamp()}] 肖像完成：{rep.summary()}', 'ok')
        return rep

    async def _make_map_bitmaps(self, proj: Project, add_log, set_progress) -> None:
        """**地图位图底画**：三级矢量底图之外再出一层画面（`MAP_ATLAS_BITMAP`）。

        用户 2026-10-08 选的是**两条都要**：矢量结构定"事实"（位置稳定、能取景），
        位图只作**氛围底画**。所以这里与三级矢量底图是**两件事**：

          · 矢量底图 —— `run_ingest` 里生成（只花文本 token，位置稳定的保证）；
          · 位图底画 —— 这里生成（每张一次出图，贵，默认关）。

        ⚠ 与 `_make_portraits` 同一套做法：生成是**同步阻塞**的（一张一次 HTTP），
          丢进线程；日志只能由主协程写（Flet 控件不能跨线程改），
          所以线程里往 `pending` 塞消息、主协程每 0.25s 掏一次。
        ⚠ 拿不到就**明说**（不静默）：矢量底图照旧在，只是少一层画面质感。
        
                English:
        **Map bitmap base art**: in addition to the three-level vector base map, produce another layer
        of imagery (`MAP_ATLAS_BITMAP`).
                What the user chose on 2026-10-08 is **both**: the vector structure establishes the "facts" (stable positions, can frame shots),
                the bitmap serves only as the **atmospheric base art**. So here it is **two separate things** from the three-level vector base map:
                  · Vector base map -- generated in `run_ingest` (only spends text tokens, the guarantee of stable positions);
                  · Bitmap base art -- generated here (one image generation per image, expensive, off by default).
                ⚠ Same approach as `_make_portraits`: generation is **synchronously blocking** (one HTTP call per image),
                  thrown into a thread; logs can only be written by the main coroutine (Flet controls can't be modified across threads),
                  so the thread stuffs messages into `pending`, and the main coroutine pulls one every 0.25s.
                ⚠ If it can't be obtained, **say so explicitly** (don't stay silent): the vector base map is still there as before, just missing a layer of visual texture.
        """
        def _stamp() -> str:
            return time.strftime('%H:%M:%S')

        if not CFG.b('MAP_ATLAS_BITMAP'):
            return
        # 三级矢量底图在设定集里（`run_ingest` 写的）；没有就没有可画的依据
        # [EN] The three-level vector basemap is in the setting collection (written by `run_ingest`); if absent
        # [EN] there is no basis to draw from
        try:
            from world import atlas as AT
            from ingest import atlas as IAT
            at = AT.load(proj.settings_dir)
        except Exception as e:                                  # noqa: BLE001
            add_log(f'[{_stamp()}] 地图底画跳过：{e!r}', 'err')
            return
        if at is None or not at.has_any():
            add_log(f'[{_stamp()}] 地图底画跳过：设定集里没有三级底图'
                    f'（`MAP_ATLAS` 关着或生成失败）', 'stage')
            return

        n = (1 if at.overview is not None else 0) + min(len(at.local),
                                                       AT.MAX_PLACES)
        set_progress(0.985, t('正在画地图底图（{n} 张）…', n=n))
        add_log(f'[{_stamp()}] 开始画地图底图（{n} 张，文生图）', 'stage')

        pending: list[str] = []
        box: dict = {}

        def _work() -> None:
            try:
                box['out'] = IAT.build_bitmaps(proj, at,
                                               on_progress=pending.append)
            except BaseException as e:                          # noqa: BLE001
                box['err'] = e

        task = asyncio.create_task(asyncio.to_thread(_work))
        while not task.done():
            while pending:
                add_log(f'[{_stamp()}] {pending.pop(0)}', 'stage')
            await asyncio.sleep(0.25)
        await task
        while pending:
            add_log(f'[{_stamp()}] {pending.pop(0)}', 'stage')

        if 'err' in box:
            log_exception(t('画地图底图失败'), category="ui")
            add_log(f'[{_stamp()}] ✗ 地图底画中断：{box["err"]}', 'err')
            return
        out = box.get('out') or []
        if out:
            # 记进底图（下次进界面就知道有哪些画可用）
            # [EN] Record it into the basemap (next time the UI is entered it knows which images are available)
            try:
                at.bitmaps = list(out)
                AT.save(proj.settings_dir, at)
            except Exception:                                   # noqa: BLE001
                pass
            add_log(f'[{_stamp()}] 地图底画完成：{len(out)} 张', 'ok')
        else:
            add_log(f'[{_stamp()}] 地图底画一张都没成（矢量底图不受影响）',
                    'err')

    def _activate_project(self, proj: Project) -> None:
        """切到某个项目：记到实例上，并告诉 MCP 客户端「当前项目在这」。

        MCP 的本地服务器（项目考据 / 故事线）靠 `{project_dir}` 占位符定位，
        不设置的话它们只能看到空目录。
        
                English:
        Switch to a certain project: record it on the instance, and tell the MCP client "the current
        project is here".
                MCP's local server (project research / storyline) locates things via the `{project_dir}` placeholder,
                if it's not set they can only see an empty directory.
        """
        self.current_project = proj
        # ★ 日志文件名补上书名（2026-10-07）：
        #   `nws_2026_10_07_01_23_11.log` → `nws_临河茶肆_2026_10_07_01_23_11.log`。
        #   日志器在**程序启动**时就建好了，那会儿还没开卷、名字未知，所以
        #   只能在这儿改；这里也是**唯一**"项目名第一次确定"的地方
        #   （开卷完成与拾卷打开都走这个函数）。
        #   一本小说跑很多轮，`logs/` 里堆满 `nws_*.log`，光看名字认不出哪份是哪本书。
        # [EN] ★ Append the book title to the log file name (2026-10-07):
        # [EN] The logger is created at **program startup**, when the volume isn't opened yet and the name is
        # [EN] unknown, so
        # [EN] it can only be changed here; this is also the **only** place where "the project name is first
        # [EN] determined"
        # [EN] (both volume-opening completion and volume-pickup opening go through this function).
        # [EN] A novel runs many rounds, and `logs/` is piled with `nws_*.log`; from the name alone you can't
        # [EN] tell which is which book.
        try:
            set_project_log(proj.name)
        except Exception:                                       # noqa: BLE001
            # 改名失败**不影响使用**（日志继续写在原名里），但要说一声，别静悄悄
            # [EN] Rename failure **does not affect usage** (logs continue writing under the original name), but
            # [EN] say something, don't be silent
            log_exception(t('日志改名失败（日志继续写在原名里）'), category="ui")
        # ★ 把这本书的**输出语言**装上（`util/outlang`）—— 之后所有 LLM 调用
        #   都会带上「输出用 X 语言」那一句（见 `llm/router._inject_output_lang`）。
        #   换项目时这里会**重新装一次**，所以"英文小说→中文输出"和
        #   "中文小说→英文输出"在同一台机器上互不干扰。
        # [EN] ★ Install this book's **output language** (`util/outlang`) — afterwards all LLM calls
        # [EN] will carry the "output in language X" sentence (see `llm/router._inject_output_lang`).
        # [EN] When switching projects it is **re-installed once** here, so "English novel → Chinese output"
        # [EN] and
        # [EN] "Chinese novel → English output" don't interfere with each other on the same machine.
        outlang.set_from_project(getattr(proj, 'output_lang', ''))
        try:
            mcp_client.set_project_dir(proj.root)
        except Exception:
            log_exception(t('同步 MCP 项目路径失败'), category="ui")

    # ══════════════════════════════════════════════════════════
    #  拾卷：三栏（① 小说 / ② 这本书的存档 / ③ 存档内容）
    # [EN] Pickup: three columns (① novel / ② this book's saves / ③ save contents)
    # ══════════════════════════════════════════════════════════
    def _confirm_danger(self, title: str, lines: list, on_yes, *,
                        confirm_word: str = "") -> None:
        """危险操作的确认框：**把要删的东西列清楚**再问。

        只写一句「确定吗？」的确认框等于没确认 —— 用户没法核对，
        只能凭记忆赌一把。所以这里要求调用方把「名字 / 路径 / 多少文件 / 多大」
        都当 `lines` 传进来，确认按钮用**朱砂色**（和旁边那些纸色按钮分开）。
        `on_yes` 在**确认框已经收掉之后**才调用（调用方不用自己 pop）。

        `confirm_word` 非空时，还要**手打这个名字**才让点确认（删整本书用）——
        一整本书的分量，值一次手打。⚠ 手打不看语言：比的是**书名本身**
        （那是文件夹名，不是界面文案）。
        
                English:
        Dangerous-operation confirmation dialog: **list exactly what will be deleted** before asking.
                A confirmation dialog that only says "Are you sure?" is as good as no confirmation -- the user can't verify anything,
                and can only gamble on memory. So here the caller is required to pass in "name / path / how many files / how big"
                all as `lines`, and the confirm button uses **vermilion** (to stand apart from the paper-colored buttons beside it).
                `on_yes` is called **only after the confirmation dialog has already been dismissed** (the caller doesn't need to pop it).
                When `confirm_word` is non-empty, the user must also **type this name by hand** before the confirm button can be clicked (used for deleting an entire book) --
                the weight of a whole book, worth typing once by hand. ⚠ The typing is language-agnostic: it compares against the **book name itself**
                (that's the folder name, not UI text).
        """
        page = self.page
        controls = list(lines)
        btn = mk_btn(t("确认删除"), danger=True)

        if confirm_word:
            typed = mk_field(t("在这里打出「{w}」以确认", w=confirm_word),
                             "", width=DLG_W - 200)
            btn.disabled = True

            def _watch(e=None) -> None:
                ok_word = (field_value(typed) or '').strip() == confirm_word
                btn.disabled = not ok_word
                try:
                    btn.update()
                except Exception:                               # noqa: BLE001
                    pass

            typed._field.on_change = _watch
            typed._field.on_submit = _watch
            controls.append(ft.Divider(height=4, color='transparent'))
            controls.append(typed)

        # 长路径会折两行 —— 给个滚动，宁可滚也别把最后那条"去哪找回来"裁掉
        # [EN] Long paths wrap to two lines — give a scroll, better to scroll than to cut off the last "where
        # [EN] to find it back" line
        body = ft.Container(
            content=ft.Column(controls, spacing=6, scroll=ft.ScrollMode.ADAPTIVE),
            width=DLG_W - 160, height=280 if confirm_word else 250,
        )

        def _go(e=None):
            if btn.disabled:
                return
            page.pop_dialog()               # 先收确认框，再动手
            # [EN] Dismiss the confirmation box first, then act
            on_yes()

        btn.on_click = _go
        dlg = mk_dialog(
            title, body,
            [btn, mk_btn(t("取消"), on_click=lambda e: page.pop_dialog(),
                         primary=False)],
        )
        page.show_dialog(dlg)

    def _ask_duplicate(self, page, dup: list, src: str, name: str) -> None:
        """「这本小说已经开过卷了」的提示框（用户 2026-10-07 报的那个问题）。

        用户原话：「如果小说已经存在 则后续再开卷的话 要提示已经存在，
        而不是继续可以开卷这本小说」。以前的行为是**一声不吭地又开一遍** ——
        更糟的是同名会复用同一个项目目录（`Project.create_new` 里
        `ensure_dir` 存在即用），于是新书的设定集写进旧项目、
        而旧项目那本书的存档还挂在里面。

        三个按钮（推荐动作在**左**，本项目的老规矩）：
          · 「打开『<已有的那本>』」→ 直接去看那一本（他多半要的就是这个）；
          · 「仍然重新开卷」→ **先自动避开重名**再放行。要重开是他的事，
            但**不许覆盖**已经开过的那本（见 `store.project.unique_name`）；
          · 「取消」。

        ⚠ 这个框是**叠在向导上面**的：调用方（`_do_import`）没有 pop 向导，
          取消之后用户回到原来那一步，可以改文件夹或改名字再试。
        
                English:
        The "this novel already has a volume started" prompt dialog (the issue reported by the user on
        2026-10-07).
                User's exact words: "If the novel already exists, then when starting a volume later it should prompt that it already exists,"
                rather than continuing to allow starting a volume for this novel." The previous behavior was to **silently start it again** --
                worse, the same name would reuse the same project directory (in `Project.create_new`,
                `ensure_dir` uses it if it exists), so the new book's setting collection got written into the old project,
                while the old project's book save was still hanging inside it.
                Three buttons (recommended action on the **left**, the long-standing convention of this project):
                  · "Open '<the existing one>'" -> go straight to that one (that's probably what he wants);
                  · "Still restart the volume" -> **first automatically avoid the duplicate name**, then proceed. Restarting is his business,
                    but **overwriting** the one already started is not allowed (see `store.project.unique_name`);
                  · "Cancel".
                ⚠ This dialog is **stacked on top of the wizard**: the caller (`_do_import`) does not pop the wizard,
                  so after canceling the user returns to the original step and can change the folder or name and try again.
        """
        first = dup[0]
        rows = [
            ft.Text(t("这本小说已经开过卷了，不必再开一遍。"),
                    color=C['seal'], size=BODY_FS),
            ft.Divider(height=6, color='transparent'),
            ft.Text(t("· 项目：「{name}」", name=first.name),
                    color=C['text'], size=BODY_FS),
            ft.Text(t("· 创建 {created}　最近运行 {last}　跑过 {runs} 轮",
                      created=first.created or t('（时间未记）'),
                      last=first.last_run or t('（还没跑过）'),
                      runs=first.run_count), color=C['muted'], size=HINT_FS),
        ]
        if first.source_folder:
            rows.append(ft.Text(t("· 源文件夹：{src}", src=first.source_folder),
                                color=C['muted'], size=HINT_FS))
        if len(dup) > 1:
            rows.append(ft.Text(t("（另外还有 {n} 本同名或同素材的项目）",
                                  n=len(dup) - 1),
                                color=C['muted'], size=HINT_FS))
        rows += [
            ft.Divider(height=6, color='transparent'),
            ft.Text(t("再走一遍会重新读一遍素材（多花一次开卷的时间与额度）。"
                      "只想接着看故事的话，点左边那个按钮打开已经开好的那本。"),
                    color=C['muted'], size=HINT_FS),
            ft.Text(t("「仍然重新开卷」不会覆盖已有的那本 —— 会另存成一个新的项目名。"),
                    color=C['muted'], size=HINT_FS),
        ]

        open_btn = mk_btn(t("打开「{name}」", name=first.name), primary=True)
        again_btn = mk_btn(t("仍然重新开卷"), primary=False)

        def _open_existing(e=None):
            page.pop_dialog()                       # 先收提示框
            # [EN] Dismiss the prompt box first
            try:
                page.pop_dialog()                   # 再收向导
                # [EN] Then dismiss the wizard
            except Exception:                                    # noqa: BLE001
                pass
            self._activate_project(first)
            self.show_main_screen()

        def _open_anyway(e=None):
            # ★ 避重名：他要重开就重开，但**不能**写进已经开过的那一本里。
            # [EN] ★ Avoid name collision: if he wants to reopen, let him reopen, but **must not** write into the
            # [EN] one already opened.
            new_name = unique_name(CFG.projects_dir(), name)
            self._wizard_name = new_name
            self._wizard_name_auto = new_name       # 免得自动填充又给改回去
            # [EN] Lest auto-fill changes it back again
            fld = getattr(self, '_wizard_name_field', None)
            try:
                if fld is not None and getattr(fld, '_field', None) is not None:
                    fld._field.value = new_name
            except Exception:                                    # noqa: BLE001
                pass
            self._dup_cache = None                  # 项目清单可能刚变，重扫
            # [EN] The project list may have just changed, rescan
            page.pop_dialog()
            if new_name != name:
                self._show_snack(t('项目名已改成「{name}」—— 不会覆盖已经开过的那本',
                                   name=new_name))
            self._do_import(page, force=True)

        open_btn.on_click = _open_existing
        again_btn.on_click = _open_anyway
        body = ft.Container(
            content=ft.Column(rows, spacing=4, scroll=ft.ScrollMode.ADAPTIVE),
            width=DLG_W - 160, height=250,
        )
        page.show_dialog(mk_dialog(
            t("这本小说已经开过卷了"), body,
            [open_btn, again_btn,
             mk_btn(t("取消"), on_click=lambda e: page.pop_dialog(), primary=False)],
        ))

    def show_projects_dialog(self):
        """拾卷：**三栏**（① 小说 / ② 这本书的存档 / ③ 存档内容）。

        2026-10-06 用户要的改版，理由是"删除这本小说"埋在底部按钮行里不好找：
        「删除这本小说有办法放到上面吗？比如你修改下小说列表的形式，不用下拉框而是
        用别的形式可好。比如把拾卷改成三列 第1列是小说 第2列是特定小说存档
        第3列是存档内容，而且这3列你都简单说明下是什么东西；而且最左侧的小说部分
        也加上一个删除按钮，小说这个不需要太多东西 就标题和创建时间就好了。」

        于是：
        - 顶部那个**项目下拉框删了** —— 它只解决"选哪一本"，解决不了"在哪删一本"；
        - 三栏并排，**每栏都带一句说明**（三栏都窄，不写清就只是三个认不出来的框）；
        - **删整本的入口跟着那一本走**（左栏每本右边一个小图标按钮），
          底部按钮行只剩「打开选中项目 / 关闭」；
        - 存档卡与详情照旧（Markdown 渲染 + 各自带滚动条 + 每轮一个删除按钮）。

        ⚠ 删除按钮一律用 `mk_icon_btn()`（自己画底 + 居中 `ft.Icon`）：
        老写法 `mk_btn('🗑')` 里那个 emoji 是**彩色字形**，宽度由字体决定，
        塞进 30px 宽的 FilledButton 会**溢出背景** —— 用户看到的正是
        「垃圾桶图标没在红色背景里」。
        
                English:
        Pick a volume: **three columns** (① Novel / ② This book's saves / ③ Save contents).
                2026-10-06 revision requested by the user, reason being that "delete this novel" was buried in the bottom button row and hard to find:
                "Is there a way to move 'delete this novel' up top? For example, modify the form of the novel list, not a dropdown but
                some other form. For example, change Pick a volume to three columns: column 1 is novels, column 2 is saves for a specific novel,
                column 3 is save contents, and for all 3 columns simply explain what each is; also add a delete button
                to the leftmost novel section -- the novel doesn't need much, just title and creation time."
                So:
                - The **project dropdown at the top was removed** -- it only solved "which one to select", not "where to delete one";
                - Three columns side by side, **each column carries a one-line description** (all three are narrow; without a clear label they're just three unrecognizable boxes);
                - **The entry to delete a whole book follows that book** (a small icon button to the right of each book in the left column),
                  and the bottom button row only keeps "Open selected project / Close";
                - Save cards and details stay as before (Markdown rendering + each with its own scrollbar + one delete button per round).
                ⚠ Delete buttons all use `mk_icon_btn()` (draw the background yourself + centered `ft.Icon`):
                the old approach `mk_btn('🗑')` had that emoji as a **color glyph**, whose width is decided by the font,
                and stuffing it into a 30px-wide FilledButton would **overflow the background** -- what the user saw was exactly
                "the trash icon not inside the red background".
        """
        page = self.page
        projects_root = CFG.projects_dir()
        projects = scan_projects(projects_root)
        if not projects:
            # 走到这儿只有一种可能：**菜单是旧的**（磁盘上已经没书了，但开始界面
            # 还是从有书那一版画出来的，所以「拾　卷」还是亮的）。顺手把界面重画
            # 一遍让它自己熄火，别只说一句"暂无项目"就留着个能点的假入口。
            # [EN] Getting here means only one thing: **the menu is stale** (the books are already gone from disk,
            # [EN] but the start screen
            # [EN] was still drawn from the version that had books, so "Pick a Volume" is still lit). Just redraw
            # [EN] the UI
            # [EN] once to let it extinguish itself, don't just say "no projects" and leave a clickable fake entry.
            if self._refresh_start_screen():
                self._show_snack(t('小说都被删掉了 —— 「拾　卷」已置灰，'
                                   '要重新开始请点「开　卷」'))
            else:
                self._show_snack(t('暂无项目，请先开卷导入。'))
            return

        proj_map: dict[str, Project] = {p.name: p for p in projects}
        shown = {'proj': None, 'run': None}      # 当前选中的书 / 存档
        #: ② 存档栏当前的排序档（见 `_sorted_runs`）。默认「结束时间倒序」——
        #: 与"最新的在最上面"观感一致（推演通常一轮接一轮，后跑的推得更远）。
        # [EN] Currently selected book / save
        # [EN] : (2) The current sort profile of the save column (see `_sorted_runs`). Defaults to "end time
        # [EN] descending" —
        # [EN] : consistent with the impression that "the newest is on top" (runs usually happen one after
        # [EN] another, and later runs get further).
        sort_state = {'key': 'end_desc'}

        def _centered(text: str, *, size: float = BODY_FS) -> ft.Row:
            return ft.Row([
                ft.Container(expand=True),
                ft.Text(text, size=size, color=C['muted'],
                        text_align=ft.TextAlign.CENTER),
                ft.Container(expand=True),
            ], spacing=0)

        def _new_list() -> ft.ListView:
            """一栏里的清单。⚠ 用 `ListView` 而不是 `Column`：① 项在交叉轴上被**紧约束**
            → 天然"水平沾满"；② 自带 `padding`，正好把**滚动条车道**做进去
            （滚动条画在右边缘、往左画，不留车道就会压在最右边那列字上）。
                        English:
            A list within a column. ⚠ Use `ListView` instead of `Column`: ① items are **tightly
            constrained** on the cross axis
                        → naturally "filled horizontally"; ② it comes with `padding`, which conveniently builds in the **scrollbar lane**
                        (the scrollbar is drawn at the right edge, drawn leftward; without a lane reserved it presses onto the rightmost column of text).
            """
            return ft.ListView(spacing=6, padding=ft.Padding(0, 0, SAVE_GUTTER, 0),
                               scroll=ft.ScrollMode.ADAPTIVE, expand=True)

        novel_list = _new_list()
        save_list = _new_list()
        detail_list = _new_list()
        # ★ 三栏各一条**自绘常驻滚动条**（`_new_list` 的车道就是给它的）。
        #   三栏都是**预载内容**（打开对话框时一次填满），没人滚过 ——
        #   所以装载完要显式 `reset` 一次，否则条要等到用户滚动才现身。
        # [EN] ★ Each of the three columns has one **self-drawn persistent scrollbar** (the lane in `_new_list`
        # [EN] is for it).
        # [EN] All three columns are **preloaded content** (filled in one shot when the dialog opens), nobody
        # [EN] has scrolled —
        # [EN] so after loading we must explicitly `reset` once, otherwise the bar won't appear until the user
        # [EN] scrolls.
        novel_bar = self._scroll_bar(novel_list, SAVE_LIST_H, lane=SAVE_GUTTER)
        save_bar = self._scroll_bar(save_list, SAVE_LIST_H, lane=SAVE_GUTTER)
        detail_bar = self._scroll_bar(detail_list, SAVE_LIST_H, lane=SAVE_GUTTER)
        self._ui_saves = {'novel_bar': novel_bar, 'save_bar': save_bar,
                          'detail_bar': detail_bar}

        def _column(title: str, hint: str, body: ft.Control,
                    width: int = None, extra: ft.Control = None) -> ft.Container:
            """一栏 = 栏头（名字 + 一句话说明）+（可选）一行控件 + 内容。

            **每栏都要有那句说明**：三栏并排、栏都窄，用户得一眼知道
            "这栏是什么、点它会怎样"。

            `extra`（2026-10-10 加）：夹在栏头与清单之间的那一行 ——
            ② 存档栏用它放**排序单选框**。放在栏头**下面**而不是上面：
            栏头那句说明是"这栏是什么"，排序是"这栏里的东西怎么摆"，
            先说是什么、再说怎么摆，顺序才对。
            
                        English:
            One column = column header (name + one-line description) + (optional) one row of controls +
            content.
                        **Every column needs that description**: three columns side by side, each narrow, the user must know at a glance
                        "what this column is, what happens when you click it".
                        `extra` (added 2026-10-10): the row sandwiched between the column header and the list --
                        ② the save column uses it for the **sort radio buttons**. Placed **below** the column header rather than above:
                        the column header's description is "what this column is", and sorting is "how the things in this column are arranged";
                        say what it is first, then how it's arranged -- that's the correct order.
            """
            head = ft.Container(
                content=ft.Column([
                    ft.Text(title, size=LBL_FS + 0.5, color=C['gold'],
                            weight=ft.FontWeight.BOLD),
                    ft.Text(hint, size=HINT_FS, color=C['muted']),
                ], spacing=2),
                padding=ft.Padding(0, 0, 0, 6),
                border=make_border_bottom(1, C['border']),
            )
            kids = [head] + ([extra] if extra is not None else []) + [body]
            return ft.Container(
                content=ft.Column(kids, spacing=4, expand=True),
                width=width, expand=(width is None),
                bgcolor=with_alpha(C['hover'], panel_alpha()),
                border=make_border(1, C['border']),
                border_radius=6,
                padding=ft.Padding(SAVE_PAD, SAVE_PAD, SAVE_PAD, SAVE_PAD),
            )

        # 详情那一栏底色浅一档（纸白），跟左边两栏的"列表纸"分开
        # [EN] The detail column's background is one shade lighter (paper white), separating it from the "list
        # [EN] paper" of the two left columns
        detail_panel = ft.Container(
            content=ft.Column([
                ft.Container(
                    content=ft.Column([
                        ft.Text(t('③ 存档内容'), size=LBL_FS + 0.5,
                                color=C['gold'], weight=ft.FontWeight.BOLD),
                        ft.Text(t('选中那一轮的世界：元信息、最近剧情、运行小结。'),
                                size=HINT_FS, color=C['muted']),
                    ], spacing=2),
                    padding=ft.Padding(0, 0, 0, 6),
                    border=make_border_bottom(1, C['border']),
                ),
                ft.Container(content=_centered(t('（先在中间选一条存档）')),
                             alignment=ft.Alignment(0, 0), expand=True),
            ], spacing=4, expand=True),
            expand=True,
            bgcolor=C['input_bg'],
            border=make_border(1, C['border']),
            border_radius=6,
            padding=ft.Padding(SAVE_PAD, SAVE_PAD, SAVE_PAD, SAVE_PAD),
        )

        # ── 选中态（bgcolor + 描金边；hover 之后要能还原）──
        # [EN] ── Selection state (bgcolor + gold outline; must be restorable after hover) ──
        novel_cards: list = []
        save_cards: list = []

        def _is_sel(kind: str, item) -> bool:
            # ⚠ 两边都可能是 None，直接比会把**整列**都判成选中（踩过）
            # [EN] ⚠ Both sides may be None, comparing directly marks the **entire column** as selected (been
            # [EN] there)
            cur = shown['proj'] if kind == 'proj' else shown['run']
            return item is not None and cur == item

        def _card_bg(kind: str, item) -> str:
            return (with_alpha(C['hover'], panel_alpha())
                    if _is_sel(kind, item) else C['panel'])

        def _card_border(kind: str, item) -> ft.Border:
            return make_border(1, C['border_gold'] if _is_sel(kind, item)
                               else C['border'])

        # ── 读盘（都只读）──
        #: 故事时间跨度的缓存（键 = 存档目录）。**必须有**：一张卡片建一次、
        #: 点开详情又算一次，而它要读目录里所有 `第NNN天.*` —— 同一轮算两遍
        #: 是白花时间（拾卷里可能躺着几十轮）。
        # [EN] ── Disk reads (all read-only) ──
        # [EN] : Cache of story time spans (key = save directory). **Must have**: built once per card,
        # [EN] : and computed again when the detail is opened, and it reads all `第NNN天.*` in the directory —
        # [EN] computing it twice in the same run
        # [EN] : is wasted time (there may be dozens of runs sitting in Pick a Volume).
        _span_cache: dict[str, StorySpan] = {}

        def _span(run_dir: Path) -> StorySpan:
            """这一轮的「故事里的时间」跨度（带缓存，见上）。**永不抛异常**：
            读盘失败就返回空跨度，界面照旧把卡片画出来（宁可少一行信息，
            也不要因为读不出时间就整栏打不开）。
                        English:
            This round's "in-story time" span (cached, see above). **Never raises**:
                        if reading the disk fails, return an empty span, and the UI draws the card as usual (better to lose one line of info
                        than to have the whole column fail to open just because the time couldn't be read).
            """
            key = str(run_dir)
            got = _span_cache.get(key)
            if got is None:
                try:
                    got = story_span_of(run_dir)
                except Exception:                                # noqa: BLE001
                    got = StorySpan()
                _span_cache[key] = got
            return got

        def _read_task_intro(run_dir: Path) -> dict:
            """读取运行文件夹的 任务介绍.md，提取结构化信息。
                        English:
            Read the run folder's 任务介绍.md and extract structured information.
            """
            intro_path = run_dir / "任务介绍.md"
            if not intro_path.exists():
                return {}
            try:
                lines = intro_path.read_text(encoding='utf-8', errors='ignore').splitlines()
                info = {}
                for line in lines:
                    line = line.strip()
                    if line.startswith('- **') and '**：' in line:
                        k, v = line.split('**：', 1)
                        k = k.lstrip('- **').rstrip('**')
                        info[k] = v.strip()
                return info
            except Exception:
                return {}

        def _read_md(folder: Path, filename: str) -> str:
            """读一份 Markdown 原文（**不截断**；截断交给 `md_excerpt` 管）。
                        English:
            Read a Markdown source (**no truncation**; truncation is handled by `md_excerpt`).
            """
            path = folder / filename
            try:
                return path.read_text(encoding='utf-8', errors='ignore') if path.exists() else ''
            except OSError:
                return ''

        def _read_daily_md(run_dir: Path) -> str:
            daily_dir = run_dir / "每天的生活"
            if not daily_dir.exists():
                return ''
            files = sorted(daily_dir.glob("*.md"))
            return _read_md(daily_dir, files[-1].name) if files else ''

        def _save_time(run_name: str) -> str:
            """从文件夹名里抠出存档时间（`第N次模拟2026-10-05-22-42`）。
                        English:
            Extract the save time from the folder name (`第N次模拟2026-10-05-22-42`).
            """
            m = re.search(r'(\d{4}-\d{2}-\d{2}-\d{2}-\d{2})', run_name)
            if not m:
                return ''
            s = m.group(1)
            return f"{s[:10]} {s[11:]}"

        # ── ③ 存档内容 ──
        # [EN] ── (3) Save content ──
        def _build_detail(proj: Project, run_dir: Path) -> list:
            intro = _read_task_intro(run_dir)
            span = _span(run_dir)
            meta_lines = []
            if intro.get('项目'):
                meta_lines.append(f"📁 {t('项目')}：{intro['项目']}")
            if intro.get('源文件夹'):
                meta_lines.append(f"📂 {t('源文件夹')}：{intro['源文件夹']}")
            if intro.get('类型'):
                meta_lines.append(f"🎭 {t('类型')}：{intro['类型']}")
            if intro.get('评档'):
                meta_lines.append(f"⭐ {t('评档')}：{intro['评档']}")
            if intro.get('起始节点'):
                meta_lines.append(f"📍 {t('起始节点')}：{intro['起始节点']}")

            save_time = _save_time(run_dir.name)
            daily = md_excerpt(_read_daily_md(run_dir), 1500)
            summary = md_excerpt(_read_md(run_dir, '运行小结.md'), 2000)

            def _sec(label: str) -> ft.Control:
                return ft.Text(label, size=LBL_FS, color=C['gold'],
                               weight=ft.FontWeight.BOLD)

            return [
                ft.Text(run_dir.name, size=SEC_FS, color=C['gold'],
                        weight=ft.FontWeight.BOLD),
                # ★ 2026-10-10：**两个时间必须并排出现，而且要说明白哪个是哪个**。
                #   用户点名要"故事里的时间"；而这里原本只有一个"存档时间"，
                #   那其实是**现实世界**的时刻（你什么时候点的起笔）。
                #   只写一个、还不说明它是哪个，正是把两件事混成一件的老毛病。
                # [EN] ★ 2026-10-10: **The two times must appear side by side, and it must be clear which is which**.
                # [EN] The user explicitly asked for "the time in the story"; whereas here there was originally only a
                # [EN] "save time",
                # [EN] which is actually the **real-world** moment (when you clicked to start writing).
                # [EN] Writing only one and not saying which one it is — that's exactly the old habit of conflating two
                # [EN] things into one.
                ft.Row([
                    ft.Text(f"⏳ {t('故事时间')}：{span.full()}" if span.ok else
                            t('⏳ 故事时间：（这一轮还没有落盘的故事）'),
                            size=HINT_FS,
                            color=C['accent'] if span.ok else C['muted']),
                    mk_tip(t('故事里过了多久 —— 从第几天演到第几天，取自 '
                             '`每天的生活/` 里的落盘产物。')),
                ], spacing=4, vertical_alignment=ft.CrossAxisAlignment.CENTER),
                ft.Row([
                    ft.Text(f"💾 {t('存档时间')}：{save_time}" if save_time else '',
                            size=HINT_FS, color=C['gold']),
                    mk_tip(t('**现实世界**里这个存档是什么时候生成的'
                             '（文件夹名上那串年月日）。')),
                ], spacing=4, vertical_alignment=ft.CrossAxisAlignment.CENTER),
                ft.Container(
                    content=ft.Text('\n'.join(meta_lines) or t('（无元信息）'),
                                    size=BODY_FS, color=C['text'], selectable=True),
                    bgcolor=with_alpha(C['hover'], panel_alpha()),
                    border_radius=4,
                    padding=ft.Padding(10, 8, 10, 8),
                ),
                _sec(t('最近剧情')),
                mk_md(daily or t('（暂无每天的生活记录）')),
                _sec(t('运行小结')),
                mk_md(summary or t('（暂无运行小结）')),
                ft.Divider(height=10, color='transparent'),
                ft.Row([
                    mk_icon_btn(ft.Icons.DELETE_OUTLINE, danger=True,
                                on_click=lambda e, p=proj, d=run_dir: _ask_delete_save(p, d),
                                tooltip=t('删除这个存档')),
                    ft.Text(t('删除这一轮（会移到「已删除备份」）'),
                            size=HINT_FS, color=C['muted']),
                    ft.Container(expand=True),
                ], spacing=8,
                    vertical_alignment=ft.CrossAxisAlignment.CENTER),
            ]

        def _show_detail(proj: Project, run_dir: Path) -> None:
            shown['run'] = run_dir
            detail_list.controls = _build_detail(proj, run_dir)
            detail_bar.reset(len(detail_list.controls) * 110 > SAVE_LIST_H)
            detail_panel.content = ft.Column([
                detail_panel.content.controls[0],      # 栏头（原样保留）
                # [EN] Column header (kept as-is)
                detail_bar,
            ], spacing=4, expand=True)
            for c in save_cards:
                c.bgcolor = _card_bg('run', getattr(c, '_run', None))
                c.border = _card_border('run', getattr(c, '_run', None))
            try:
                page.update()
            except Exception:                                   # noqa: BLE001
                pass

        def _reset_detail(hint: str) -> None:
            shown['run'] = None
            detail_bar.reset(False)              # 没内容 → 条也收起来
            # [EN] No content -> collapse the bar too
            head = detail_panel.content.controls[0]
            detail_panel.content = ft.Column([
                head,
                ft.Container(content=_centered(hint), alignment=ft.Alignment(0, 0),
                             expand=True),
            ], spacing=4, expand=True)

        # ── ② 存档卡 ──
        # [EN] ── (2) Save card ──
        def _build_save_card(proj: Project, run_dir: Path,
                             span: 'StorySpan | None' = None) -> ft.Container:
            """一张存档卡。⚠ 标题仍是纯 `ft.Text`（它是文件夹名，不是 Markdown，
            而且 `developers/shoot_manual.py` 靠 `VU.all_texts()` 里的「第N次模拟」找它）。

            `span`（2026-10-10 加）：这一轮**故事里的时间**跨度，直接印在
            标题下面那一行 —— 用户点名的"加一个属性"，也是排序的依据。
            拿不到（旧存档 / 只跑了半天）时**整行不画**，不留一个空框。
            
                        English:
            A save card. ⚠ The title is still pure `ft.Text` (it is a folder name, not Markdown,
                        and `developers/shoot_manual.py` finds it via the "第N次模拟" in `VU.all_texts()`).
                        `span` (added 2026-10-10): the **in-story time** span of this run, printed directly on
                        the line under the title — the "add an attribute" the user asked for, and also the sort key.
                        When unavailable (old save / only ran half a day), **skip the whole line**, don't leave an empty box.
            """
            genre = _read_task_intro(run_dir).get('类型', '') or t('未设定')
            save_time = _save_time(run_dir.name)
            summary = md_excerpt(_read_daily_md(run_dir), 110,
                                 skip_leading_heads=True)

            row = ft.Row([], spacing=4,
                         vertical_alignment=ft.CrossAxisAlignment.CENTER)
            card = ft.Container(content=row, bgcolor=C['panel'],
                                border=_card_border('run', None), border_radius=6,
                                padding=ft.Padding(0, 0, 4, 0))
            card._run = run_dir
            card._span = span

            titles: list[ft.Control] = [
                ft.Text(run_dir.name, size=BODY_FS, color=C['text'],
                        weight=ft.FontWeight.BOLD, no_wrap=True,
                        overflow=ft.TextOverflow.ELLIPSIS),
            ]
            if span is not None and span.ok:
                titles.append(ft.Row([
                    ft.Text(t('⏳ 故事时间'), size=HINT_FS, color=C['muted'],
                            no_wrap=True),
                    mk_tip(t('这一轮**故事里**的时间跨度：从第几天演到第几天。'
                             '不是「你什么时候点的起笔」——那个时间在下面那一行。')),
                    ft.Text(span.short(), size=HINT_FS, color=C['accent'],
                            weight=ft.FontWeight.BOLD, no_wrap=True,
                            overflow=ft.TextOverflow.ELLIPSIS),
                ], spacing=4, vertical_alignment=ft.CrossAxisAlignment.CENTER))
            titles.append(mk_md(summary or t('（无摘要）'), body_fs=SAVE_CARD_FS))
            titles.append(ft.Text(f'{save_time} · {genre}' if save_time else genre,
                                  size=HINT_FS, color=C['gold'], no_wrap=True,
                                  overflow=ft.TextOverflow.ELLIPSIS))

            body = ft.Container(
                content=ft.Column(titles, spacing=2),
                expand=True, padding=ft.Padding(10, 8, 4, 8),
            )
            body.on_click = lambda e, p=proj, d=run_dir: _show_detail(p, d)
            body.on_hover = lambda e, r=run_dir, c=card: _hover_card(e, c, 'run', r)

            del_btn = mk_icon_btn(ft.Icons.DELETE_OUTLINE, danger=True,
                                  on_click=lambda e, p=proj, d=run_dir:
                                  _ask_delete_save(p, d),
                                  tooltip=t('删除这个存档'))
            row.controls = [body, del_btn]
            return card

        def _hover_card(e, card, kind: str, item) -> None:
            """悬停只改底色，移开回到「选中/未选中」那一档（别一律刷成透明）。
                        English:
            Hover only changes the background color; moving away returns to the "selected/unselected" tier
            (don't just paint it all transparent).
            """
            try:
                card.bgcolor = (with_alpha(C['hover'], panel_alpha())
                                if e.data == 'true' else _card_bg(kind, item))
                card.update()
            except Exception:                                   # noqa: BLE001
                pass

        # ── ① 小说卡：**标题 + 创建时间**，右上一个「打开文件夹」、右下一个「删除」
        # [EN] ── (1) Novel card: **title + creation time**, top-right an "open folder", bottom-right a
        # [EN] "delete"
        # 用户 2026-10-08 的要求：
        #    「在拾卷的最左侧 小说列表的每个标签上加一个文件夹，放到删除按钮的上面
        #     （删除按钮放到第2行，文件夹按钮放到第一行最右边，两者稍微有点距离）
        #     文件夹按钮点了之后打开项目文件夹」
        # 所以从"两行文字 + 右边一个删除"改成**两行，各带一个按钮**：
        #   第 1 行：书名 ………  📁（打开文件夹）
        #   第 2 行：创建时间 ……  🗑（删除）
        # 两个按钮分居两行、**各自贴右**，天然就有了一段纵向距离。
        # [EN] User's 2026-10-08 request:
        # [EN] "On the far left of Pick a Volume, add a folder to each label of the novel list, above the
        # [EN] delete button
        # [EN] (put the delete button on line 2, the folder button at the far right of line 1, with a bit of
        # [EN] distance between them)
        # [EN] Clicking the folder button opens the project folder"
        # [EN] So change from "two lines of text + one delete on the right" to **two lines, each with one
        # [EN] button**:
        # [EN] Line 1: book title ……… 📁 (open folder)
        # [EN] Line 2: creation time …… 🗑 (delete)
        # [EN] The two buttons sit on separate lines, **each hugging the right**, which naturally gives some
        # [EN] vertical distance.
        def _build_novel_card(proj: Project) -> ft.Container:
            card = ft.Container(bgcolor=C['panel'],
                                border=_card_border('proj', None), border_radius=6,
                                padding=ft.Padding(0, 0, 4, 0))
            card._proj = proj

            title = ft.Text(proj.name, size=BODY_FS, color=C['text'],
                            weight=ft.FontWeight.BOLD, no_wrap=True,
                            overflow=ft.TextOverflow.ELLIPSIS)
            created = ft.Text(t('创建 {t}', t=proj.created or '—'),
                              size=HINT_FS, color=C['gold'], no_wrap=True,
                              overflow=ft.TextOverflow.ELLIPSIS)
            folder_btn = mk_icon_btn(ft.Icons.FOLDER_OPEN_OUTLINED, danger=False,
                                     on_click=lambda e, p=proj: self._open_path(p.root),
                                     tooltip=t('打开这本小说的项目文件夹'))
            del_btn = mk_icon_btn(ft.Icons.DELETE_OUTLINE, danger=True,
                                  on_click=lambda e, p=proj: _ask_delete_project(p),
                                  tooltip=t('删除这本小说'))

            # 文字那一侧要 `expand` 才把按钮挤到最右（不给的话按钮紧跟文字）
            # [EN] The text side needs `expand` to squeeze the buttons to the far right (otherwise the button
            # [EN] follows the text tightly)
            def _line(txt: ft.Control, btn: ft.Control) -> ft.Row:
                return ft.Row(
                    [ft.Container(content=txt, expand=True,
                                  padding=ft.Padding(10, 0, 0, 0)), btn],
                    spacing=6, vertical_alignment=ft.CrossAxisAlignment.CENTER)

            body = ft.Container(
                content=ft.Column([_line(title, folder_btn),
                                   _line(created, del_btn)], spacing=6),
                expand=True, padding=ft.Padding(0, 8, 0, 8),
            )
            body.on_click = lambda e, p=proj: _load_saves(p)
            body.on_hover = lambda e, p=proj, c=card: _hover_card(e, c, 'proj', p)

            card.content = body
            return card

        # ── 装载：① 小说 → ② 存档 → ③ 内容 ──
        # [EN] ── Loading: (1) novel -> (2) save -> (3) content ──
        def _sorted_runs(proj: Project) -> list[Path]:
            """这一轮的存档清单，按**当前单选框**排好。

            用户 2026-10-10：「上面加一组单选框 可以按照推演开始时间正序 /
            开始时间倒序 / 结束时间正序 / 结束时间倒序 4 种方式排列」。

            ★ 两条纪律：

            ① **默认那一档要与旧行为对得上**。以前就是"最新的在最上面"
               （`reversed(list_runs())`，按*现实时间*）。默认给「结束时间倒序」
               （`end_desc`）—— 推演通常一轮接一轮，后跑的推得更远，
               于是观感仍是"最近的推演在最上面"。

            ② **读不到故事时间的存档，正序倒序都排在最后**。
               不许让它按"第 0 天"参与排序 —— 那会让一轮**旧存档**冒充
               "最早开始的"顶到第一位（正序时），把真正该看的那几轮挤下去。
               （这就是 `StorySpan.sort_*` 里那个 `1` 开头那一段的作用，
                 这里再按"知不知道"分成两段排，双保险。）
            
                        English:
            The save list for this run, sorted by the **current radio button**.
                        User 2026-10-10: "Add a group of radio buttons above that can arrange by simulation start time ascending /
                        start time descending / end time ascending / end time descending — 4 ways".
                        ★ Two rules:
                        ① **The default tier must match the old behavior**. Previously it was "newest on top"
                           (`reversed(list_runs())`, by *wall-clock time*). The default is "end time descending"
                           (`end_desc`) — simulations usually run one after another, and later runs advance further,
                           so the impression is still "the most recent simulation on top".
                        ② **Saves whose story time can't be read rank last in both ascending and descending order**.
                           Don't let them participate in sorting as "day 0" — that would let an **old save** masquerade as
                           "the earliest started" and jump to first place (in ascending order), pushing down the runs that actually matter.
                           (This is the role of the section starting with `1` in `StorySpan.sort_*`;
                             here it's split into two segments by "known or not" again — double insurance.)
            """
            runs = list(reversed(proj.list_runs()))       # 现实时间：新的在前
            # [EN] Real-world time: newest first
            key = sort_state['key']
            if key == 'time_desc':                        # 保留旧口径（备用档）
            # [EN] Keep the old convention (backup profile)
                return runs
            spans = {str(r): _span(r) for r in runs}
            field = 'start' if key.startswith('start') else 'end'
            rev = key.endswith('desc')

            def _k(r: Path):
                s = spans[str(r)]
                day = (s.start_day or s.end_day) if field == 'start' \
                    else (s.end_day or s.start_day)
                at = s.start_at if field == 'start' else s.end_at
                return (day, at)

            known = [r for r in runs if spans[str(r)].ok]
            unknown = [r for r in runs if not spans[str(r)].ok]
            known.sort(key=_k, reverse=rev)
            return known + unknown

        def _load_saves(proj: Project, keep: Path = None) -> None:
            shown['proj'] = proj
            for c in novel_cards:
                c.bgcolor = _card_bg('proj', getattr(c, '_proj', None))
                c.border = _card_border('proj', getattr(c, '_proj', None))

            save_cards.clear()
            shown['run'] = None
            save_list.controls = []
            runs = _sorted_runs(proj)
            if runs:
                for run_dir in runs:
                    card = _build_save_card(proj, run_dir, _span(run_dir))
                    save_cards.append(card)
                    save_list.controls.append(card)
                # 默认把**排在最前那一轮**摆出来（打开拾卷十有八九是想看
                # "上次跑到哪了"）；换排序档时把原来选中的那条**保住**，
                # 否则用户一点"开始 ↑"，右边详情就跳到了另一套内容上。
                # [EN] By default show **the run ranked first** (opening Pick a Volume is almost always to see
                # [EN] "where did I get to last time"); when switching sort profiles, **keep** the originally selected
                # [EN] one,
                # [EN] otherwise as soon as the user clicks "start ↑", the detail on the right jumps to another set of
                # [EN] content.
                pick = keep if (keep is not None and keep in runs) else runs[0]
                _show_detail(proj, pick)
            else:
                save_list.controls.append(
                    _centered(t('这本书还没跑过 —— 存档在第一次推演之后出现。')))
                _reset_detail(t('这本书还没有存档'))
            # 预载完再通知两条。
            # ⚠ 一张**小说卡**现在是"两行、各带一个 22px 的图标按钮"（约 66px），
            #   比存档卡高一点 —— 所以这里给小说栏留 96 的估高（宁可多报一点：
            #   多报最多多画一条滚动条，少报会把最后一条卡**藏在可视区外**，
            #   而用户看不出来"下面还有"）。
            # [EN] Notify the two after preloading.
            # [EN] ⚠ A **novel card** is now "two lines, each with a 22px icon button" (about 66px),
            # [EN] a bit taller than a save card — so here give the novel column an estimated height of 96 (better
            # [EN] to over-report:
            # [EN] over-reporting at most draws one extra scrollbar; under-reporting hides the last card **outside
            # [EN] the visible area**,
            # [EN] and the user can't tell there's "more below").
            novel_bar.reset(len(novel_list.controls) * 96 > SAVE_LIST_H)
            # ⚠ 2026-10-10：存档卡**又高了一行**（多了"故事时间"那一行）——
            #   估高从 90 提到 108。少报的后果同上一段：卡被藏在可视区外。
            # [EN] ⚠ 2026-10-10: the save card **got one line taller again** (an extra "story time" line) —
            # [EN] estimated height raised from 90 to 108. The consequence of under-reporting is the same as the
            # [EN] previous paragraph: the card is hidden outside the visible area.
            save_bar.reset(len(save_list.controls) * 108 > SAVE_LIST_H)
            try:
                page.update()
            except Exception:                                   # noqa: BLE001
                pass

        def _load_novels(select: Project = None) -> None:
            novel_cards.clear()
            novel_list.controls = []
            for p in projects:
                card = _build_novel_card(p)
                novel_cards.append(card)
                novel_list.controls.append(card)
            target = select or shown['proj'] or projects[0]
            _load_saves(proj_map.get(target.name, target))

        # ── 删除 ──
        # [EN] ── Delete ──
        def _ask_delete_save(proj: Project, run_dir: Path) -> None:
            n, size = folder_stats(run_dir)
            self._confirm_danger(
                t('删掉这一轮存档？'),
                [
                    ft.Text(t('存档：{name}', name=run_dir.name),
                            size=BODY_FS, color=C['text'], selectable=True),
                    ft.Text(t('路径：{path}', path=str(run_dir)),
                            size=HINT_FS, color=C['muted'], selectable=True),
                    ft.Text(t('里面有 {n} 个文件，共 {sz}',
                              n=n, sz=human_size(size)),
                            size=BODY_FS, color=C['text']),
                    ft.Text(t('备份目录：{path}',
                              path=str(trash_dir_for(projects_root))),
                            size=HINT_FS, color=C['muted'], selectable=True),
                    mk_text(t('这一轮会**移到「已删除备份」**（项目目录的旁边）—— '
                              '反悔了可以手工搬回来。同一本书的其他轮次不受影响。'),
                            size=HINT_FS, color=C['seal']),
                ],
                lambda: _do_delete_save(proj, run_dir))

        def _do_delete_save(proj: Project, run_dir: Path) -> None:
            # ★★ 先放开**这一轮占着的文件句柄**（2026-10-07，用户报
            #   「最后一个存档无法删除」）。
            # [EN] ★★ First release **the file handle held by this run** (2026-10-07, user reported
            # [EN] "the last save cannot be deleted").
            #   推演用的 sqlite 就在运行文件夹里（`<运行文件夹>/state.db`），
            #   而 `RunLoop` 拿着那个连接一直到进程结束都不关。Windows 上
            #   只要有句柄开着，**整个目录的改名就会失败** ——
            #   `shutil.move` 于是回退成「复制 + 删除」，复制进了备份、
            #   删除卡在 `state.db` 上：用户看到的就是"点了几次都删不掉"，
            #   备份目录里还攒下一堆半成品。
            # [EN] The sqlite used by the run is right in the run folder (`<run folder>/state.db`),
            # [EN] and `RunLoop` holds that connection open until the process ends. On Windows,
            # [EN] as long as any handle is open, **renaming the whole directory will fail** —
            # [EN] `shutil.move` then falls back to "copy + delete", the copy goes into the backup,
            # [EN] and the delete gets stuck on `state.db`: what the user sees is "clicked several times and it
            # [EN] won't delete",
            # [EN] and a pile of half-finished artifacts accumulates in the backup directory.
            why = self._release_run_files(run_dir)
            if why:
                self._post_message(t('没能删掉：{why}', why=why), 'error', snack=True)
                return
            ok, msg = archive_run_dir(run_dir, proj.root, projects_root)
            if ok:
                self._post_message(t('已把存档「{name}」移到已删除备份：{path}',
                                     name=run_dir.name, path=msg), level='ok')
                _load_saves(proj)
                # 删的正是当前项目里最后一轮 → 开始界面那句「回到推演界面」
                # 现在说的已经不是实话了（`_refresh_start_screen` 只在开始
                # 界面正显示着时才真做事，在别处调是安全的）。
                # [EN] If what's deleted is exactly the last run in the current project -> the start screen's line
                # [EN] "return to the run screen"
                # [EN] is no longer telling the truth (`_refresh_start_screen` only actually does work
                # [EN] when the start screen is currently shown; calling it elsewhere is safe).
                if not proj.list_runs():
                    self._refresh_start_screen()
            else:
                self._post_message(t('没能删掉：{why}', why=msg), 'error', snack=True)

        def _ask_delete_project(proj: Project) -> None:
            n, size = folder_stats(proj.root)
            runs = proj.list_runs()
            self._confirm_danger(
                t('删掉整本小说？'),
                [
                    ft.Text(t('小说：{name}', name=proj.name),
                            size=BODY_FS, color=C['text'], selectable=True),
                    ft.Text(t('路径：{path}', path=str(proj.root)),
                            size=HINT_FS, color=C['muted'], selectable=True),
                    ft.Text(t('设定集、肖像、全部 {n} 轮存档一起删，'
                              '共 {c} 个文件 / {sz}',
                              n=len(runs), c=n, sz=human_size(size)),
                            size=BODY_FS, color=C['text']),
                    mk_text(t('会**移到「已删除备份」**（项目目录的旁边）—— '
                              '反悔了可以手工搬回来。'),
                            size=HINT_FS, color=C['seal']),
                    mk_text(t('要删的是整整一本书（含全部轮次与设定），'
                              '所以还要**手打一次书名**才让点确认。'),
                            size=HINT_FS, color=C['gold']),
                ],
                lambda: _do_delete_project(proj),
                confirm_word=proj.name)

        def _do_delete_project(proj: Project) -> None:
            # 整本删也要先放开句柄 —— 与删单轮同一个道理：这一轮如果正是
            # 当前项目最近跑的那一轮，它的 `state.db` 就在这本书里面。
            # [EN] Deleting an entire book must also release the handle first — same reasoning as deleting a single
            # [EN] run: if this run happens to be
            # [EN] the most recently run one of the current project, its `state.db` is inside this book.
            for r in proj.list_runs():
                why = self._release_run_files(r)
                if why:
                    self._post_message(t('没能删掉：{why}', why=why), 'error',
                                       snack=True)
                    return
            ok, msg = archive_project_dir(proj.root, projects_root)
            if not ok:
                self._post_message(t('没能删掉：{why}', why=msg), 'error', snack=True)
                return
            # 回执定 `ok` 级 —— 删东西是**不可逆动作的收尾**，得留在状态栏里
            # （写清搬到哪个备份目录，人回头想捞才捞得着）。同理见下一个函数。
            # [EN] The receipt is set to `ok` level — deleting things is **the wrap-up of an irreversible action**,
            # [EN] it must stay in the status bar
            # [EN] (state clearly which backup directory it was moved to, so people can retrieve it later if they
            # [EN] want). Same reasoning, see the next function.
            self._post_message(t('已把《{name}》移到已删除备份：{path}',
                                 name=proj.name, path=msg), level='ok')
            # 删掉的正好是当前这本 → 清掉引用，别让运行界面指着已经不存在的目录
            # [EN] If what's deleted is exactly the current book -> clear the reference, don't let the run screen
            # [EN] point at a directory that no longer exists
            cur = self.current_project
            was_current = cur is not None and cur.root == proj.root
            if was_current:
                self.current_project = None
                if getattr(self, '_view', '') == 'main':
                    page.pop_dialog()
                    self.show_start_screen()
                    return
            remaining = scan_projects(projects_root)
            proj_map.clear()
            proj_map.update({p.name: p for p in remaining})
            projects[:] = remaining
            # ★ 只要开始界面正显示着，就无条件重画一遍（2026-10-07）——
            #   以前只在"删掉的正好是当前这本"或"删光了"时才重画，于是
            #   **删掉一本不是当前的小说**时，那块界面还是删之前建的：
            #   小字里的本数不变（用户报的正是这个）。菜单的可用性是构建时
            #   算好的，盘面一变就得重建 —— 与其逐条猜"这次要不要重建"，
            #   不如每次都问一遍（`_refresh_start_screen` 在别的界面上是空操作）。
            # [EN] ★ As long as the start screen is currently shown, unconditionally redraw it once (2026-10-07) —
            # [EN] previously it only redrew when "the deleted one was exactly the current book" or "everything was
            # [EN] deleted", so
            # [EN] **when deleting a novel that isn't the current one**, that screen was still the one built before
            # [EN] the delete:
            # [EN] the count in the small text didn't change (this is exactly what the user reported). Menu
            # [EN] availability was
            # [EN] computed at build time, and must be rebuilt whenever the disk state changes — rather than
            # [EN] guessing item by item "should this be rebuilt",
            # [EN] Better to ask every time (`_refresh_start_screen` is a no-op on other screens).
            self._refresh_start_screen()
            if not remaining:
                page.pop_dialog()
                self._post_message(
                    t('已删除最后一本小说 —— 开始界面里「拾卷」「书斋」「回卷」'
                      '已随之置灰。备份在：{path}',
                      path=str(trash_dir_for(projects_root))), level='warn')
                return
            # 还剩别的书 → 把选中项清掉，就地刷新三栏（不用重开对话框）。
            # 删掉的若是「当前那本」，「书斋 / 回卷」跟着 `current_project` 走
            # —— 那半边已经在上面那次无条件重画里处理过了。
            # 对话框在另一层（`page._dialogs`），重画页面不会把它关掉。
            # [EN] Other books remain -> clear the selection and refresh the three columns in place (no need to
            # [EN] reopen the dialog).
            # [EN] If the deleted one was "the current book", "书斋 / 回卷" follows `current_project`
            # [EN] -- that half was already handled by the unconditional redraw above.
            # [EN] The dialog is on another layer (`page._dialogs`); redrawing the page won't close it.
            shown['proj'] = None
            _load_novels(remaining[0])

        # ── 底部按钮 ──
        # [EN] -- bottom buttons --
        def _open_selected():
            proj = shown['proj']
            if proj is None:
                self._show_snack(t('先在左边选一本小说。'))
                return
            self._activate_project(proj)
            page.pop_dialog()
            self.show_main_screen()

        # ── ② 存档栏的**排序单选框**（2026-10-10）──
        # [EN] -- ② the **sort radio group** in the save column (2026-10-10) --
        # 用户原话：「上面加一组单选框 可以按照推演开始时间正序 / 开始时间倒序 /
        # 结束时间正序 / 结束时间倒序 4 种方式排列（单选框的标签里文字可以包含
        # 字少一些 能够看懂就行，还可以鼠标放上去有 tip 提示）」。
        # [EN] User's exact words: "Add a radio group on top, can sort by simulation start time ascending /
        # [EN] start time descending /
        # [EN] end time ascending / end time descending, 4 ways (the label text can contain
        # [EN] fewer characters, just enough to understand, and hovering the mouse can have a tip)".
        # ★ 标签刻意短（「开始 ↑」），完整意思放进 tip：
        #   这一栏只有 300px 宽，四个"正序/倒序"字样会把一行撑爆 ——
        #   而撑爆的后果在本项目里见过太多次：**控件被裁掉，且不报错**。
        #   短标签 + 悬停解释，比"写全但看不见"好。
        # [EN] ★ Labels are deliberately short ("Start ↑"); the full meaning goes in the tip:
        # [EN] This column is only 300px wide; four "ascending/descending" labels would blow out a single line
        # [EN] --
        # [EN] and the consequence of blowing out has been seen too many times in this project: **controls get
        # [EN] clipped, with no error reported**.
        # [EN] Short labels + hover explanation beats "written out in full but invisible".
        SORT_META = [
            ('start_asc', t('开始 ↑'), t('按**故事里**的开始时间，早的在前')),
            ('start_desc', t('开始 ↓'), t('按**故事里**的开始时间，晚的在前')),
            ('end_asc', t('结束 ↑'), t('按**故事里**的结束时间，早的在前')),
            ('end_desc', t('结束 ↓'),
             t('按**故事里**的结束时间，晚的在前 —— 推得最远的那一轮在最上面')),
        ]

        def _apply_sort(key: str) -> None:
            if not key or key == sort_state['key']:
                return
            sort_state['key'] = key
            proj = shown['proj']
            if proj is not None:
                # 换了排序档，**把原来选中的那一条保住**（`keep`）：
                # 否则一点"开始 ↑"，右边详情就跳到另一条上，像丢了自己在看的东西。
                # [EN] When switching sort mode, **keep the originally selected item** (`keep`):
                # [EN] otherwise the moment you click "Start ↑", the details on the right jump to another item, as if
                # [EN] you lost what you were looking at.
                _load_saves(proj, keep=shown['run'])

        def _radio_row(meta: list) -> ft.Row:
            return ft.Row([
                ft.Radio(value=v, label=lab, tooltip=tip, scale=0.82,
                         active_color=C['border_gold'],
                         label_style=ft.TextStyle(size=HINT_FS, color=C['text']))
                for v, lab, tip in meta
            ], spacing=0, vertical_alignment=ft.CrossAxisAlignment.CENTER)

        sort_radio = ft.RadioGroup(
            value=sort_state['key'],
            content=ft.Column([_radio_row(SORT_META[:2]),
                               _radio_row(SORT_META[2:])], spacing=0),
            on_change=lambda e: _apply_sort(e.control.value),
        )
        sort_box = ft.Column([
            ft.Row([
                ft.Text(t('排序'), size=HINT_FS, color=C['gold'],
                        weight=ft.FontWeight.BOLD),
                mk_tip(t('按**故事里的时间**排 —— 不是按「你什么时候点的起笔」'
                         '（那个是下面卡片上的「存档时间」）。\n'
                         '悬停每个选项，会说明它具体拿哪个时间排。')),
                ft.Container(expand=True),
            ], spacing=4, vertical_alignment=ft.CrossAxisAlignment.CENTER),
            sort_radio,
        ], spacing=0)

        content = ft.Column([
            ft.Row([
                _column(t('① 小说'),
                        t('点一本，中间那栏就换成它的存档。'),
                        novel_bar, width=NOVEL_COL_W),
                _column(t('② 存档'),
                        t('这本书跑过的每一轮。点一条看右边。'),
                        save_bar, width=SAVE_COL_W, extra=sort_box),
                detail_panel,
            ], spacing=8, expand=True,
                vertical_alignment=ft.CrossAxisAlignment.STRETCH),
        ], spacing=8)

        dlg = mk_dialog(
            t("拾 卷 · 存 档 列 表"),
            ft.Container(content=content, width=SAVE_DLG_W, height=SAVE_DLG_H),
            [
                mk_btn(t("打开选中项目"), on_click=lambda e: _open_selected(),
                       primary=True),
                mk_btn(t("关闭"), on_click=lambda e: page.pop_dialog(), primary=False),
            ],
        )

        page.show_dialog(dlg)
        _load_novels(projects[0])
        return dlg

    # ══════════════════════════════════════════════════════════
    #  剧组 Agents 设置（2026-10-11）
    # [EN] Crew Agents settings (2026-10-11)
    # ══════════════════════════════════════════════════════════
    # 用户原话：「在天问(全局设置)加一个 Tab，专门用于 Agents 设置……
    #   样式应该是一个列表，简单介绍 Agent 名字，作用，目前提示词简略介绍。
    #   点击名字可以打开 Agent 属性编辑对话框…… 支持分页，默认分页大小 5，
    #   支持调整大小。在项目设置里有一个同样的设置 tab，功能基本一样，
    #   唯一区别不允许新建和删除。」
    # [EN] User's exact words: "Add a Tab to 天问 (global settings), dedicated to Agents settings...
    # [EN] The style should be a list, briefly introducing the Agent name, its role, and a brief
    # [EN] introduction of the current prompt.
    # [EN] Clicking the name can open the Agent property edit dialog... support pagination, default page
    # [EN] size 5,
    # [EN] support resizing. There's an identical settings tab in project settings, with basically the same
    # [EN] functionality,
    # [EN] the only difference being that creating and deleting are not allowed."
    # 两处**共用这一套**（`project=None` = 天机/软件层；给了 project = 书斋/项目层）：
    # 两套各写一份的话，"取消 → 保存"这类交互必然在两处慢慢长歪。
    # [EN] Both places **share this one set** (`project=None` = 天机/software layer; with project =
    # [EN] 书斋/project layer):
    # [EN] If written separately as two sets, interactions like "Cancel -> Save" will inevitably drift
    # [EN] apart in the two places over time.

    def _agents_tab(self, *, project=None, allow_new: bool,
                    open_agent: str | None = None) -> list:
        """「剧组 Agents」页签的内容（返回控件列表，交给 `mk_tab_content`）。

        ★★ `open_agent`（2026-10-11 加）：给了就**先翻到那一页、再把那个职位的
          编辑框叠上去**。运行页「剧组」面板点某一行走的就是这条路 ——
          用户要的是"点某一个 Agent 则**直接进入**项目的 Agent 设置"，
          而不是"先进列表、再自己找到那一行点开"。

        ⚠ 顺序不能反：必须先 `refresh()`（列表铺好、`state['page']` 定位到
          那一页）**再**开编辑框。反过来的话编辑框一关，列表还停在第一页，
          用户看到的是"刚改的那个职位不见了"。
        ⚠ 找不到那个 key 就**什么都不做**（列表照常显示）——
          比弹一个"找不到 xxx"更少打扰，而且这种情况本来就只可能是
          职位被删了（那时列表里也确实没有它）。

            English:
        The content of the "Crew Agents" tab (returns the widget list, handed to `mk_tab_content`).

        ★★ `open_agent` (added 2026-10-11): when provided, **first flip to that page and then stack that
          position's editor on top**. This is the path taken by clicking a row in the run page's "Cast"
          panel -- the user wants "clicking one Agent goes **directly** into the project's Agent settings",
          not "open the list, then find that row and click it yourself".

        ⚠ The order must not be reversed: `refresh()` must come first (list laid out, `state['page']`
          positioned on that page) **before** opening the editor. Otherwise, once the editor closes, the list
          is still on page one and the user sees "the position I just edited is gone".
        ⚠ If that key isn't found, **do nothing** (the list shows as usual) -- less intrusive than popping a
          "cannot find xxx", and this case can only really happen when the position was deleted (in which
          case it genuinely isn't in the list).
        """
        from crew import catalog as CAT
        # 打开这一页时**顺手把软件目录播种/补齐**：作者看到「文件目录：…\agents」
        # 之后第一件事就是去资源管理器里找它 —— 目录不存在会让人以为"没生效"。
        # 幂等（已存在就不写），所以每次打开都调也无所谓。
        # [EN] When opening this page, **conveniently seed/fill in the software directory**: the author sees
        # [EN] "File directory: ...\agents"
        # [EN] and the first thing afterward is to go find it in the file explorer -- if the directory doesn't
        # [EN] exist, people think it "didn't take effect".
        # [EN] Idempotent (don't write if it already exists), so calling it every time the page opens doesn't
        # [EN] matter.
        if project is None:
            try:
                CAT.ensure_ready()
            except Exception as e:                               # noqa: BLE001
                log_exception(t('初始化 Agent 目录失败：{e}', e=f'{e!r}'),
                              category='ui')
        state = {'page': 0, 'size': AGENT_PAGE_DEFAULT}
        body = ft.Column([], spacing=6)
        head_line = ft.Text('', size=HINT_FS, color=C['muted'])
        pager = ft.Row([], spacing=8)

        def _specs() -> list:
            try:
                return CAT.effective(project=(None if project is None else project))
            except Exception as e:                               # noqa: BLE001
                log_exception(t('读 Agent 设置失败：{e}', e=f'{e!r}'), category='ui')
                return []

        def refresh() -> None:
            specs = _specs()
            n = len(specs)
            size = max(1, int(state['size']))
            pages = max(1, (n + size - 1) // size)
            state['page'] = min(max(0, int(state['page'])), pages - 1)
            lo = state['page'] * size
            page_specs = specs[lo:lo + size]
            body.controls = (
                [self._agent_row(
                    s, project=project, allow_new=allow_new, on_done=refresh,
                    # ★ 只有**演员**有角色设置（它在系统层没有具体角色，
                    #   在项目层才有 —— 见 `_casting_dialog`）。
                    #   ⚠ 只在**项目页签**给（`project is not None`）：
                    #     天机里没有"这本书"可谈，给了就是假按钮。
                    # [EN] ★ Only **actors** have role settings (it has no concrete role at the system layer,
                    # [EN] only at the project layer -- see `_casting_dialog`).
                    # [EN] ⚠ Only provide it on the **project tab** (`project is not None`):
                    # [EN] In 天机 there is no "this book" to speak of; providing it would be a fake button.
                    on_casting=(_casting_open(project)
                                if (project is not None and s.key == 'actor')
                                else None))
                 for s in page_specs]
                or [mk_hint(t('（这里还没有职位）'))])
            head_line.value = t('共 {n} 个职位 · 第 {p}/{m} 页',
                                n=n, p=state['page'] + 1, m=pages)
            pager.controls = self._agent_pager(state, pages, refresh)
            try:
                self.page.update()
            except Exception:                                    # noqa: BLE001
                pass

        def _new(e=None) -> None:
            self._agent_editor(None, project=project, allow_new=True,
                               on_done=refresh)

        def _casting_open(pr):
            """给演员那一行造一个"打开角色设置"的**无参可调用**。

            ⚠ **别写成 `lambda pr=project: (lambda: self._casting_dialog(pr))`**
              —— 那种双层 lambda 交给 `mk_icon_btn(on_click=lambda e: on_casting())`
              时，`on_casting()` 只是**返回了内层函数**、根本没有调用它：
              表现是"点那个按钮一点反应都没有"（不报错、也不弹窗）。
              判据 D2c 就是被这件事钉住的。这里用一个具名函数，一眼能看出它的作用。
            
                        English:
            Build a **no-arg callable** that "opens the character settings" for that actor row.
                        ⚠ **Don't write `lambda pr=project: (lambda: self._casting_dialog(pr))`**
                          — when that kind of double lambda is passed to `mk_icon_btn(on_click=lambda e: on_casting())`,
                          `on_casting()` merely **returns the inner function** and never calls it:
                          the symptom is "clicking that button does nothing at all" (no error, no dialog).
                          Criterion D2c is pinned down by this very issue. Use a named function here so its purpose is obvious at a glance.
            """
            def _open() -> None:
                self._casting_dialog(pr)
            return _open

        top: list = [head_line]
        if allow_new:
            top.append(ft.Row(
                [mk_btn(t('＋ 新建职位'), on_click=_new, height=SET_H),
                 # ★★ 「演员类型库」（2026-10-11）—— 系统层给**演员**的第二个入口。
                 #   用户问的"演员在系统层怎么设置"：**两个入口**
                 #     ① 演员那一行（职位提示词：这个工种怎么干活）
                 #     ② 这个按钮（类型库：预写好的各种演员**怎么说话**）
                 # [EN] ★★ "Actor type library" (2026-10-11) -- the second entry point for **actors** at the system
                 # [EN] layer.
                 # [EN] What the user asked, "how do actors get configured at the system layer": **two entry points**
                 # [EN] ① The actor row (position prompt: how this job type does its work)
                 # [EN] ② This button (type library: how the various pre-written actors **speak**)
                 mk_btn(t('演员类型库'), on_click=lambda e: self._actor_types_dialog(),
                        height=SET_H, primary=False),
                 ft.Text(t('自建职位在**每天收工**时出工一次，产物落在那一轮的运行文件夹里'),
                         size=HINT_FS, color=C['muted'], expand=True)],
                spacing=8))
            top.append(mk_hint(t(
                '⚠ **具体角色不要写在这里**：这里每一份是**全组通读**的，写进来'
                '每个角色都会读到别人的设定。演员的**具体角色**在「项目 · 剧组 Agents」'
                '→「角色设置」里（一人一份）。')))
        else:
            top.append(mk_hint(t(
                '这里是**这一本书**的定制：只覆盖你改过的那几项，'
                '其余跟「天机 · 剧组 Agents」里的软件默认走。'
                '新建与删除只在软件层做 —— 那是"这个软件有哪些职位"的事。')))
            top.append(mk_hint(t(
                '⚠ 演员那一行右边还有一个**「角色设置」**（👥）：'
                '那里定**每个具体角色**演成什么样（一人一份）；'
                '这一份 md 只管**演员这个工种**（全组通读，别写具体角色）。')))
        # 目录位置写出来：作者要能自己用记事本打开 `agents/xxx.md` 改（两处是同一份文件）
        # [EN] Write out the directory location: the author should be able to open `agents/xxx.md` in Notepad
        # [EN] and edit it themselves (both places are the same file)
        try:
            where = (CAT.proj_dir(project) if project is not None else CAT.soft_dir())
            top.append(ft.Text(t('文件目录：{p}', p=str(where)),
                               size=HINT_FS, color=C['muted'], no_wrap=True,
                               overflow=ft.TextOverflow.ELLIPSIS))
        except Exception:                                        # noqa: BLE001
            pass
        refresh()
        # ★★ 定位到指定职位并直接开它的编辑框（2026-10-11，见 `open_agent` 的说明）。
        # [EN] ★★ Position to the given role and open its editor directly (2026-10-11, see `open_agent`).
        if open_agent:
            specs = _specs()
            idx = next((i for i, s in enumerate(specs)
                        if str(getattr(s, 'key', '')) == str(open_agent)), None)
            if idx is not None:
                size = max(1, int(state['size']))
                state['page'] = idx // size
                # 先铺好列表（顺序不能反 —— 见 `open_agent` 那段说明）
                # [EN] Lay out the list first (the order cannot be reversed -- see the note at `open_agent`)
                refresh()
                self._agent_editor(specs[idx], project=project,
                                   allow_new=allow_new, on_done=refresh)
        return [*top, body, pager]

    def _agent_pager(self, state: dict, pages: int, refresh) -> list:
        """分页控件：上一页 / 页码 / 下一页 / 每页几条（用户点名"支持调整大小"）。
                English:
        Pagination widget: prev page / page number / next page / items per page (the user explicitly
        asked for "support resizing").
        """
        def _go(delta: int):
            def _f(e=None) -> None:
                state['page'] = max(0, min(pages - 1, int(state['page']) + delta))
                refresh()
            return _f

        def _size_changed(e=None) -> None:
            try:
                state['size'] = int(field_value(size_dd) or AGENT_PAGE_DEFAULT)
            except Exception:                                    # noqa: BLE001
                state['size'] = AGENT_PAGE_DEFAULT
            state['page'] = 0
            refresh()

        # ★★ 「每页几条」这个下拉（2026-10-11 用户报「默认只能看到"每"」）：
        #   · **标签**从空串改成 `t('每页')` —— 空标签并不会省掉左边那 88px
        #     （`_label_box` 仍按 `LABEL_GUTTER_MIN` 留位，为的是让输入框起点对齐），
        #     所以那 88px 本来就花掉了，不如让它承担"这是干什么的"；
        #   · **选项只写数字**（用户原话：「就直接写个 4 也行 **不要用汉字**」）——
        #     下拉本体只剩 44px，写"每页 5 条"必然被省略。
        # [EN] ★★ The "items per page" dropdown (user report 2026-10-11: "it only shows '每'"):
        # [EN] · the **label** changed from an empty string to `t('每页')` -- an empty label does not save
        # [EN] that 88px on the left (`_label_box` still reserves `LABEL_GUTTER_MIN` so input fields line
        # [EN] up), so the space was spent anyway; better to let it say what the control is;
        # [EN] · **options are bare numbers** (the user's exact words: "just write a 4, that's fine, **do
        # [EN] not use Chinese characters**") -- the dropdown body only has 44px, so "每页 5 条" would
        # [EN] necessarily be ellipsized.
        size_dd = mk_dropdown(
            # `key` 是存盘值、`text` 是"这项该显示什么"的可读记录 ——
            # 按 `_norm_options` 的约定**两个都写**（它俩在这里正好相同）。
            # [EN] `key` is the stored value and `text` is the readable record of "what this item should
            # [EN] display" -- write **both**, per `_norm_options`' convention (they happen to be equal).
            t('每页'), [ft.dropdown.Option(key=str(v), text=str(v))
                        for v in AGENT_PAGE_CHOICES],
            str(state['size']), width=SET_W_PAGER_DD)
        size_dd._field.on_change = _size_changed
        prev = mk_btn(t('上一页'), on_click=_go(-1), primary=False,
                      height=SET_H, width=SET_W_PAGER_BTN)
        nxt = mk_btn(t('下一页'), on_click=_go(1), primary=False,
                     height=SET_H, width=SET_W_PAGER_BTN)
        prev.disabled = int(state['page']) <= 0
        nxt.disabled = int(state['page']) >= pages - 1
        return [prev,
                ft.Text(t('第 {p}/{m} 页', p=int(state['page']) + 1, m=pages),
                        size=HINT_FS, color=C['muted']),
                nxt, size_dd]

    def _agent_row(self, spec, *, project, allow_new: bool, on_done,
                   on_casting=None) -> ft.Control:
        """列表里的一行：名字 · 标记 · 作用 · 提示词简略。点它开编辑对话框。

        `on_casting` 给了就多一个「角色设置」按钮 —— **只有演员**需要
        （见 `_casting_dialog`：演员是"系统层没有具体角色、项目层才有"的那一位）。
        
                English:
        A row in the list: name · tag · role · prompt summary. Click it to open the edit dialog.
                If `on_casting` is provided, add a "Role Settings" button -- **only actors** need it
                (see `_casting_dialog`: the actor is the one that "has no specific role at the system layer, only at the project layer").
        """
        tags: list = []
        tags.append(ft.Container(
            content=ft.Text(t('自建') if spec.is_custom else t('软件自带'),
                            size=SZ(11), color=C['gold'] if spec.is_custom else C['muted']),
            bgcolor=with_alpha(C['border_gold'], 0.16),
            border=make_border(1, C['border_gold']), border_radius=3,
            padding=ft.Padding(5, 1, 5, 1)))
        if spec.overridden:
            tags.append(ft.Container(
                content=ft.Text(t('本项目已定制'), size=SZ(11), color=C['seal']),
                bgcolor=with_alpha(DANGER, 0.12),
                border=make_border(1, DANGER), border_radius=3,
                padding=ft.Padding(5, 1, 5, 1)))
        #  ⚠ 用 `plain_prompt`（**剥过注释**的正文）：`spec.prompt` 是盘上那份
        #    原样，开头是给作者看的 `<!-- … -->` 说明 —— 直接截前 52 字
        #    会让这一栏显示"这是本职位在软件层的设置…"，而不是提示词本身。
        # [EN] ⚠ Use `plain_prompt` (**with comments stripped**): `spec.prompt` is the one on disk
        # [EN] as-is, starting with a `<!-- ... -->` note for the author -- directly truncating the first 52
        # [EN] chars
        # [EN] would make this column show "this is this position's setting at the software layer..." instead
        # [EN] of the prompt itself.
        try:
            from crew import catalog as _CAT
            _p = _CAT.plain_prompt(spec.prompt or '')
        except Exception:                                        # noqa: BLE001
            _p = str(spec.prompt or '')
        brief = ' '.join(_p.split())
        brief = (brief[:52] + '…') if len(brief) > 52 else (brief or t('（还没写系统提示词）'))
        # ⚠ 名字与简介要过 `t()`：内置职位的名字/职责在 i18n 里有英文，
        #   直接摆中文的话英文界面下这一栏全是中文（作者自建的那些
        #   翻不出来 —— `t()` 找不到就原样返回，那本来就是他写的字）。
        # [EN] ⚠ Names and descriptions must go through `t()`: built-in positions' names/duties have English in
        # [EN] i18n,
        # [EN] if you just put Chinese there, this column is all Chinese under an English UI (for those the
        # [EN] author built themselves,
        # [EN] there's no translation anyway -- when `t()` can't find it, it returns it as-is, which is what he
        # [EN] wrote).
        head = ft.Row([ft.Text(t(spec.name), size=BODY_FS,
                               weight=ft.FontWeight.BOLD, color=C['text']),
                       *tags], spacing=6)

        def _open(e=None) -> None:
            self._agent_editor(spec, project=project, allow_new=allow_new,
                               on_done=on_done)

        extra: list = []
        if on_casting is not None:
            # ★★ 「角色设置」（2026-10-11）——**只给演员**。
            #   用户问的："演员Agent在系统层面是没有具体角色的，但是在项目层面
            #   是有具体角色的，在系统全局设置里怎么设置、在项目级别怎么设置"。
            #   答案分成两处入口：**这一份 md = 演员这个工种**（全组通读），
            #   **角色 = 一人一份**（这个按钮）。
            # [EN] ★★ "Role settings" (2026-10-11) -- **only for actors**.
            # [EN] What the user asked: "Actor Agents have no concrete role at the system level, but at the project
            # [EN] level
            # [EN] they do have a concrete role; how do you configure it in system global settings and at the
            # [EN] project level".
            # [EN] The answer splits into two entry points: **this md = the actor job type** (read by the whole
            # [EN] crew),
            # [EN] **role = one per person** (this button).
            extra.append(mk_icon_btn(
                ft.Icons.GROUPS_OUTLINED, on_click=lambda e: on_casting(),
                tooltip=t('角色设置 —— 这本书里**每个角色**演成什么样（一人一份）')))
        if allow_new and spec.is_custom:
            extra.append(mk_icon_btn(
                ft.Icons.DELETE_OUTLINE, on_click=lambda e: self._agent_delete(
                    spec, on_done=on_done),
                tooltip=t('删除这个自建职位')))
        elif project is not None and spec.overridden:
            extra.append(mk_icon_btn(
                ft.Icons.SETTINGS_BACKUP_RESTORE,
                on_click=lambda e: self._agent_reset_project(spec, on_done=on_done),
                danger=False, tooltip=t('恢复软件默认（只影响这一本书）')))
        return ft.Container(
            content=ft.Row([
                ft.Column([head,
                           ft.Text(t(spec.intro or ''), size=HINT_FS,
                                   color=C['muted']),
                           ft.Text(brief, size=HINT_FS, color=C['muted'])],
                          spacing=2, expand=True),
                *extra,
            ], spacing=8),
            # ★★ **行宽必须写死 `SET_W`**（2026-10-11 用户报："书斋→剧组Agents
            #   右边的滚动条跟 Agents 列表重合盖住了"）。
            #   这一行里的 `Column` 是 `expand=True` ⇒ 整行会**吃掉父列的全部宽度**，
            #   而父列宽 = `SET_W + TAB_GUTTER`（544，`mk_tab_content` 的构造），
            #   于是右端一路钻到那条 24px 车道里（探针实测：书斋重叠 **9px**、
            #   天机重叠 **13px**）。
            #   ⚠ 不给宽度的写法**在源码上完全看不出来** —— 它长得跟别的行一样。
            #   判据 `verify_agent_catalog` 的 D7 用像素量着钉住它。
            # [EN] ★★ **The row width must be hard-coded to `SET_W`** (user report 2026-10-11:
            # [EN] "the scrollbar to the right of Study -> Crew Agents overlaps and covers the Agents
            # [EN] list").
            # [EN] The `Column` inside this row is `expand=True` ⇒ the whole row **eats the parent
            # [EN] column's entire width**, and the parent column is `SET_W + TAB_GUTTER` (544, built by
            # [EN] `mk_tab_content`), so its right end runs all the way into that 24px lane (probe
            # [EN] measured: Study overlaps by **9px**, Tianji by **13px**).
            # [EN] ⚠ The width-less form **is completely invisible in the source** -- it looks just like
            # [EN] any other row. Criterion D7 of `verify_agent_catalog` pins it down by measuring pixels.
            width=SET_W,
            bgcolor=C['input_bg'], border=make_border(1, C['border']),
            border_radius=4, padding=ft.Padding(10, 6, 8, 6),
            on_click=_open, ink=False)

    # ══════════════════════════════════════════════════════════
    #  ★★ 演员的两层设置（2026-10-11）
    # [EN] ★★ Two layers of actor settings (2026-10-11)
    # ══════════════════════════════════════════════════════════
    # 用户原话：
    #   「演员Agent在系统层面是没有具体角色的 但是在项目层面是有具体角色的
    #     演员Agent在系统全局设置（天机）中如何设置和在项目级别如何设置
    #     你要仔细思考下怎么配置」
    # [EN] User's exact words:
    # [EN] "Actor Agents have no concrete role at the system level, but at the project level they do have a
    # [EN] concrete role
    # [EN] how do you configure Actor Agents in system global settings (天机) and at the project level
    # [EN] think carefully about how to configure it"
    # 按"换什么它才变"分四层（`actors/casting.py` 模块头那张表是权威说法）：
    #   ① 系统·职位    `agents/actor.md`                ← 天机·剧组 Agents 的这一行
    #   ② 系统·类型库  `actors/archetypes.yaml`          ← 下面 `_actor_types_dialog`
    #   ③ 项目·剧组    `<项目>/agents/actor.md`          ← 项目·剧组 Agents 的同名文件
    #   ④ 项目·角色    `<项目>/设定集/人物.yaml`         ← 下面 `_casting_dialog`
    # [EN] Divided into four layers by "what changes it": (the table at the top of the `actors/casting.py`
    # [EN] module is the authoritative statement):
    # [EN] ① System · Position    `agents/actor.md`                <- this row of 天机 · Crew Agents
    # [EN] ② System · Type library  `actors/archetypes.yaml`          <- `_actor_types_dialog` below
    # [EN] ③ Project · Crew `<project>/agents/actor.md` <- the same-named file of Project · Crew Agents
    # ⚠ ④ **绝不能进 ①②③ 任何一份 md**：一份 md 是全组通读的，
    #   写进去等于让每个角色读到别人的设定（串台）。所以它有自己的入口。
    # [EN] ⚠ ④ **must never go into any md of ①②③**: one md is read by the whole crew,
    # [EN] writing it in means every role reads someone else's settings (cross-contamination). So it has
    # [EN] its own entry point.
    def _actor_types_dialog(self) -> None:
        """**演员类型库**（系统层）：预写好的各种演员"怎么演"。

        ★ 这是用户 2026-10-07 那句"先提前写好各种演员的 Agent，比如年轻男演员、
          女演员、小孩、老人、甜美型、高冷型等等"的落点 —— 它一直存在
          （`actors/archetypes.yaml`），但**界面上从来没有入口**（只能文本编辑器改）。
          这一窗把它摆出来：能看有哪些型、每型怎么说话，也能改、能新建。
        ⚠ 与角色无关：换一本书，这些型还是这些型。
        
                English:
        **Actor type library** (system layer): pre-written "how to act" for various actors.
                ★ This is the landing spot for the user's 2026-10-07 remark "write in advance various actor Agents, such as young male actor,
                  actress, child, elderly, sweet type, aloof type, etc." -- it has always existed
                  (`actors/archetypes.yaml`), but **there was never an entry point in the UI** (only editable via a text editor).
                  This window puts it out in the open: you can see which types exist, how each type speaks, and also edit and create new ones.
                ⚠ Unrelated to roles: switch to another book, and these types are still these types.
        """
        from actors import casting as CASTING
        page = self.page
        names = CASTING.type_names()
        rows: list = []

        def _open(name: str, create: bool = False) -> None:
            self._actor_type_editor(name, create=create, on_done=refresh)

        def _row(name: str) -> ft.Control:
            e = CASTING.entry(name)
            sk = ' '.join(str(e.get('骨架') or '').split())
            nv = len(CASTING.variants(name))
            return ft.Container(
                content=ft.Row([
                    ft.Column([
                        ft.Text(name, size=BODY_FS, weight=ft.FontWeight.BOLD,
                                color=C['text']),
                        ft.Text((sk[:60] + '…') if len(sk) > 60 else (sk or '（还没写）'),
                                size=HINT_FS, color=C['muted']),
                        ft.Text(t('变奏 {n} 条（同型多人的分流轴）', n=nv),
                                size=HINT_FS,
                                color=C['muted'] if nv >= 3 else DANGER),
                    ], spacing=2, expand=True),
                    mk_icon_btn(ft.Icons.EDIT_OUTLINED,
                                on_click=lambda e2, _n=name: _open(_n),
                                tooltip=t('改这一型')),
                ], spacing=8),
                bgcolor=C['input_bg'], border=make_border(1, C['border']),
                border_radius=4, padding=ft.Padding(10, 6, 8, 6),
                # ★ **整行**可点（不只那个小图标）—— 与 `_agent_row`、
                #   左栏那些行同一个交互习惯：点的面积大一点，手感就对了。
                # [EN] ★ The **entire row** is clickable (not just that small icon) -- same as `_agent_row`,
                # [EN] the rows in the left column follow the same interaction habit: a slightly larger click area and
                # [EN] it just feels right.
                on_click=lambda e2, _n=name: _open(_n), ink=True)

        holder = ft.Column([], spacing=6, scroll=ft.ScrollMode.AUTO, expand=True)

        def refresh() -> None:
            try:
                CASTING.load(force=True)          # 改完立刻看到新的
                # [EN] See the new one immediately after editing
            except Exception:                                        # noqa: BLE001
                pass
            ns = CASTING.type_names()
            holder.controls = [_row(n) for n in ns] or [
                mk_hint(t('（类型库读不到 —— 见日志）'))]
            try:
                page.update()
            except Exception:                                        # noqa: BLE001
                pass

        refresh()
        body = ft.Column([
            mk_hint(t('这是**系统层**：这一库里每一"型"是一种演员**怎么说话** —— '
                      '句长、语速、身体习惯、待人接物的底色。换一本书它也一样。')),
            mk_hint(t('⚠ 它**不管演谁**。谁演谁在「项目 · 剧组 Agents」→「角色设置」里 '
                      '（一人一份），参考：{p}', p=str(CASTING._types_path()))),
            ft.Divider(height=6, color='transparent'),
            ft.Container(content=holder, expand=True),
        ], spacing=6, expand=True)
        dlg = mk_dialog(
            t('演员类型库 · {n} 型', n=len(names)),
            ft.Container(content=body, width=DLG_W, height=DLG_H),
            [mk_btn(t('＋ 新建一型'), on_click=lambda e: _open('', create=True),
                    height=SET_H, primary=False),
             mk_btn(t('关闭'), on_click=lambda e: page.pop_dialog(), primary=False)])
        page.show_dialog(dlg)

    def _actor_type_editor(self, name: str, *, create: bool, on_done) -> None:
        """改/新建一型演员。保存走 `casting.save_type`（整块替换，保住文件头注释）。
                English:
        Edit/create an actor type. Saving goes through `casting.save_type` (whole-block replacement,
        preserving the file header comment).
        """
        from actors import casting as CASTING
        page = self.page
        e = CASTING.entry(name) if not create else {}
        name_field = mk_field(t('类型名（如 青年·高冷）'), name, width=DLG_W - 160,
                              hint=t('"年龄层·气质"的写法与本库一致'))
        if not create:
            name_field._field.disabled = True     # 改名 = 盘的键变了（先不做，免得半路出岔）
            # [EN] Renaming = the key on disk changes (not doing it for now, to avoid a mid-way mishap)
        cast_as = mk_field(t('常演'), str(e.get('常演') or ''), width=DLG_W - 160,
                           hint=t('主角位 / 对手位…（可以空着）'))
        skel = ft.TextField(
            value=str(e.get('骨架') or ''), multiline=True, min_lines=3, max_lines=5,
            height=76, text_size=SET_FS, width=DLG_W - 160,
            hint_text=t('这一类人**是什么样**（两三句，说清"为什么这样"）'),
            bgcolor=C['input_bg'], border_color=C['border'], border_radius=4,
            color=C['text'], content_padding=ft.Padding(8, 6, 8, 6))
        sp = e.get('说话') if isinstance(e.get('说话'), dict) else {}
        plen = mk_field(t('句子长短'), str(sp.get('句长') or ''), width=SET_W_HALF,
                        hint=t('如：短，通常一句说完'))
        rate = mk_field(t('语速'), str(sp.get('语速') or ''), width=SET_W_HALF,
                        hint=t('如：慢，中间有停顿'))
        catch = mk_field(t('惯用语（逗号分隔）'),
                         '，'.join(str(x) for x in (sp.get('口头禅') or [])),
                         width=DLG_W - 160, hint=t('如：嗯。，不用。，随你。'))
        taboo = mk_field(t('说话忌讳'), str(sp.get('忌讳') or ''), width=DLG_W - 160,
                         hint=t('如：不解释动机、不说长段'))
        body_txt = mk_field(t('身体 / 习惯'), str(e.get('身体') or ''),
                            width=DLG_W - 160, hint=t('如：动作少而准；不主动靠近别人'))
        tension = mk_field(t('张力'), str(e.get('张力') or ''), width=DLG_W - 160,
                           hint=t('与哪一型天然对冲（可空）'))
        variants_txt = ft.TextField(
            value='\n'.join(CASTING.variants(name)) if not create else '',
            multiline=True, min_lines=3, max_lines=6, height=80, text_size=SET_FS,
            width=DLG_W - 160,
            hint_text=t('一行一条。**至少三条** —— 同一个类型要能长出好几种人，'
                        '只有一种演法就是套路'),
            bgcolor=C['input_bg'], border_color=C['border'], border_radius=4,
            color=C['text'], content_padding=ft.Padding(8, 6, 8, 6))
        avoid = mk_field(t('忌讳（别写成什么）'), str(e.get('忌讳') or ''),
                         width=DLG_W - 160)

        def _save(ev) -> None:
            nm = str(field_value(name_field) or '').strip() or name
            if not nm:
                self._post_message(t('类型名不能为空'), level='warn', snack=True)
                return
            fields = {
                '常演': field_value(cast_as) or '',
                '骨架': str(skel.value or ''),
                '句长': field_value(plen) or '',
                '语速': field_value(rate) or '',
                '口头禅': [x for x in str(field_value(catch) or '').replace('，', ',')
                           .split(',') if x.strip()],
                '说话忌讳': field_value(taboo) or '',
                '身体': field_value(body_txt) or '',
                '张力': field_value(tension) or '',
                '变奏': [x for x in str(variants_txt.value or '').splitlines()
                        if x.strip()],
                '忌讳': field_value(avoid) or '',
            }
            ok, why = CASTING.save_type(nm, fields, create=create)
            if ok:
                self._post_message(t('已保存「{n}」', n=nm), level='ok', snack=True)
                page.pop_dialog()
                on_done()
            else:
                self._post_message(t('没能保存：{w}', w=why), level='warn', snack=True)

        body = ft.Column([
            mk_hint(t('改的是**这一类演员怎么演**（系统层，所有书共用）。'
                      '它是方法、不是某一个角色 —— 具体角色在「角色设置」里。')),
            name_field, cast_as, skel,
            ft.Row([plen, rate], spacing=8), catch, taboo, body_txt, tension,
            mk_section(t('变奏轴（同型多人靠它分流）')), variants_txt, avoid,
        ], spacing=6, scroll=ft.ScrollMode.AUTO, expand=True)
        dlg = mk_dialog(
            t('新建一型演员') if create else t('编辑：{n}', n=name),
            ft.Container(content=body, width=DLG_W, height=DLG_H),
            [mk_btn(t('保存'), on_click=_save, primary=True),
             mk_btn(t('取消'), on_click=lambda e: page.pop_dialog(), primary=False)])
        page.show_dialog(dlg)

    def _casting_dialog(self, project) -> None:
        """**角色设置**（项目层）：这本书里**每个角色**演成什么样 —— 一人一份。

        ★ 为什么角色必须是"一人一份"、不能写进 md：见 `actors/casting.py`
          模块头那条硬约束（一份 md 全组通读，写进去就串台）。
        ★ 改的是 `设定集/人物.yaml` 里**归界面管的那四个字段**
          （`演员类型` / `变奏` / `选角` / `打破类型`）—— 行级编辑 + 备份，
          其它内容一个字不动（`casting.write_card` 里写着为什么）。
        ⚠ **下一轮起生效**：本轮设定集已经冻结（`freeze_settings_into_run`）。
        
                English:
        **Role Settings** (project layer): how **each role** in this book is acted -- one file per
        person.
                ★ Why roles must be "one file per person" and cannot be written into the md: see the hard constraint in the `actors/casting.py`
                  module header (one md is read through by the whole cast; writing it in causes crosstalk).
                ★ What's being edited is **the four fields managed by the UI** in `设定集/人物.yaml`
                  Nothing else in the content is touched (the reason is written in `casting.write_card`).
                ⚠ **Takes effect from the next round**: this round's settings have already been frozen (`freeze_settings_into_run`).
        """
        from actors import casting as CASTING
        page = self.page
        if project is None:
            return
        sd = project.settings_dir

        def _open(card: dict) -> None:
            self._casting_editor(project, card, on_done=refresh)

        def _row(card: dict) -> ft.Control:
            f = CASTING.card_fields(card)
            bits = [str(card.get('身份') or ''), str(card.get('性格') or '')]
            bits = [b for b in bits if b.strip()]
            at = f['演员类型'] or t('（自动配）')
            return ft.Container(
                content=ft.Row([
                    ft.Column([
                        ft.Text(str(card.get('姓名') or ''), size=BODY_FS,
                                weight=ft.FontWeight.BOLD, color=C['text']),
                        ft.Text(' · '.join(bits) or t('（没有身份/性格）'),
                                size=HINT_FS, color=C['muted']),
                        ft.Text(t('演员类型：{a}{v}', a=t(at),
                                  v=('　·　' + f['变奏']) if f['变奏'] else ''),
                                size=HINT_FS,
                                color=C['gold'] if f['演员类型'] else C['muted']),
                    ], spacing=2, expand=True),
                    mk_icon_btn(ft.Icons.EDIT_OUTLINED,
                                on_click=lambda e2, _c=card: _open(_c),
                                tooltip=t('改这个角色怎么演')),
                ], spacing=8),
                bgcolor=C['input_bg'], border=make_border(1, C['border']),
                border_radius=4, padding=ft.Padding(10, 6, 8, 6),
                on_click=lambda e2, _c=card: _open(_c), ink=True)

        holder = ft.Column([], spacing=6, scroll=ft.ScrollMode.AUTO, expand=True)

        def refresh() -> None:
            cards = CASTING.load_cards(sd)
            holder.controls = [_row(c) for c in cards] or [
                mk_hint(t('（这本书还没有人物表 —— 先完成「开卷」摄取）'))]
            try:
                page.update()
            except Exception:                                        # noqa: BLE001
                pass

        refresh()
        body = ft.Column([
            mk_hint(t('这里是**这一本书**：每个角色**演成什么样** —— 一人一份。')),
            mk_hint(t('上层是「演员类型库」（这一类演员**怎么说话**）；'
                      '两者冲突时**以这里的角色为准**（类型只管怎么说，角色管演谁）。')),
            mk_hint(t('⚠ 演员那一行 md 里**不要**写具体角色 —— 那份是全组通读的。'
                      '改完**下一轮**起生效（这一轮的设定集已冻结）。')),
            ft.Divider(height=6, color='transparent'),
            ft.Container(content=holder, expand=True),
        ], spacing=6, expand=True)
        dlg = mk_dialog(
            t('角色设置 · {n}', n=project.name),
            ft.Container(content=body, width=DLG_W, height=DLG_H),
            [mk_btn(t('关闭'), on_click=lambda e: page.pop_dialog(), primary=False)])
        page.show_dialog(dlg)

    def _casting_editor(self, project, card: dict, *, on_done) -> None:
        """改**一个角色**的演法（四个字段）。
                English:
        Change the performance of **one character** (four fields).
        """
        from actors import casting as CASTING
        page = self.page
        sd = project.settings_dir
        who = str(card.get('姓名') or '')
        cur = CASTING.card_fields(card)
        types = CASTING.type_names()
        type_dd = mk_dropdown(
            t('演员类型'),
            [ft.dropdown.Option('', t('（自动配 —— 按性格/身份从类型库里挑）'))]
            + [ft.dropdown.Option(k, k) for k in types],
            cur['演员类型'], width=DLG_W - 160)
        var_holder = ft.Column([], spacing=4)
        var_dd = {'c': None}
        cast_txt = ft.TextField(
            value=cur['选角'], multiline=True, min_lines=3, max_lines=5, height=72,
            text_size=SET_FS, width=DLG_W - 160,
            hint_text=t('这一份怎么演（这一本书里他的处境/跟谁顶/说话要注意什么）'),
            bgcolor=C['input_bg'], border_color=C['border'], border_radius=4,
            color=C['text'], content_padding=ft.Padding(8, 6, 8, 6))
        brk = mk_field(t('打破类型'), cur['打破类型'], width=DLG_W - 160,
                       hint=t('只写一点：这个人**不像**他那一型的哪一处'))

        def _sync_variants(*_a) -> None:
            """类型一换，变奏下拉跟着换（变奏是**类型的**属性）。
                        English:
            When the type changes, the variation dropdown follows (variations are an attribute of the
            **type**).
            """
            tname = str(field_value(type_dd) or '')
            vs = CASTING.variants(tname) if tname else []
            var_holder.controls.clear()
            if not vs:
                var_holder.controls.append(mk_hint(
                    t('（选一个类型才会出现变奏；"自动配"由程序按顺序分）')))
                var_dd['c'] = None
            else:
                var_dd['c'] = mk_dropdown(
                    t('这一份的变奏'),
                    [ft.dropdown.Option('', t('（自动：同型多人按顺序分不同的那条）'))]
                    + [ft.dropdown.Option(v, v) for v in vs],
                    cur['变奏'] if cur['变奏'] in vs else '', width=DLG_W - 160)
                var_holder.controls.append(var_dd['c'])
            try:
                page.update()
            except Exception:                                        # noqa: BLE001
                pass

        type_dd._field.on_change = _sync_variants
        _sync_variants()

        def _save(ev) -> None:
            fields = {
                '演员类型': str(field_value(type_dd) or ''),
                '变奏': str(field_value(var_dd['c']) or '') if var_dd['c'] else '',
                '选角': str(cast_txt.value or ''),
                '打破类型': str(field_value(brk) or ''),
            }
            ok, why = CASTING.write_card(sd, who, fields)
            if ok:
                self._post_message(
                    t('已保存「{n}」的演法（**下一轮**起生效）', n=who),
                    level='ok', snack=True)
                page.pop_dialog()
                on_done()
            else:
                self._post_message(t('没能保存：{w}', w=why), level='warn', snack=True)

        body = ft.Column([
            mk_hint(t('角色：**{n}**　（人本身在那本书的 `设定集/{f}` 里；'
                      '这里只定"演成什么样"）', n=who, f=CASTING.PEOPLE_FILE)),
            type_dd, var_holder,
            mk_section(t('这一份怎么演（可选，但很值）')), cast_txt, brk,
            mk_hint(t('⚠ 清空某一项 = 删掉那一行（不留空壳）。'
                      '改的是**这本书**的人物表，写前自动备份一份 `.bak`。')),
        ], spacing=6, scroll=ft.ScrollMode.AUTO, expand=True)
        dlg = mk_dialog(
            t('角色设置 · {n}', n=who),
            ft.Container(content=body, width=DLG_W, height=DLG_H),
            [mk_btn(t('保存'), on_click=_save, primary=True),
             mk_btn(t('取消'), on_click=lambda e: page.pop_dialog(), primary=False)])
        page.show_dialog(dlg)

    def _agent_delete(self, spec, *, on_done) -> None:
        """删一个**自建**职位（软件层）。护栏在 `catalog.delete_soft` 里。
                English:
        Delete a **self-created** position (software layer). The guard is in `catalog.delete_soft`.
        """
        from crew import catalog as CAT
        self._confirm_danger(
            t('删除自建职位'),
            [t('职位：{n}（{s}.md）', n=t(spec.name), s=spec.slug),
             t('目录：{p}', p=str(CAT.soft_dir())),
             t('删掉之后这个职位不会再出工；它不会进回收站。')],
            on_yes=lambda: self._agent_delete_go(spec, on_done=on_done))

    def _agent_delete_go(self, spec, *, on_done) -> None:
        from crew import catalog as CAT
        ok, why = CAT.delete_soft(spec.slug)
        if ok:
            try:
                CAT.write_readme()
            except Exception:                                    # noqa: BLE001
                pass
            self._post_message(t('已删除自建职位「{n}」', n=t(spec.name)),
                               level='ok', snack=True)
        else:
            self._post_message(t('没能删除：{why}', why=t(why)), level='warn',
                               snack=True)
        on_done()

    def _agent_reset_project(self, spec, *, on_done) -> None:
        from crew import catalog as CAT
        ok, why = CAT.clear_project(CAT.bound_project(), spec.slug)
        if ok:
            self._post_message(t('「{n}」已回到软件默认（只影响这一本书）',
                                 n=t(spec.name)), level='ok', snack=True)
        else:
            self._post_message(t('没能恢复：{why}', why=t(why)), level='warn',
                               snack=True)
        on_done()

    def _agent_editor(self, spec, *, project, allow_new: bool, on_done) -> None:
        """**Agent 属性编辑对话框**。

        `spec is None` = 新建（只在软件层给）。
        保存去哪：`project is None` → 软件层 `agents/<slug>.md`；
        否则 → 本项目 `agents/<slug>.md`（**只写改过的几项**）。
        
                English:
        **Agent property edit dialog**.
                `spec is None` = new (only provided at the software layer).
                Where to save: `project is None` → software layer `agents/<slug>.md`;
                otherwise → this project's `agents/<slug>.md` (**only write the changed items**).
        """
        from crew import catalog as CAT
        from crew import roster as RST
        page = self.page
        is_new = spec is None
        if is_new:
            spec = CAT.AgentSpec(key='', slug='', name='', name_en='', intro='',
                                 usage='', prompt='', when=CAT.CUSTOM_WHEN,
                                 tier='daily', feeds='author', builtin=False,
                                 order=CAT.CUSTOM_ORDER)
        # ── 可编辑的标识：内置职位是**固定的**（它是盘上的文件名）──
        # [EN] -- Editable identifier: built-in positions are **fixed** (it's the filename on disk) --
        slug_field = mk_field(t('英文标识（文件名）'),
                              spec.slug if not is_new else '',
                              width=DLG_W - 160,
                              hint=t('例如 fact_checker'))
        if not is_new and spec.builtin:
            slug_field._field.disabled = True
        name_zh = mk_field(t('名字'), spec.name, width=DLG_W - 160)
        intro = mk_field(t('简介'), spec.intro, width=DLG_W - 160)
        usage = mk_dropdown(t('什么情况下使用'),
                            [ft.dropdown.Option(v, t(v) if v else t('（没写）'))
                             for v in CAT.usage_options()],
                            spec.usage or '', width=DLG_W - 160)
        when_opts = [ft.dropdown.Option(k, t(v)) for k, v in CAT.WHEN_ZH.items()]
        when_dd = mk_dropdown(t('出工时机'), when_opts, spec.when,
                              width=SET_W_HALF)
        if not spec.builtin:
            # 自建职位只能 `day`（见 `catalog.CUSTOM_WHEN`）——给一个选了
            # 不生效的选项就是假按钮，所以这里直接锁住。
            # [EN] self-built positions can only be `day` (see `catalog.CUSTOM_WHEN`) -- giving one
            # [EN] an option that doesn't take effect is a fake button, so just lock it here.
            when_dd._field.disabled = True
        # ⚠ 模型档与产出对象都**不许露变量值**（`daily` / `novelist`）——
        #   这与运行模式/界面语言那批下拉是同一条规矩（键是值、显示是人话）。
        # [EN] ⚠ Neither the model tier nor the output target may **expose variable values** (`daily` /
        # [EN] `novelist`) --
        # [EN] this is the same rule as the run mode / UI language dropdown batch (key is the value, display is
        # [EN] human language).
        tier_dd = mk_dropdown(t('模型档'),
                              [ft.dropdown.Option(v, t(CAT.TIER_LABEL.get(v, v)))
                               for v in CAT.TIER_VALUES],
                              spec.tier, width=SET_W_HALF)
        feed_keys = [r.key for r in RST.roles()]

        def _feed_label(k: str) -> str:
            try:
                return t(RST.role(k).name)
            except Exception:                                    # noqa: BLE001
                return k

        feeds_dd = mk_dropdown(t('产出交给'),
                               [ft.dropdown.Option(k, _feed_label(k))
                                for k in feed_keys],
                               spec.feeds if spec.feeds in feed_keys
                               else CAT.DEFAULT_FEEDS,
                               width=DLG_W - 160)
        prompt = ft.TextField(
            value=spec.prompt, multiline=True, min_lines=6, max_lines=12,
            # ⚠ 多行 `TextField` 在 Flet 1.0 里**不认 `expand`**，只认
            #   `min_lines` / `max_lines` / `height` —— 所以给死高度 + 宽度，
            #   别指望 `expand=True` 撑满（那是无效的）。
            # [EN] ⚠ Multi-line `TextField` **does not honor `expand`** in Flet 1.0, only
            # [EN] `min_lines` / `max_lines` / `height` -- so give a fixed height + width,
            # [EN] Do not expect `expand=True` to fill it (that does not work).
            height=AGENT_PROMPT_H, width=DLG_W - 160,
            text_size=SET_FS,
            bgcolor=C['input_bg'], border_color=C['border'],
            border_radius=4, color=C['text'],
            content_padding=ft.Padding(10, 6, 10, 6))

        def _save(e=None) -> None:
            name_v = (field_value(name_zh) or '').strip()
            if not name_v:
                self._post_message(t('名字不能空着'), level='warn', snack=True)
                return
            slug_v = (field_value(slug_field) or '').strip()
            try:
                if project is None:
                    if is_new:
                        made = CAT.create_custom(
                            name=name_v, name_en=slug_v, intro=field_value(intro),
                            usage=field_value(usage), prompt=prompt.value,
                            tier=field_value(tier_dd), feeds=field_value(feeds_dd))
                        slug_v = made.slug
                    else:
                        new_spec = spec.merged_with(
                            name=name_v, intro=field_value(intro) or '',
                            usage=field_value(usage) or '', prompt=prompt.value or '',
                            when=field_value(when_dd) or spec.when,
                            tier=field_value(tier_dd) or spec.tier,
                            feeds=field_value(feeds_dd) or spec.feeds)
                        if not spec.builtin and slug_v:
                            new_spec = new_spec.merged_with(
                                slug=CAT._slugify(slug_v) or spec.slug,
                                name_en=slug_v)
                        CAT.save_soft(new_spec, old_slug=spec.slug)
                    try:
                        CAT.write_readme()
                    except Exception:                            # noqa: BLE001
                        pass
                else:
                    CAT.save_project(project, spec.key,
                                     name=name_v, intro=field_value(intro),
                                     usage=field_value(usage), prompt=prompt.value,
                                     when=field_value(when_dd),
                                     tier=field_value(tier_dd),
                                     feeds=field_value(feeds_dd))
            except Exception as ex:                              # noqa: BLE001
                log_exception(t('保存 Agent 设置失败'), category='ui')
                self._post_message(t('保存失败：{e}', e=f'{ex!r}'),
                                   level='error', snack=True)
                return
            self._post_message(
                t('已保存「{n}」', n=name_v), level='ok', snack=True)
            page.pop_dialog()
            on_done()

        def _cancel(e=None) -> None:
            page.pop_dialog()

        # 标题里那个名字也过 `t()`（自建职位翻不出来 —— 那是作者自己的字）。
        # [EN] The name in the title also goes through `t()` (custom job titles cannot be translated - those
        # [EN] are the author's own words).
        disp_name = t(spec.name)
        title = (t('新建职位') if is_new
                 else t('编辑职位 · {n}', n=disp_name))
        if project is not None:
            title = t('本项目定制 · {n}', n=disp_name)
        dlg = mk_dialog(
            title,
            ft.Container(
                content=ft.Column([
                    mk_hint(t('正文就是**系统提示词**；它会在每次出工前拼在该职位的'
                              '提示词最前面。') if project is None else t(
                                  '这里只写**这一本书**要改的项；没改的跟软件默认。')),
                    slug_field, name_zh, intro, usage,
                    mk_sep_row(when_dd, tier_dd), feeds_dd,
                    mk_section(t('系统提示词')),
                    prompt,
                ], spacing=6, scroll=ft.ScrollMode.ADAPTIVE),
                width=DLG_W - 100, height=DLG_H_WIZARD + 90,
            ),
            [mk_btn(t('保存'), on_click=_save, height=BTN_H),
             mk_btn(t('取消'), on_click=_cancel, primary=False, height=BTN_H)],
        )
        page.show_dialog(dlg)

    # ══════════════════════════════════════════════════════════
    #  模型登记表（2026-10-12）
    # [EN] Model registry (2026-10-12)
    # ══════════════════════════════════════════════════════════
    # 用户原话：「把现在的两个LLM设置合并到一起，改成可以配置多个模型，
    #   配置好的模型在LLM配置页的模型列表里，可以指定一个默认模型。
    #   而且会有一个说明，包含不同的功能推荐用什么模型。」
    # [EN] User's exact words: "Merge the current two LLM settings into one, change it to allow
    # [EN] configuring multiple models; the configured models appear in the model list on the LLM
    # [EN] config page, and one can be designated as the default. There will also be a note saying
    # [EN] which model is recommended for which function."
    #
    # 三条实现口径（改之前先读）：
    #   ① **增删改立刻落盘**（`llm/models.save`）—— 模型条目是"登记表"，
    #      不是"对话框里填了一半的草稿"。对话框那个「保存」只管标量配置
    #      （默认模型 / 三档 / 超时…）。这样关掉对话框也不会丢刚加的模型。
    #   ② 每条模型**自带地址与密钥**（用户拍板"各自独立"），所以能同时接多家。
    #   ③ 三档是**快速配置**（用户拍板"保留三档"）：Agent 没点名时按它的档走。
    # [EN] Three implementation rules (read before changing):
    # [EN] ① **Add/edit/delete persist immediately** (`llm/models.save`) -- model entries are a
    # [EN] "registry", not "a draft half-filled in a dialog". The dialog's "Save" only handles scalar
    # [EN] config (default model / tiers / timeout...). This way closing the dialog doesn't lose a
    # [EN] newly added model.
    # [EN] ② Each model **carries its own endpoint and key** (the user chose "independent"), so
    # [EN] several providers can be used at once.
    # [EN] ③ The three tiers are **quick config** (the user chose "keep the three tiers"): when an
    # [EN] Agent names nothing, it follows its tier.

    def _model_editor(self, page, entry, state: dict, on_done) -> None:
        """新增/编辑一条模型。`entry is None` = 新增。
                English:
        Add/edit one model. `entry is None` = add.
        """
        from llm import models as MODELS
        from llm import capabilities as CAP
        is_new = entry is None
        e = entry or MODELS.ModelEntry(key='', label='', model='',
                                       base_url=CFG.s('LLM_BASE_URL'),
                                       api_key=CFG.s('LLM_API_KEY'),
                                       provider=CFG.s('LLM_PROVIDER') or 'openai_compatible')
        label_f = mk_field(t('显示名'), e.label, width=DLG_W - 160,
                           hint=t('例如 混元 Hy3'))
        model_f = mk_field(t('模型名'), e.model, width=DLG_W - 160,
                           hint=t('发给服务端的名字，例如 hy3'))
        url_f = mk_field(t('接口地址'), e.base_url, width=DLG_W - 160,
                         hint=t('写到 /v1 这一层，程序自己接 /chat/completions'))
        key_f = mk_field(t('API Key'), e.api_key, password=True, width=DLG_W - 160)
        prov_dd = mk_dropdown(t('接入协议'),
                              [ft.dropdown.Option(p, p)
                               for p in MODELS.PROVIDERS],
                              e.provider, width=SET_W_HALF)
        note_f = mk_field(t('备注'), e.note, width=DLG_W - 160,
                          hint=t('给自己看的：这家是谁给的、什么时候到期'))
        # 能力开关：**按模型名自动判**，作者可以覆盖。
        # ⚠ 默认勾选的是"按模型名判出来的事实"，不是"当前全局声明" ——
        #   后者是别的模型留下的，抄进来等于给新模型贴错标签。
        facts, _matched = CAP.detect(e.model or '')
        cap_boxes: dict[str, ft.Checkbox] = {}
        cap_ui: list = []
        for ck in MODELS.CAP_FIELDS:
            cur = bool(e.caps.get(ck, facts.get(ck, False)))
            cb = mk_check(t(CAP.CAP_META[ck][0]), cur)
            cap_boxes[ck] = cb
            cap_ui.append(ft.Row([cb,
                                  ft.Text(t('按模型名判定：{v}',
                                            v=(t('支持') if facts.get(ck) else t('不支持'))),
                                          size=HINT_FS, color=C['muted'])],
                                 spacing=8))

        def _save(ev=None) -> None:
            label = (field_value(label_f) or '').strip()
            m = (field_value(model_f) or '').strip()
            if not label and not m:
                self._post_message(t('显示名与模型名至少填一个'), level='warn', snack=True)
                return
            entries = list(state['entries'])
            k = e.key or MODELS.duplicate_key(label or m, entries=entries)
            new = MODELS.ModelEntry(
                key=k, label=label or m, model=m or label,
                base_url=(field_value(url_f) or '').strip(),
                api_key=(field_value(key_f) or '').strip(),
                provider=field_value(prov_dd) or 'openai_compatible',
                note=(field_value(note_f) or '').strip(),
                caps={ck: bool(cb.value) for ck, cb in cap_boxes.items()})
            hit = next((i for i, x in enumerate(entries) if x.key == k), None)
            if hit is not None:
                entries[hit] = new
            else:
                entries.append(new)
            MODELS.save(entries)
            state['entries'] = entries
            self._post_message(t('已保存模型「{n}」', n=new.display()),
                               level='ok', snack=True)
            page.pop_dialog()
            on_done()

        dlg = mk_dialog(
            t('新建模型') if is_new else t('编辑模型 · {n}', n=e.display()),
            ft.Container(
                content=ft.Column([
                    mk_hint(t('这一条 = **一家可以调用的服务**（地址 + 密钥 + 模型名）。'
                              '不同的 Agent 可以用不同的服务商。')),
                    label_f, model_f, url_f, key_f,
                    mk_sep_row(prov_dd, ft.Container()),
                    note_f,
                    mk_section(t('模型能力')),
                    mk_hint(t('默认按**模型名**自动判定；只有你确知它不一样时才改。')),
                    *cap_ui,
                ], spacing=6, scroll=ft.ScrollMode.ADAPTIVE),
                width=DLG_W - 100, height=DLG_H_WIZARD,
            ),
            [mk_btn(t('保存'), on_click=_save, height=BTN_H),
             mk_btn(t('取消'), on_click=lambda ev: page.pop_dialog(),
                    primary=False, height=BTN_H)])
        page.show_dialog(dlg)

    def _model_test(self, page, entry, line, btn) -> None:
        """测一条模型：**真发一条最小请求**（不信环境变量、不记台账）。
                English:
        Test one model: **really send a minimal request** (ignores env vars, records no ledger).
        """
        from llm import probe

        async def _run():
            btn.disabled = True
            line.value = t('正在测试「{m}」…', m=entry.display())
            line.color = C['muted']
            page.update()
            try:
                res = await probe.probe_model(entry.model, base_url=entry.base_url,
                                              api_key=entry.api_key,
                                              provider=entry.provider)
            except Exception as ex:                              # noqa: BLE001
                line.value = t('❌ 测试时出错：{err}', err=repr(ex))
                line.color = C['seal']
            else:
                line.value = res.line()
                line.color = C['accent_green'] if res.ok else C['seal']
                self._post_message(
                    t('模型测试「{m}」：{r}', m=entry.display(), r=res.line()),
                    level='ok' if res.ok else 'error', keep=True)
            btn.disabled = False
            page.update()

        page.run_task(_run)

    def _model_row(self, page, entry, state: dict, on_done) -> ft.Control:
        """模型列表里的一行。
                English:
        One row in the model list.
        """
        from llm import models as MODELS
        line = ft.Text('', size=HINT_FS, color=C['muted'], width=SET_W, selectable=True)
        test_btn = mk_icon_btn(ft.Icons.NETWORK_CHECK, danger=False,
                               tooltip=t('测试这一条（真发一条最小请求）'))
        test_btn.on_click = lambda e: self._model_test(page, entry, line, test_btn)
        edit_btn = mk_icon_btn(ft.Icons.EDIT_OUTLINED, danger=False,
                               tooltip=t('改这一条'))
        edit_btn.on_click = lambda e: self._model_editor(page, entry, state, on_done)

        def _del(e=None) -> None:
            entries = [x for x in state['entries'] if x.key != entry.key]
            MODELS.save(entries)
            state['entries'] = entries
            self._post_message(t('已删除模型「{n}」', n=entry.display()),
                               level='ok', snack=True)
            on_done()

        del_btn = mk_icon_btn(ft.Icons.DELETE_OUTLINE, on_click=_del,
                              tooltip=t('删除这一条（不影响已经点名的 Agent，'
                                        '它们会退回档位/默认）'))
        url = entry.base_url or t('（跟上面那个默认接口）')
        return ft.Container(
            content=ft.Column([
                ft.Row([
                    ft.Column([
                        ft.Text(entry.display(), size=BODY_FS,
                                weight=ft.FontWeight.BOLD, color=C['text']),
                        ft.Text(t('{p} · {u}', p=entry.provider, u=url),
                                size=HINT_FS, color=C['muted']),
                        *([ft.Text(entry.note, size=HINT_FS, color=C['muted'])]
                          if entry.note else []),
                    ], spacing=2, expand=True),
                    test_btn, edit_btn, del_btn,
                ], spacing=6),
                line,
            ], spacing=2),
            width=SET_W, bgcolor=C['input_bg'],
            border=make_border(1, C['border']), border_radius=4,
            padding=ft.Padding(10, 6, 8, 6))

    def _model_list_section(self, page, state: dict) -> list:
        """「模型列表 + 默认模型 + 三档」这一整块（**增删改立刻落盘**）。
                English:
        The whole "model list + default model + three tiers" block (**CRUD persists immediately**).
        """
        from llm import models as MODELS
        holder = ft.Column([], spacing=4)
        head_line = ft.Text('', size=HINT_FS, color=C['muted'], width=SET_W)
        # 默认模型与三档的下拉都挂在 `state` 上（保存时按它取值）。
        state.setdefault('pickers', {})

        def refresh() -> None:
            entries = state['entries']
            holder.controls = ([self._model_row(page, e, state, refresh)
                                for e in entries]
                               or [mk_hint(t('（还没配模型 —— 点下面「＋ 新增模型」，'
                                             '或者照上面那套默认接口填一条）'))])
            opts = [ft.dropdown.Option('', t('（默认）'))] + [
                ft.dropdown.Option(x.key, x.display()) for x in entries]
            # 默认模型
            cur = CFG.s('LLM_DEFAULT_MODEL')
            dd = mk_dropdown(t('默认模型'), opts,
                             cur if any(x.key == cur for x in entries) else '',
                             width=SET_W - 8 - BTN_TEST_W)
            state['pickers']['LLM_DEFAULT_MODEL'] = dd
            # 三档
            tier_rows: list = []
            for tf in MODELS.TIER_FIELDS:
                cv = CFG.s(tf)
                tdd = mk_dropdown(t(MODELS.TIER_ZH[tf]), opts,
                                  cv if any(x.key == cv for x in entries) else '',
                                  width=SET_W - 8 - BTN_TEST_W)
                state['pickers'][tf] = tdd
                tier_rows.append(tdd)
            state['tier_box'].controls = tier_rows
            head_line.value = t('共 {n} 个模型 · 默认：{d}',
                                n=len(entries),
                                d=(next((x.display() for x in entries
                                         if x.key == CFG.s('LLM_DEFAULT_MODEL')),
                                        t('（没指定，用第一条）'))))
            try:
                page.update()
            except Exception:                                    # noqa: BLE001
                pass

        add_btn = mk_btn(t('＋ 新增模型'), height=SET_H,
                         on_click=lambda e: self._model_editor(page, None, state,
                                                               refresh))
        return [mk_section(t('模型列表')),
                head_line,
                holder,
                ft.Divider(height=8, color='transparent'),
                add_btn,
                mk_hint(t('每一条 = 一家可以调用的服务（自有地址与密钥），'
                          '所以能同时接**多家**：写小说用一家、判定用另一家都行。\n'
                          '增删改**立刻生效**，不用点保存。')),]

    def _models_recommend_table(self) -> list:
        """「哪个功能推荐用什么模型」那张表。
                English:
        The "which model is recommended for which function" table.
        """
        from llm import recommend as REC
        from llm import models as MODELS
        entries = MODELS.ensure_ready()
        rows: list = []
        last_kind = ''

        def _group_bar(title: str) -> ft.Control:
            return ft.Text(title, size=BODY_FS, weight=ft.FontWeight.BOLD,
                           color=C['gold'], width=SET_W)

        for spec in self._agent_specs_for_advice():
            adv = REC.advice_for(spec.key)
            if spec.kind != last_kind:
                last_kind = spec.kind
                rows.append(_group_bar({
                    'crew': t('剧组职位'),
                    'service': t('系统服务'),
                    'special': t('特殊 Agent'),
                }.get(spec.kind, t('剧组职位'))))
            hit = REC.best_match(spec.key, entries)
            if hit is not None:
                state_txt = t('已配：{n}', n=hit.display())
                col = C['accent_green']
            else:
                state_txt = t('还没配 —— 建议加一个：{names}',
                              names=' / '.join(REC.suggest_names(spec.key)))
                col = C['seal']
            rows.append(ft.Container(
                content=ft.Column([
                    ft.Row([
                        ft.Text(t(spec.name), size=BODY_FS, color=C['text']),
                        self._chip(t(adv.profile_name)),
                        *([self._chip(t('每拍都跑'), fg=C['seal'],
                                      bg=with_alpha(DANGER, 0.12))]
                          if adv.hot else []),
                    ], spacing=6),
                    ft.Text(t(adv.why), size=HINT_FS, color=C['muted'],
                            width=SET_W - 20),
                    ft.Text(state_txt, size=HINT_FS, color=col,
                            width=SET_W - 20, selectable=True),
                ], spacing=2),
                width=SET_W, bgcolor=C['input_bg'],
                border=make_border(1, C['border']), border_radius=4,
                padding=ft.Padding(10, 6, 8, 6)))
        return [mk_section(t('推荐：哪个功能用什么模型')),
                mk_hint(t('这张表是**按功能**给的（不是排名）。'
                          '「已配」= 你已经在上面配好了对应的模型，'
                          '在「剧组 Agents」里点那一位就能选它。')),
                *rows]

    def _agent_specs_for_advice(self) -> list:
        """推荐表要遍历的 Agent（剧组 + 系统服务 + 特殊；**不含**作者自建）。
                English:
        The Agents the recommendation table iterates (crew + system services + special; **excluding**
        author-created ones).
        """
        try:
            from crew import catalog as CAT
            return [s for s in CAT.effective(project=None) if s.builtin]
        except Exception:                                        # noqa: BLE001
            return []

    def show_global_settings(self, tab: int | None = None,
                             agent: str | None = None):
        """显示全局设置对话框（选项卡布局，紧凑尺寸）。

        `tab` = 打开时停在第几个选项卡（**从 1 开始**，跟 `ft.Tabs.selected_index`
        和 `TabBar` 的显示序号一致）。不给（None）就落在 `self.TAB_LLM`
        ——「LLM 接入」那一页：从"还没配 LLM"那个对话框点「去配置」进来时，
        要直接落在这一页上，不能让用户自己去几个选项卡里找（2026-10-06）。

        ⚠ 上面那句「**从 1 开始**」是**错的**，2026-10-11 更正：Flet 的
          `selected_index` 是 **0 起算**，`TAB_LLM = 1` 之所以对，是因为
          「推演服务LLM设定」**本来就排第 2 个**（0 = 常规）。这句话当年
          把"0 起算"误写成"1 起算"，害得 `verify_regular_tab` 的判据也跟着
          写了 `titles[i - 1]`（见 `TAB_LLM` 那段的长说明）。
          运行页跳过来的 `TAB_GLOBAL_*` 同样按 **0 起算**写。

        `agent`（2026-10-11 加）：同「书斋」那一侧 —— 给了就把那个职位的
        编辑框叠在「剧组 Agents」列表上（运行页点剧组某一行、且当时没在跑时走这里）。
        
                English:
        Show the global settings dialog (tab layout, compact size).

        `tab` = which tab to open on. If not given (None) it lands on `self.TAB_LLM` -- the "LLM Access"
        page: when entering by clicking "Go configure" from the "no LLM configured yet" dialog, it should
        land directly on this page rather than making the user hunt through tabs (2026-10-06).

        ⚠ That sentence "**1-based**" is **wrong**; corrected 2026-10-11: Flet's `selected_index` is
          **0-based**, and `TAB_LLM = 1` is only correct because "Simulation Service LLM Settings" is
          **inherently the 2nd item** (0 = General). That sentence once mis-stated "0-based" as "1-based",
          which pushed the `verify_regular_tab` criterion into writing `titles[i - 1]` (see the long note at
          `TAB_LLM`). The `TAB_GLOBAL_*` values used by the run page's jumps are likewise **0-based**.

        `agent` (added 2026-10-11): same as the "Study" side -- when provided, stack that position's editor
        on top of the "Crew Agents" list (this is the path taken when clicking a cast row on the run page
        while not running).

        ⚠ 默认值**不要写成字面量 `1`**（2026-10-08）：2026-10-08 在「LLM 接入」
        左边加了「常规」页签之后，`1` 变成了「常规」——
        默认值和"去配置"那一跳若各写各的字面量，就会**一起错到「常规」页上**
        （用户想填 Key，看到的却是项目根目录），而且不报错、不崩。
        所以两边都取 `self.TAB_LLM`（见那个常量的说明）。
        
                English:
        Show the global settings dialog (tab layout, compact size).
                `tab` = which tab to open on (**1-based**, consistent with `ft.Tabs.selected_index`
                and the display index of `TabBar`). If not given (None), it lands on `self.TAB_LLM`
                — the "LLM 接入" page: when entering from the "no LLM configured yet" dialog by clicking "去配置",
                it should land directly on this page, and not make the user search through several tabs themselves (2026-10-06).
                ⚠ The default value **must not be written as the literal `1`** (2026-10-08): on 2026-10-08, after adding the "常规" tab to the left of "LLM 接入", `1` became "常规" —
                if the default value and the "go configure" jump each write their own literal, they will **both be wrong onto the "常规" page**
                (the user wants to fill in the Key, but sees the project root directory), and it neither errors nor crashes.
                So both sides take `self.TAB_LLM` (see that constant's description).
        """
        page = self.page
        log_ui_action(t("打开全局设置"))

        # ── LLM 接入 ──
        # 这一节现在自带**连通性自检**：Base URL 旁边能拉取对方的模型列表，
        # 三个模型档位旁边各有一个「测试」按钮。用户 2026-10-06 的原话是
        # 「我之前写的模型名字不对」+「配置完可以直接点了测试…如果不行可以
        # 马上把错误信息爆出来」—— 光让人填、填错了只能等到推演时才炸，
        # 是最难查的一种体验。
        # [EN] -- LLM integration --
        # [EN] This section now includes a **connectivity self-check**: next to Base URL you can fetch the
        # [EN] other side's model list,
        # [EN] and each of the three model tiers has a "Test" button next to it. The user's exact words on
        # [EN] 2026-10-06 were
        # [EN] "the model name I wrote before was wrong" + "after configuring it, you can just click test... if
        # [EN] it fails you can
        # [EN] immediately surface the error message" -- just letting people fill it in and only blowing up at
        # [EN] inference time when they get it wrong
        # [EN] is the hardest kind of experience to debug.
        api_key = mk_field("API Key", CFG.s('LLM_API_KEY'), password=True)
        base_url = mk_field(t("Base URL"), CFG.s('LLM_BASE_URL'),
                            width=SET_W - 8 - BTN_PULL_W)
        mock_switch = mk_switch(t("演示模式 (MOCK_LLM)"), CFG.b('MOCK_LLM'))
        timeout_field = mk_field(t("请求超时(秒)"), CFG.i('LLM_TIMEOUT_SECONDS'), width=SET_W_THIRD)
        retries_field = mk_field(t("重试次数"), CFG.i('LLM_MAX_RETRIES'), width=SET_W_THIRD)
        concurrency_field = mk_field(t("并发上限"), CFG.i('LLM_MAX_CONCURRENCY'), width=SET_W_THIRD)

        # ⚠ 这段说明必须**显式给宽度**。滚动列（`ScrollMode.ADAPTIVE` 的
        # `ft.Column`）里的 `ft.Text` 默认不换行 —— 一百多字会撑成一条一千多
        # 像素宽的横条，把整列的布局挤坏，**后面所有控件都不再画出来**
        # （实测：只把它换成一行短的，下面三档模型行立刻可见；见
        #  `developers/probe_fold.py` 的可见性地图）。
        # [EN] ⚠ This explanatory text **must be explicitly given a width**. In a scrolling column (a
        # [EN] `ft.Column` with `ScrollMode.ADAPTIVE`), `ft.Text` does not wrap by default -- over a hundred
        # [EN] characters will stretch into a horizontal bar
        # [EN] over a thousand pixels wide, breaking the whole column's layout, and **all subsequent controls
        # [EN] stop being drawn**
        # [EN] (measured: just replacing it with a short one-liner made the three model rows below immediately
        # [EN] visible; see
        # [EN] the visibility map in `developers/probe_fold.py`).
        # ★ 2026-10-06 用户：「LLM 接入这个地方 我圈起来的地方话太多了」——
        #   于是压成**一句**。原来那句还把「拉取模型列表」也解释了一遍，
        #   可按钮上就写着这五个字 —— 解释一个自明的按钮，是最典型的水词。
        # [EN] ★ 2026-10-06 user: "this LLM integration part, the places I circled have too much text" --
        # [EN] so it was compressed into **one sentence**. The original sentence also explained "fetch model
        # [EN] list",
        # [EN] but the button already says those five characters -- explaining a self-evident button is the
        # [EN] most typical kind of filler.
        _MODEL_HINT = ft.Container(
            content=mk_hint(t('「测试」真发一条最小请求，结果写在下面'
                              '（不受「演示模式」影响）。')),
            width=SET_W)

        # ★ 2026-10-10：加一条**常见服务速查**（用户当天问「我要用 Hy3，怎么填」）。
        #   只写在文档里能核实的两条，并给出"怎么自证填对了" —— 就是旁边那颗
        #   「拉取模型列表」。**刻意只列两条**：宁可少列，也不要在界面上写一个
        #   可能过期的第三方地址（那种错用户很难发现）。
        # [EN] ★ 2026-10-10: added a **common services quick reference** (the user asked that day "I want to
        # [EN] use Hy3, how do I fill it in").
        # [EN] Only include the two entries that can be verified in the docs, and give "how to prove you filled
        # [EN] it in correctly" -- which is the
        # [EN] "fetch model list" next to it. **Deliberately list only two**: better to list fewer than to
        # [EN] write a
        # [EN] possibly outdated third-party address in the UI (that kind of error is very hard for users to
        # [EN] notice).
        _SVC_HINT = ft.Container(
            content=mk_hint(t('常见服务怎么填（Base URL 写到 /v1 或 /plan/v3 这一层，'
                              '程序自己接 /chat/completions）：\n'
                              '· DeepSeek：https://api.deepseek.com/v1\n'
                              '· 腾讯 TokenHub（混元 Hy3）：'
                              'https://tokenhub.tencentmaas.com/plan/v3，模型名 hy3\n'
                              '别的服务照它的文档填。填完点右边「拉取模型列表」，'
                              '能列出名字就说明地址与 Key 都对。')),
            width=SET_W)

        # ── 拉取模型列表（挨着 Base URL）──
        # 状态文字**单独占一行**：错误信息里带服务端原话，塞在同一行会把
        # 行撑宽（本项目对"行宽恒等于 SET_W"是硬要求）。
        # [EN] -- Fetch model list (next to Base URL) --
        # [EN] The status text **occupies its own line**: error messages contain the server's exact words, and
        # [EN] cramming them onto the same line would
        # [EN] stretch the line wide (this project has a hard requirement that "line width is always equal to
        # [EN] SET_W").
        list_line = ft.Text('', size=HINT_FS, color=C['muted'],
                            width=SET_W, selectable=True)
        pull_btn = mk_btn(t('拉取模型列表'), width=BTN_PULL_W, height=SET_H,
                          primary=False)
        base_url_row = ft.Row([base_url, pull_btn], spacing=8,
                              vertical_alignment=ft.CrossAxisAlignment.CENTER)

        # ── 模型选择 ──（2026-10-12 重做：改成**模型登记表**）
        # 这一段原来只有三个下拉（华彩/日常/摘要各填一个模型名），
        # 现在换成"模型列表 + 默认模型 + 三档快速配置"，见 `_model_list_section()`。
        # ⚠ 三个下拉**没有删掉** —— 用户拍板"保留三档做快速配置"：
        #   Agent 没点名时按它自己那一档走（解析顺序见 `llm/models.resolve()`）。
        # [EN] -- Model selection -- (redone 2026-10-12: it is now a **model registry**)
        # [EN] This segment used to be three dropdowns (one model name each for
        # [EN] flourish/daily/summary); it is now "model list + default model + three-tier quick
        # [EN] config", see `_model_list_section()`.
        # [EN] ⚠ The three dropdowns were **not removed** -- the user ruled "keep the three tiers as
        # [EN] quick config": when an Agent names nothing, it follows its own tier (see
        # [EN] `llm/models.resolve()`).
        model_state: dict = {'entries': _MODELS.ensure_ready(),
                             'tier_box': ft.Column([], spacing=4),
                             'pickers': {}}
        dd_w = SET_W - 8 - BTN_TEST_W

        def _paint(ctrl, text: str, level: str = 'info') -> None:
            """给状态文字上色。级别沿用全局消息框那一套（ok/error/warn/info）。
                        English:
            Colorize the status text. Levels follow the global message box set (ok/error/warn/info).
            """
            ctrl.value = text
            ctrl.color = {'ok': C['accent_green'], 'warn': C['seal'],
                          'error': C['seal']}.get(level, C['muted'])

        def _now() -> dict:
            """**界面上此刻的值**（可能还没保存）。

            测试必须用框里的新值：用户改完名字第一件事就是点测试，
            而 `CFG` 里还是老的 —— 拿保存过的值去测，测的是上一次的配置。
            
                        English:
            **The value currently in the UI** (may not be saved yet).
                        Tests must use the new value in the box: the first thing a user does after editing the name is click Test,
                        but `CFG` still has the old one — testing with the saved value tests the previous configuration.
            """
            return dict(base_url=field_value(base_url),
                        api_key=field_value(api_key),
                        provider=CFG.s('LLM_PROVIDER'))

        def _refill(ids: list) -> str:
            """拉到了一批模型名 —— 记进缓存，并告诉用户怎么用它。

            ★ 2026-10-12 改：以前这里是"灌进三个下拉框"，现在模型是**登记表**，
              拉到的名字**不自动变成模型条目** —— 一次拉回来几十个，
              全塞进登记表只会让列表变成一团噪音，而且它们**没有密钥**（等于假条目）。
              所以这里只做到"把名字留在缓存里 + 告诉用户去「＋ 新增模型」里挑"。

                English:
            A batch of model names was fetched -- record it in the cache and tell the user how to use it.
                ★ Changed 2026-10-12: this used to "pour into three dropdowns"; now models are a
                **registry**, and fetched names **do not automatically become entries** -- a single
                fetch returns dozens, and stuffing them all into the registry would turn the list
                into noise, besides having **no key** (i.e. fake entries). So this only does "keep the
                names in the cache + tell the user to pick one under '+ Add model'".
            """
            if not ids:
                return ''
            shown = '、'.join(ids[:6])
            more = t('（还有 {n} 个）', n=len(ids) - 6) if len(ids) > 6 else ''
            return t('拉到了 {n} 个模型名：{list}{more} —— 在「＋ 新增模型」里'
                     '把它们填进去（每条要自己的密钥）。', n=len(ids),
                     list=shown, more=more)

        async def _pull():
            pull_btn.disabled = True
            _paint(list_line, t('正在拉取模型列表…'))
            page.update()
            try:
                res = await probe.list_models(**_now())
            except Exception as e:                              # noqa: BLE001
                _paint(list_line, t('❌ 拉取时出错：{err}', err=repr(e)), 'error')
            else:
                extra = _refill(res.ids) if res.ok else ''
                line = res.line()
                if extra:
                    line += ' ｜ ' + extra
                _paint(list_line, line, 'ok' if res.ok else 'error')
                if res.ok:
                    # 内存级写入；点「保存」时随其它项一起落盘（见 save 末尾）。
                    # [EN] In-memory write; when "Save" is clicked it is persisted to disk along with the other items (see
                    # [EN] the end of save).
                    CFG.set('MODEL_LIST_CACHE', ','.join(res.ids))
                get_logger('nws.gui').info('拉取模型列表：%s', line[:200])
                # ★ **结果同时进全局消息框**。这一条不是锦上添花：
                #   这一节在选项卡里是要**滚动**才看得到的（对话框内容区只有
                #   三百多像素，实测三档模型行本来就在首屏之外），
                #   而"拉取/测试的结果"必须在**用户一定看得见**的地方 ——
                #   用户的原话就是「如果不行可以马上把错误信息爆出来」。
                # [EN] ★ **The result also goes into the global message box**. This one is not a nice-to-have:
                # [EN] this section requires **scrolling** to be seen in the tab (the dialog content area is only
                # [EN] a bit over three hundred pixels, and measurements show the three model rows are already off the
                # [EN] first screen),
                # [EN] and "the result of fetch/test" must be somewhere the **user is guaranteed to see** --
                # [EN] the user's exact words were "if it fails you can immediately surface the error message".
                self._post_message(t('拉取模型列表：{r}', r=line),
                                   level='ok' if res.ok else 'error', keep=True)
            pull_btn.disabled = False
            page.update()

        pull_btn.on_click = lambda e: page.run_task(_pull)
        list_block = ft.Column([base_url_row, list_line], spacing=4)



        # ── 剧组（`crew/`，2026-10-07）──────────────────────────────
        #   用户：「各个Agent合理的分配到界面各个位置」。这一栏就是**这班人的
        #   在岗表** —— 每个职位一行（状态点 + 名字 + 最近一次产出）。
        # [EN] ── Crew (`crew/`, 2026-10-07) ──────────────────────────────
        # [EN] User: "each Agent reasonably assigned to each position on the interface". This column is **these
        # [EN] people's
        # [EN] on-duty roster** -- one row per role (status dot + name + most recent output).
        #   ⚠ 读的是 `loop.studio.ledger()`，**不是另存一份界面状态**：
        #     界面显示的和日志/落盘里记的必须是同一件事
        #     （两处各存一份，第一件会出现的事就是"界面上写'已交活'，
        #      而台账里那行还是空的"）。
        #   ⚠ `STRETCH` 是**给高亮用的**（2026-10-08）：出工中那一行是一块
        #     带底色的 `Container`，不拉满宽度的话它只包住文字那一小段，
        #     看着像个标签而不是"这一行在亮"。对普通行没有视觉影响
        #     （`ft.Row` 拉满后内容照旧靠左）。
        # [EN] ⚠ It reads `loop.studio.ledger()`, **not a separately stored UI state**:
        # [EN] what the UI shows and what is recorded in the log/on disk must be the same thing
        # [EN] (if both store their own copy, the first thing that happens is "the UI says '已交活'
        # [EN] while that row in the ledger is still empty").
        # [EN] ⚠ `STRETCH` is **for highlighting** (2026-10-08): the row currently working is a
        # [EN] `Container` with a background color; without stretching to full width it only wraps the small
        # [EN] segment of text,
        # [EN] looking like a label rather than "this row is lit up". No visual effect on ordinary rows
        # [EN] (once `ft.Row` is stretched, the content stays left-aligned as before).
        crew_list = ft.Column([], spacing=3,
                              horizontal_alignment=ft.CrossAxisAlignment.STRETCH)
        self._ui_run['crew_list'] = crew_list
        crew_panel = self._create_panel(
            t("剧组"),
            [crew_list,
             ft.Text(t('点「起　笔」开拍后，这班人各司其职'), size=HINT_FS,
                     color=C['muted'], no_wrap=False)],
            tip=t("这一班出工的人（小说作家 / 编剧 / 导演 / 场记 …）。\n"
                  "谁在干活会高亮；点了名的人这一轮没派上用场就一直是灰的。\n"
                  "★ **点标题**去「剧组 Agents」列表；**点某一行**直接打开"
                  "那个职位的设置（名字 / 作用 / 系统提示词）。"),
            goto=self._goto_crew,
            goto_tip=t('点标题去「剧组 Agents」列表（在跑：书斋 / 没跑：天问）'))
        self._ui_run['crew_hint'] = crew_panel.content.controls[-1]

        right = ft.Column([char_panel, plot_panel, crew_panel],
                          spacing=8, width=240,
                          scroll=ft.ScrollMode.AUTO,
                          horizontal_alignment=ft.CrossAxisAlignment.STRETCH)
        right_bar = self._scroll_bar(right, self.RUN_SIDE_H, lane=self.RUN_SIDE_LANE,
                                    scroller=right)

        # 主内容区
        # [EN] Main content area
        content = ft.Row([left_bar, center, right_bar], spacing=8, expand=True)

        # 背景：淡彩水墨（铺满，半透明面板让画面透出来）
        # [EN] Background: light ink wash (fills the area; the semi-transparent panel lets the image show
        # [EN] through)
        bg_path = get_bg('soft')
        bg = ft.Image(src=bg_path, opacity=1.0 if bg_path else 0.0,
                      fit=ft.BoxFit.COVER, left=0, top=0, right=0, bottom=0)

        # 主体：Stack 默认 StackFit.LOOSE（松约束），子控件只按内容宽度收缩，
        # 中栏会被压得很窄。必须用 StackFit.EXPAND 让非定位子控件铺满整块，
        # 再配合 Column 的 STRETCH 横向拉伸，header / 内容行才会撑满。
        # 全局消息框：紧贴页头下方（页头就是这块界面的「状态栏」）。
        # 常驻可见 —— 需要处理的消息（配置被改回、需重启…）不能靠 SnackBar 一闪而过。
        # [EN] Body: Stack defaults to StackFit.LOOSE (loose constraints), so child controls shrink to content
        # [EN] width,
        # [EN] and the middle column gets squeezed very narrow. You must use StackFit.EXPAND so non-positioned
        # [EN] child controls fill the whole block,
        # [EN] and combined with Column's STRETCH for horizontal stretching, the header / content rows will
        # [EN] fill the width.
        # [EN] Global message box: right below the page header (the page header is this interface's "status
        # [EN] bar").
        # [EN] Always visible -- messages that need action (config was changed back, restart required...) must
        # [EN] not flash by in a SnackBar.
        msg_bar = ft.Container(
            content=self._message_bar(),
            padding=ft.Padding(10, 6, 10, 6),
        )

        body = ft.Column([header, msg_bar, content], spacing=0,
                         horizontal_alignment=ft.CrossAxisAlignment.STRETCH)

        page.add(ft.Stack([bg, body], expand=True, fit=ft.StackFit.EXPAND))
        page.update()
        # 按当前会话状态定按钮的可用性与文字（暂停↔继续 在这里切换）
        # [EN] Set the button's availability and text based on the current session state (pause↔resume toggles
        # [EN] here)
        self._refresh_run_controls()
        # 剧组面板：进界面时**先画一次**（正在跑的话立刻就有内容；
        # 没在跑则留空 —— 不预填，本项目的规矩）。
        # [EN] Crew panel: **draw it once** when entering the interface (if it's running there's content
        # [EN] immediately;
        # [EN] if not running, leave it blank -- no pre-filling, that's this project's rule).
        self._refresh_crew_panel()

    # ══════════════════════════════════════════════════════════
    #  剧组面板（`crew/`，2026-10-07）
    # [EN] Crew panel (`crew/`, 2026-10-07)
    # ══════════════════════════════════════════════════════════
    #: 职位状态 → (字面用什么颜色键, 圆点用什么颜色键)。
    #: 与 `crew/studio.py::ledger_md` 的四个状态**一一对应**
    #: （台账里写"待命/出工中/已交活/未启用"，界面不能自己另起一套说法）。
    # [EN] : role status → (which color key for the text, which color key for the dot).
    # [EN] : **one-to-one correspondence** with the four statuses in `crew/studio.py::ledger_md`
    _CREW_STATE_STYLE: dict[str, tuple[str, str]] = {
        'idle': ('muted', 'muted'),
        'working': ('text', 'accent'),
        'done': ('text', 'accent_green'),
        'off': ('muted', 'muted'),
    }

    #: ★★ **「正在出工」那一行的高亮样式**（2026-10-08 用户要求：
    #:   「右侧的剧组成员 谁在干活请高亮显示 等不干活了再恢复普通样式
    #:    以让用户知道谁在干活」）。
    # [EN] : ★★ **the highlight style for the "正在出工" row** (2026-10-08 user request:
    # [EN] : "the crew members on the right, please highlight whoever is working, and restore the normal
    # [EN] style when they stop working
    # [EN] :    so the user knows who is working").
    #: 四条一起用，缺一条都"不够显眼"（试过只换文字颜色 —— 在 12 号字上
    #: 几乎看不出来）：
    #:   · 暖金底（不透明实色：面板本身是半透明的，用半透明色会被背景吃掉）；
    #:   · 左侧一道**朱砂竖条**（与 `_narr_card` 的 accent 条同一套语言）；
    #:   · 金边（跟旁边那些没在跑的行分开）；
    #:   · 名字用**赭金加粗** + 状态词"出工中"。
    #: 干完活（`done` / `idle` / `off`）**一律恢复普通样式** ——
    #: 高亮是"此刻在动"的记号，不是"干过活"的勋章（后者靠那个绿点）。
    CREW_BUSY_BG = '#f7e2ae'      # 暖金底
    #: 朱砂竖条与"出工中"那个圆点**同一个色**（就取色表里的朱砂，
    #: 不另写一个十六进制 —— 配色要改时只改一处）。
    # [EN] : all four are used together; missing any one is "not eye-catching enough" (tried changing only
    # [EN] the text color -- on 12pt text
    # [EN] : it's almost imperceptible):
    # [EN] : · warm gold background (opaque solid color: the panel itself is semi-transparent, so a
    # [EN] semi-transparent color would be swallowed by the background);
    # [EN] : · a **cinnabar vertical bar** on the left (same visual language as the accent bar in
    # [EN] `_narr_card`);
    # [EN] :   · gold border (to separate it from the neighboring rows that aren't running);
    # [EN] :   · the name in **ochre-gold bold** + the status word "出工中".
    # [EN] : When done (`done` / `idle` / `off`), **always restore the normal style** --
    # [EN] : the highlight is a marker for "moving right now", not a medal for "has worked" (the latter is
    # [EN] shown by that green dot).
    # [EN] warm gold background
    # [EN] : the cinnabar vertical bar is **the same color** as the "出工中" dot (just take the cinnabar from
    # [EN] the color palette,
    # [EN] : don't write another hex value -- when the palette changes, only one place needs changing).
    CREW_BUSY_BAR = C['seal']
    CREW_BUSY_PAD = ft.Padding(6, 4, 5, 4)

    def _refresh_crew_panel(self) -> None:
        """按 `studio.ledger()` 重画「剧组」面板。

        **读的是台账本身**（`loop.studio.ledger()`）—— 界面显示的和日志/落盘里
        记的必须是同一件事。自己另存一份界面状态，第一件会出现的事就是
        "界面上写'已交活'，而台账里那行还是空的"。

        没有会话（还没起笔 / 已收工）时留空 —— **不预填**（本项目的规矩）。

        ★ **谁在干活要高亮**（2026-10-08）。判据走 `r['busy']`（台账算的），
          界面**不自己判** `state == 'working'` —— 口径只有一处定义才不会漂。
        
                English:
        Redraw the "Cast" panel from `studio.ledger()`.
                **Reads the ledger itself** (`loop.studio.ledger()`) -- what the UI shows and what is
                recorded in logs/on disk must be the same thing. If you keep a separate copy of UI state, the first thing
                that happens is "the UI says 'done', while that line in the ledger is still empty".
                Leave empty when there is no session (not yet started / already wrapped up) -- **do not prefill** (project convention).
                ★ **Who is working must be highlighted** (2026-10-08). The criterion comes from `r['busy']` (computed by the ledger);
                  the UI **does not** judge `state == 'working'` on its own -- only a single definition of the criterion prevents drift.
        """
        col = self._ui_run.get('crew_list')
        if col is None:
            return
        ses = self.session
        studio = getattr(getattr(ses, 'loop', None), 'studio', None) if ses else None
        if studio is None:
            if col.controls:
                col.controls = []
                self._safe_update(col)
            return
        try:
            rows = studio.ledger()
        except Exception:                                        # noqa: BLE001
            return
        ctrls: list = []
        for r in rows:
            busy = bool(r.get('busy'))
            ck, dk = self._CREW_STATE_STYLE.get(r.get('state', 'idle'),
                                                ('muted', 'muted'))
            line = str(r.get('line') or '').strip()
            # ★★ 第二行**照实说"此刻在做什么"**（2026-10-08 用户报的）：
            # [EN] ★★ The second line **honestly says "what it's doing right now"** (2026-10-08 user report):
            #   以前不管什么状态，只要还没交过活就写「还没轮到」—— 于是那行
            #   上面明明亮着「出工中 · 已跑 12 秒」，下面却写着「还没轮到」，
            #   自相矛盾。用户原话：「右边人员都在干活了 跟着他们的状态还是
            #   还没轮到 这个有点奇怪」。
            # [EN] previously, regardless of status, as long as it hadn't delivered yet it would say "还没轮到" -- so
            # [EN] that row
            # [EN] contradicting itself. The user's exact words: "the people on the right are all working, yet
            # [EN] their statuses still say
            #   现在分三种：**在干活就写它正在做的那件事**（该职位的职责，
            #   `ledger()` 里本来就有）、**未启用的**写"这一轮没启用"、
            #   剩下的才是真的"还没轮到"。
            # [EN] Now there are three cases: **if it's working, write the thing it's doing** (that role's duty,
            if not line:
                duty = str(r.get('duty') or '').strip()
                if busy:
                    line = (t('正在做：{d}', d=duty) if duty else t('正在做…'))
                elif r.get('state') == 'off':
                    line = t('这一轮没启用')
                else:
                    line = t('还没轮到')
            # 状态词只在**不寻常**时才写出来（待命/未启用），
            # 交活了就是交活了 —— 一行里塞两个词会把那一行挤满。
            # [EN] delivered is delivered -- cramming two words into one row would fill that row up.
            note = ''
            if r.get('state') == 'off':
                note = t('未启用')
            elif busy:
                # 出工中 + **已跑几秒**：这一栏最要紧的信息就是"它还在跑、
                # 跑了多久"。没有秒数的话，一个跑了三分钟的职位和一个
                # 刚起步的职位在屏幕上一模一样。
                # [EN] 出工中 + **seconds elapsed**: the most important info in this column is "it's still running,
                # [EN] and for how long". Without seconds, a role that has been running for three minutes and one that
                # [EN] just started look identical on screen.
                secs = float(r.get('secs') or 0.0)
                note = (t('出工中 · 已跑 {s} 秒', s=int(secs)) if secs >= 1
                        else t('出工中…'))
            head = f"{r.get('name', '')}" + (f' · {note}' if note else '')
            # ★ 每一行都能点开"这个职位"的设置（2026-10-11 用户要求）。
            # ⚠ 用**关键字绑定的单层 lambda**（`k=_k`），不写双层 lambda ——
            #   双层那个坑本项目已经踩过一次（见 `_agents_tab` 里 `_casting_open`
            #   的说明：`on_casting()` 只会返回内层函数、根本不调用）。
            # [EN] ★ Every row can open "this position's" settings (requested by the user on 2026-10-11).
            # [EN] ⚠ Uses a **keyword-bound single-layer lambda** (`k=_k`), not a double lambda -- this
            # [EN] project already stepped on that pitfall once (see `_casting_open` in `_agents_tab`:
            # [EN] `on_casting()` merely returns the inner function and never calls it).
            _k = str(r.get('key') or '')
            ctrls.append(self._crew_row(
                r, busy=busy, head=head, line=line, text_key=ck, dot_key=dk,
                on_click=(lambda e, k=_k: self._goto_crew_agent(k)) if _k else None))
        col.controls = ctrls
        hint = self._ui_run.get('crew_hint')
        if hint is not None:
            # 面板底下那句话随状态变：还没起笔时说"怎么开始"，
            # 开拍之后就没有必要再讲一遍了（那会占着一行不放）。
            # 有人在出工时**先说这件事**（那是此刻唯一在动的信息）。
            # [EN] The sentence at the bottom of the panel changes with status: before starting it says "how to
            # [EN] begin",
            # [EN] and after filming starts there's no need to repeat it (that would occupy a row indefinitely).
            # [EN] When someone is working, **say this first** (that's the only moving piece of information right
            # [EN] now).
            busy_n = sum(1 for r in rows if r.get('busy'))
            done = sum(1 for r in rows if r.get('state') == 'done')
            if busy_n:
                hint.value = t('{n} 位正在出工（高亮的那几位）', n=busy_n)
            elif done:
                hint.value = t('{n} / {m} 位已交活', n=done, m=len(rows))
            else:
                hint.value = t('点「起　笔」开拍后，这班人各司其职')
        self._safe_update(col)

    def _crew_row(self, r: dict, *, busy: bool, head: str, line: str,
                  text_key: str, dot_key: str,
                  on_click=None) -> ft.Control:
        """剧组面板里的一行。`busy=True` = **正在出工 → 高亮**。

        干完活恢复普通样式：`Container` 的底色/描边/圆角全部撤掉，
        就退回原来那个"圆点 + 两行字"的样子（`bgcolor=None`）。

        ★★ `on_click`（2026-10-11 用户要求）：给了就**整行可点** ——
          点一下直接进这个职位的设置（`_goto_crew_agent`）。
          用户原话：「点击某一个Agent则直接进入项目的Agent设置」。
          ⚠ 套 `ft.GestureDetector` 是**包在最后**（不是改 `inner` 本身）：
            高亮那一支返回的是 `Container`、普通那一支返回的是 `Row`，
            两种都要能点，包一层才不用写两遍。
          ⚠ 悬停说明写**职位名**（不是干巴巴一句"点击设置"）：
            这一栏一屏能有好几行，说清"点了会开哪一个"才不会点错。

                English:
        One row in the Cast panel. `busy=True` = **currently working -> highlight**.
                Restore normal style when work is done: remove all of `Container`'s background/border/corner radius,
                reverting to the original "dot + two lines of text" look (`bgcolor=None`).
                ★★ `on_click` (requested by the user on 2026-10-11): when provided the **whole row is
                  clickable** -- one click goes straight to that position's settings
                  (`_goto_crew_agent`). The user's exact words: "clicking one Agent goes directly into the
                  project's Agent settings".
                ⚠ The `ft.GestureDetector` is wrapped **at the end** (not by changing `inner` itself): the
                  highlighted branch returns a `Container` and the normal branch returns a `Row`, and both
                  must be clickable -- wrapping once avoids writing it twice.
                ⚠ The hover text names **the position** (not a bare "click to configure"): this column can
                  hold several rows on one screen, and saying which one will open prevents mis-clicks.
        """
        dot_color = self.CREW_BUSY_BAR if busy else C.get(dot_key, C['muted'])
        name_color = C['gold'] if busy else C.get(text_key, C['text'])
        inner = ft.Row([
            ft.Text('●', size=(10 if busy else 8), color=dot_color),
            ft.Column([
                ft.Text(head, size=HINT_FS, color=name_color,
                        weight=(ft.FontWeight.BOLD if busy
                                else ft.FontWeight.NORMAL),
                        no_wrap=True, overflow=ft.TextOverflow.ELLIPSIS),
                ft.Text(line or t('还没轮到'), size=HINT_FS,
                        color=(C['text'] if busy else C['muted']),
                        no_wrap=True, overflow=ft.TextOverflow.ELLIPSIS),
            ], spacing=0, expand=True),
        ], spacing=5, vertical_alignment=ft.CrossAxisAlignment.CENTER)
        row_ctl: ft.Control = inner
        if busy:
            row_ctl = ft.Container(
                content=inner,
                bgcolor=self.CREW_BUSY_BG,
                border=ft.Border(left=ft.BorderSide(3, self.CREW_BUSY_BAR)),
                border_radius=5,
                padding=self.CREW_BUSY_PAD,
            )
        if on_click is None:
            return row_ctl
        box = ft.GestureDetector(
            content=row_ctl, on_tap=on_click,
            mouse_cursor=ft.MouseCursor.CLICK,
            tooltip=t('点这一行去改「{name}」的设置', name=str(r.get('name') or '')))
        #: 抓手：判据靠它认出"这一行能点开该职位的设置"。
        # [EN] : Handle: the criteria use it to recognize "this row opens that position's settings".
        box._crew_goto = str(r.get('key') or '')
        return box

    def _on_crew_work(self, key: str, state: str) -> None:
        """**某位剧组成员开始/结束干活** → 立刻把那一栏重画一次（2026-10-08）。

        用户：「右侧的剧组成员 谁在干活请高亮显示 等不干活了再恢复普通样式
        以让用户知道谁在干活」。

        ⚠ 为什么是**事件**而不是只靠那 0.5 秒一轮的定时刷新：出工是一阵一阵的，
          定时刷新**天然会漏帧** —— 短出工（演示模式下几十毫秒）整个落在两次
          刷新之间，屏幕上永远看不到有人亮过。事件驱动则"开始那一刻"就亮。
        ⚠ 这里**只重画，不做别的**：出工状态本身在台账里（唯一事实来源），
          界面不另存一份状态（否则迟早出现"界面亮着、台账里已经干完了"）。
        
                English:
        **A cast member starts/stops working** -> immediately redraw that row once (2026-10-08).
                User: "For the cast members on the right, please highlight whoever is working, and restore normal style when
                they are not working, so the user knows who is working".
                ⚠ Why an **event** instead of relying only on that 0.5-second periodic refresh: work comes in bursts,
                  and periodic refresh **naturally drops frames** -- a short work stint (tens of milliseconds in demo mode) falls entirely between two
                  refreshes, so you never see anyone light up on screen. Event-driven means it lights up "the moment it starts".
                ⚠ Here it **only redraws, does nothing else**: the working state itself lives in the ledger (single source of truth),
                  the UI does not keep a separate copy of state (otherwise sooner or later you get "UI lit up, but the ledger already finished").
        """
        try:
            self._refresh_crew_panel()
        except Exception:                                        # noqa: BLE001
            log_exception(t('刷新剧组面板失败'), category='ui')

    @staticmethod
    def _safe_update(ctl) -> None:
        try:
            ctl.update()
        except Exception:                                        # noqa: BLE001
            pass

    # ══════════════════════════════════════════════════════════
    #  运行页面板标题 → 设置页（2026-10-11 用户点名）
    # [EN] Run-page panel title → settings page (named by the user on 2026-10-11)
    # ══════════════════════════════════════════════════════════
    #  用户原话：「运行配置和风格控制 这2个我希望点了标题（用下划线表示可以点击）
    #  进入对应配置位置（项目设置的）且配置之后马上起效。右侧剧组则点击剧组
    #  （也可以点击）进入项目的Agent列表 点击某一个Agent则直接进入项目的
    #  Agent设置。以上是在启动推演的时候是这样。如果是还没启动启动推演，
    #  则点击这些按钮进入天问（全局设置）的对应页面」。
    #  ⇒ 规则（用户拍板："在跑→书斋，没跑→天问"）：
    #      · 推演**正在跑**      → 书斋（项目设置）对应页
    #      · 推演**还没启动**    → 天问（全局设置）对应页
    #  ★ 为什么"还没启动"要去天问，而不是"永远去书斋"：
    #    正跑着一本书时改的是**这一本**；还没开跑时这本书并没有
    #    "正在跑的现场"，此刻能调的只有程序层的默认值。
    #  ⚠ 这一层**只负责"去哪儿"**：跳转复用已有的两个对话框，不新造一套设置界面 ——
    #    两处各有一套才会出现"改了这页、那一页还是旧值"。
    #    （要复用的是 `show_project_settings` 与 `show_global_settings` 这两个）
    # [EN] ⇒ Rule (the user decided: "running -> study, not running -> Tianji"):
    # [EN] · deduction **running** -> the study (project settings) page
    # [EN] · deduction **not started** -> the Tianji (global settings) page
    # [EN] ★ Why "not started" goes to Tianji rather than "always the study":
    # [EN] when a book is running you're changing **this one**; when it hasn't started this book has no
    # [EN] "running scene" yet, and the only thing adjustable is the program-layer default.
    # [EN] ⚠ This layer **only decides "where to go"**: the jump reuses the two existing dialogs
    # [EN] (`show_project_settings` / `show_global_settings`) rather than building a second settings UI --
    # [EN] two parallel UIs would inevitably produce "changed it on this page, that page still shows the old
    # [EN] value".

    def _run_alive(self) -> bool:
        """这一轮**正在跑**吗（决定点标题去书斋还是天问）。

        ⚠ 与中栏"实时叙事"用的是**同一个判据**（`session.is_alive`）——
          两处各判一套的话，迟早出现"中栏在滚正文、而点标题却去了天问"。

            English:
        Is this round **currently running** (decides whether the title click goes to the study or to Tianji).
            ⚠ Uses the **same criterion** as the center column's "live narrative" (`session.is_alive`) -- two
            separate judgments would eventually produce "the center column is scrolling body text while the
            title click goes to Tianji".
        """
        try:
            return bool(self.session and self.session.is_alive)
        except Exception:                                        # noqa: BLE001
            return False

    def _clickable_title(self, title: str, goto, goto_tip: str = '') -> ft.Control:
        """把面板标题做成**可点入口**：下划线 + `↗` + 手型光标 + 悬停说明。

        判据抓手：返回的控件上挂 `_panel_goto = True`（真机脚本靠它认出
        "这是跳转标题"，不用去猜控件树的形状）。

            English:
        Turn the panel title into a **clickable entry**: underline + `↗` + hand cursor + hover text.
            Criterion handle: the returned control carries `_panel_goto = True` (the on-device script uses it to
            recognize "this is a jumping title" instead of guessing the control-tree shape).
        """
        row = ft.Row([
            ft.Text(title, size=BODY_FS, color=C['muted'],
                    style=ft.TextStyle(
                        decoration=ft.TextDecoration.UNDERLINE)),
            ft.Text(self._PANEL_GOTO_MARK, size=SZ(11), color=C['muted']),
        ], spacing=3, tight=True,
            vertical_alignment=ft.CrossAxisAlignment.CENTER)
        box = ft.GestureDetector(
            content=row, on_tap=goto,
            mouse_cursor=ft.MouseCursor.CLICK,
            tooltip=goto_tip or t('点这里去改这些值'))
        #: 抓手：判据靠它认出"这个标题能点"（见 `verify_run_panel_nav`）。
        # [EN] : Handle: the criteria use it to recognize "this title is clickable" (see
        # [EN] `verify_run_panel_nav`).
        box._panel_goto = True
        return box

    def _settings_target(self, *, book_tab: int, global_tab: int) -> tuple[str, int]:
        """该去哪个对话框、第几页（在跑 → 书斋；没在跑 → 天问）。

        ⚠ 书斋是**本书**设置，没有书就无从打开（那两个入口在开始界面
          本来就是灰的）——所以"没在跑且没有项目"时一律走天问，
          不会跳到一页什么也改不了的地方。

            English:
        Which dialog and which page (running -> study; not running -> Tianji).
            ⚠ The study is **book** settings; with no book there is nothing to open (those two entries are
            already greyed out on the start screen) -- so "not running and no project" always goes to Tianji,
            never to a page where nothing can be changed.
        """
        if self._run_alive() and self.current_project is not None:
            return 'book', int(book_tab)
        return 'global', int(global_tab)

    def _open_settings_at(self, kind: str, tab: int,
                          agent: str | None = None) -> None:
        """打开对应设置对话框并落在指定页（`agent` 给了就顺带弹出那个职位的编辑框）。
            English:
        Open the corresponding settings dialog on the given page (`agent`, if provided, also pops that
        position's editor right away).
        """
        try:
            if kind == 'book':
                self.show_project_settings(tab=tab, agent=agent)
            else:
                self.show_global_settings(tab=tab, agent=agent)
        except Exception as e:                                   # noqa: BLE001
            log_exception(t('打开设置页失败：{e}', e=f'{e!r}'), category='ui')
            self._show_snack(t('打开设置页失败：{e}', e=e), error=True)

    def _goto_run_config(self, e=None) -> None:
        """「运行配置」标题 → 这些值所在的那一页。
            English:
        "Run config" title -> the page where those values live.
        """
        kind, tab = self._settings_target(book_tab=self.TAB_BOOK_STYLE,
                                         global_tab=self.TAB_GLOBAL_RUN)
        log_ui_action(t('跳转到运行配置'), '书斋·类型风格' if kind == 'book' else '天问·运行')
        self._open_settings_at(kind, tab)

    def _goto_style(self, e=None) -> None:
        """「风格控制」标题 → 风格参数所在的那一页。
            English:
        "Style control" title -> the page where the style parameters live.
        """
        kind, tab = self._settings_target(book_tab=self.TAB_BOOK_STYLEPANEL,
                                         global_tab=self.TAB_GLOBAL_STYLE)
        log_ui_action(t('跳转到风格控制'), '书斋·风格控制' if kind == 'book' else '天问·导演与合规')
        self._open_settings_at(kind, tab)

    def _goto_crew(self, e=None) -> None:
        """「剧组」标题 → 剧组 Agents 列表那一页。
            English:
        "Cast" title -> the page listing the cast Agents.
        """
        self._goto_crew_agent(None)

    def _goto_crew_agent(self, key: str | None = None, e=None) -> None:
        """「剧组」标题（`key=None`）或**某一行**（`key='writer'`）→ Agents 列表／那一行的设置。

        ★ "点某一个 Agent 直接进入它的设置"是这样落地的：先打开
          「剧组 Agents」那一页（列表在下面铺好），紧接着把**那一个职位
          的编辑框**叠在上面 —— 关掉编辑框就回到列表，而不是回到运行页。
          比"只弹一个编辑框"多给了一层上下文。
          ⚠ **两层对话框是 Flet 支持的**（`show_dialog` 会叠），
            取消/保存调的都是 `pop_dialog()`，只会弹掉最上面那层。

            English:
        The "Cast" title (`key=None`) or **one row** (`key='writer'`) -> the Agents list / that row's settings.
            ★ "Clicking one Agent goes straight into its settings" is implemented like this: first open the
              "Cast Agents" page (the list lays out underneath), then stack **that one position's editor** on top
              -- closing the editor returns to the list, not to the run page. That gives one more layer of
              context than "just pop an editor".
            ⚠ **Two stacked dialogs are supported by Flet** (`show_dialog` stacks), and both cancel/save call
              `pop_dialog()`, which only pops the top layer.
        """
        kind, tab = self._settings_target(book_tab=self.TAB_BOOK_CREW,
                                         global_tab=self.TAB_GLOBAL_CREW)
        log_ui_action(t('跳转到剧组 Agents'),
                      f"{'书斋' if kind == 'book' else '天问'}·{key or '列表'}")
        self._open_settings_at(kind, tab, agent=key)

    def _after_settings_closed(self) -> None:
        """设置框关掉之后：**正停在运行页就重建一次**，让刚改的值立刻回到面板上。

        用户要的"配置之后马上起效"有两半：
          · **值本身**立刻生效 —— 由各控件写 `CFG` 达成（`CFG` 是唯一事实来源，
            推演循环每拍都现读）；
          · **面板上看得见** —— 就是这里：运行页的「运行配置 / 风格控制 / 系统」
            都是**建的时候读一次**，不重建就还显示旧数。

        ⚠ 只在 `_view == 'main'` 时重建：从开始界面打开设置再关掉，
          不该顺手把人从开始界面推到运行页。

            English:
        After the settings dialog closes: **rebuild once if we're on the run page**, so the values just
        changed show up on the panels immediately.
            The user's "takes effect right after configuring" has two halves:
              · **the value itself** takes effect immediately -- achieved by each control writing `CFG` (`CFG`
                is the single source of truth; the run loop re-reads it every beat);
              · **it's visible on the panel** -- that's this method: the run page's "Run config / Style control
                / System" are all **read once at build time**, so without a rebuild they still show the old
                numbers.
            ⚠ Only rebuilds when `_view == 'main'`: opening settings from the start screen and closing it must
              not drag the person from the start screen into the run page.
        """
        if self._view != 'main' or not self.current_project:
            return
        try:
            self.show_main_screen()
        except Exception:                                        # noqa: BLE001
            log_exception(t('重建运行界面失败'), category='ui')

    def _create_panel(self, title: str, controls: list,
                      tip: str = '', goto=None, goto_tip: str = '') -> ft.Container:
        """创建水墨丹青风格面板（半透明纸卡，透出背景）。

        `tip`（2026-10-10 加）：给了就在标题右边挂一个**白色带圈小问号**
        （`mk_tip`），鼠标放上去解释这一块是什么。运行界面左栏那一串面板
        名字都很短（「时间」「剧情」「系统」），第一次看的人未必知道
        "剧情"里是节点还是梗概、"系统"里是开关还是日志 —— 一句话说清，
        比让他点进去猜便宜。

        ★★ `goto`（2026-10-11 加，用户点名）：给了就把**标题本身**变成入口 ——
          文字带**下划线**、悬停变手型、右边跟一个 `↗`，点一下跳到写这些值的
          那一页设置。用户原话：「运行配置和风格控制 这2个我希望点了标题
          （用下划线表示可以点击）进入对应配置位置」。

        ★ 三个记号一起给，是因为**只给一个都会漏掉一类人**：
          · 下划线 —— 告诉"这里能点"（用户点名要的）；
          · `↗` —— 告诉"点了会去别处"（不是展开/折叠）；
          · 悬停说明 —— 告诉"会去哪一页"（省得点进去发现不是想找的那页）。
          鼠标形状是第四重保险（手型是全世界通用的"可点"信号）。

        ⚠ 用 `ft.GestureDetector` 而不是 `ft.Text(on_click=…)`：
          `ft.Text` 在 Flet 1.0 里没有 `mouse_cursor`（实测），
          做不出手型光标；`GestureDetector` 两个都有（`on_tap` + `mouse_cursor`）。
          判据 `verify_run_panel_nav` 认的是 `_panel_goto` 这个抓手属性。

            English:
        Create an ink-wash (shuimo danqing) style panel (translucent paper card, letting the background
        show through).
                `tip` (added 2026-10-10): if provided, hang a **white circled small question mark** to the right of the title
                (`mk_tip`); hovering explains what this block is. The panel names in the left column of the run UI are all
                very short ("Time", "Plot", "System"); a first-time viewer may not know whether
                "Plot" contains nodes or a synopsis, or whether "System" contains switches or logs -- one sentence clears it up,
                which is cheaper than making them click in and guess.
                ★★ `goto` (added 2026-10-11, requested by the user): when provided, the **title itself** becomes an entry
                  point -- the text is **underlined**, the cursor turns into a hand on hover, a `↗` follows it, and
                  clicking jumps to the settings page that owns these values. The user's exact words: "for Run Config
                  and Style Control, I want the title clickable (underlined to show it can be clicked) to enter the
                  corresponding settings location".
                ★ All three cues are given because **any one alone misses a class of people**:
                  · the underline -- says "this can be clicked" (the user explicitly asked for it);
                  · the `↗` -- says "clicking goes elsewhere" (not expand/collapse);
                  · the hover text -- says "which page it goes to" (saves clicking in and discovering it's the wrong page).
                  The cursor shape is the fourth safety net (a hand is a universally understood "clickable" signal).
                ⚠ Uses `ft.GestureDetector` rather than `ft.Text(on_click=...)`: `ft.Text` has no `mouse_cursor` in
                  Flet 1.0 (measured), so it cannot produce a hand cursor; `GestureDetector` has both (`on_tap` +
                  `mouse_cursor`). The criterion `verify_run_panel_nav` recognizes the `_panel_goto` handle attribute.
        """
        head: ft.Control = ft.Text(title, size=BODY_FS, color=C['muted'])
        if goto is not None:
            head = self._clickable_title(title, goto, goto_tip)
        if tip:
            head = ft.Row([head, mk_tip(tip)], spacing=5,
                          vertical_alignment=ft.CrossAxisAlignment.CENTER)
        content = [head, ft.Divider(height=8, color='transparent')]
        content.extend(controls)
        return ft.Container(
            content=ft.Column(content, spacing=4),
            bgcolor=C['panel_glass'],
            border=make_border(1, C['border']),
            border_radius=6,
            padding=ft.Padding(12, 12, 12, 12),
        )

    def _style_bar(self, label: str, key: str) -> ft.Row:
        """左栏「风格控制」的一行：标签 + 进度条 + 「当值/最大值」。

        用户 2026-10-08：
        「左下角的**风格控制**部分 每个参数的数值**不显示出来** 正常应该是
          **中间线条显示类似进度条的样式** 右侧横线是**数值 5/10** 这样的
          **当值 最大值**的形式」

        ★ 之前是坏的，而且是"两头都不对"：
          · 调用处一律 `_style_bar(标签)` —— **不传 value** → `value=None`
            → 永远空条 + 「—」；而且**全仓没有任何一处**再给它填过值
            （同一天已经踩过两次同一个病：时间面板、底部状态条 —— 都是
             "控件建出来就没人管"）。所以从进界面到跑完，"风格控制"永远是空的。
          · 右边写的是百分比（`30%`）——用户要的是**当值/最大值**（`3/10`）。
            为什么 10：这一档参数的分档数就是 10（见 `STYLE_DIV` 与
            「书斋 · 风格控制」那些滑杆的 `divisions=10`）。

        `key` 是配置键：值的**唯一事实来源是 `CFG`**（「起笔」对话框与
        「书斋 · 风格控制」写的都是它）。控件句柄存进 `_ui_run['style_rows']`，
        好让秒表按真值刷 —— 见 `_refresh_style_panel()`。
        
                English:
        One row of "Style Control" in the left column: label + progress bar + "current/max value".
                User 2026-10-08:
                "The **Style Control** section in the lower left **does not display** the value of each parameter; normally it should
                  have **a line in the middle showing a progress-bar-like style**, and the horizontal line on the right should be **a value like 5/10**,
                  in the form **current value / max value**.
                ★ It was broken before, and wrong on **both ends**:
                  · Every call site was `_style_bar(label)` -- **no value passed** -> `value=None`
                    -> always an empty bar + "—"; and **nowhere in the entire repo** did anything ever fill in a value for it
                    (the same disease was hit twice on the same day: the time panel and the bottom status bar -- both were
                     "the control is created and then nobody takes care of it"). So from entering the UI to finishing the run, "Style Control" was always empty.
                  · The right side showed a percentage (`30%`) -- what the user wants is **current value / max value** (`3/10`).
                    Why 10: the number of divisions for this tier of parameter is 10 (see `STYLE_DIV` and
                    the `divisions=10` on those sliders in "Study · Style Control").
                `key` is the config key: the **single source of truth for the value is `CFG`** (both the "Start Writing" dialog and
                "Study · Style Control" write to it). The control handles are stored in `_ui_run['style_rows']`,
                so the stopwatch can refresh against the true value -- see `_refresh_style_panel()`.
        """
        bar = ft.ProgressBar(value=0.0, color=C['accent'], expand=True, height=6)
        num = ft.Text('—', size=HINT_FS, color=C['gold'], width=44)
        self._ui_run.setdefault('style_rows', {})[key] = (bar, num)
        self._fill_style_bar(key, bar, num)
        return ft.Row([
            ft.Text(t(label), size=HINT_FS, color=C['muted'], width=46),
            bar, num,
        ], spacing=8)

    def _fill_style_bar(self, key: str, bar, num) -> None:
        """把一条风格条填成 `CFG` 里的真值（读不到就空条 + 「—」，不抛）。
                English:
        Fill one style bar with the true value from `CFG` (if unreadable, empty bar + "—", do not
        raise).
        """
        try:
            v = max(0.0, min(1.0, float(CFG.f(key))))
        except Exception:                                       # noqa: BLE001
            bar.value, num.value = 0.0, '—'
            return
        bar.value = v
        num.value = f'{round(v * self.STYLE_DIV)}/{self.STYLE_DIV}'

    def _refresh_style_panel(self) -> None:
        """左栏「风格控制」按**配置真值**刷一遍（随秒表，零成本：只读配置）。

        为什么要**持续**刷、而不是"建界面时填一次"：这几个值是在
        「起笔」对话框里调的，而那一轮跑起来之后用户还会回头去「书斋」改 ——
        改了之后左栏如实不跟着变，就成了"界面在骗人"。
        
                English:
        Refresh the left-column "Style Control" once using **the config's true values** (with the
        stopwatch, zero cost: config reads only).
                Why **continuously** refresh instead of "fill once when building the UI": these values are set in
                the "Start Writing" dialog, and after that run is underway the user will still go back to the "Study" and change them --
                if the left column doesn't follow along truthfully after the change, it becomes "the UI is lying."
        """
        rows = dict(self._ui_run.get('style_rows') or {})
        if not rows:
            return
        for key, (bar, num) in rows.items():
            self._fill_style_bar(key, bar, num)

    # ── 「系统」面板里那个会变的数：今天已用 / Token 预算 ──────────────
    # [EN] The changing number in the "System" panel: used today / Token budget
    def _budget_used(self) -> int:
        """本进程今天已经花掉的 token（输入 + 输出）。

        ★★ 为什么读**内存账本**（`llm.ledger`）而**不是**全局台账库
        （`usage.db`）—— 这是这一行唯一容易做错的地方：
          ① **必须与「预算耗尽」的判定同源**。`LLM.budget_exceeded()` 用的就是
             `ledger.today_tokens`，主循环弹的「今天的 token 用完了」对话框里
             那个数也是它。两边若各取一处，屏幕上就会出现
             "显示已经超了、程序却照跑"（库里的量含**别的进程** ——
             判据脚本、开卷摄取、另开的一轮推演，全都记在同一个库上）。
          ② **零成本**：只读一个内存列表，不查库、不问模型。这一行挂在
             0.5 秒的秒表上，不能每次去开一个 SQLite 连接。
        ★ 拿不到账本（判据里的替身、导入失败）就返回 0 —— 界面不该因为
          记账问题崩掉，与 `llm/usage.record()` 的"失败只记日志"同一个道理。
        [EN] Today's spent tokens (input + output) **in this process**.
        [EN] ★★ Why the **in-memory ledger** (`llm.ledger`) and **not** the global usage DB
        [EN] (`usage.db`) -- the one place this row is easy to get wrong:
        [EN]   ① **It must share the same source as the "budget exhausted" decision**.
        [EN]      `LLM.budget_exceeded()` uses `ledger.today_tokens`, and so does the number in the
        [EN]      "today's tokens are used up" dialog the main loop pops. If the two read from
        [EN]      different places, the screen will show "already over" while the program keeps
        [EN]      running (the DB total includes **other processes** -- verification scripts, the
        [EN]      open-book ingestion, another run of the simulation, all writing to the same DB).
        [EN]   ② **Zero cost**: it reads one in-memory list, no DB, no model. This row rides a
        [EN]      0.5-second stopwatch and must not open a SQLite connection each time.
        [EN] ★ If the ledger is unavailable (stand-ins in criteria, import failure) return 0 -- the
        [EN]   UI must not crash over bookkeeping, the same reasoning as "log only, never throw" in
        [EN]   `llm/usage.record()`.
        """
        try:
            return int(getattr(llm.ledger, 'today_tokens', 0) or 0)
        except Exception:                                        # noqa: BLE001
            return 0

    def _budget_line(self) -> str:
        """「今天已用 / 每日上限」这一串字。

        ⚠ **不带千分位**（就是 `524288 / 500000` 这个样子），两个原因：
          ① 这一栏只有 220px 宽，左边还有个「Token 预算」标签；实测带千分位时
             「950,123 / 500,000」这一串就要 116px，加上标签 74px + 间距 6px
             = **196px，正好顶到边**（用微软雅黑 / 落笔字体都是这个数）。
             再涨一位数（`12,345,678`）当场越界 —— 而这一栏在窗口变窄 /
             字号放大到 150% 时更紧。宁可少两个逗号，也不要数字被裁掉。
          ② 它和改之前的样子（`0 / 500000`）保持一致，用户不会觉得"多出来一堆符号"。
        ⚠ **不要**套 `t(...)`：这一串只有数字和斜杠，中英文一模一样 ——
          套上去只会在 i18n 表里多一条没有意义的词条。
        [EN] The "used today / daily cap" string.
        [EN] ⚠ **No thousands separators** (it reads `524288 / 500000`), for two reasons:
        [EN]   ① this column is only 220px wide and the "Token 预算" label sits to its left; measured,
        [EN]      "950,123 / 500,000" alone needs 116px, and with the 74px label + 6px spacing that is
        [EN]      **196px -- exactly at the edge** (same number for Microsoft YaHei and the bundled
        [EN]      handwriting font). One more digit (`12,345,678`) goes over, and the column gets even
        [EN]      tighter when the window narrows or the font scale is 150%. Better two fewer commas
        [EN]      than a clipped number.
        [EN]   ② it matches the form before the change (`0 / 500000`), so the user doesn't see "a bunch
        [EN]      of new symbols".
        [EN] ⚠ **Do not** wrap it in `t(...)`: it is only digits and a slash, identical in Chinese and
        [EN] English -- wrapping it would just add a meaningless entry to the i18n table.
        """
        cap = CFG.i('TOKEN_BUDGET_PER_DAY')
        return f'{self._budget_used()} / {cap}'

    def _budget_color(self) -> str:
        """用量给这一行上色：过警告线转赭金、用满转朱砂，平时是墨色。

        ★ 警告线用 `TOKEN_WARN_AT`（和 `LLM._maybe_warn` 同一个配置项），
          不另立一个数 —— 两处口径不同会出现"这里的数字变黄了、
          日志里却还没到警告线"。
        [EN] Color this row by usage: ochre gold past the warning line, cinnabar when used up,
        [EN] ink color otherwise.
        [EN] ★ The warning line is `TOKEN_WARN_AT` (the same config item as `LLM._maybe_warn`),
        [EN] not a separate number -- two different thresholds would produce "this number turned
        [EN] gold while the log hasn't reached the warning line yet".
        """
        cap = CFG.i('TOKEN_BUDGET_PER_DAY')
        if cap <= 0:
            return C['text']
        used = self._budget_used()
        if used >= cap:
            return C['seal']
        try:
            warn_at = float(CFG.f('TOKEN_WARN_AT') or 0.8)
        except (TypeError, ValueError):
            warn_at = 0.8
        if warn_at > 0 and used >= cap * warn_at:
            return C['gold']
        return C['text']

    def _refresh_sys_panel(self) -> None:
        """刷新左下角「系统」面板里**会变的那一个数**（今天已用 token）。

        ★ 为什么要它（2026-10-12 用户原话：「左下角的系统的 Token 预算左侧的
          数字要实时更新」）：这一行原来写的是 `f"0 / {budget}"` —— 那个 `0`
          是**硬编码**的，从建出来到关窗口一动不动，用户看到的就是永远
          「0 / 200000」，哪怕这一轮已经烧掉一半预算。
        ★ 挂在 0.5 秒的秒表上（`_start_status_ticker`），和「时间」面板、
          「风格控制」同一个理由：数字要**自己走** —— 只靠"某件事发生时刷
          一下"的话，两拍之间屏幕是静止的，而"静止"和"坏了"长得一样。
        ★ 上限**每次重新读** `CFG`：用户可以在推演中用「预算用完了」那个
          对话框把上限翻倍（`sim/loop.py` 会 `CFG.set`），这时屏幕上的分母
          必须跟着变，否则又成了"界面在骗人"。
        ★ 面板还没建出来（没进运行界面 / 预算为 0 没这一行）就什么都不做。
        [EN] Refresh **the one changing number** in the bottom-left "System" panel (tokens used
        [EN] today).
        [EN] ★ Why it exists (user's words on 2026-10-12: "the number to the left of Token budget in
        [EN] the bottom-left system panel must update in real time"): this row used to read
        [EN] `f"0 / {budget}"` -- that `0` was **hardcoded**, motionless from creation to window
        [EN] close, so the user saw a permanent "0 / 200000" even after burning half the budget this
        [EN] round.
        [EN] ★ It rides the 0.5-second stopwatch (`_start_status_ticker`), for the same reason as the
        [EN] "Time" panel and "Style control": the number must **advance on its own** -- refreshing
        [EN] only "when something happens" leaves the screen static between beats, and "static" and
        [EN] "broken" look the same.
        [EN] ★ The cap is **re-read from `CFG` each time**: the user can double it mid-run from the
        [EN] "budget used up" dialog (`sim/loop.py` calls `CFG.set`), and the denominator on screen
        [EN] must follow, otherwise the UI is lying again.
        [EN] ★ If the panel does not exist yet (not in the run screen / budget is 0 so there is no
        [EN] such row), do nothing.
        """
        ctrl = (getattr(self, '_ui_run', None) or {}).get('budget_text')
        if ctrl is None:
            return
        if CFG.i('TOKEN_BUDGET_PER_DAY') <= 0:
            return
        ctrl.value = self._budget_line()
        ctrl.color = self._budget_color()


# ══════════════════════════════════════════════════════════════════════
#  界面字体 / 字号的**应用**（「天机 · 全局设置 → 界面外观」里可调）
# [EN] Applying the UI font / font size (adjustable in "Tianji · Global Settings → UI appearance")
# ══════════════════════════════════════════════════════════════════════
#  ★★ 为什么是"改模块级常量 + 改类属性"，而不是把 300 多处 `size=` 改成参数：
#     这套界面早就把字号收拢成了**十几个命名常量**（`HINT_FS` 142 处、
#     `BODY_FS` 65 处…），字面量只剩二十来处。所以"整体缩放"只要改那十几个
#     常量即可 —— 控件在**创建时**读全局，改完重建界面就是新字号。
#     （这也正是 `apply_ui_opacity()` 的路子，两处口径一致。）
#  ★ **缩放永远从基准值算起**，不是"在当前值上再乘" —— 后者会把 100%→130%
#    再回到 100% 变成 1.3×1.3=1.69 倍，且不可逆。
#  ★ 高度（`SET_H` / `BTN_H`）**必须跟着字号一起缩**：框高/字号是一条比例判据
#    （`developers/measure_controls.py` 卡着 [1.6, 2.6]），只放大字号会让
#    文字顶到边框上。
# [EN] ★★ Why "modify module-level constants + class attributes" instead of turning 300+ `size=`
# [EN] into parameters: this UI long ago consolidated font sizes into **a dozen named constants**
# [EN] (`HINT_FS` 142 places, `BODY_FS` 65, ...), leaving only ~20 literals. So "scale everything"
# [EN] only needs those dozen constants changed -- controls read the globals **at creation time**, so
# [EN] rebuilding the UI after the change gives the new sizes. (This is exactly the approach of
# [EN] `apply_ui_opacity()`; the two stay consistent.)
# [EN] ★ **Scaling always starts from the base value**, never "multiply the current value again" --
# [EN] the latter would make 100%→130%→100% end up at 1.3×1.3=1.69×, and irreversible.
# [EN] ★ Heights (`SET_H` / `BTN_H`) **must scale with the font size**: box height / font size is a
# [EN] ratio criterion (pinned to [1.6, 2.6] in `developers/measure_controls.py`), and scaling only
# [EN] the font size makes text press against the border.
_BASE_METRICS: dict = {
    'SET_H': SET_H, 'SET_FS': SET_FS, 'LBL_FS': LBL_FS, 'HINT_FS': HINT_FS,
    'BODY_FS': BODY_FS, 'SEC_FS': SEC_FS, 'DLG_TITLE_FS': DLG_TITLE_FS,
    'BTN_H': BTN_H, 'BTN_FS': BTN_FS,
    'SAVE_CARD_FS': SAVE_CARD_FS, 'MD_CODE_FS': MD_CODE_FS,
}
#: 叙事区的三个字号是**类属性**（`NovelWorldApp.NARR_FS` …），单独记基准。
# [EN] : the narrative area's three font sizes are **class attributes** (`NovelWorldApp.NARR_FS` ...),
# so their base values are tracked separately.
_BASE_NARR: dict = {}          # 在类定义之后填（见文件末尾）
# [EN] Fill in after the class definition (see end of file)


def font_scale() -> float:
    """当前字号缩放系数（读 `.env` 的 `UI_FONT_SCALE`，越界夹紧到 80~150）。
        English:
    The current font-size scale factor (reads `UI_FONT_SCALE` from `.env`, clamped to 80~150).
    """
    try:
        v = int(CFG.i('UI_FONT_SCALE') or 100)
    except (TypeError, ValueError):
        v = 100
    return max(80, min(150, v)) / 100.0


def SZ(base: float) -> float:
    """把一个**字面量**字号按当前缩放换算（保留一位小数）。

    只有二十来处真的很小的字（状态点、徽标、卡片小注）才走它；
    其余都走命名常量。**两者必须用同一个系数**，否则缩放到 130% 时
    会看到"大部分字变大了，角落里几处没动"。
    
        English:
    Convert a **literal** font size by the current scale (one decimal place).
        Only the ~20 genuinely tiny bits of text (status dots, badges, card notes) go through it;
        everything else uses the named constants. **Both must use the same factor**, otherwise at
        130% you'd see "most text grew but a few corners didn't move".
    """
    return round(base * font_scale(), 1)


def apply_font_settings() -> tuple:
    """按 `.env` 重算**字体族 + 全部字号/控件高**（原地改模块常量与类属性）。

    返回 `(font_family, scale)`，调用方可以用来打日志 / 决定要不要重建界面。
    **改完必须重建界面**才会看到效果（控件在创建时读这些值）。
    
        English:
    Recompute the **font family + all font sizes / control heights** from `.env` (modify module
    constants and class attributes in place).
        Returns `(font_family, scale)`; the caller can use it to log / decide whether to rebuild.
        **The UI must be rebuilt after the change** to see the effect (controls read these values at
        creation time).
    """
    global UI_FONT
    global SET_H, SET_FS, LBL_FS, HINT_FS, BODY_FS, SEC_FS, DLG_TITLE_FS, BTN_H, BTN_FS
    global SAVE_CARD_FS, MD_CODE_FS

    s = font_scale()
    for name, base in _BASE_METRICS.items():
        val = base * s
        # 高度**向上取整**，字号保留一位小数。
        # ★ 高度不能用四舍五入：130% 时 `round(24×1.3)=31`，而字号是 19.5，
        #   框高/字号 = 1.59 —— 刚好跌破 `measure_controls` 卡的下限 1.6
        #   （差 0.01 也是"字顶到边框"）。
        # [EN] Heights are rounded **up**, font sizes keep one decimal.
        # [EN] ★ Heights must not use round-half-even: at 130% `round(24×1.3)=31` while the font size is
        # [EN] 19.5, giving box height / font size = 1.59 -- just below the 1.6 lower bound that
        # [EN] `measure_controls` pins (0.01 off still means "text pressing the border").
        globals()[name] = int(math.ceil(val)) if name.endswith('_H') else round(val, 1)

    UI_FONT = resolve_ui_font(CFG.s('UI_FONT'))
    for attr, base in _BASE_NARR.items():
        setattr(NovelWorldApp, attr, round(base * s, 1))
    NovelWorldApp.NARR_FONT = UI_FONT
    NovelWorldApp.NARR_FONT_TITLE = UI_FONT
    return UI_FONT, s


# 类定义之后才能填基准（`NARR_FS` 那几个是类属性）
# [EN] Bases can only be filled in after the class definition (`NARR_FS` etc. are class attributes)
_BASE_NARR.update({
    'NARR_FS': NovelWorldApp.NARR_FS,
    'NARR_FS_BODY': NovelWorldApp.NARR_FS_BODY,
    'NARR_FS_TINY': NovelWorldApp.NARR_FS_TINY,
    'NARR_FS_STAMP': NovelWorldApp.NARR_FS_STAMP,
})
# 先算一次：保证任何界面构建之前，字号与字体就已是当前设置对应的值
# （与 `apply_ui_opacity()` 开头那一次同一个道理）。
# [EN] Compute once now: ensure font sizes and family already match the current settings before any UI
# [EN] is built (same reasoning as the initial call of `apply_ui_opacity()`).
apply_font_settings()


def start_gui():
    """启动 GUI 应用。
        English:
    Launch the GUI application.
    """
    app = NovelWorldApp()
    # ★ **显式**给 `assets_dir`（绝对路径）。不传时 Flet 默认用 "assets"，
    #   但那个相对路径是拿**当前脚本所在目录**去解析的 —— 也就是说能不能找到
    #   `assets/fonts/LXGWWenKai-Regular.ttf`，取决于"从哪里启动"。
    #   字体、说明书插图都住在 `assets/` 里，这种事不该靠推断。
    #   （实测：在 `tools/` 或 `developers/` 下跑脚本时，默认解析会落到
    #    `tools/assets`、`developers/assets` —— 都不存在，于是 `assets_dir`
    #    直接变成 None，`page.fonts` 静默失效、字体悄悄退回系统字体。）
    # [EN] ★ Give `assets_dir` **explicitly** (absolute path). If not passed, Flet defaults to "assets",
    # [EN] but that relative path is resolved against **the directory of the current script** -- that is,
    # [EN] whether it can find
    # [EN] `assets/fonts/LXGWWenKai-Regular.ttf` depends on "where you launched it from".
    # [EN] Fonts and manual illustrations all live in `assets/`; this kind of thing shouldn't rely on
    # [EN] inference.
    # [EN] (measured: when running scripts under `tools/` or `developers/`, the default resolution falls to
    # [EN] `tools/assets`, `developers/assets` -- neither exists, so `assets_dir`
    # [EN] becomes None directly, `page.fonts` silently fails, and fonts quietly fall back to system
    # [EN] fonts.)
    ft.run(app.main, assets_dir=str(APP_DIR / 'assets'))
