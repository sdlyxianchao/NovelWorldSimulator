# ═══════════════════════════════════════════════════════════════════════════════
# 小说世界AI模拟 · 配置文件
# ═══════════════════════════════════════════════════════════════════════════════
#
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 按需要修改配置
# 3. 启动程序：python start.exe（或 python main_gui.py）
#
# 配置指南请参见：配置指南.md
#
# ⚠ 本文件由 tools/sync_env_example.py 与 config.py 的 SPEC 对齐（键集合以 SPEC 为准）。
#   改注释请直接改本文件并重跑脚本 —— 脚本会保留已有注释，只补缺失的键。
#
# ═══════════════════════════════════════════════════════════════════════════════

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  模型与LLM                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# 接入协议
# - openai_compatible: OpenAI 兼容协议（支持 DeepSeek、OpenAI、智谱、Moonshot 等）
# - ollama: 本地 Ollama 服务（需先安装 Ollama）
# 候选：openai_compatible / ollama
# ⚠ 改完要重启程序才生效
LLM_PROVIDER=openai_compatible

# API 地址（OpenAI 兼容协议）
# - DeepSeek: https://api.deepseek.com/v1
# - OpenAI: https://api.openai.com/v1
# - 智谱: https://open.bigmodel.cn/api/paas/v4
# - Moonshot: https://api.moonshot.cn/v1
# - 本地 Ollama: http://localhost:11434/v1
# ⚠ 改完要重启程序才生效
LLM_BASE_URL=https://api.deepseek.com/v1

# API Key（必填，演示模式除外）
# - 从对应平台获取：https://platform.deepseek.com
# - 演示模式（MOCK_LLM=true）时可留空
# ⚠ 改完要重启程序才生效
LLM_API_KEY=

# 单次请求超时（秒）
# - 太小会大量重试反而费 token
# - 建议：60（默认）~ 120（复杂生成）
# ⚠ 改完要重启程序才生效
LLM_TIMEOUT_SECONDS=60

# 失败重试次数
# - 0 = 失败即暂停
# - 建议：3（默认）
# ⚠ 改完要重启程序才生效
LLM_MAX_RETRIES=3

# 全局并发上限（防 429 限流）
# - 多前台 Agent 决策排队 + 指数退避
# - 建议：4（默认），可根据 API 限额调整
# ⚠ 改完要重启程序才生效
LLM_MAX_CONCURRENCY=4

# 演示模式（零成本体验）
# - true: 不发任何真实请求，用内置语料跑全流程
# - false: 正常调用 LLM
# - 用途：体验界面、教学、截图制作
# ⚠ 改完要重启程序才生效
MOCK_LLM=false

# 三档模型（**快速配置**，2026-10-12 起从"唯一方式"降级为"Agent 没点名时的兜底"）
# - MODEL_FRONT: 华彩档（关键事件/重要对话/反思/故事文档/运行小结）~15% 调用量
# - MODEL_DAILY: 日常档（常规循环/日志整理）~55% 调用量
# - MODEL_CHEAP: 摘要档（压缩/打分/后台/进度评估）~30% 调用量
# - 值 = 模型登记表里的 **key**（迁移后通常就是原来的模型名）
# - 空 = 跳过这一档，往下走"默认模型 → 第一条"
#
# ★ 想按"某一位 Agent 用什么"来配，**不要在这里配** —— 去
#   「天问 · 剧组 Agents」点那一位，它有一个「模型」选项，旁边写着推荐的模型。
#   （用户 2026-10-12：「后续LLM不再针对特定功能进行模型配置」）
#
# ★ 「哪个功能推荐用什么模型」有一张现成的表：界面上的
#   「天问 · 模型与LLM · 推荐：哪个功能用什么模型」，代码在 `llm/recommend.py`。
# ⚠ 改完要重启程序才生效
MODEL_FRONT=deepseek-flash

# 日常档模型，约 55% 调用量（常规循环 / 「每天的生活」整理）。值 = 模型登记表里的 key；空 = 跳过这一档，往下走「默认模型 → 第一条」。
# ⚠ 改完要重启程序才生效
MODEL_DAILY=deepseek-flash

# 摘要档模型，约 30% 调用量（压缩 / 打分 / 后台 / 进度评估）。值 = 模型登记表里的 key；空 = 跳过这一档，往下走「默认模型 → 第一条」。
# ⚠ 改完要重启程序才生效
MODEL_CHEAP=deepseek-flash

# 默认模型（谁都没指定时用哪一个）
# - 值 = 模型登记表里的 **key**（不是发给服务端的模型名，虽然迁移后两者通常相同）
# - 空 = 用登记表里的第一条
# ⚠ 改这一项要重启程序才生效。
LLM_DEFAULT_MODEL=

# 手填价格覆盖（元/百万 token）
# - 格式（新）：模型名=命中价/未命中价/输出价
# - 格式（老）：模型名=未命中价/输出价（命中价自动按 1/10 推）
# - 示例：hy3=0.25/1/4,my-proxy=1/3/12,deepseek-chat=2/8
# - 空 = 使用内置价目表
#
# ⚠️ 价格说明：LLM 服务价格会随市场调整，内置价目表仅为参考预估。
# 实际费用请以 LLM 服务商（如 DeepSeek、OpenAI 等）官方公布的最新价格为准。
# 如需精确计费，请使用此配置项手动填入当前官方价格；
# 也可以在「天问 · 模型与LLM」里逐条模型填（推荐，那样每条模型带自己的价）。
MODEL_PRICE_OVERRIDES=

# 上次拉取到的可用模型列表（逗号分隔，由「拉取模型列表」按钮写入）
MODEL_LIST_CACHE=

# 向量检索方案（默认 none：不需要安装任何东西，装上程序就能用）
# - none: 关闭向量检索，用关键词命中替代（默认值，零依赖）
# - api: 走你在上面配的那个账号的 /embeddings 接口（同一个 Key，按量计费；不是每家都有）
# - local: 本地离线向量模型（需额外 pip install sentence-transformers，首次运行下载约 100MB）
# - ollama: 本地 Ollama 服务（可选；必须自己先装 Ollama 再 ollama pull，不装完全不影响使用）
# ⚠ 这四项目前对推演**没有影响**：llm/embedding.py 尚未接入记忆检索。
#   天机 · AI 模型配置页已不显示这个开关（2026-10-25 降级），只能在这里改。
# 候选：local / api / ollama / none
EMBEDDING_PROVIDER=none

# 本地向量模型（EMBEDDING_PROVIDER=local 时生效）
# - 首次运行会自动下载模型（约 100MB）
# - 推荐：BAAI/bge-small-zh-v1.5（中文效果好）
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-zh-v1.5

# API 向量模型（EMBEDDING_PROVIDER=api 时生效）
# - OpenAI: text-embedding-3-small
# - 智谱: embedding-3
EMBEDDING_MODEL_API=text-embedding-3-small

# Ollama embedding 配置（EMBEDDING_PROVIDER=ollama 时生效）
# - 需先安装 Ollama：https://ollama.com
# - 需先拉取模型：ollama pull nomic-embed-text
# - 推荐模型：
#   - nomic-embed-text: 通用，效果好
#   - mxbai-embed-large: 更大模型，效果更好
#   - bge-m3: 多语言支持
EMBEDDING_OLLAMA_MODEL=nomic-embed-text

# Ollama 服务地址
# - 默认：http://localhost:11434
# - 如果 Ollama 运行在其他机器，修改为对应地址
EMBEDDING_OLLAMA_URL=http://localhost:11434


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  LLM 能力                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# 模型支持文生图（能调 /images/generations）
# - 取值由 IMAGE_AI_MODEL 的型号决定（没配图像模型时看三档聊天模型）
# - false: 「全彩文生图」这一档自动降级为本地 PNG 矢量图，人物肖像改用文字代替
# ⚠ 改完要重启程序才生效
LLM_CAP_IMAGE=false

# 模型是推理模型（自带思维链，如 deepseek-reasoner / o1 / o3 / R1 这类）
# - true: 请求里**不再发送 temperature** —— 这类模型会拒绝或忽略该参数
# - false: 正常发送 temperature
# ⚠ 改完要重启程序才生效
LLM_CAP_REASONING=false

# 允许在「只要结论」的用途上关掉思考模式（发 thinking:{"type":"disabled"}）。进度评估、类型判定、正文对齐这三处只要一个结论，而**思考会连 max_tokens 一起吃**：2026-10-06 实测一句「判据满足了吗」让 deepseek-flash 思考 3233 token、2000 的额度全用光、正文一个字都没写出来。**关掉之后 56 token 就答完，快 3 倍**。程序每次都还会按当次请求的模型再确认一遍，不认识这个参数的模型（o1 / Claude…）一个字都不会发 —— 所以这项只在你想「宁可多想一点、也别给不出结论」时才关掉
# ⚠ 改完要重启程序才生效
LLM_CAP_THINKING=true

# 模型支持 JSON 模式（response_format={"type":"json_object"}）
# - true: 结构化输出交给服务端保证
# - false: 退回「在提示词末尾追加『请仅以 JSON 回答』」的老办法
# ⚠ 改完要重启程序才生效
LLM_CAP_JSON_MODE=true

# 模型接受 role=system 的消息
# - true: 系统提示作为独立的 system 消息发送
# - false: 把系统提示并入首条 user 消息（部分模型收到 system 会直接 400）
# ⚠ 改完要重启程序才生效
LLM_CAP_SYSTEM_ROLE=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  项目与运行                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 项目根目录（每个故事一个子文件夹）
# - 空 = 默认根（「桌面 / 小说世界AI模拟 / Projects」；老用户若已有
#   小说世界虚拟模拟\Projects，会继续用那个，书不会"不见了"）
# - 示例：D:\小说项目
# ★ 界面上也能改：**天机 · 常规** 页最上面那一项（旁边有「浏览…」）
#   ⚠ 它**改完不用重启**：`projects_dir()` 每次现读，回到开始界面书列表就换了
#     （实测：改完保存 → 开始界面「拾卷」那行小字立刻跟着变）。
#     已经打开的那本书**不会跟着搬**（仍在原处，照常能读能写）；
#     下次开新卷才建到新目录里，「已删除备份」也随之改到新目录旁边。
DEFAULT_PROJECTS_DIR=

# 导入未达黄金档时自动进 AI 优化向导
# - true: 自动进入优化向导（推荐）
# - false: 跳过优化，直接使用原始设定
OPTIMIZE_ON_IMPORT=true

# ── 开卷打磨 Agent ───────────────────────────────────────────────────────────
#
# 开卷里「使用 AI 优化项目设定」那一段，从 2026-10-07 起是一个**真的 Agent**：
#   · **记得整场对话**（你说过的、它查过的、它改过的、体检结论，全都在）；
#   · **会动手**：改设定用结构化打补丁（不是把整份设定抄一遍回来 —— 那样很容易
#     被长度上限截断）、能读你的引用文件夹、能写打磨记录、能把结论追加回素材夹；
#   · **会当场写工具**：内置工具不够用时，它写一个 Python 工具给自己用
#     （在沙盒里跑：子进程 + 硬超时 + 只能写打磨暂存区，见 `polish/sandbox.py`）；
#   · **会自查**：收尾之后换一双眼睛查"漏改 / 改坏 / 越权 / 编造"，
#     查出问题就带着意见再走一轮。
#
# 关掉它就退回老的「一问一答」：省调用次数，但模型看不到历史，
# 「就按你刚才说的第 2 条改」这种话会落空。
POLISH_AGENT=true

# 一轮最多走几步（想 → 用工具 → 看结果 算一步）。
# 太小：查不完就收口；太大：容易一直在"再确认一下"里打转。
POLISH_MAX_STEPS=6

# 一场打磨总共最多调多少次工具（防死循环烧钱）。超了会停下来收口。
POLISH_MAX_TOOL_CALLS=60

# 开卷 AI 优化最多来回几轮（**你发一条指令算一轮**）。
# 到上限就不再收新指令，会让你点「完成优化并进入」—— 防着一路聊下去把钱烧光。
# ⚠ 它只管"还能不能再开新一轮"；**中途打断正在跑的那一轮**用摄取窗口里的
#   「⏹ 强制停止」按钮（不受这个数限制，随时可点）。
POLISH_MAX_ROUNDS=10

# 收尾后自查一遍。查的四件事：漏没漏 / 改坏没有 / 有没有越权 / 有没有编。
POLISH_REFLECT=true

# 自查出问题时，最多再走几轮把它改掉（0 = 只报不改）。
POLISH_REFLECT_ROUNDS=1

# 允许 Agent 现场写代码：动态生成工具 + 临时跑代码。
# ⚠ 生成代码在**子进程**里跑，执行前过两遍 AST 审查（危险导入/属性/内置名一律拒），
#   只能写打磨暂存区 —— **不许碰引用文件夹**（要动素材只能走内置的"追加回写"，只追加）。
POLISH_TOOLS=true

# 沙盒里跑一次生成代码的硬超时（秒）。超时会被强制中断（死循环就靠它）。
POLISH_SANDBOX_TIMEOUT=20

# 把打磨结论**追加**成 `AI打磨记录.md` 到引用文件夹。
# ⚠ 只追加、不覆盖，每个被改的文件自动留 `.bak`；**项目一开始推演就封口**。
# 项目里也留一份同样的（`<项目>/打磨记录.md`），两处写的是同一份文本。
POLISH_WRITE_BACK=true

# 与「开卷」是两件事，别混：
#   开卷 = 读**你要写**的那本书的素材 → 变成设定集 → 进项目；
#   拆书 = 读**你觉得写得好**的那本书 → 变成写法   → 进 skills/。
# 一句话：开卷把书变成你的世界，拆书把书变成你的本事。
#
# 入口：开始菜单 →「拆　书」。会问你四件事：书名 / 类型 / 觉得哪里好 / 重点拆什么，
# 其中「觉得哪里好」最要紧 —— 拆解会优先看那些地方。
BOOKLAB_ENABLED=true

# 粗扫最多跑几批（每批十几章）。一本长篇分层取样后约 24 批。
# 调小 = 省钱，但读得更粗（结论会更浮）。
BOOKLAB_MAX_BATCHES=26

# 一本新书最多引用几份拆书经验。多了会挤掉别的上下文。
BOOKLAB_LESSON_PACKS=2

# 关掉后**三人小组（小说作家/剧作家/导演）也只拿压缩版**的拆书经验。
# 默认 false = 他们拿完整版（多出节奏 / 立人 / 文风 / 不要照搬什么那几节）——
# 因为这几位决定"这个故事怎么讲"，写法经验正是用在这一层上。
BOOKLAB_SKIP_WRITERS=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  类型与风格                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 故事类型
# - auto: LLM 自动判定 + 人工确认（推荐）
# - 手填：「主题材+副题材|结构|频道」
# - 示例：悬疑+灵异|单元剧|男频
STORY_GENRE=auto

# 风格来源
# - auto: 从正文提取风格卡（推荐，需有正文）
# - plain: 使用默认白描风格
# - custom: 使用 NOVEL_STYLE_CUSTOM 自定义描述
# 候选：auto / plain / custom
NOVEL_STYLE=auto

# 自定义风格描述（NOVEL_STYLE=custom 时生效）
# - 示例：长句绵密、冷笔白描、对话占比低
NOVEL_STYLE_CUSTOM=

# 工艺库
# - builtin: 使用内置工艺库（推荐）
# - none: 关闭工艺库（纯沙盒）
# - 自定义目录：指向你的工艺库目录
CRAFT_LIBRARY=builtin

# 案例库是否参与提示
# - true: 案例库内容会注入 LLM 提示（推荐）
# - false: 关闭案例库（省 token）
CRAFT_CASES_ENABLED=true

# 场景名称
# - auto: 提议 2~3 个候选由你选定（推荐）
# - 手填：直接指定场景名，跳过提议
SCENE_NAME=auto

# 开局情境（自然语言，可选）
# - 示例：雨夜，茶肆打烊前
# - 空 = 由 LLM 根据设定生成
SCENE_START_HINT=

# 历法显示
# - auto: 自动推断（推荐）
# - regnal: 年号纪年（如「康熙三年」）
# - ganzhi: 干支纪年（如「甲子日」）
# - modern: 现代日期（如「2026-10-04」）
# - daycount: 第 N 天（如「第 42 天」）
# 候选：auto / ganzhi / modern / daycount
CALENDAR_DISPLAY=auto


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   运行边界                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 运行模式
# - story: 按进度表走到终点自动收尾 + 小结（推荐，定位是「按设定走一遍」）
# - open: 不限期推演，每 N 虚拟日暂停等确认
# - story_day: 按进度表推演，但每隔 N 虚拟日暂停等确认（适合长篇连载）
#
# 注：这里存的一律是上面这三个**变量值**；界面上（天机 → 运行）显示的是人话，
#     对照关系是 ——
#       story     「走完故事（有终点）」
#       open      「不限期限（一直续写）」
#       story_day 「定期暂停（每几天停一次）」
#     手改这个文件写变量值就对了，别写界面上那句中文。
# 候选：story / open / story_day
RUN_MODE=story

# open 模式的巡检闸（虚拟日）
# - 每隔 N 个虚拟日自动暂停，弹窗：已推演 N 天，[继续/看账/出故事文档/停止并小结]
OPEN_CHECKPOINT_EVERY_DAYS=3

# story_day 模式的存档点间隔（虚拟日）
# - 每隔 N 个虚拟日打一次存档点
# - 适合长篇连载（有节奏地存，不用一口气跑完）
# - 示例：3（每 3 天一次）
STORY_DAY_EVERY_DAYS=3

# 存档点要不要停下来等你确认
# - false（推荐）: 只落盘并在中栏说一句，推演继续
#                 存档点回答的是"存了没有"，不需要你决定，所以不打断
# - true: 弹提问对话框（说明 + 选项 + 确定/取消）等你拍板
CHECKPOINT_PAUSE=false

# 故事起始点
# - auto: 有正文接续最新进度，无正文大纲起点（推荐）
# - begin: 从头开始
# - 节点 ID: 从指定节点开始（如 N03）
STORY_START_POINT=auto

# 每隔几秒把"当前这一天已经演出来的"写一份**中途稿**到运行文件夹：
#   <运行文件夹>/自动落盘/进度.md   （滚动覆盖同一份，不是一天一个文件）
#
# 为什么需要它：正式产物（每天的生活/第NNN天.md）只在**跨天 / 收工**时才写。
# 在那之前点暂停、或者直接关掉窗口，当天演过的大半就**只在内存里**，白跑。
#
# 除了按秒定时，下面三个时刻**各再补一次**：
#   · 点「暂停」时（用户点名的场景）；
#   · 关窗口时（`page.on_disconnect`）；
#   · 收工 / 停止之前。
#
# 0 = 关闭（运行界面左下角那颗小胶囊会写"已关闭"）。
# ⚠ 改这项**不用重启**：下一次落盘就按新间隔走。
AUTOSAVE_SECONDS=30

# 到达终点后是否由导演安排收束场景
# - true: 先安排收束场景再停（推荐，结尾更完整）
# - false: 直接停
ENDING_SCENE=true

# 主线吸附力（0~1）
# - 越高导演越积极把剧情拉回进度节点
# - 0.7: 适度引导（推荐）
# - 0.3: 放养，看人物自己长戏
PLOT_ADHERENCE=0.7

# 本轮结束自动导出「运行报告」（运行小结）
# - false: 只手动导出（默认）——报告含账单与 OOC 分析，跑完再出更有用
# - true:  结束时自动出
# 注意：这只管"要不要自动"；手动导出随时可用，不受此项影响。
AUTO_SUMMARY_ON_END=false

# 故事文档/运行小结的生成档位
# - MODEL_FRONT: 华彩档（质量优先，推荐）
# - MODEL_DAILY: 日常档（省钱）
# 候选：MODEL_FRONT / MODEL_DAILY
STORY_DOC_MODEL=MODEL_FRONT

# 运行报告用哪一档模型（MODEL_FRONT / MODEL_DAILY / MODEL_CHEAP）。报告含账单与 OOC 分析，默认走华彩档。
# 候选：MODEL_FRONT / MODEL_DAILY
SUMMARY_MODEL=MODEL_FRONT

# 起笔的装配超时（秒）
# - 点「开始推演」后最多等多久；超时界面会停止等待，可以再点一次「起笔」
# - 后台那一趟会自己作废，不会偷跑；正常机器十几秒就装完，一般不用改
# - 范围 20~3600，默认 180
LAUNCH_TIMEOUT_S=180


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   本轮推演                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 这一轮的性质
# - normal: 正常（导演照常挑事、正常推主线）——默认
# - daily:  日常生活型（不主动注入关键事件，只过日子；剧情自然走到节点仍会推进）
# 候选：normal / daily
ROUND_KIND=normal

# 这一轮最多发生几件**关键事件**（导演注入的那种；0 = 不限）
# 上限一到就不再挑事，剩下的靠人物自己走。
ROUND_EVENT_LIMIT=0

# 本轮**只让这几个人上场**（逗号分隔；空 = 全体）
# ⚠ 名字要跟人物卡里写得一致；认不出来的会被丢掉并在日志里说明。
#   留空最稳 —— 换了另一本书之后，这里的名字多半对不上。
ROUND_CAST=

# 本轮**锁在一个地点**（不发生换场；空 = 不锁）
# 也要跟这本书的地点表对得上，对不上会被忽略。
ROUND_SCENE=

# 剧作家写到**设定集里没有的地点**时（比如「河岸柳树下」），把它**补进「设定集/地点.yaml」**长期保留（下次开卷还认它，地图也能画到那儿）。关掉就只在**本轮**临时认它，下一轮又变回不认识（地图又会卡在开头那一张）。⚠ 只追加一条、绝不重写你原来的条目；写之前留一份 `.bak-新地点-时间戳` 备份
PLACE_PERSIST=true

# 每个故事日大概写多少字（软目标：会告诉编剧组与各人，并显示在状态条上）
# 0 = 不限。
ROUND_DAILY_WORDS=0

# 没事的时候把时间跳过去（默认开）
# 连着几拍谁都没做事，就用一句旁白带过一段时间，不再一拍拍空转（省 token）。
SKIP_IDLE_TIME=true

# 连着几拍"谁都没做事"才跳
SKIP_IDLE_BEATS=6

# 每次跳过多少**故事分钟**（上限 720 = 半天，最多跨一次日界）
SKIP_IDLE_MINUTES=30

# 连着几拍**大多数人都在等同一件事**，就让导演给那件事一个结果（门开了 / 人进来了 / 东西掉了）。设 0 = 关掉这个破局（戏可能一直停在原地）。2026-10-19 加：《雪国》实测 34 拍里 7 次 wait，全在等门外那脚步，而那脚步一直没结果。
STALL_BREAK_BEATS=3

# 整理成小说时，**整段一句都没铺开**的段落最多重写几段。设 0 = 不重写（只靠提示词，改回 2026-10-19 之前的行为）。重写只动被判出来的那几段，失败一律保留原文。
PROSE_FLOW_FIX=2

# 整理成小说时，**同一个写法用了一次又一次**（沉默总是“没应+看一眼” / 口头禅 / 道具状态反复交代）就修一次。设 0 = 只报不修。2026-10-19 加：《雪国》实测“你这个人哪”一天 4 次、“没应，看雪光”这类成套句式一天 2 次。修的方式是给可数的事实、让模型换法子重写，事实一个字不动；失败一律保留原文。
PROSE_REPEAT_FIX=1

# 整理成小说时，**一大段塞了太多件事**（读起来是一坨流水账）就修一次。设 0 = 只报不修。2026-10-20 加：真人 18 章段内最多 7 件事、18 章没有一章越界；《雪国》实测最长一段塞了 44 件事（638 字）。修法是**拆段**，不是删事 —— 事实一个字不动，失败一律保留原文。
PROSE_CROWD_FIX=1

# 整理成小说时，**在同一个地方打转**（同一个人把同一个诉求换着说法问了一遍又一遍 / 同一个动作做了一遍又一遍）就修一次。设 0 = 只报不修。2026-10-20 加：《雪国》实测驹子把「我是不是好人」问了 7 遍、叶子送酒 5 次。⚠ 这一条的**判决在 LLM 判官**，不在代码 —— 打转是换了说法的重复，字面量法（动宾紧邻 / 2-gram 峰值 / 字面承接）实测全部零区分度。代码只管安全：判官说没打转、或回话看不懂，就一个字都不改。
PROSE_SPIN_FIX=1

# 整理成小说时，**读起来不成立的句子**（写成了几乎听不见的话却被隔着一扇门的人听见 / 隔着距离写到睫毛那一层的微距 / 干燥的釉面自己“流过一道亮痕”这类物理瑕疵）就定点改一句。设 0 = 只报不修。2026-10-20 加：前两类有可数的形状（真人 18 章 0 条，《雪国》v17 2 条），第三类写不出字面判据，所以三类一起交给判官。⚠ 不整章重写 —— 只替换判官点名的那几句，并有四道闸（毛病不许变多 / 台词不许变少 / 长度 0.9–1.3 倍 / 新句不短于原句）。
PROSE_PLAUS_FIX=1

# 整理成小说时，**叙述者跳出来讲结构**的那半句就删掉（「算是第二层的新问」「把这第三轮收住」「这回不重复进门送物」）。设 0 = 只留着。2026-10-20 加：这个病是我们自己的修复提示词喂出来的 ——提示词里写了“最多来回三轮”“换个由头”，模型就把它念给读者听；真人 18 章 0 条，《雪国》v17 6 条。⚠ 这一条**故意不调模型**：元叙述是“多写了一句”，删是唯一不会写坏的动作。
PROSE_META_FIX=1

# 整理成小说时，**连着三句问出去没人接**的对话就修出一处真答复（上一句问「你要不要看」，下一句答「这酒还够喝吗」，再下一句又问新的 —— 两个人各说各话）。设 0 = 只报不修。2026-10-20 加：先量过，**单句悬空不是病**（真人 80%–100% 都不直接答），真人最长连续悬空 2，《雪国》v18 到 5 ⇒ 阈值 ≥3，真人 18 章零误报。⚠ 推演层的对话审计早就看得见（每拍都在报），但只算不拦 —— 这一条在成篇的散文上把其中一两句改成半句回应。四道闸：毛病必须变少 / 台词不许变少 / 长度 0.9–1.3 倍 / 新句不短于原句。**改几句也管**：从少到多试，第一次压到阈值以下就停 —— 全改会把四句连排都写成「半句回答；自己的问题」，是新的模版腔。
PROSE_DRIFT_FIX=1

# **道具循环**：同一件东西被反复「续上—耗掉」就改掉中间那一两句（茶凉了 → 续上 → 又凉了 → 再续上；台词每句都不同，手上的事一遍没变）。设 0 = 只报不修。2026-10-20 加（用户：「继续修复道具循环」）：先量过 —— 真人 18 章「同一件东西的最大复位次数」中位 0、最大 0；真跑 v12/v15/v17/v18 是 0，v16/v19/v20 是 4 ⇒ 阈值 ≥3，零误报。⚠ 这个数必须**贴着东西**算（句子里要有器皿或可消耗物），否则真人科幻那章会被判进 11 次「消耗」（全是表格里的「没有」）。⚠ 与「打转」是两件事：那边数话，这边数手 —— 所以打转判官放过它。**不删戏，只换动作**，并明写不许换成同族动作（又喝了/又添了）。
PROSE_PROP_FIX=1

# 整理稿**查几轮**（R48）。每一轮把「删 → 改内容 → 排版」全部走一遍，然后**重新数一遍还剩多少毛病**；没了就停，连续几轮没变少也停（见下一项）。2026-10-20 加（用户：「一开始写小说和最后导出的时候都要进行几轮检查也修复」）。以前是**一轮串行跑完就走**、改完从不复查 —— 修 A 时把 B 弄坏了没人管（删一句答话 ⇒ 问答变悬空；整章重写 ⇒ 又添一句元叙述）。**作者 2026-10-20 明确：成本可以接受、以质量优先** ⇒ 默认从 3 提到 5，实测 3 轮时常停在「还剩 2 处」。设 1 = 退回老样子（只跑一轮）。⚠ 每一轮要跑 8 个步骤，其中 5 步要调模型 ⇒ 轮数越多越慢越贵。
PROSE_CHECK_ROUNDS=5

# 多轮修稿走**Reflexion 路径**（默认开）。旧路径是「跑 8 个步骤 → 数总数 → 降了就留」，它的四个结构性缺陷都不是某一步写得不好：① 每一步自己判自己（跨类退化没人看得见，实测修好太碎却把憋气从 0 改到 2）；② 被拒的尝试整份丢掉，下一轮从零瞎试；③ 一轮只有一个候选；④ 收敛判据是单标量求和，把「两类互换」看成「没变化」。新路径把判定交给确定性验收层（多目标分别判、退化就拒、硬约束先于优劣、满分可疑），被拒时写一条**带原句的教训**进有界记忆，下一轮进提示词；每步可出 2 个候选；最终从 Pareto archive 里取最优（按 毛病 → 台词 → 字数 三级排序）。设 0 = 逐字回到旧路径（保留是为可回退）。
PROSE_REFLEXION=true

# 反思记忆最多存几条教训（默认 24）。Reflexion 的老毛病是记忆越堆越长、最后把上下文吃光；这一项就是那个上限。同类别 + 同差异的教训会自动去重，所以 24 条足够覆盖一轮里会重复踩的坑。
PROSE_REFLECT_MEMORY=24

# **连续几轮没有进展才收工**（默认 2）。一轮没变少**不代表改不动了** —— 模型有抖动，同一句它可能这一轮改不动、下一轮换个说法就通了。设 1 = 老规矩（一轮没变少立刻停，最省钱）。配上一项用：`PROSE_CHECK_ROUNDS` 管最多跑几轮，这一项管什么时候认输。
PROSE_CHECK_PATIENCE=2

# ── 场次编排（2026-10-11）──────────────────────────────────────────────
# 按剧作家的分拍表**一场戏一场戏地演**（默认开）。
# 开了以后：
#   ① 剧作家写的每一拍（在哪 / 讲什么 / 有谁 / 要落到哪些动作 / 动什么道具 /
#      情绪 / 演完的样子）**真的下发到演员与导演**；
#   ② 该出场的都露过面、戏量也够了，这一场就收，换下一拍；
#   ③ 换场按这一拍的「场」来定，不再等"人都走光"。
# 关掉 = 回到从前（分拍表还在剧组台账里，只是不按它推进）。
SCENE_BEATS=true

# 一场戏**最少演几拍**才允许收场（拍 = `BEAT_SECONDS` 那一种）
# 设太小会让"一场戏"和"一拍"一样长，反而更碎 —— 这是下限，不是目标。
SCENE_BEAT_MIN_TICKS=3

# 一场戏**最多演几拍**，到点强制收场（防止一场戏无限拖）。不能小于上面那个。
SCENE_BEAT_MAX_TICKS=12

# 这一场**至少要发生几条实动作**才算"演过了"
# 用的是"真做了事"的条数（说话、走动、交手），不是"跑了几拍"——全场发呆不算演过。
SCENE_BEAT_MIN_ACTS=2


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                    导出                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 导出时走**分层创作**（默认开）：先从本次推演抽出全书骨架，再逐章拆纲、写草稿、补细节，**每层过闸才往下走**。解决的是老流程治不了的病：按日拼出来的是「每天的过程稿首尾相接」，没有全书骨架，所以「好几章在问同一件事」在结构上就已注定，事后修句子没用（实测莫问楼连跑三版都在打转）。闸是确定性代码：事件必须全覆盖、每章必须交代「哪一格变了」、相邻章/相邻拍不许是同一个变化、状态不许倒退、正文必须能引原句自证落点。⚠ 关掉就退回按日装订（老样子）；失败也会自动退回，不会因此导不出书。产物落在 `<运行>/导出/`：骨架.json / 分层稿.md / 分层日志.md。
EXPORT_ATELIER=true

# 分层创作每层最多写几轮（默认 3）。一轮不过闸就带着「哪一条不过」重写；用完还不过就**标出来**装订，不假装过。
EXPORT_ATELIER_ROUNDS=3

# ─────────────────────────────────────────────────────────────
# 本轮结束自动导出：**四个都默认关**（2026-10-26 用户定）
# - 导出回到"**你点了才发生**"
# - 原因：点「停止」会顺带自动导出，而那一步开着 MUMU_FOR_EXPORT 时能跑十分钟
#   ⇒ 以为卡死 → 又手动点一次 ⇒ 同时产出两份内容不同的稿子
# - 想要收工自动出，把对应的改成 true（导出对话框「③ 结束时自动导出」也可以勾）
# ─────────────────────────────────────────────────────────────
# **原始稿**（按天逐字原样，不动一个字）：它是「当初到底写了什么」的唯一凭据
#（另两种装订稿都是程序从日志重建出来的）
EXPORT_ON_END_RAW=false

# 「原始稿加细节」
# - = 原始稿 + 细节：正文一字不改，另外留着**过程细节**
#   （在场名单、本幕依据、机制备注、图片路径），用于对照「这句是从哪条设定长出来的」
# - 零成本、不调 LLM、可复现
EXPORT_ON_END_REFERENCE=false

# 本轮结束自动导出「最终改写稿」
# - = 成品稿：同样按日装订，但**剃掉过程细节**，只留时间说明、场景说明、
#   人物出场/退场、旁白、对白、动作、心声与同时性 —— 目的是读起来像小说
# - 零成本、不调 LLM
# - ⚠ 打开下面的 MUMU_FOR_EXPORT 后，这一档每天会被重写 ⇒ 同一份素材导两次
#   正文可以完全不同。要"一字不改、可复现"请用「原始稿」或「原始稿加细节」。
EXPORT_ON_END_NOVEL=false

# 本轮结束自动导出「写作指导」（大纲建议）
# - 这是推演后的写作大纲，可直接当提纲用
# - **要调 LLM 生成**，默认关；想省钱就等需要时手动出
EXPORT_ON_END_GUIDE=false

# 导出最终改写稿时，额外出一份 LLM 润色稿
# - false: 只出合订稿（默认）——零成本、忠实原文
# - true:  再把合订稿交给 LLM 整理成连贯小说，另存为「最终改写稿_vN_润色.md」
# 注意：润色稿是**改写稿**，永远另存，不覆盖合订本；
#      它只做整理不新增情节，但措辞会变，且要花 token。
EXPORT_NOVEL_POLISH=false

# **成书前整本复查**（默认开，2026-10-20 加）：
# 把每一天的正文再跑几轮「检查→修复」才装订成书，用的是和写小说时**同一套规则**（删元叙述、接住问出去的话、拆道具循环、收拥挤段……）。
# 为什么要再查一遍：写小说时每章都查过，但那是**单章视角** —— **跨天才暴露的毛病只有合并后看得见**（同一件东西昨天续、今天续、后天还续；同一句问话昨天问、今天还问）。
# ⚠ 只改「最终改写稿 / 原始稿加细节」这一档；**「原始稿」一个字符都不动** —— 它是「一字未改」的凭据稿。
# ⚠ 复查失败一律**按原样导出**，不许因此丢稿。
# 跑几轮由 `PROSE_CHECK_ROUNDS` 决定；设 0 = 不复查（快，但跨天毛病留着）。
EXPORT_FINAL_CHECK=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   时间系统                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 故事开始时间
# - 空 = 随开局方案
# - 格式：YYYY-MM-DD HH:MM
# - 示例：2026-10-04 08:00
GAME_START_TIME=

# 时间倍率
# - 1 现实秒 = 多少故事秒
# - 60: 现实 1 秒 = 故事 1 分钟（推荐）
# - 3600: 现实 1 秒 = 故事 1 小时（快节奏）
TIME_RATIO=1

# 心跳间隔（毫秒）
# - 主循环 tick 间隔
# - 1000: 1 秒（推荐）
# - 500: 0.5 秒（更流畅但更耗资源）
TICK_REAL_MS=1000

# 一拍 = 等多少**真实秒**再决策（`TIME_RATIO` 倍率再除）。⚠ 它也是**花钱的节拍器**（一拍 = 1~2 次 LLM 调用）。默认 60 = 一拍一分钟：中档一天 15~25 拍，一天演 15~25 分钟，看着是一章的量。⚠ 它不决定故事时间；调小只会让同样的内容冲得更快，不会多演故事 —— 想一天更厚改进度表里那一站的「篇幅」。
BEAT_SECONDS=60

# 开（默认）：**这一站的拍演完就收一天的稿** —— 小说的「一天」是这一天写出来的那些事，不再要求填满 24 小时。关掉逐字回到旧行为（一拍恒定故事秒、跨 24 点换天），旧行为实测一天演 133 幕 / 21.3 万字。
DAY_ENDS_ON_BEAT_BUDGET=true

# 一拍最多推多少**故事分钟**。一拍 = 场景内的一个节拍（一个人做一件事、说一两句），一次换场或一段等待最多半小时。更长的时间流逝不是拍该干的活，而是「过场」：站末把剩余时间一次跳掉并推一句旁白。调大它会让一场戏里冒出「过了两小时」，读者会觉得戏被剪了。
BEAT_MAX_MINUTES=30

# 全场都没人动时，隔多少**故事分钟**才写一次「片刻无话」。不设这个门槛，安静的时刻会把版面刷满（满屏「没动，也没出声」）。
QUIET_MINUTES=5

# 每隔这么多**故事分钟**补一条环境白描，**与有没有人在动无关**。0 = 关掉这条通路（环境只在空场时出现）。⚠ 单位是故事分钟；默认 TIME_RATIO=1 时，填 1 就是「每真实 1 分钟一条」。
AMBIENT_MINUTES=1

# 同一句环境白描隔多少条之后才可以再现（0 = 永不复现）。⚠ 别靠调小它来「加环境」：候选池只有 1~5 条，池子就那么大，调小只会让同一句回来得更快。真正的「空气」由演员的细节承担。
AMBIENT_REPEAT_EVERY=24

# 跑满 N 故事日自动暂停
# - 0 = 不限（story 模式以终点为准）
# - 示例：10（跑 10 天后暂停）
AUTO_RUN_DAYS=0

# 全员就寝自动暂停省 token
# - true: 夜间自动暂停
# - false: 不暂停（推荐，可手动 pause）
PAUSE_AT_NIGHT=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                 Agent 核心                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# 前台人数上限
# - 超出的 Agent 降格为后台 light
# - 建议：12（默认）
AGENT_MAX=12

# 记忆检索 top-K
# - 每次决策检索多少条记忆
# - 建议：8（默认）
MEMORY_RETRIEVE_K=8

# 记忆检索权重（三权重加权）
# - WEIGHT_RECENCY: 时间衰减权重（越新越重要）
# - WEIGHT_IMPORTANCE: 重要性权重
# - WEIGHT_RELEVANCE: 相关性权重（关键词命中）
# - 建议：1.0（默认）
WEIGHT_RECENCY=1.0

# 记忆检索打分里「重要性」这一项的权重（0~5）。调大 = 更优先想起重要的事；调小 = 更看近期。
WEIGHT_IMPORTANCE=1.0

# 记忆检索打分里「相关度」这一项的权重（0~5）。调大 = 更优先想起跟当前场景有关的事。
WEIGHT_RELEVANCE=1.0

# 时间衰减系数
# - 0.995: 24 小时衰减约 50%（推荐）
# - 0.99: 更快衰减
# - 0.999: 更慢衰减
RECENCY_DECAY=0.995

# 重要性打分策略
# - hybrid: 规则粗筛 + LLM 精评（推荐，省约 70%）
# - llm: 全部用 LLM 打分（贵但准）
# - heuristic: 纯规则（免费但粗糙）
# 候选：hybrid / llm / heuristic
IMPORTANCE_SCORING=hybrid

# 反思触发阈值
# - 累计重要性过此值触发反思
# - 建议：100（默认）
REFLECTION_THRESHOLD=100

# 每日每 Agent 反思上限
# - 建议：2（默认）
REFLECTION_MAX_PER_DAY=2

# 分层计划
# - true: 启用日计划 → 时段块 → 当前动作（推荐）
# - false: 关闭计划
PLANNING_ENABLED=true

# 跨天时先由导演写「当天要演的故事」并改写成剧本、分派到人；关掉则退回各人自己排计划
DAY_PLAN=true

# ── 今日任务分配（用户白名单里的「导演工作分配」）──
# 开演前推一张卡：**今天分到谁头上是哪几件事**（剧作者写剧本时分的活）。
# 它与 `NOTE` 那条「（导演派活）…」不是一件事：
#   那条是**每 N 拍的临时派活**（导演盯着进度现派的，随时会变）；
#   这一条是**一天一次的任务分配**（开演前定下来的框架）。
# 关掉则只写进人物自己的「今日计划」，不上屏。
DAY_TASKS=true

# 当日剧本验算不过关时，带意见重写的最多轮数
DAY_PLAN_FIX_ROUNDS=2

# 「前情提要」总字数上限。**要小** —— 它是提要不是梗概，几天的内容按天平分这个额度
RECAP_MAX_CHARS=240

# 前情提要往回取几天（跨天摘要）。取最近这几天，不是取全书
RECAP_DAYS=3

# ── 对话衔接（2026-10-07）──
# 让"对话"真的接得上：人物决策时会看到一段 [刚才]（这个场面此刻正在发生的事，
# 标出"谁对谁说"），被点名的人优先答话，同一拍里先开口的人说完其余人再看得到。
#
# - true: 启用（推荐）· false: 退回老做法（人物只知道自己做过什么，各说各的）
DIALOGUE_CONTEXT=true

# [刚才] 那段最多给几条：
# - 0  = 不给（等于关掉这一段，但"被点名的优先答话"仍然生效）
# - 6  = 默认 · 8 = 上限（留太多会变成流水账，越早的话越没人看）
DIALOGUE_CONTEXT_LINES=6

# ── 重复台词（2026-10-07）──
# 人物说了一模一样的话时怎么办。去重护栏只认字面，分不清两类完全不同的重复：
#   · 模型偷懒复读（"账差七文"一字不差说过 4 次）→ 该拦；
#   · 这句话非说不可（追问、对方没听见、"嗯"这种应答）→ 拦了反而是错的。
# 以前一律丢 —— 丢掉的代价是**那一拍可能整拍空白**。
#
# 现在的做法：先让他"重新想清楚当前情况"、换一句再说；
#   他若**仍然**说原话，那就是"非说不可"，放行。
# 这一步**只是心里的盘算**：第一遍那句话不上屏、也不进别人听得见的缓冲
#   （开关只影响台词；"同一句话不说第二遍"这条护栏本身照旧生效）。
DIALOGUE_RETRY_DUP=true

# 一拍最多让几个人重说（安全阀 —— 重说要多花一次调用）：
# - 2 = 默认（每拍最多两个人被问一次）
# - 0 = 不重说（等于只去重、不追问，会回到"重复句直接丢"的老行为）
DIALOGUE_RETRY_MAX=2

# 决策提示词里给人物几层目标（目标金字塔，2~5 层；由近及远：此刻 / 这一站 / 今日计划 / 这一程 / 你想要的）
GOAL_LADDER=3

# 计划时段块长度（分钟）
# - 建议：30（默认）
PLAN_BLOCK_MINUTES=30

# 一句话：把导进来的设定按**作用范围**分成四层 ——
#   世界层（大背景）/ 主线层（大纲·进度·伏笔）/ 场景层（地点·关系）/ 细节层（器物·习俗·小规矩）。
#
# 为什么需要它：设定文件夹里既有"这个世界的规矩"这种大东西，也有
# "东家那把壶缺了个角"这种小东西。以前是**一坨**，大背景排在前面吃掉额度，
# 小细节根本轮不上 —— 而"具体每天的故事往往是那些小设定在推动"。
#
# 现在的行为：
#   · 大背景**平时只给一句"气候"**，只在 开篇第 1 天 / 高潮日 / 每 3 天
#     这些特定的时候展开全文；
#   · 主线层、场景层按"当前该推进的节点 / 这场戏在哪儿"筛；
#   · 细节层只要**场合对得上**就出现 —— 它是每天戏里的主角。
# 落盘成 `<运行文件夹>/分层设定.md`（给人翻）与 `分层设定.yaml`（给程序读）。
#
# - true: 启用分层（推荐）
# - false: 退回老做法（一整段世界观取前 500 字，行为与从前一字不差）
SETTING_LAYERS=true

# 对话轮数
# - DIALOGUE_MIN_TURNS: 最少轮数
# - DIALOGUE_MAX_TURNS: 最多轮数（封顶）
DIALOGUE_MIN_TURNS=2

# 一场对话最多几轮（1~40）。防止两个人来回客套把戏拖住。
DIALOGUE_MAX_TURNS=4

# 群聊同场发言人数上限
# - 3 人及以上同场进入群聊模式
# - 建议：6（默认）
GROUP_CHAT_MAX=6

# ── 今日剧情简介（用户要的顺序：前情提要 → 今日简介 → 正式剧情）──
# 由剧作者在同一次调用里产出（零额外成本），排在「前情提要」之后、
# 「场景介绍」之前。拿不到就不推（不拿前情凑数）。
DAY_BRIEF=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                    剧组                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 启用剧组：小说作家写样章 → 剧作者改成能拍的剧本 → 导演定框架，另有场记/道具/美术/宣发各司其职
CREW=true

# 小说作家写样章时**先把场景交代清楚**（谁在哪、器物在哪一侧、光从哪来）—— 标准是**美术据此能画出当天地图**。关掉则回到从前（只写气氛）
CREW_SCENE_CARD=true

# 顺手把样章写得**能拍**（一场一事 / 只写拍得到的 / 对白写出话 / 不用「与此同时」跳）—— 给剧作者分场、给演员念台词用。关掉会更散文、更难改成剧本
CREW_FILMABLE=true

# 让台词**像活人说的**（卡顿与改口落在关键处 / 不必每句都接 / 默认平常声量·吼要付代价 / 一次说一件事 / 停顿与口气写在纸上 / 对谁说话换一副样子）—— 小说作家、剧作者、演员、审读**同一条**。关掉则回到从前
CREW_LIVE_SPEECH=true

# 场记每日连戏检查（时间·物件·称呼·在场状态·与前情矛盾）—— **只报不改**，提请作者注意
CREW_CONTINUITY=true

# 道具每日出单（这一场有哪些具体物件、哪件要反复出现）—— 产出会进出图提示词，画面里真的会多出这些东西
CREW_PROPS=true

# 美术定这部的画风与主色（一次定、全剧用），让各天的出图保持一致
CREW_ART=true

# 资料员每日考据（名物·制度·称谓站不站得住）；查不到会明说查不到，不编
CREW_RESEARCH=true

# 宣发写一句话卖点、看点、预告（收工与导出时出）
CREW_PUBLICITY=true

# 各职位**按自己这一刻的活儿**从 `skills/` 里挑合适的知识包（题材 + 职位的关心点 + 你在书斋手写的那几句一起进检索）。挑不到就不给 —— 见运行文件夹里的《本书可用的技能.md》；关掉则完全不查技能
CREW_SKILL_ROUTE=true

# 每个职位最多带几份知识包进提示词（一张卡五 K，十二个职位全塞进去会把注意力淹掉）
CREW_SKILL_LIMIT=2

# ── 剧组：编剧室（导演 · 小说作家 · 剧作者 三方会审）──
# 讨论"为了让今天这一段演得下去，该补哪些**局部**设定"，然后**真的拿去推演**。
#
# 两条硬规矩（程序强制执行，不是靠自觉）：
#   ① 只能新增**场景层 / 细节层** —— 世界层与主线层是作者的总体设定，剧组动不了；
#   ② 每条**必须有作用范围**（限地点 / 限人 / 限时间），否则等于改总体设定，当场拒收。
# 它们存在 `<运行文件夹>/临时设定.md`（与设定集**物理隔离**，只在推演里生效）。
#
# - true: 启用（推荐）· false: 不讨论（省一次摘要档调用）
CREW_SETTING_TALK=true

# 编剧室每几天会审一次：
# - 1 = 每天 · 2 = 隔天（默认）· 30 = 一月一次
# 没有需要时它会返回空数组，只花一次摘要档调用（约几百 token）。
CREW_SETTING_EVERY_DAYS=2

# 小说作家每天写的原著样章最少多少字
CREW_STORY_MIN=180

# 原著样章最多多少字
CREW_STORY_MAX=600

# 样章低于多少字就算没写出来（宽容下限）
CREW_STORY_MIN_FLOOR=80

# 剧作者最多分几拍（拍太多等于把一天写死，人物没有发挥空间）
CREW_MAX_BEATS=6

# 非阻塞 Agent（美工/场记/道具等）出工的**总预算**（秒）—— 0 = 不限（只用 LLM 层的超时）。⚠ 是**总共**等这么久（重试也在这个预算内），不是「每次窗口」：默认 300s + 重试 1 次 = 每次 150s，合起来仍是 300s。超时后该职位标记为跳过，不堵后面的人。
CREW_STAGE_TIMEOUT=300

# 非阻塞 Agent 超时后重试几次（0 = 不重试，直接跳过；1 = 重试 1 次，共试 2 次）。⚠ 重试**不延长总时长**，只是把预算切成几段用。
CREW_STAGE_RETRIES=1

# 小说作家（novelist）单次输出的 token 上限。写样章用，调大才写得更长。
CREW_STORY_TOKENS=2400

# 剧作者（screenwriter）单次输出的 token 上限。剧本比样章长，所以默认给得最大。
CREW_SCRIPT_TOKENS=4000

# 场记（continuity）单次输出的 token 上限。
CREW_CONTINUITY_TOKENS=2000

# 道具（props）单次输出的 token 上限。
CREW_PROPS_TOKENS=1600

# 美术（art）单次输出的 token 上限。
CREW_ART_TOKENS=1400

# 资料员（researcher）单次输出的 token 上限。
CREW_RESEARCH_TOKENS=1600

# 宣发（publicity）单次输出的 token 上限。
CREW_PUBLICITY_TOKENS=1400

# 编剧室会审的输出上限（token）—— 安全网，不是目标值。
CREW_SETTINGS_TOKENS=2600

# 群众演员（extra）单次输出的 token 上限。
CREW_EXTRA_TOKENS=1000

# 门外的新面孔由「群众演员」按剧情投人（关掉则退回从固定池抽 —— 省 token，但每次来的路人都长一个样）
CREW_EXTRA_CASTING=true

# **剧组往剧情窗口（中栏）报多少**。2026-10-07 第三次改口径，现在是：
#   · 剧组产出的**正文永不进中栏**（那是拍摄现场的花絮，不是小说）；
#     它照旧落盘（`剧组台账.md` / `道具单.md` / `今日总结.md` …）并进日志。
#   · 中栏只出现两样新的**小消息**：阶段（`▸ 剧组排练 · 3.2s`，只报名字与用时）
#     与工作状态（`· 美术 已交活`）。
#   · 三个档位管的是**报多细**：
#       off  = 只报阶段 + 「今日总结」+ 故障（不报工作状态）
#       key  = 再报工作状态（默认）—— 就是开头要的那几张工作状态卡片
#       full = 再在工作状态后面补一句标题（"今天 2 处"）—— 仍然不是产出全文
# ⚠ 「没出活」在**任何档位**都报 —— 那是故障信号，不是内容。
# ⚠ 「今日总结」在**任何档位**都报 —— 你点名要的"一天结束之后的总结"。
# 候选：off / key / full
CREW_SCREEN=key

# 剧组/剧务消息**前面带一个折叠箭头**：点开看「正在出工时 LLM 的思考过程（流式）」或「这一步的执行结果」。关掉就只有一行状态、点不开
CREW_EXPAND=true

# 剧组出工时**用流式接收**（展开框里的思考才会逐字出现）。关掉=等整段返回（展开框点开时已经有全文，看不到过程）。个别网关不支持流式会自动退回整段，不影响推演
CREW_STREAM=true

# ── 剧组新补的四位 ──
# 复盘：每天收工出「今日总结」（剧情总结 + 存在的问题 + 后续修改意见）。
#       它只报不改 —— 除了「需要重演」那面旗（见 DAY_REVIEW_REPLAY）。
CREW_REVIEW=true

# 造型：人物**身上**的东西（衣着·随身物·仪态）。道具管场景里的物件、
#       美术管画面怎么画，而"这个人穿什么、带着什么"以前两边都不认。
CREW_STYLIST=true

# 声音：这一场**听得见**什么（环境音·静默·声音的转折），进场景的环境句。
CREW_SOUND=true

# 语言审校：读当天样章，点名哪几句 AI 味重、该怎么改。
#       与去 AI 库的分工：库查**词与句式**（确定的、每次都查），
#       审校查**句子读起来对不对**（要判断的、每天一次）。
CREW_POLISH=true

# 四位各自的输出上限（安全网，不是目标值）
CREW_REVIEW_TOKENS=2200

# 造型（stylist）单次输出的 token 上限。
CREW_STYLIST_TOKENS=1400

# 声音（sound）单次输出的 token 上限。
CREW_SOUND_TOKENS=1400

# 语言审校（polisher）单次输出的 token 上限。
CREW_POLISH_TOKENS=2000

# ── 排练（剧本定稿后、开演前把这一天空走一遍）──
# 「所有人先快速走一遍，但不出现结果在窗口里」：
#   谁做不到、人不在场、台词写死了 —— 有问题就带意见退回剧作者重写，
#   然后**再排一遍**（排练 → 重新修改 → 再排练）。
# 排出什么**只落 `排练记录.md` 与日志**，中栏只有一条「▸ 剧组排练 · 3.2s」。
CREW_REHEARSAL=true

# 排练（rehearsal）单次输出的 token 上限。
CREW_REHEARSAL_TOKENS=1800

# 排练不过就重写，最多几轮（0 = 排完只记不改）。
# ⚠ 它与 DAY_PLAN_FIX_ROUNDS（导演验算的轮数）是两件事：
#   一个从"能不能演"挑毛病，一个从"故事顺不顺"挑毛病。
CREW_REHEARSAL_ROUNDS=1

# **分镜师**：剧本定稿后、开演前，把分拍拆成**镜头清单**（景别 / 画面描述 / 台词 / 镜头运动），落 `分镜.md`；开源漫剧流程里「剧本→分镜」这一步——让导演与演员在演之前先有「每一镜怎么拍」
CREW_STORYBOARD=true

# 分镜师（storyboard）单次输出的 token 上限。
CREW_STORYBOARD_TOKENS=1800

# **视觉参考图**：分镜定稿后，为出场人物 / 关键场景生成**一致性参考图**（接 image_gen），落 `视觉参考.md` + 图片；开源漫剧流程里「分镜→视觉（角色/场景）」这一步——下游生图 / 视频有统一参照，不每次重新瞎画
CREW_VISREF=true

# ── 当天这一章（收工后把今天整理成小说形式）──
# 落 `当天故事.md`（**按天累积**，不是一天一覆盖），并给「今日总结.md」
# 追加一节「今天这一章（整理稿）」。
# ⚠ 与导出的小说是两件事：那份是**装订成书**的，这份是**按天累积**的工作本。
CREW_DAY_NOVEL=true

# **整理当天这一章**时**每一块**最多写多少 token。它是**输出**上限：太小会把一天的戏写成一段摘要（2026-10-17 之前默认 2600，实测一天 4.4 万字的材料被写成 900 字）。分块后每块都按这个上限写
CREW_DAY_NOVEL_TOKENS=6000

# 整理当天这一章时**多少字一块**（0 = 不分块，整段一次交给模型）。分块是为了让模型**每一段都写完整**而不是挑几段写；设 0 适合上下文很大的模型
CREW_DAY_NOVEL_CHUNK=6000

# ── 剧本审读（2026-10-08）──────────────────────────────────────
# 用户原话：「你看是否有独立的Agent 而不是导演在盯着演员说的每一句话 没有就做一个
# 在演员真的说出来之前，把新生成的话放到已经出现的话里过一遍，看是否通顺 而且
# 这个Agent要一直记录生成的所有信息，所有输出到窗口的东西…都要让这个Agent记录下来
# 任何一个新出现的东西，不管来自哪个Agent或者来源，都需要这个Agent放到已有历史里
# 看下是否是一个合理的 正确的好看的故事和剧本 不是就不要放出来」
#
# 它是**每一拍都要跑**的那个闸门，所以下面几个数直接决定成本。
# ⚠ 它的产出**永远不上中栏**（那是读稿意见，不是故事），只进
#   `<运行文件夹>/剧本审读.md`（小结，一天一份）与 `审读台账.jsonl`（流水，追加）。
# 上屏**之前**逐条过一遍（是不是人话·像不像这个人·接不接上文·是不是一个主题），
# 不通过就改写或**拦下**；同时**记录一切上屏的东西**（动作/对话/场景切换/
# 伏笔激活/导演动作…）。关掉 = 既不审也不记
SCRIPT_REVIEW=true

# 审读要不要**问模型**。关掉 = 只跑零成本的**规则层**（残留的 JSON / 占位话 /
# 出戏词 / 标点乱敲 / 半截话）—— 那几条抓不住语感，但一分钱不花
SCRIPT_REVIEW_MODEL=true

# 每几拍让审读过一次模型（默认 1 = **每拍都过**）。调大更省，但中间那几拍只有规则层把关
SCRIPT_REVIEW_EVERY_TICKS=1

# 审读时带**多少条已上屏的历史**当上文 —— 它判「接不接上文 / 是不是一个主题」全靠这个
SCRIPT_REVIEW_HISTORY=30

# **进了场、过了几拍还没人跟他说上话**就往导演提示里加一句「谁在场谁接住他」
SCRIPT_REVIEW_NEWCOMER_TICKS=8

# 判不过时**真的拦下**（默认）。关掉 = 只记（`剧本审读.md` 里照样列出来），不拦
SCRIPT_REVIEW_STRICT=true

# 剧本审读（script_doctor）单次输出的 token 上限。
SCRIPT_REVIEW_TOKENS=1600


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   推演窗口                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 把推演写成的小说**自动推送到推演窗口**（收工时 / 点停止时）。关掉就只落盘、不占窗口。
SHOW_NOVEL_IN_WINDOW=true

# 推送到窗口的那篇小说**默认展开还是收起**。默认收起：几百到几千字，展开会把正在看的戏挤出屏幕；想看的人点一下标题就展开。
NOVEL_WINDOW_OPEN=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                    运行                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# **点停止之后，最多等收尾多少秒**（判据与探针用这个数，界面不等）。为什么默认 15 分钟：收尾要跑 场记→宣发→审校→复盘→整理→导出 一串调用，真机下每次几十秒到几分钟；以前判据写死 20 秒，于是把「收尾正常但要跑两分钟」误判成「停止坏了」。⚠ 这不是放宽标准：真卡死时它照样超时。⚠ 点停止后**还在写样章**是另一件事（已修：每遍开始前检查停止），别拿调大这个数去掩盖它。
WRAP_WAIT_SECONDS=900


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   认知模式                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# ── 认知模式：思维链 / 反思链 / 组合（2026-10-07 第七轮）──
# 参考《AI Agent 从入门到精通》第四章（ReAct / Plan-and-Solve / Reflection）
# 与第七章（构建你的 Agent 框架）。模式表、思考骨架、反思判据都在
# `crew/cognition.py` 一处；本文档尾部有《Agent 认知升级方案.md》的索引。
#
# 一句话：让该"先想后答"的职位**先想后答**，让该"产出后审一遍"的地方**真审**。
#
# 总闸：关掉则**逐字退回**从前的行为（提示词里不出现思考段，
# JSON 格式里也不出现思考字段 —— 判据 `verify_cognition` 盯的就是这件事）。
COGNITION=true

# 演员的思维链：他开口之前先在心里过一遍（我要什么 / 刚才那句对我做了什么 /
# 换个人说成不成立 / 该说多长），答案压进 `推演`。
# ⚠ 演员是**每拍都跑**的职位（一次推演几百拍 × 十几个人）。
#   想省额度先关这条 —— 剧组那条一天只出工几次，便宜得多。
COT_ACTOR=true

# 剧组职位的思维链：剧作者（怎么分拍）· 小说作家（这一章怎么写）·
# 导演（先看清谁卡在哪儿再派活）· 场记/资料员/语言审校（先逐条核再下结论）。
COT_CREW=true

# 台词自省（反思链的"执行→反思→优化"落在台词上）：
# 某句台词**明显不像人在场上说的**（书面连接词 / 情绪直说 / 长得像作文）时，
# 让演员在说出口之前再审一遍自己这句 —— 可以改，也可以坚持原话。
# ⚠ 只处理规则挑出来的那一小撮（零成本粗筛）；正常对白**一次额外调用都不花**。
ACTOR_SELF_REVIEW=true

# 每一拍最多让几个人自省重说（安全阀：重说要额外花一次调用；0 = 等同关掉）。
ACTOR_SELF_REVIEW_MAX=2


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   前后台                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 后台模式
# - off: 关闭后台（省 token）
# - light: 轻量后台（推荐，规则 + 批量摘要）
# - full: 完整后台（贵）
# 候选：off / light / full
BACKGROUND_MODE=light

# 后台批次间隔（分钟）
# - 建议：30（默认）
BACKGROUND_TICK_MINUTES=30

# 进镜头自动升格
# - true: 后台 Agent 进镜头时自动升格为前台（推荐）
# - false: 不自动升格
PROMOTE_ON_STAGE=true

# 后台事件发生率（0~1）
# - 0.15: 约 15% 概率发生后台事件（推荐）
BACKGROUND_EVENT_RATE=0.15


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                 群演（临演池）                                  │
# └─────────────────────────────────────────────────────────────────────────────┘

# 按客流生成背景/功能群演（给故事一个外部输入）
EXTRAS_ENABLED=true

# 同一时刻最多几个群演在场上
EXTRAS_MAX_ALIVE=6

# 允许少数群演反复出现（带跨场记忆，像有故事的人）
EXTRAS_HOOKS=true

# 同一个钩子群演出现过几次后，建议转正为正式人物卡
EXTRAS_HOOK_PROMOTE_AT=3

# 每个故事日最多新生成几个（防刷屏）
EXTRAS_DAILY_BUDGET=8


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   每轮开场                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 开跑前出一屏「场景介绍 + 登场人物介绍」
SHOW_OPENING=true

# full = 引子 + 每人三行；brief = 信息条 + 每人一行
# 候选：full / brief
OPENING_DETAIL=full

# 引子调一次便宜档模型；关掉 = 纯拼装、零成本
OPENING_PROSE=true

# 续跑时：previously = 前情一行 + 本轮场景；full = 完整重介
# 候选：previously / full
OPENING_ON_RESUME=previously


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   导演引擎                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 三层目标全空时禁止 wait / 原地动作，强制重新决策
ANTI_IDLE_GATE=true

# 任务规训：人物能自己决定干什么。低＝照剧本演（剧本+分拍表都给），中＝只给要办的事（不给分拍表），高＝连今天要演什么都不说。同时影响采样温度（55℃–95℃）。⚠ 想清楚：调高会带来意外，也会带来跑题与空转
TASK_FREEDOM=50

# 文笔规训：字有多讲究。低＝最讲究（禁词全列/距离强制/思维链五问/口癖配额），高＝松（禁词只列一半/距离由人物自己选/思维链只留一问/口癖配额关）。⚠ 松的是“当场怎么写”，不是“写完不查”—— 审计照旧全量跑
STYLE_FREEDOM=50

# 每 N 拍给在场人物派一次活（0=关闭）。派的是「要达成什么」，不派「怎么做」
DISPATCH_EVERY_TICKS=8

# 同一件派活连续几轮被判「还在办」就判卡死、强制换新的（0=不限，可能永远换不了）
DISPATCH_STUCK_ROUNDS=2

# 导演引擎总开关
# - true: 启用导演（推荐）
# - false: 关闭导演（纯 Agent 自由发挥）
DIRECTOR_ENABLED=true

# 戏剧总闸（0~1）
# - 0.6: 适度戏剧性（推荐）
# - 0.3: 平淡日常
# - 0.9: 高强度冲突
DRAMA_LEVEL=0.6

# 冲突频率（0~1）
# - 0.4: 中等频率（推荐）
CONFLICT_FREQUENCY=0.4

# 伏笔/秘密揭示节奏（0~1）
# - 0.5: 适中（推荐）
REVEAL_PACING=0.5

# 巧合概率（0~1）
# - 0.2: 少量巧合（推荐）
COINCIDENCE_RATE=0.2

# 新人物登场倾向（0~1）
# - 0.1: 偶尔引入新人物（推荐）
NEW_FACE_RATE=0.1

# 张力曲线
# - auto: 取类型档案节奏模板（推荐）
# - flat: 平淡
# - medium: 中等波动
# - roller: 过山车式
# 候选：auto / flat / medium / roller
TENSION_CURVE=auto

# 每 N 日至少一次小高潮
# - 建议：5（默认）
CLIMAX_EVERY_DAYS=5

# 分支提案数量
# - 建议：3（默认，2~4 个）
BRANCH_PROPOSALS=3

# 分支等待秒数（岔路口那个面板等你多久）
# - 300 = 等 5 分钟后自动选（默认；面板上还有自定义输入框，
#   留够把一句走向想清楚并打完的时间）
# - 0 = 基本不等：面板照开，但主循环立刻按 `BRANCH_AUTO_POLICY` 挑
#   （想"必须我选"就把它设 0 **并且**让策略 = pause）
# ★ 你一动它（选中候选 / 开始在框里打字）倒计时就**停表**，不会把你的输入丢掉。
BRANCH_WAIT_SECONDS=300

# 分支超时策略
# - weighted: 按权重随机选（推荐）
# - first: 选第一个
# - random: 完全随机
# - pause: 暂停等人工
# 候选：weighted / first / random / pause
BRANCH_AUTO_POLICY=weighted

# 停滞检测窗口（分钟）
# - 180: 3 小时无事件视为停滞（推荐）
STALL_WINDOW_MINUTES=180

# 常规挑事的"安静上限"（**故事分钟**）
#   距上次事件超过这么多故事分钟，即使张力还高也照常挑事。
#   它不是用来调事件密度的（密度由 DRAMA_LEVEL × CONFLICT_FREQUENCY 说了算），
#   只保证密度不会掉到零 —— 张力在**一天之内只升不降**（回落只在跨天那一刻），
#   而一天有几百拍，只按张力判会让这一天剩下的几百拍再也没有外部刺激。
# - 5: 约 60 拍（BEAT_SECONDS=5 时）。想退回旧行为就设成一个很大的数
DIRECTOR_QUIET_MINUTES=5

# ── 导演盯戏（用户：「导演要一直盯着」「随时可以要求回档」）──
# 查两件事：**好几个人各自独立重复同一件事/同一句话**（这是单人的去重护栏
# 抓不到的：对每个人来说那句都是"第一次说"），以及连着几拍在原地打转。
# 判重的阈值是**量出来的**（正常对话 0.00 / 真重复 0.43 起），见
# `director/supervisor.py` 顶上那张表。
DIRECTOR_WATCH=true

# 每几拍盯一次（1 = 每拍）。盯戏本身零成本（不调模型），降频只是为了少刷日志。
DIRECTOR_WATCH_EVERY=2

# 几个**不同的人**各自说了类似的话才算「多人各自独立重复」。
# 2 会常常误报（对话里附和/复述确认本来就像）—— 默认 3。
DIRECTOR_WATCH_MIN_PEOPLE=3

# 一次最多删掉刚生成的几条戏（0 = 只提醒、不回档）。
# 回档会同时把屏幕上那几条撤掉、并把「场上刚发生」缓冲一起退回去。
DIRECTOR_ROLLBACK_MAX=6

# 复盘标了「需要重演」时，允许回档当天最后一段重排。
# - false（默认）: 只报不改 —— 动作者的稿子这事要你点头
# - true: 真的回档重演（一天最多一次，反复重演是死循环且每次都要花钱）
DAY_REVIEW_REPLAY=false

# 对话循环检测相似度阈值
# - 0.85: 相似度超过此值视为循环（推荐）
REPETITION_SIMILARITY=0.85

# 干预策略
# - pause: 暂停等人工（推荐）
# - auto_resolve: 自动解决
# 候选：pause / auto_resolve
INTERVENTION_POLICY=pause


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  模型与额度                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 正文被思考吃光时，自动关掉思考重试一次（关掉则只记一条警告，不再多发一次请求）
LLM_NO_THINK_RETRY=true

# 思考模式：auto=只有结论型用途关（默认）；off=一律关思考（快且省，创作类也关）；always=一律开思考（连判定也不关）
# 候选：auto / off / always
LLM_THINKING_MODE=auto


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   风格控制                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 虐心程度（0~1）
# - 0: 纯甜，不虐
# - 0.3: 小虐怡情（推荐）
# - 0.5: 适度虐心
# - 0.8: 大虐
# - 1: 虐到极致
ANGST_LEVEL=0.3

# 幽默度（0~1）
# - 0: 纯正剧，不搞笑
# - 0.3: 偶尔幽默（推荐）
# - 0.5: 适度搞笑
# - 0.8: 轻松喜剧
# - 1: 纯喜剧
HUMOR_LEVEL=0.3

# 爽点密度（0~1）
# - 0: 无爽点
# - 0.3: 偶尔爽
# - 0.5: 适中（推荐）
# - 0.8: 高密度爽点
# - 1: 爽到飞起
SATISFACTION_DENSITY=0.5

# 感情线占比（0~1）
# - 0: 无感情线
# - 0.3: 少量感情线（推荐）
# - 0.5: 适中
# - 0.8: 感情线为主
# - 1: 纯言情
ROMANCE_RATIO=0.3

# 悬念密度（0~1）
# - 0: 无悬念
# - 0.3: 偶尔悬念
# - 0.5: 适中（推荐）
# - 0.8: 高悬念
# - 1: 悬念不断
SUSPENSE_DENSITY=0.5

# 世界观展开速度（0~1）
# - 0: 缓慢渗透
# - 0.3: 渐进式
# - 0.5: 适中（推荐）
# - 0.8: 快速展开
# - 1: 一开始就全部展示
WORLDBUILDING_PACE=0.5

# 人物智商（0~1）
# - 0: 降智剧情
# - 0.3: 偶尔降智
# - 0.5: 正常（推荐）
# - 0.8: 高智商
# - 1: 天才级别
CHARACTER_IQ=0.5

# 节奏感
# - slow: 慢热
# - medium: 适中（推荐）
# - fast: 快节奏
# - roller: 过山车式
# 候选：slow / medium / fast / roller
PACING_STYLE=medium


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                    合规                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 合规总开关
# - true: 启用合规检测（推荐）
# - false: 关闭（强烈不建议）
COMPLIANCE_ENABLED=true

# 法域基准
# - zh_us: 双法并集，冲突以中国法为准（推荐）
# - zh: 仅中国法
# - us: 仅美国法
# 候选：zh_us / zh / us
COMPLIANCE_JURISDICTION=zh_us

# 审查力度
# - strict: C1 从严
# - standard: 标准档（推荐）
# - relaxed: 只拦法律禁止生成类（C0）
# 候选：strict / standard / relaxed
COMPLIANCE_LEVEL=standard

# 摄取时对项目文档做合规静态扫描
# - true: 扫描（推荐）
# - false: 跳过
COMPLIANCE_SCAN_ON_INGEST=true

# LLM 复核策略
# - hybrid: 仅规则命中或敏感场景才复核（推荐，省钱）
# - always: 每条都复核（贵）
# - never: 仅规则层（快但可能漏）
# 候选：hybrid / always / never
COMPLIANCE_LLM_REVIEW=hybrid

# 命中后的默认动作
# - rewrite: 降尺度重写（推荐）
# - block: 回滚该事件
# - pause: 暂停等管理员
# 候选：rewrite / block / pause
COMPLIANCE_ACTION=rewrite

# 合规命中日志
# - true: 记录（推荐）
# - false: 不记录
COMPLIANCE_LOG=true

# 项目级白名单（题材标签，逗号分隔）
# - 示例：冤案,战争场面
# - 需在向导/设置里显式确认才生效
COMPLIANCE_WHITELIST=

# 合规 Agent 专用模型
# - 空 = 用 MODEL_CHEAP（默认，够用）
# - 可指定更强的模型（合规判定错不起的场景）
COMPLIANCE_MODEL=

# 自定义策略库目录
# - 空 = 内置默认库
# - 自定义目录会与内置库叠加，同名文件用户优先
COMPLIANCE_POLICY_DIR=

# 策略文件变动热重载
# - true: 运行中改词表立即生效（推荐）
# - false: 需重启
COMPLIANCE_WATCH_POLICY=true

# 检查点覆盖
# - all: CP1~CP8 全查（推荐）
# - minimal: 只查摄取+前台事件+导出物（最省）
# 候选：all / minimal
COMPLIANCE_CHECKPOINTS=all


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                 Token 经济                                 │
# └─────────────────────────────────────────────────────────────────────────────┘

# 每日 token 预算（硬闸）
# - 200000: 约 20 万 token/天（推荐）
# - 0 = 不限
# - 首跑建议 AUTO_RUN_DAYS=1 试一晚再放大
TOKEN_BUDGET_PER_DAY=200000

# 预算告警阈值（0~1）
# - 0.8: 达到 80% 时告警（推荐）
TOKEN_WARN_AT=0.8

# 预算耗尽策略
# - degrade: 降级阶梯（推荐，关反思→后台 off→换便宜档→叙事模板化→暂停）
# - pause: 直接暂停
# 候选：degrade / pause
BUDGET_EXHAUST_POLICY=degrade

# 上下文缓存
# - true: 启用前缀缓存（推荐，省 token）
# - false: 关闭
CONTEXT_CACHE=true

# 记忆压缩阈值
# - 超过此条数后压缩记忆
# - 建议：200（默认）
SUMMARIZE_MEMORY_AFTER=200

# 最大上下文 token 数
# - 超过此值从动态层尾部往前裁，固定前缀永不裁
# - 建议：6000（默认）
MAX_CONTEXT_TOKENS=16000

# ── 输出上限怎么定（2026-10-10）──────────────────────────────────────
# 用户点名：按**模型自己的上限**来限，而不是我们手猜一个。
# 起因：真机日志里 day_script 两次 out=3998（上限 4000，正好卡住）、
#       day_summary 一次 out=2000 —— 都是写到一半被砍断。
# - model: 自动查表（llm/capabilities.MAX_OUTPUT_TOKENS），认不出这个模型就用下面那个兜底
# - manual: 回到按各用途的 *_TOKENS 旋钮（再乘 LLM_TOKEN_SCALE）
# 候选：model / manual
LLM_TOKEN_BUDGET_MODE=model

# 认不出模型时的兜底上限（故意保守；真撞上了还有"减半重试"兜着）
LLM_MAX_TOKENS_FALLBACK=819200

# 只在 manual 模式下参与：把所有 *_TOKENS 旋钮整体放大这么多倍
LLM_TOKEN_SCALE=1.0

# 警戒线：一次输出用到上限的这个比例就记一条日志（在"被截断"之前先看见）
LLM_TOKEN_WARN_RATIO=0.85

# **主动压缩的触发线**：上下文用到预算的这个比例就动手压（不等到撞墙、也不只是提醒）
CTX_COMPACT_AT=0.8

# 压缩后**保留最近多少比例**的记忆原文（更老的折成一条摘要）
CTX_COMPACT_KEEP=0.35

# **目标水位**：压完要落回预算的这个比例以下 ——否则下一拍立刻又触发，来回抖
CTX_COMPACT_TARGET=0.5

# 一次最多压几轮（防跑飞；压不动就停下并说明）
CTX_COMPACT_MAX_ROUNDS=2

#
# ① 空闲时段折扣：DeepSeek 是峰谷定价（高峰=周一至周五 9:00-12:00、14:00-18:00，
#    北京时间），空闲是高峰的一半。模拟可以挑时间跑 —— 大批量放晚上/周末直接省半。
#    ⚠ 只作用于认得出是峰谷定价的模型（DeepSeek）；别家平价，不受影响。
#    填 1.0 = 关掉折扣（一律按高峰算）。
LLM_OFFPEAK_DISCOUNT=0.5

# ② 同题复用：完全相同的输入+模型+参数，保质期内再问一次直接返回上次的答案
#    —— 不发请求、不花钱，结果仍然是对的。只对下面那张白名单里的用途生效。
LLM_DEDUP_ENABLED=true

#    可以复用的用途（逗号分隔）。共同点：同一段输入就该给出同一个结论。
#    ⚠ 绝对不要加 dialogue / narrate / crew_novelist / day_story 这类 ——
#      那些要的正是"每次不一样"，缓存会让全场人说着同一句话。
LLM_DEDUP_PURPOSES=progress_eval,progress,genre,style,extract,book_scan,compliance,day_verify,summary,day_summary,memory_compact

#    复用的保质期（秒）。设定会改、进度会变，老答案不能一直用。0 = 不过期（不建议）。
LLM_DEDUP_TTL_SECONDS=3600

# 跨进程共享缓存（主程序与三个外挂共用一份问答缓存）；只对「判定/抽取/校对」这类用途生效
LLM_CACHE_ENABLED=true

# 共享缓存的保质期（秒）；0 = 永不过期
LLM_CACHE_TTL_SECONDS=7200

# 共享缓存文件的位置；留空 = 软件根目录的 llm_cache.db
LLM_CACHE_PATH=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  输出与日志                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 日志目录
# - 留空（推荐）: 写到「程序目录 / logs/」
# - 也可以填绝对路径，例如 D:\nws-logs
# ⚠ 日志器在启动时一次性建好，所以**改这项要重启程序才生效**。
#    「天机 · 全局设置 → 日志」里也能改，旁边有「浏览…」按钮。
#
# logs/ 下会是三样东西（详见《使用说明》§12）：
#   nws_<书名>_<时间>.log            主日志：程序流水（用户名/密钥等会打码）
#   nws_<书名>_dialogue_<时间>.log   对话日志：每次 LLM 交换的全文（**不打码**，
#                                    里面是你的作品与设定，发给别人前先看一眼）
#   llm_calls.jsonl                  调用账本：一行一次调用（跨运行累积）
# ⚠ `nws*.log` 里**超过 30 天**的会在启动时被删掉 —— 要留档的先复制走。
LOG_DIR=

# 日志级别
# ⚠⚠ **目前不生效**（如实说明）：这一项会被保存，但日志器还没读它 ——
#     主日志**固定记录 DEBUG 及以上**，改这里不会让日志变多变少。
#     想安静一点，目前只能手动清理 logs/ 目录。
# 留下这四个档位是为了以后接上（接上是一次行为变更，要单独做）：
# - DEBUG: 调试信息（详细，含人物决策细节）
# - INFO / WARNING / ERROR
# 候选：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 调试模式（排障用）
# - true: 每次 LLM 请求的**前 200 字**也写进**主日志**，并让账本存**完整响应**
# - false: 正常模式（推荐）
# ⚠ 它**不影响**对话日志 —— 对话日志本来就记全文，且与这一项无关。
DEBUG_MODE=false

# 保存调用账本（logs/llm_calls.jsonl）
# - true: 记（推荐，一行一次调用：模型/用途/进出 token/耗时）
# - false: 不记
# ⚠ 只影响**账本**，不影响主日志与对话日志；账本**不在自动清理范围内**，会一直涨。
SAVE_RAW_LOGS=true

# 日志的**额外**清理天数（只管 `nws*.log`）
# ⚠ 先说清一件事：**不管这里填什么**，程序每次启动都会清掉
#   **30 天前**的 `nws*.log`（主日志与对话日志都在内）。
#   要留档的，先复制走。
# 这一项是在那次之上**再**清一遍：
# - 0 = 不做额外清理（默认；启动时那一次 30 天照旧生效）
# - 30: 额外再清一次 30 天前的
# ⚠ `llm_calls.jsonl`（调用账本）**不在任何清理范围内**，会一直涨，嫌大就手动删。
LOG_ROTATE_DAYS=0

# 快照保留份数
# - 30: 保留 30 份（推荐）
# - 0 = 不限
SNAPSHOT_KEEP=30


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                    界面                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 界面语言
# - zh: 中文（默认）
# - en: English
# 注：界面上下拉框里显示的是**语言自己的名字**（中文 / English；英文界面下是
#     Chinese / English），但这里存的、以及 .env 里生效的一律是 zh / en。
# 注：也可在程序内「天机 · 全局设置 → 界面外观 → 界面语言」里切换，切换后界面立即刷新
# 候选：zh / en
LANGUAGE=zh

# 界面不透明度（%）
# **数值越大越透**：0 = 完全不透明，100 = 最透（2026-10-13 起的方向）
# 作用范围（**只有这两处**）：
#   - 运行界面的所有面板，**包括中间那块叙事/输出区**
#   - 开始界面（标题块 + 菜单卡片）
# **不影响任何对话框**（天机 / 书斋 / 开卷向导 / 拾卷 / 开卷摄取）——
#   对话框始终是不透明的纸，这是 2026-10-13 用户点名要的
# 不生效的地方（有意为之）：
#   - 文字与 1px 描边保持不透明 —— 半透明的字会直接伤可读性
#   - 输入框 / 下拉框保留 85% 的下限 —— 得看清自己打的字
#   - 面板底色最低保留 30%（再透字就糊在背景花纹上了），
#     所以 70%~100% 都停在最透那一档
# 建议区间：30~70。超过 70 之后滑杆不再变化
UI_OPACITY=70

# 背景滤镜不透明度（%）：**只对开始界面与运行界面生效，不影响任何对话框**。0=完全不压暗（背景最清晰），数值越大纸色滤镜越浓、背景越退到文字后面。这一项是「运行时滤镜」，图片本身保持高清——调它不会改到图片文件；调完立刻生效，在「天机 · 全局设置 → 界面外观」里拖动即可
BG_DIM=35

# 界面字体
# 候选（程序会把**本机真的能用**的列在「天机 · 全局设置 → 界面外观」的下拉里）：
# - auto   : 随附宋体（= serif，推荐；2026-10-11 起的默认值）
# - serif  : 随附宋体 —— **思源宋体**（Noto Serif SC，SIL OFL 1.1）
# - sans   : 随附黑体 —— 思源黑体（Noto Sans SC，SIL OFL 1.1）
# - kai    : 随附楷体 —— 霞鹜文楷（LXGW WenKai，SIL OFL 1.1）
# - system : 跟随系统默认（Windows 微软雅黑 / macOS 苹方 / Linux 思源黑体 CJK）
# - yahei  : 系统 · 微软雅黑      （Windows）
# - simsun : 系统 · 宋体          （Windows）
# - simhei : 系统 · 黑体          （Windows）
# - kaiti  : 系统 · 楷体          （Windows）
# - dengxian: 系统 · 等线         （Windows）
# - pingfang: 系统 · 苹方         （macOS）
# - songti : 系统 · 宋体-简       （macOS）
# - noto-cjk: 系统 · 思源黑体 CJK （Linux）
#
# 为什么默认换成了思源宋体（2026-10-11 用户反馈）：
#   霞鹜文楷的底子是日文教科书体 Klee One，**部分汉字用的是日文字形** ——
#   用户点名的那一个是「门」：霞鹜文楷把第一笔的「点」写成一条斜长的撇，而
#   思源宋体 / 系统宋体 / 微软雅黑都是「一点 + 竖」的国标写法。
#   思源宋体同时满足"通用"（跨平台一致、字形合规）与"好看"（与水墨纸感一路）。
#
# ⚠ 「系统 · xxx」那几种**不随程序分发**（操作系统的字体许可不允许），
#   只在本机装了的时候才会出现在下拉里；换到别的机器上会回落到系统默认。
# ⚠ 改完**不用重启**：保存后界面立刻重建。
# 候选：auto / serif / sans / kai / system / yahei / simsun / simhei / kaiti / dengxian / pingfang / songti / noto-cjk
UI_FONT=auto

# 关闭运行窗口底部的命令行（命令输入框 + 「发送」按钮）
# - true : 不显示（**默认**）
# - false: 显示那一栏
# 为什么默认关掉：那一栏只接了 /help /status /settings 三条命令，平时用不上，
#   留着只是占掉中间叙事区的高度。
# ⚠ **关掉不减能力**：命令本身照旧可用，右上角「❓ 帮助」与快捷键 F11 都在；
#   命令行只是一个可见的输入入口，不是唯一入口。
HIDE_COMMAND_BAR=false

# 界面字号缩放（%）
# - 100 = 标准（默认）
# - 80~150 之外会被夹紧
# 作用：标题、正文、提示、按钮、**控件高度**按同一比例一起缩放
#       （只放大字号会把字顶到边框上，所以高度必须跟着走）
# 改完**不用重启**：保存后界面立刻重建。
# ⚠ 调到很大（如 140、150）时，对话框里的内容可能需要滚动才能看全。
UI_FONT_SCALE=100


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   叙事输出                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 叙事输出格式
# - script: 剧本式（推荐）——按「时间说明 → 场景说明 → 人物出场/退场 →
#           旁白 → 对白 → 动作」组织；同一时刻多人在做不同事会排成「同时」的并行轨，
#           异地同时用「切至」；每个 action 都带主体，能看清"谁在做事"
# - prose:  旧的自由文本（一维字符串流，动作与对白混在一起）
# 两种格式的旧运行文件夹都能读，随时可切回。
# 候选：script / prose
OUTPUT_FORMAT=script

# 自动补环境句
# - true: 幕首与空场时补一句环境描写（由**真实**的时段与天气推出，不编造剧情）
# - false: 不补，只写实际发生的事
# 注意：这不是"填假数据"——时段和天气都取自 WorldState 的真值；
#      不想要就把这项关掉。
SCRIPT_AMBIENT=true

# 插图位置（图片输出以"少而准"为原则，文字仍是主体）
# - off:      不出图
# - map:      场景切换时给一张场景图（小地图帧）
# - portrait: 人物**首次出场**时给一张肖像
# - both:     两者都要（推荐）
# 说明：这些图由 Pillow 本地绘制，**零成本、不出机**。
#      文生图场景插画不在本项范围内（那个按张计费，需单独开）。
# 候选：off / map / portrait / both
SCRIPT_IMAGES=both

# 一幕最多多少条
# - 40: 适中（推荐）
# - 一幕太长读起来累，超过就自动分幕（换新幕首，重新标时间与在场）
SCRIPT_SCENE_MAX_ENTRIES=40

# ── 叙事窗口：分页与时间戳（2026-10-11）────────────────────────────────
# 叙事窗口里每条左上角标一行很小的时间（真实时间 · 剧情时间），方便对照
# 「哪句话是什么时候说的」。
# ⚠ 只对本轮**实时产生**的条目有效 —— 从落盘文件读回来的历史没有真实时间，
#   不编（留空）。嫌挤可以关掉。
NARR_TIMESTAMP=true

# 叙事窗口**一页显示多少条**（条 = 一条叙事/台词/分隔符）。
# 超过一页时叙事区上方会出现翻页条，可以往回翻到**本次推演的最开头**。
# ⚠ 以前只渲染最近 200 条、且控件超 400 会删掉最前面 100 个（内容真的被吞）。
#   现在是分页：内容一条不丢，控件数有界。
# - 200: 适中（推荐）
# - 调大 = 一页装更多、翻页少，但一次画的控件多、切换稍慢
NARR_PAGE_ENTRIES=200


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   对话插图                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 全彩文生图用的模型名
# - 示例：gpt-image-1 / dall-e-3 / flux-1.1-pro / cogview-3
# - 留空 = 不启用这一档（选了会自动降级为 PNG 矢量图，人物肖像改用文字代替）
# - 这一项决定 LLM_CAP_IMAGE 的取值：填聊天模型（如 deepseek-chat）没有意义，
#   启动校验会据此把 LLM_CAP_IMAGE 置为 false 并提示
# ⚠ 改完要重启程序才生效
IMAGE_AI_MODEL=

# 文生图尺寸
# - 1024x1024（方图，最便宜） / 1024x1536 / 1536x1024 / 512x512
# - 横向（1536x1024）更适合当插画
# 候选：1024x1024 / 1024x1536 / 1536x1024 / 512x512
# ⚠ 改完要重启程序才生效
IMAGE_AI_SIZE=1024x1024

# 每张图的费用（元）。0 = 不估钱（调用次数照记）
IMAGE_AI_UNIT_PRICE=0.0


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   小地图                                    │
# └─────────────────────────────────────────────────────────────────────────────┘

# 今天这张小地图交给剧组美术按当天剧情**从底图里取景**。
# 关掉 = 按剧情顺序沿一条主路铺开（不联网、零成本）
MINIMAP_AI=true

# ── 三级底图（2026-10-08）──────────────────────────────────────
# 用户原话：「设定集里是否可以包含某个房屋的地图，另外 是否可以在开卷的时候
# 把一些整体地图 局部地图 (房屋附近 房屋内部 以及别的需要的地图) 提前画好
# 需要的时候基于这些地图让美术加细节」
#
# 做的：**开卷时**按 地点.yaml 把三层底图一次定下来，存进
# `设定集/小世界地图.yaml`；之后每天美术**从底图里取景 + 补细节**，
# 不再凭空摆位（那样同一处地方今天画左、明天画右）。
#
#   整体 = 地点之间的方位与通路（城/镇一级）
#   局部 = 一处地点周边（河、桥、邻舍）
#   室内 = 房屋内部的房间与院落（堂屋 / 后院 / 井 / 柜台）
#
# 代价：整体一次调用 + 每处地点一次（`地点.yaml` 提取上限本来是 5 条）。
# 沿用同一原则：**依据没变就不重画**（改一句说明不会让整本书的图重画一遍）。
MAP_ATLAS=true

# 三级底图之外**再出位图氛围底画**（整体一张 + 每处局部一张，走文生图）。
# 每张一次出图，耗时且花钱；矢量底图不依赖它 —— 关着也照样有稳定的图，
# 只是少一层画面质感。
MAP_ATLAS_BITMAP=false

# 每层底图一次生成允许多少 token（整体一次、每处地点一次）
MAP_ATLAS_TOKENS=1800

# **同一处地方永远画在同一块位置**：位置一旦定下就不再变，新的地点只往空处补（存在项目的 `地图/锚定.json` 里，换一轮推演也还是它）。关掉 = 每次都按模型给的重新排，同一处地方在不同天里可能换位置
MAP_ANCHOR=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   显示节奏                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 显示档位
# - reading: 看戏阅读档（打字机+18 字/秒，推荐）
# - fast: 监控速览档（关打字机，整段上屏）
# 候选：reading / fast
DISPLAY_PROFILE=reading

# 阅读呈现速度（字/秒）
# - 18: 中文舒适区（推荐）
# - 15: 慢读
# - 25: 快读
READING_CPS=18

# 显示队列积压上限（条）
# - 超过按积压策略处理
DISPLAY_BACKLOG_LIMIT=40

# 积压策略
# - compress: P3 折叠成一行式（推荐）
# - jump: 跳到最新
# - block: 等同锁定模式
# 候选：compress / jump / block
DISPLAY_CATCHUP_POLICY=compress

# 锁定模式
# - true: 模拟等显示，一字不漏（速度受阅读速度限制）
# - false: 自由队列（推荐）
DISPLAY_LOCK_SIM=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  资料与考据                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 用户资料库根目录
# - 空 = 不使用资料库
# - 示例：E:\参考资料
# - 目录结构：参考书/ 参考小说/ 规则/
REFERENCE_DIR=

# 单次注入资料片段上限（字）
# - 500: 适中（推荐）
REFERENCE_INJECT_MAX=500

# 技能目录
# - .\skills: 默认技能目录
SKILLS_DIR=.\skills

# 技能启用
# - true: 启用技能（推荐）
# - false: 关闭技能
SKILLS_ENABLED=true

# MCP 服务配置文件
# - .\mcp_servers.yaml: 默认配置（随程序发行，含 3 个本地服务 + 4 个联网模板）
# - 配置格式与写法见 mcp/README.md
MCP_CONFIG=.\mcp_servers.yaml

# MCP 总开关
# - true: 允许调用 MCP 服务（推荐；本地服务不出机）
# - false: 完全不拉起任何 MCP 进程
# 注意：这是**总闸**。每个服务还有自己的 enabled 开关，
#      联网模板（fetch / duckduckgo-search / wikipedia / time）默认都是 false，
#      要用得自己改成 true —— 它们会把查询词发出本机。
MCP_ENABLED=true

# 单次 MCP 调用的超时（秒）
# - 20: 适中（推荐）
# - 服务启动慢或查询重时可调大；上限 300
MCP_TIMEOUT_SECONDS=20

# 知识缺口自动考据
# - true: 自动考据（推荐）
# - false: 仅手动 research 命令
RESEARCH_AUTO=true

# 每日自动考据上限
# - 10: 适中（推荐）
RESEARCH_MAX_PER_DAY=10

# 考据结果缓存期（天）
# - 30: 30 天（推荐）
RESEARCH_CACHE_DAYS=30

# 联网搜索兜底
# - true: 启用（出机警告，向导二次确认）
# - false: 关闭（推荐，隐私优先）
ONLINE_LOOKUP=false


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                  AI 质量                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 提示词模板目录
# - .\prompts: 默认目录
# - 用户目录同名文件优先覆盖
PROMPTS_DIR=.\prompts

# 提示词热重载
# - true: 改词不动码（推荐）
# - false: 需重启
PROMPT_WATCH=true

# 叙事整理审稿 pass
# - true: 低于阈值重写一次（推荐）
# - false: 关闭审稿（省 token）
REVIEW_PASS=true

# 审稿阈值（0~1）
# - 0.7: 良好以上通过（推荐）
REVIEW_THRESHOLD=0.7

# 从正文取 few-shot
# - true: 关键生成注入正文好段落做示例（推荐，风格卡的活体版）
# - false: 不注入（无正文时自动跳过）
FEWSHOT_FROM_NOVEL=true

# 库在 `style/deai.py`：四类**硬禁词**（论述腔/连接腔/情绪直说/空转修饰）
# + 十条**软提示**（对仗句/比喻堆叠/解释腔/三连排比/标点/总结收尾）。
#
# 两半都不花钱，所以"每一段产出都过一遍"才做得起：
#   · **事前**：把清单塞进演员决策提示词（"别写出来"）；
#   · **事后**：产出逐条审计（词表比对），命中落盘「去AI审计.md」。
# 覆盖范围：演员的台词 + 剧组 15 个职位的全部产出。
#
# 想加自己这本书不许出现的词：写进 `craft/去AI补充.yaml`（不用改代码）：
#   词: [某某, 某某某]
#   情绪直说: [心里一紧]
DEAI=true

# 提示词里每类列几个禁词（0 = 不列词、只列句式）。
# 列太多会挤占上下文，而模型的注意力有限 —— 剩下的交给事后审计兜底。
DEAI_PROMPT_ITEMS=5

# 台词里偶发写进的**套话词**直接删掉（"首先，我不去" → "我不去"）。
# 只删词、**不动句式**（删了会把句子弄坏）；删了什么会记进日志与审计页。
# - true: 删（推荐）· false: 只审计、不改写
DEAI_STRIP=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                                   影视镜头                                   │
# └─────────────────────────────────────────────────────────────────────────────┘

# 影视镜头卡
# - true: 叙事段附镜头卡（机位/拍法/出场人物）
# - false: 关闭（推荐，省 token 约 10-20%）
FILM_MODE=false

# TUI 显示镜头卡
# - true: 段首显示镜头卡（FILM_MODE=true 时生效）
# - false: 隐藏
DISPLAY_FILM_CARDS=true


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                            创作服务 · MuMuAINovel                            │
# └─────────────────────────────────────────────────────────────────────────────┘

# 总开关：允许剧组把写作交给 MuMuAINovel（本机 8001 端口的独立写小说服务，上游 https://github.com/xiamuceer-j/MuMuAINovel ）。关掉 = 完全用本项目自己的写法；打开后若服务没起/超时/写空，会自动退回本项目自己的写法并记明原因
MUMU_ENABLED=false

# 小说作家（写当天样章、收工整理稿）改走 MuMuAINovel。关掉则只有别的职位用它
MUMU_FOR_NOVELIST=true

# 导出『最终改写稿』时改走 MuMuAINovel：据『原始稿 + 推演过程』重写每一天。关掉则导出沿用内部整理稿；打开后若服务没起/超时/写空，会自动退回内部整理稿并记明原因（不丢戏）
MUMU_FOR_EXPORT=false

# 程序启动时自动拉起写小说服务（后台起，起不来只提示、不拦主程序）。关掉则要自己跑 `novelservices/MuMuAINovel/backend/novelservice.py start`
# ⚠ 改完要重启程序才生效
MUMU_AUTOSTART=true

# 关闭程序时**一并停掉**写小说服务。默认开（关掉程序就真的什么都不留）。关掉 = 服务常驻后台，下次启动更快，但要自己记得停它
MUMU_FOLLOW_APP=true

# 等 MuMuAINovel 写完一章的上限（秒）。**别调太小**：实测同一章 17 秒到 207 秒都出现过，推理模型想多久控不住；超时会造成这一章白等
MUMU_TIMEOUT_SECONDS=900

# 导出重写**最多让服务写几遍**（含第一遍）。每遍拿回来先过**本项目自己的**检查清单，有可数的毛病就把「哪一类、几处」退回让它重写，并且**两版按验收层比，取更好的**——不是无条件采用新稿。1 = 只要一遍（旧行为）；调大会明显变慢，而且超过 3 遍收益很小
MUMU_EXPORT_TRIES=2

# **开演前那份「样章」**目标多少字。0 = 跟随剧组自己的口径（CREW_STORY_MIN~MAX，即 180~600 字的**质感样本**）。⚠ 别拿 MUMU_TARGET_WORDS（2500）当它用：那是**导出重写整章**的字数。实测两条路差 4~14 倍，而它们的产物都交给同一个编剧去拆拍 ——2500 字的样章会让编剧拆出更细的拍，把演员框死（用户 2026-10-21 问的正是这个）。
MUMU_SAMPLE_WORDS=0

# 交给 MuMuAINovel 那一章的目标字数
MUMU_TARGET_WORDS=2500

# 让 MuMuAINovel 给每章做一次分析（角色状态/伏笔/剧情总结）。开着它下一章能「记得住」，代价是明显更慢
MUMU_ENABLE_ANALYSIS=false

# MuMuAINovel 的章节分析用哪个模型。**留空 = deepseek-chat**（推荐）：它不思考，而推理模型会把输出预算烧在思考上（实测最坏一次想 22876 字符、正文 0 字）
MUMU_ANALYSIS_MODEL=

# 用 MuMuAINovel 的哪个技能（可空）。候选见 novelservices/MuMuAINovel/backend/app/skills/。留空 = 用它的默认写作流程。常用：story-long-write
MUMU_SKILL_KEY=

# 「来自 AI模型配置」下拉的当前选择（登记表的 key）。空 = 不覆盖，服务用它自己 .env 里的配置
MUMU_LLM_PICK=


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                             创作服务 · PlotPilot                             │
# └─────────────────────────────────────────────────────────────────────────────┘

# 总开关：允许剧作者把『本章方案』交给 PlotPilot（本机 8005 端口的独立叙事引擎，上游 https://github.com/shenminglinyi/PlotPilot ）。关掉 = 完全用本项目自己的编剧逻辑；打开后若服务没起/超时/空章，会自动退回本项目自己的编剧逻辑并记明原因
PLOTPILOT_ENABLED=false

# 剧作者（screenwriter）改走 PlotPilot 产出本章方案。关掉则只有别处用到它
PLOTPILOT_FOR_SCREENWRITER=true

# PlotPilot 服务监听地址（默认 127.0.0.1，本机）
PLOTPILOT_HOST=127.0.0.1

# PlotPilot 服务端口（默认 8005）
PLOTPILOT_PORT=8005

# 覆盖 PlotPilot 用的 LLM 档案/模型（可空）。留空 = 用 PlotPilot 自己的默认；具体填法取决于 PlotPilot 的 profile_id
PLOTPILOT_MODEL=

# 「来自 AI模型配置」下拉的当前选择（登记表的 key）。空 = 不覆盖，服务用它自己 .env 里的配置
PLOTPILOT_LLM_PICK=

# 程序启动时自动拉起 PlotPilot（它需要 LLM 凭证，默认**关**避免无谓冷启动；要常驻再打开）
# ⚠ 改完要重启程序才生效
PLOTPILOT_AUTOSTART=false

# 关闭程序时一并停掉 PlotPilot（默认开）
PLOTPILOT_FOLLOW_APP=true

# 等 PlotPilot 产出一章方案的上限（秒）
PLOTPILOT_TIMEOUT_SECONDS=900


# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                              创作服务 · PenShot                              │
# └─────────────────────────────────────────────────────────────────────────────┘

# 总开关：允许导演把『分镜方案』交给 PenShot（本机 8000 端口的独立导演/分镜引擎，上游 https://github.com/neopen/story-shot-agent ）。关掉 = 完全用本项目自己的导演逻辑；打开后若服务没起/超时，会自动退回本项目自己的导演逻辑并记明原因
PENSHOT_ENABLED=false

# 导演（director）改走 PenShot 产出分镜方案。关掉则只有别处用到它
PENSHOT_FOR_DIRECTOR=true

# PenShot 服务监听地址（默认 127.0.0.1，本机）
PENSHOT_HOST=127.0.0.1

# PenShot 服务端口（默认 8000）
PENSHOT_PORT=8000

# 覆盖 PenShot 用的模型（可空）。留空 = 用 PenShot 自己 .env 里的配置（PENSHOT_LLM__DEFAULT__*）
PENSHOT_MODEL=

# 「来自 AI模型配置」下拉的当前选择（登记表的 key）。空 = 不覆盖，服务用它自己 .env 里的配置
PENSHOT_LLM_PICK=

# 程序启动时自动拉起 PenShot（它需要 LLM 凭证，默认**关**避免无谓冷启动；要常驻再打开）
# ⚠ 改完要重启程序才生效
PENSHOT_AUTOSTART=false

# 关闭程序时一并停掉 PenShot（默认开）
PENSHOT_FOLLOW_APP=true

# 等 PenShot 产出分镜的上限（秒）
PENSHOT_TIMEOUT_SECONDS=900
